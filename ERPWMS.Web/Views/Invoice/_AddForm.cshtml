@{
    Layout = null;
}
<style>
    .inv-f .form-label { font-size: 11px; font-weight: 600; color: #1e293b; margin-bottom: 3px; display: block; }
    .inv-f .form-control, .inv-f .form-select { font-size: 12px; padding: 6px 10px; min-height: 34px; border-radius: 6px; border: 1px solid #cbd5e1; }
    .inv-f .form-control[readonly] { background: #f1f5f9; }
    .inv-f .row.g-2 { --bs-gutter-y: 8px; --bs-gutter-x: 10px; }
    .inv-f .item-row { padding: 10px 12px; background: #fafbfc; border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 8px; }
    .inv-f .btn-gold { background:#F5A623;color:#0A1628;border:none;font-weight:700;padding:6px 16px;border-radius:6px;font-size:12px; }
    .inv-f .btn-ghost { background:#fff;color:#475569;border:1px solid #cbd5e1;padding:6px 16px;border-radius:6px;font-size:12px;font-weight:600; }
    .inv-f .so-locked { padding: 8px 12px; background: #DBEAFE; border-radius: 6px; font-size: 11px; color: #1E40AF; font-weight: 600; display: none; }
    .inv-f .so-locked.show { display: block; }
</style>

<form id="addForm" method="post" action="/Invoice/Register" autocomplete="off" class="inv-f">
    @Html.AntiForgeryToken()
    <div id="addAlert" style="display:none;padding:8px 12px;border-radius:6px;font-size:11.5px;margin-bottom:12px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>

    <div class="row g-2">
        <div class="col-md-6">
            <label class="form-label">Sales Order *</label>
            <select name="SalesId" id="soSelect" class="form-select" required>
                <option value="">-- Select Sales Order --</option>
                @if(ViewBag.SalesOrders != null) { foreach(var s in ViewBag.SalesOrders) {
                    <option value="@s.salesId">@s.salesOrderNo</option>
                } }
            </select>
            <div style="font-size:10px;color:#64748B;margin-top:3px;">
                <i class="bi bi-info-circle"></i> Only uninvoiced Sales Orders appear
            </div>
        </div>
        <div class="col-md-6">
            <label class="form-label">Invoice No *</label>
            <input type="text" name="InvoiceNo" class="form-control" readonly value="@(ViewBag.NextInvoiceNo ?? "")" style="font-family:monospace;font-weight:700;" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Invoice Date</label>
            <input type="date" name="InvoiceDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Due Date</label>
            <input type="date" name="DueDate" class="form-control" value="@DateTime.Now.AddDays(30).ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Paid Amount</label>
            <input type="number" step="0.01" name="PaidAmount" class="form-control paid-input" value="0" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Discount</label>
            <input type="number" step="0.01" name="Discount" class="form-control discount-input" value="0" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Tax</label>
            <input type="number" step="0.01" name="TaxAmount" class="form-control tax-input" value="0" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Net Amount</label>
            <input type="text" class="form-control" id="netDisplay" readonly value="Rs 0.00" style="background:#f0f9ff;font-weight:700;color:#0369a1;" />
        </div>
    </div>

    <div class="so-locked" id="soLocked">
        <i class="bi bi-lock-fill"></i> Items are locked from Sales Order — cannot add or remove
    </div>

    <div style="display:flex;justify-content:space-between;align-items:center;margin:14px 0 8px;">
        <span style="font-size:12px;font-weight:700;color:#0A1628;">Invoice Items</span>
        <span style="font-size:10px;color:#94A3B8;">(Auto-loaded from Sales Order)</span>
    </div>

    <div id="itemsContainer">
        <div class="item-row" style="text-align:center; padding: 24px; color: #94A3B8; font-size: 11px;">
            <i class="bi bi-arrow-up-circle" style="font-size: 24px; display: block; margin-bottom: 6px;"></i>
            Select a Sales Order to load items
        </div>
    </div>

    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold"><i class="bi bi-check-lg"></i> Create Invoice</button>
    </div>
</form>

<script>
(function(){
    var form = document.getElementById('addForm'); if(!form) return;

    function fmt(n){ return "Rs " + (Number(n)||0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ","); }

    function calc(){
        var sub = 0;
        form.querySelectorAll('.item-row').forEach(function(row){
            var qtyEl = row.querySelector('.qty-input');
            if(!qtyEl) return;
            var q = parseFloat(qtyEl.value||0)||0;
            var p = parseFloat(row.querySelector('.price-input') ? row.querySelector('.price-input').value : 0)||0;
            var dp = parseFloat(row.querySelector('.disc-input') ? row.querySelector('.disc-input').value : 0)||0;
            var lt = q * p;
            var net = lt - (lt * dp / 100);
            sub += net;
            var lf = row.querySelector('.line-total');
            if(lf) lf.value = fmt(net);
        });
        var disc = parseFloat(form.querySelector('.discount-input') ? form.querySelector('.discount-input').value : 0)||0;
        var tax = parseFloat(form.querySelector('.tax-input') ? form.querySelector('.tax-input').value : 0)||0;
        var grand = sub - disc + tax;
        var nd = document.getElementById('netDisplay');
        if(nd) nd.value = fmt(grand);
    }

    form.addEventListener('input', function(e){
        var n = e.target.name || '';
        if(n.match(/quantity|price|discount|tax|paid/i)) calc();
    });

    // ═══ LOAD SO ITEMS (locked) ═══
    var soSel = document.getElementById('soSelect');
    if(soSel) soSel.addEventListener('change', function(){
        var sid = this.value;
        var cont = document.getElementById('itemsContainer');
        var lock = document.getElementById('soLocked');

        if(!sid){
            cont.innerHTML = '<div class="item-row" style="text-align:center; padding: 24px; color: #94A3B8; font-size: 11px;"><i class="bi bi-arrow-up-circle" style="font-size: 24px; display: block; margin-bottom: 6px;"></i>Select a Sales Order to load items</div>';
            lock.classList.remove('show');
            return;
        }

        cont.innerHTML = '<div style="text-align:center;padding:20px;"><div class="spinner-border spinner-border-sm text-primary"></div></div>';
        lock.classList.remove('show');

        fetch('/Invoice/GetSalesDetails?salesId=' + sid)
            .then(r => r.json())
            .then(function(items){
                if(!Array.isArray(items) || items.length === 0){
                    cont.innerHTML = '<div class="item-row" style="text-align:center; padding: 24px; color: #DC2626; font-size: 11px;"><i class="bi bi-exclamation-triangle" style="font-size: 24px; display: block; margin-bottom: 6px;"></i>No items found in this Sales Order</div>';
                    return;
                }

                lock.classList.add('show');

                var h = '';
                items.forEach(function(it, idx){
                    h += '<div class="item-row">';
                    h += '<div class="row g-2">';
                    h += '<div class="col-md-5">';
                    h += '<label class="form-label">Product</label>';
                    h += '<input type="text" class="form-control" value="' + (it.productName || 'Product') + '" readonly style="background:#f1f5f9;font-weight:600;" />';
                    h += '<input type="hidden" name="InvoiceDetails[' + idx + '].ProductId" value="' + it.productId + '" />';
                    h += '<input type="hidden" name="InvoiceDetails[' + idx + '].SalesDetailId" value="' + it.salesDetailId + '" />';
                    h += '</div>';
                    h += '<div class="col-md-2">';
                    h += '<label class="form-label">Qty *</label>';
                    h += '<input type="number" name="InvoiceDetails[' + idx + '].Quantity" class="form-control qty-input" min="1" value="' + it.quantity + '" required />';
                    h += '</div>';
                    h += '<div class="col-md-2">';
                    h += '<label class="form-label">Price *</label>';
                    h += '<input type="number" step="0.01" name="InvoiceDetails[' + idx + '].UnitPrice" class="form-control price-input" min="0" value="' + it.unitPrice + '" required />';
                    h += '</div>';
                    h += '<div class="col-md-2">';
                    h += '<label class="form-label">Disc %</label>';
                    h += '<input type="number" step="0.01" name="InvoiceDetails[' + idx + '].DiscountPercent" class="form-control disc-input" min="0" value="' + (it.discountPercent || 0) + '" />';
                    h += '</div>';
                    h += '<div class="col-md-1"></div>';
                    h += '<div class="col-md-5">';
                    h += '<label class="form-label">Batch No</label>';
                    h += '<input type="text" name="InvoiceDetails[' + idx + '].BatchNo" class="form-control" value="' + (it.batchNo || '') + '" maxlength="50" />';
                    h += '</div>';
                    h += '<div class="col-md-3">';
                    h += '<label class="form-label">Line Total</label>';
                    h += '<input type="text" class="form-control line-total" readonly value="Rs 0.00" style="background:#f8fafc;font-weight:700;" />';
                    h += '</div>';
                    h += '</div></div>';
                });

                cont.innerHTML = h;
                calc();
            })
            .catch(function(e){
                cont.innerHTML = '<div class="item-row" style="text-align:center; padding: 24px; color: #DC2626; font-size: 11px;">Error: ' + e.message + '</div>';
            });
    });

    setTimeout(calc, 300);
})();
</script>

