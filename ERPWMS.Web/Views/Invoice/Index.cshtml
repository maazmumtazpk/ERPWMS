@{
    ViewData["Title"] = "Invoices";
    Layout = "_Layout";
}
<form id="__af" style="display:none;">@Html.AntiForgeryToken()</form>
<div class="toast-holder" id="toastHolder"></div>
@await Html.PartialAsync("_AdminCss")

<div style="padding-bottom:30px;">
    <div class="row g-3">
        <div class="col-xl-3 col-lg-3 col-md-6"><div class="kpi-card total"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Total Invoices</p><h2 class="kpi-number" id="kpiTotal">0</h2></div><div class="kpi-icon blue"><i class="bi bi-file-earmark-text"></i></div></div></div></div>
        <div class="col-xl-3 col-lg-3 col-md-6"><div class="kpi-card active"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Paid</p><h2 class="kpi-number" id="kpiActive">0</h2></div><div class="kpi-icon green"><i class="bi bi-check-circle"></i></div></div></div></div>
        <div class="col-xl-3 col-lg-3 col-md-6"><div class="kpi-card inactive"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Unpaid</p><h2 class="kpi-number" id="kpiInactive">0</h2></div><div class="kpi-icon orange"><i class="bi bi-hourglass"></i></div></div></div></div>
        <div class="col-xl-3 col-lg-3 col-md-6"><div class="kpi-card month"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">This Month</p><h2 class="kpi-number" id="kpiMonth">0</h2></div><div class="kpi-icon purple"><i class="bi bi-calendar-plus"></i></div></div></div></div>
    </div>

    <div class="table-card">
        <div class="card-header-custom">
            <h5><i class="bi bi-file-earmark-text" style="color:#F5A623;"></i> All Invoices <span class="badge-count" id="xCount">0</span></h5>
            <div style="display:flex;gap:4px;align-items:center;">
                <input type="text" id="tSearch" class="search-input" placeholder="Search..." onkeyup="filterRows()" />
                <button type="button" class="btn-icon gold" onclick="openAdd()"><i class="bi bi-plus-circle"></i></button>
                <button type="button" class="btn-icon" onclick="reload_()"><i class="bi bi-arrow-clockwise"></i></button>
            </div>
        </div>
        <div class="card-body">
            <table class="table-premium" id="xTable">
                <thead>
                    <tr>
                        <th>Invoice No</th>
                        <th>Customer</th>
                        <th>SO No</th>
                        <th>Invoice Date</th>
                        <th>Net Amount</th>
                        <th>Balance</th>
                        <th>Status</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody id="xBody"><tr><td colspan="8" class="text-center py-3"><div class="spinner-border text-primary" style="width:20px;height:20px;"></div></td></tr></tbody>
            </table>
            <div id="emptyState" class="empty-state d-none">
                <i class="bi bi-file-earmark-text empty-icon"></i>
                <h4>No Invoices Yet</h4>
                <button class="btn-gold" onclick="openAdd()"><i class="bi bi-plus-circle"></i> Create Invoice</button>
            </div>
        </div>
        <div class="table-footer"><span><i class="bi bi-info-circle"></i> Showing <span id="tableCount">0</span> invoices</span></div>
    </div>
</div>

<div class="modal fade pm-modal" id="addModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered" style="max-width:850px;"><div class="modal-content"><div class="modal-header"><h5><i class="bi bi-plus-circle"></i> New Invoice</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body" id="addModalBody"></div></div></div></div>
<div class="modal fade pm-modal" id="editModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered" style="max-width:650px;"><div class="modal-content"><div class="modal-header"><h5><i class="bi bi-pencil-square"></i> Edit Invoice</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body" id="editModalBody"></div></div></div></div>

@await Html.PartialAsync("_AdminJs")

<script>
function tk(){var e=document.querySelector("input[name=__RequestVerificationToken]");return e?e.value:"";}
function showToast(m,t){var h=document.getElementById("toastHolder");if(!h)return;var d=document.createElement("div");d.className="toast-item "+(t||"success");var i=t==="error"?"bi-x-circle-fill":"bi-check-circle-fill";d.innerHTML='<i class="bi '+i+'"></i><span class="msg">'+m+'</span>';h.appendChild(d);setTimeout(function(){d.style.transition="opacity .4s";d.style.opacity="0";setTimeout(function(){d.remove();},400);},3500);}
function execScripts(c){c.querySelectorAll("script").forEach(function(s){var n=document.createElement("script");n.textContent=s.textContent;document.body.appendChild(n);});}
function toggleMenu(id,e){e.stopPropagation();document.querySelectorAll(".act-menu").forEach(function(m){if(m.id!=="menu-"+id)m.classList.remove("show");});var el=document.getElementById("menu-"+id);if(!el)return;if(el.classList.contains("show")){el.classList.remove("show");return;}var b=e.currentTarget||e.target;var r=b.getBoundingClientRect();el.style.top=(r.bottom+4)+"px";el.style.right=(window.innerWidth-r.right)+"px";el.style.left="auto";el.classList.add("show");}
document.addEventListener("click",function(){document.querySelectorAll(".act-menu").forEach(function(m){m.classList.remove("show");});});
function filterRows(){var f=document.getElementById("tSearch").value.toLowerCase();var rows=document.querySelectorAll("#xBody tr");var n=0;rows.forEach(function(r){var t=(r.textContent||"").toLowerCase();if(t.indexOf(f)>-1){r.style.display="";n++;}else{r.style.display="none";}});document.getElementById("xCount").textContent=n;document.getElementById("tableCount").textContent=n;}

function openAdd(){
    var el=document.getElementById("addModal");
    var b=document.getElementById("addModalBody");
    b.innerHTML="<div class='text-center py-4'><div class='spinner-border text-primary'></div></div>";
    new bootstrap.Modal(el).show();
    fetch("/Invoice/AddPartial").then(r=>r.text()).then(function(h){b.innerHTML=h;execScripts(b);}).catch(function(e){b.innerHTML="<div class='text-center py-4 text-danger'>Load failed: "+e.message+"</div>";});
}

function openEdit(id){
    var el=document.getElementById("editModal");
    var b=document.getElementById("editModalBody");
    b.innerHTML="<div class='text-center py-4'><div class='spinner-border text-primary'></div></div>";
    new bootstrap.Modal(el).show();
    fetch("/Invoice/EditPartial?id="+id).then(r=>r.text()).then(function(h){b.innerHTML=h;execScripts(b);}).catch(function(e){b.innerHTML="<div class='text-center py-4 text-danger'>Load failed: "+e.message+"</div>";});
}

function reload_(){
    fetch("/Invoice/GetStatistics").then(r=>r.json()).then(function(d){
        document.getElementById("kpiTotal").textContent=d.total||0;
        document.getElementById("kpiActive").textContent=d.active||0;
        document.getElementById("kpiInactive").textContent=d.inactive||0;
        document.getElementById("kpiMonth").textContent=d.addedThisMonth||0;
    }).catch(function(){});

    fetch("/Invoice/GetAll").then(r=>r.json()).then(function(d){
        if(!Array.isArray(d) || d.length===0){
            document.getElementById("xBody").innerHTML="";
            document.getElementById("xTable").style.display="none";
            document.getElementById("emptyState").classList.remove("d-none");
            document.getElementById("xCount").textContent="0";
            document.getElementById("tableCount").textContent="0";
            return;
        }
        document.getElementById("xTable").style.display="";
        document.getElementById("emptyState").classList.add("d-none");
        var h="";
        d.forEach(function(x){
            var isDone = (x.status==="Paid" || x.status==="Approved");
            var st = isDone ? "active" : "inactive";
            var dt = x.invoiceDate ? new Date(x.invoiceDate).toLocaleDateString("en-GB",{day:"2-digit",month:"short",year:"numeric"}) : "-";

            var menuHtml = "<a href='/Invoice/Profile/"+x.invoiceId+"'><i class='bi bi-eye'></i> View Invoice</a>";
            if(!isDone){
                menuHtml += "<button onclick='openEdit("+x.invoiceId+")'><i class='bi bi-pencil'></i> Edit</button>";
                menuHtml += "<button onclick='toggleActive("+x.invoiceId+")'><i class='bi bi-power'></i> Mark as Paid</button>";
                menuHtml += "<div class='sep'></div>";
                menuHtml += "<button class='danger' onclick='delRow("+x.invoiceId+",\""+x.invoiceNo+"\")'><i class='bi bi-trash3'></i> Delete</button>";
            }

            h += "<tr>";
            h += "<td><div class='row-name'><span class='avatar'><i class='bi bi-file-earmark-text'></i></span><div><div style='font-weight:600;'>"+x.invoiceNo+"</div><div style='font-size:9px;color:#94A3B8;'>ID: #"+x.invoiceId+"</div></div></div></td>";
            h += "<td>"+x.customerName+"</td>";
            h += "<td style='font-family:monospace;font-size:11px;'>"+x.salesOrderNo+"</td>";
            h += "<td><span style='font-size:10px;color:#64748B;'><i class='bi bi-calendar3 me-1'></i>"+dt+"</span></td>";
            h += "<td style='font-weight:700;'>Rs "+(x.netAmount||0).toLocaleString()+"</td>";
            h += "<td style='font-weight:700;color:"+((x.balanceDue||0)>0?"#DC2626":"#159A89")+";'>Rs "+(x.balanceDue||0).toLocaleString()+"</td>";
            h += "<td><span class='badge-status "+st+"'>"+x.status+"</span></td>";
            h += "<td style='text-align:right;'><div class='act-wrap'><button class='btn-icon' onclick='toggleMenu("+x.invoiceId+",event)'><i class='bi bi-three-dots-vertical'></i></button><div class='act-menu' id='menu-"+x.invoiceId+"'>"+menuHtml+"</div></div></td>";
            h += "</tr>";
        });
        document.getElementById("xBody").innerHTML=h;
        document.getElementById("xCount").textContent=d.length;
        document.getElementById("tableCount").textContent=d.length;
    }).catch(function(e){console.error(e);});
}

function delRow(id, no){
    if(!confirm("Delete Invoice \""+(no||"")+"\"?")) return;
    var fd = new FormData();
    fd.append("__RequestVerificationToken", tk());
    fetch("/Invoice/Delete/"+id, {method:"POST", body:fd})
        .then(r=>r.json())
        .then(function(res){ if(res.success){ showToast(res.message||"Deleted","success"); reload_(); } else { showToast(res.message||"Failed","error"); } });
}

function toggleActive(id){
    if(!confirm("Mark this invoice as Paid?")) return;
    var fd = new FormData();
    fd.append("__RequestVerificationToken", tk());
    fetch("/Invoice/Toggle/"+id, {method:"POST", body:fd})
        .then(r=>r.json())
        .then(function(res){ if(res.success){ showToast(res.message||"Updated","success"); reload_(); } else { showToast(res.message||"Failed","error"); } });
}

document.addEventListener("DOMContentLoaded", reload_);
</script>
