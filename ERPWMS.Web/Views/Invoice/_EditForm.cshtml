@model ERPWMS.Database.Models.Invoice
@{
    Layout = null;
}
<style>
    .inv-f .form-label { font-size: 11px; font-weight: 600; color: #1e293b; margin-bottom: 3px; display: block; }
    .inv-f .form-control, .inv-f .form-select { font-size: 12px; padding: 6px 10px; min-height: 34px; border-radius: 6px; border: 1px solid #cbd5e1; }
    .inv-f .form-control[readonly] { background: #f1f5f9; }
    .inv-f .row.g-2 { --bs-gutter-y: 8px; --bs-gutter-x: 10px; }
    .inv-f .btn-gold { background:#F5A623;color:#0A1628;border:none;font-weight:700;padding:6px 16px;border-radius:6px;font-size:12px; }
    .inv-f .btn-ghost { background:#fff;color:#475569;border:1px solid #cbd5e1;padding:6px 16px;border-radius:6px;font-size:12px;font-weight:600; }
</style>

<form id="editForm" method="post" action="/Invoice/Edit" autocomplete="off" class="inv-f">
    @Html.AntiForgeryToken()
    <input type="hidden" name="InvoiceId" value="@Model.InvoiceId" />
    <div id="editAlert" style="display:none;padding:8px 12px;border-radius:6px;font-size:11.5px;margin-bottom:12px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>

    <div class="row g-2">
        <div class="col-md-6">
            <label class="form-label">Invoice No</label>
            <input type="text" name="InvoiceNo" class="form-control" readonly value="@Model.InvoiceNo" style="font-family:monospace;font-weight:700;" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Invoice Date</label>
            <input type="date" name="InvoiceDate" class="form-control" value="@(Model.InvoiceDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Sales Order</label>
            <select name="SalesId" class="form-select">
                <option value="">-- Select --</option>
                @if(ViewBag.SalesOrders != null) { foreach(var s in ViewBag.SalesOrders) {
                    <option value="@s.salesId" selected="@(Model.SalesId == s.salesId)">@s.salesOrderNo</option>
                } }
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Due Date</label>
            <input type="date" name="DueDate" class="form-control" value="@(Model.DueDate.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Total Amount</label>
            <input type="number" step="0.01" name="TotalAmount" class="form-control" value="@Model.TotalAmount" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Discount</label>
            <input type="number" step="0.01" name="Discount" class="form-control" value="@(Model.Discount ?? 0)" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Tax</label>
            <input type="number" step="0.01" name="TaxAmount" class="form-control" value="@(Model.TaxAmount ?? 0)" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Paid Amount</label>
            <input type="number" step="0.01" name="PaidAmount" class="form-control" value="@(Model.PaidAmount ?? 0)" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Balance Due</label>
            <input type="number" step="0.01" class="form-control" readonly value="@Model.BalanceDue" style="background:#FEF3C7;font-weight:700;color:#92400E;" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Status</label>
            <select name="Status" class="form-select">
                @foreach (var s in new[] { "Pending", "Paid", "Approved", "Cancelled" })
                {
                    if (Model.Status == s) { <option value="@s" selected>@s</option> }
                    else { <option value="@s">@s</option> }
                }
            </select>
        </div>
    </div>

    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold"><i class="bi bi-check-lg"></i> Update Invoice</button>
    </div>
</form>
