@model IEnumerable<ERPWMS.Application.DTOs.EmployeeBankAccount.EmployeeBankAccountDto>

@if (Model.Any())
{
    <table class="table table-sm table-hover">
        <thead><tr><th>Bank</th><th>Account</th><th>IBAN</th><th>Type</th><th>Primary</th><th>Status</th></tr></thead>
        <tbody>
            @foreach (var ba in Model)
            {
                <tr>
                    <td>@ba.BankName</td>
                    <td>@ba.AccountNumber</td>
                    <td>@(ba.Iban ?? "-")</td>
                    <td>@(ba.AccountType ?? "-")</td>
                    <td>@(ba.IsPrimary == true ? "<span class='badge bg-primary'>Primary</span>" : "<span class='badge bg-secondary'>Secondary</span>")</td>
                    <td>@(ba.IsActive == true ? "<span class='badge bg-success'>Active</span>" : "<span class='badge bg-warning'>Inactive</span>")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No bank accounts.</p>
}
