
@model ERPWMS.Application.DTOs.EmployeeBankAccount.CreateEmployeeBankAccountRequest

@{
    ViewData["Title"] = "Edit Bank Account";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var bankAccountId = ViewBag.BankAccountId;
    var employeeId = ViewBag.EmployeeId;
}

<div class="container-fluid">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-edit"></i> Edit Bank Account
            </h5>
        </div>

        <div class="card-body">
            <form asp-action="Edit"
                  asp-route-id="@bankAccountId"
                  asp-route-employeeId="@employeeId"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- Hidden IDs -->
                <input type="hidden" name="id" value="@bankAccountId" />
                <input type="hidden" name="employeeId" value="@employeeId" />
                <input type="hidden" asp-for="EmployeeId" />

                <div class="row">

                    <!-- Left Column -->
                    <div class="col-md-6">

                        <div class="mb-3">
                            <label class="form-label">Employee</label>

                            <select asp-for="EmployeeId"
                                    class="form-control"
                                    id="empSelect"
                                    disabled>
                                <option value="">Select Employee</option>
                            </select>

                            <span asp-validation-for="EmployeeId"
                                  class="text-danger"></span>

                            <small class="text-muted">
                                Employee cannot be changed while editing a bank account.
                            </small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BankName" class="form-label">
                                Bank Name *
                            </label>

                            <input asp-for="BankName"
                                   class="form-control"
                                   placeholder="Enter bank name" />

                            <span asp-validation-for="BankName"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AccountNumber" class="form-label">
                                Account Number *
                            </label>

                            <input asp-for="AccountNumber"
                                   class="form-control"
                                   placeholder="Enter account number" />

                            <span asp-validation-for="AccountNumber"
                                  class="text-danger"></span>
                        </div>

                    </div>

                    <!-- Right Column -->
                    <div class="col-md-6">

                        <div class="mb-3">
                            <label asp-for="Iban" class="form-label">
                                IBAN
                            </label>

                            <input asp-for="Iban"
                                   class="form-control"
                                   placeholder="Enter IBAN" />

                            <span asp-validation-for="Iban"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AccountType" class="form-label">
                                Account Type
                            </label>

                            <input asp-for="AccountType"
                                   class="form-control"
                                   placeholder="e.g. Current / Saving" />

                            <span asp-validation-for="AccountType"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="IsPrimary"
                                   class="form-check-input" />

                            <label class="form-check-label"
                                   asp-for="IsPrimary">
                                Set as Primary
                            </label>
                        </div>

                    </div>
                </div>

                <!-- Buttons -->
                <div class="mt-3 border-top pt-3">

                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Update
                    </button>

                    <a asp-action="Index"
                           asp-route-employeeId="@employeeId"
                           class="btn btn-secondary">
                        <i class="fas fa-times"></i> Cancel
                    </a>

                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {

            $.get('/api/hr/employees/dropdown', function (data) {

                var sel = $('#empSelect');

                sel.empty()
                   .append('<option value="">Select Employee</option>');

                data.forEach(function (e) {

                    var option = $('<option></option>')
                        .val(e.employeeId)
                        .text(e.fullName);

                    if (e.employeeId == '@employeeId') {
                        option.prop('selected', true);
                    }

                    sel.append(option);
                });

            });

        });
    </script>
}

