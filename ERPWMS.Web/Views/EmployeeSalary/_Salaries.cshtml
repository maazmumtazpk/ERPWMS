@model IEnumerable<ERPWMS.Application.DTOs.EmployeeSalary.EmployeeSalaryDto>

@if (Model.Any())
{
    <table class="table table-sm table-hover">
        <thead><tr><th>Effective Date</th><th>Basic Salary</th><th>Net Salary</th><th>Status</th></tr></thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.EffectiveDate.ToString("dd-MMM-yyyy")</td>
                    <td>@s.BasicSalary.ToString("C")</td>
                    <td><strong>@(s.NetSalary?.ToString("C") ?? "-")</strong></td>
                    <td>@(s.IsActive == true ? "<span class='badge bg-success'>Active</span>" : "<span class='badge bg-warning'>Inactive</span>")</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No salary records.</p>
}
