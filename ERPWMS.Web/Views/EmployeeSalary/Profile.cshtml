@model ERPWMS.Database.Models.EmployeeSalary
@{
    ViewData["Title"] = "Salary Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string statusColor = (Model.IsActive == true) ? "#159A89" : "#94A3B8";
    string statusText = (Model.IsActive == true) ? "ACTIVE" : "INACTIVE";
    var fullName = Model.Employee != null ? (Model.Employee.FirstName + " " + (Model.Employee.LastName ?? "")).Trim() : "N/A";
}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h3 class="mb-0 fw-bold" style="color:#0A1628;">Salary Details</h3><small class="text-muted">Home / Employee Salaries / @fullName</small></div>
        <div>
            <a href="/EmployeeSalary/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
            <button class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
        </div>
    </div>
    <div class="card shadow-sm mb-3" style="background:#0A1628;color:#fff;border:none;">
        <div class="card-body"><div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <div style="background:#F5A623;color:#0A1628;padding:14px;border-radius:10px;font-size:1.6rem;margin-right:16px;"><i class="bi bi-cash-stack"></i></div>
                <div><h3 class="mb-1 fw-bold" style="color:#fff;">@fullName</h3>
                <div style="font-size:12px;color:#94A3B8;">@(Model.Employee?.EmployeeCode ?? "-") | Effective: @Model.EffectiveDate.ToString("dd MMM yyyy")</div></div>
            </div>
            <div><span style="background:@statusColor;color:#fff;padding:6px 16px;border-radius:20px;font-size:11px;font-weight:700;">@statusText</span></div>
        </div></div>
    </div>
    <div class="row mb-3">
        <div class="col-md-6 mb-3 mb-md-0"><div class="card shadow-sm h-100"><div class="card-body">
            <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-person" style="color:#F5A623;"></i> Employee Info</h6>
            <table class="table table-sm mb-0" style="font-size:12px;">
                <tr><td style="color:#64748B;border:none;">Name</td><td class="text-end fw-bold" style="border:none;">@fullName</td></tr>
                <tr><td style="color:#64748B;border:none;">Code</td><td class="text-end fw-bold" style="border:none;">@(Model.Employee?.EmployeeCode ?? "-")</td></tr>
                <tr><td style="color:#64748B;border:none;">Effective Date</td><td class="text-end fw-bold" style="border:none;">@Model.EffectiveDate.ToString("dd MMM yyyy")</td></tr>
                <tr><td style="color:#64748B;border:none;">Status</td><td class="text-end fw-bold" style="border:none;color:@statusColor;">@statusText</td></tr>
            </table>
        </div></div></div>
        <div class="col-md-6"><div class="card shadow-sm h-100"><div class="card-body">
            <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-currency-dollar" style="color:#F5A623;"></i> Net Salary</h6>
            <div style="text-align:center;padding:20px 0;"><h2 style="color:#0A1628;font-size:32px;font-weight:800;">Rs @((Model.NetSalary ?? 0).ToString("N0"))</h2><p style="color:#64748B;font-size:11px;">Net Monthly Salary</p></div>
        </div></div></div>
    </div>
    <div class="row mb-3">
        <div class="col-md-6 mb-3 mb-md-0"><div class="card shadow-sm h-100"><div class="card-body">
            <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-plus-circle" style="color:#059669;"></i> Allowances</h6>
            <table class="table table-sm mb-0" style="font-size:12px;">
                <tr><td style="color:#64748B;border:none;">Basic Salary</td><td class="text-end fw-bold" style="border:none;">Rs @Model.BasicSalary.ToString("N2")</td></tr>
                <tr><td style="color:#64748B;border:none;">House Rent</td><td class="text-end" style="border:none;color:#059669;">Rs @((Model.HouseRent ?? 0).ToString("N2"))</td></tr>
                <tr><td style="color:#64748B;border:none;">Utility</td><td class="text-end" style="border:none;color:#059669;">Rs @((Model.UtilityAllowance ?? 0).ToString("N2"))</td></tr>
                <tr><td style="color:#64748B;border:none;">Medical</td><td class="text-end" style="border:none;color:#059669;">Rs @((Model.MedicalAllowance ?? 0).ToString("N2"))</td></tr>
                <tr><td style="color:#64748B;border:none;">Other</td><td class="text-end" style="border:none;color:#059669;">Rs @((Model.OtherAllowances ?? 0).ToString("N2"))</td></tr>
                <tr style="background:#F0FDF4;"><td style="color:#0A1628;border:none;font-weight:700;">Total</td><td class="text-end fw-bold" style="border:none;color:#059669;">Rs @((Model.TotalAllowances ?? 0).ToString("N2"))</td></tr>
            </table>
        </div></div></div>
        <div class="col-md-6"><div class="card shadow-sm h-100"><div class="card-body">
            <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-dash-circle" style="color:#DC2626;"></i> Deductions</h6>
            <table class="table table-sm mb-0" style="font-size:12px;">
                <tr><td style="color:#64748B;border:none;">Income Tax</td><td class="text-end" style="border:none;color:#DC2626;">Rs @((Model.IncomeTax ?? 0).ToString("N2"))</td></tr>
                <tr><td style="color:#64748B;border:none;">Professional Tax</td><td class="text-end" style="border:none;color:#DC2626;">Rs @((Model.ProfessionalTax ?? 0).ToString("N2"))</td></tr>
                <tr><td style="color:#64748B;border:none;">Other</td><td class="text-end" style="border:none;color:#DC2626;">Rs @((Model.OtherDeductions ?? 0).ToString("N2"))</td></tr>
                <tr style="background:#FEF2F2;"><td style="color:#0A1628;border:none;font-weight:700;">Total</td><td class="text-end fw-bold" style="border:none;color:#DC2626;">Rs @((Model.TotalDeductions ?? 0).ToString("N2"))</td></tr>
            </table>
        </div></div></div>
    </div>
    <div class="card shadow-sm"><div class="card-body">
        <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-people" style="color:#F5A623;"></i> Audit Info</h6>
        <div class="row" style="font-size:12px;">
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Created By:</span> <strong>@(ViewBag.CreatedByName ?? "N/A")</strong></div>
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Created Date:</span> <strong>@(Model.CreatedDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</strong></div>
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Updated By:</span> <strong>@(ViewBag.UpdatedByName ?? "-")</strong></div>
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Updated Date:</span> <strong>@(Model.UpdatedDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</strong></div>
        </div>
    </div></div>
</div>
