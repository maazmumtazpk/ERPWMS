@{ Layout = null; }
<form id="addSalaryForm" method="post" action="/EmployeeSalary/Register">
    @Html.AntiForgeryToken()
    <div id="addSalaryAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label fw-bold">Employee *</label><select name="employeeId" id="addEmp" class="form-select" required><option value="">Loading...</option></select></div>
        <div class="col-md-6"><label class="form-label fw-bold">Effective Date</label><input type="date" name="effectiveDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Basic Salary *</label><input type="number" step="0.01" name="basicSalary" class="form-control" required value="0" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">House Rent</label><input type="number" step="0.01" name="houseRent" class="form-control" value="0" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Utility Allowance</label><input type="number" step="0.01" name="utilityAllowance" class="form-control" value="0" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Medical Allowance</label><input type="number" step="0.01" name="medicalAllowance" class="form-control" value="0" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Other Allowances</label><input type="number" step="0.01" name="otherAllowances" class="form-control" value="0" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Income Tax</label><input type="number" step="0.01" name="incomeTax" class="form-control" value="0" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Professional Tax</label><input type="number" step="0.01" name="professionalTax" class="form-control" value="0" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Other Deductions</label><input type="number" step="0.01" name="otherDeductions" class="form-control" value="0" /></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Save</button>
    </div>
</form>
<script>fetch("/EmployeeSalary/GetEmployees").then(r=>r.json()).then(d=>{var s=document.getElementById("addEmp");s.innerHTML="<option value=''>-- Select --</option>";(d||[]).forEach(x=>{var o=document.createElement("option");o.value=x.employeeId;o.textContent=x.employeeName;s.appendChild(o);});});</script>
