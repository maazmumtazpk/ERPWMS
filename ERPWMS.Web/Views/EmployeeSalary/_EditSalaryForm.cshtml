@model ERPWMS.Database.Models.EmployeeSalary
@{ Layout = null; }
<form id="editSalaryForm" method="post" action="/EmployeeSalary/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="salaryId" value="@Model.SalaryId" />
    <div id="editSalaryAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-md-4"><label class="form-label fw-bold">Basic Salary *</label><input type="number" step="0.01" name="basicSalary" class="form-control" value="@Model.BasicSalary" required /></div>
        <div class="col-md-4"><label class="form-label fw-bold">House Rent</label><input type="number" step="0.01" name="houseRent" class="form-control" value="@(Model.HouseRent ?? 0)" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Utility</label><input type="number" step="0.01" name="utilityAllowance" class="form-control" value="@(Model.UtilityAllowance ?? 0)" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Medical</label><input type="number" step="0.01" name="medicalAllowance" class="form-control" value="@(Model.MedicalAllowance ?? 0)" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Other Allowances</label><input type="number" step="0.01" name="otherAllowances" class="form-control" value="@(Model.OtherAllowances ?? 0)" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Income Tax</label><input type="number" step="0.01" name="incomeTax" class="form-control" value="@(Model.IncomeTax ?? 0)" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Professional Tax</label><input type="number" step="0.01" name="professionalTax" class="form-control" value="@(Model.ProfessionalTax ?? 0)" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Other Deductions</label><input type="number" step="0.01" name="otherDeductions" class="form-control" value="@(Model.OtherDeductions ?? 0)" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Status</label><select name="isActive" class="form-select">@if((Model.IsActive == true)){<option value="true" selected>Active</option><option value="false">Inactive</option>}else{<option value="true">Active</option><option value="false" selected>Inactive</option>}</select></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>
