@model IEnumerable<ERPWMS.Application.DTOs.Audit.LoginHistoryDto>

@{
    ViewData["Title"] = "Login History";
    Layout = "~/Views/Shared/_Layout.cshtml";


int totalCount = ViewBag.TotalCount ?? 0;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int pageSize = ViewBag.PageSize ?? 50;

    int totalPages = pageSize > 0
        ? (int)Math.Ceiling((double)totalCount / pageSize)
        : 0;

    var selectedStatus = Context.Request.Query["status"].ToString();
    var selectedUserId = Context.Request.Query["userId"].ToString();
    var selectedFromDate = Context.Request.Query["fromDate"].ToString();
    var selectedToDate = Context.Request.Query["toDate"].ToString();


}

<div class="container-fluid py-4">

    
    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                <i class="bi bi-clock-history"></i>
                Login History
            </h2>

            <p class="text-muted mb-0">
                View user login and logout activity.
            </p>
        </div>

        <a asp-action="Index"
               class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left"></i>
            Dashboard

        </a>

    </div>


    <!-- FILTERS -->
    <div class="card shadow-sm mb-4">

        <div class="card-header">
            <strong>
                <i class="bi bi-funnel"></i>
                Filters
            </strong>
        </div>

        <div class="card-body">

            <form asp-action="LoginHistory"
                  method="get">

                <div class="row g-3">

                    <!-- USER ID -->
                    <div class="col-md-2">

                        <label class="form-label">
                            User ID
                        </label>

                        <input type="number"
                               name="userId"
                               value="@selectedUserId"
                               class="form-control"
                               placeholder="User ID" />

                    </div>


                    <!-- STATUS -->
                    <div class="col-md-2">

                        <label class="form-label">
                            Status
                        </label>

                        <select name="status"
                                class="form-select">

                            @if (string.IsNullOrEmpty(selectedStatus))
                            {
                                <option value="" selected>
                                    All Status
                                </option>
                            }
                            else
                            {
                                <option value="">
                                    All Status
                                </option>
                            }

                            @if (selectedStatus == "Success")
                            {
                                <option value="Success" selected>
                                    Success
                                </option>
                            }
                            else
                            {
                                <option value="Success">
                                    Success
                                </option>
                            }

                            @if (selectedStatus == "Failed")
                            {
                                <option value="Failed" selected>
                                    Failed
                                </option>
                            }
                            else
                            {
                                <option value="Failed">
                                    Failed
                                </option>
                            }

                            @if (selectedStatus == "Logout")
                            {
                                <option value="Logout" selected>
                                    Logout
                                </option>
                            }
                            else
                            {
                                <option value="Logout">
                                    Logout
                                </option>
                            }

                        </select>

                    </div>


                    <!-- FROM DATE -->
                    <div class="col-md-2">

                        <label class="form-label">
                            From Date
                        </label>

                        <input type="date"
                               name="fromDate"
                               value="@selectedFromDate"
                               class="form-control" />

                    </div>


                    <!-- TO DATE -->
                    <div class="col-md-2">

                        <label class="form-label">
                            To Date
                        </label>

                        <input type="date"
                               name="toDate"
                               value="@selectedToDate"
                               class="form-control" />

                    </div>


                    <!-- PAGE SIZE -->
                    <div class="col-md-2">

                        <label class="form-label">
                            Page Size
                        </label>

                        <select name="pageSize"
                                class="form-select">

                            @if (pageSize == 25)
                            {
                                <option value="25" selected>
                                    25
                                </option>
                            }
                            else
                            {
                                <option value="25">
                                    25
                                </option>
                            }

                            @if (pageSize == 50)
                            {
                                <option value="50" selected>
                                    50
                                </option>
                            }
                            else
                            {
                                <option value="50">
                                    50
                                </option>
                            }

                            @if (pageSize == 100)
                            {
                                <option value="100" selected>
                                    100
                                </option>
                            }
                            else
                            {
                                <option value="100">
                                    100
                                </option>
                            }

                        </select>

                    </div>


                    <!-- BUTTONS -->
                    <div class="col-md-2 d-flex align-items-end gap-2">

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-search"></i>
                            Filter

                        </button>

                        <a asp-action="LoginHistory"
                               class="btn btn-outline-secondary">

                            <i class="bi bi-x-circle"></i>

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- SUMMARY -->
    <div class="row mb-4">

        <div class="col-md-3">

            <div class="card shadow-sm">

                <div class="card-body">

                    <div class="text-muted small">
                        Total Login Records
                    </div>

                    <h3 class="mb-0">
                        @totalCount
                    </h3>

                </div>

            </div>

        </div>

    </div>


    <!-- TABLE -->
    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <h5 class="mb-0">

                <i class="bi bi-list"></i>
                Login Records

            </h5>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover table-bordered mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>#</th>
                            <th>Username</th>
                            <th>Login Time</th>
                            <th>Logout Time</th>
                            <th>IP Address</th>
                            <th>Device</th>
                            <th>Status</th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int serial =
                                ((currentPage - 1) * pageSize) + 1;

                            foreach (var login in Model)
                            {
                                <tr>

                                    <td>
                                        @serial
                                    </td>

                                    <td>
                                        <strong>
                                            @login.Username
                                        </strong>
                                    </td>

                                    <td>
                                        @login.LoginTime
                                    </td>

                                    <td>
                                        @login.LogoutTime
                                    </td>

                                    <td>
                                        @login.IPAddress
                                    </td>

                                    <td>
                                        @login.DeviceInfo
                                    </td>

                                    <td>

                                        @if (string.Equals(
                                                                                login.Status,
                                                                                "Success",
                                                                                StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success">
                                                Success
                                            </span>
                                        }
                                        else if (string.Equals(
                                            login.Status,
                                            "Failed",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-danger">
                                                Failed
                                            </span>
                                        }
                                        else if (string.Equals(
                                            login.Status,
                                            "Logout",
                                            StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-secondary">
                                                Logout
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">
                                                @login.Status
                                            </span>
                                        }

                                    </td>

                                </tr>

                                serial++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="bi bi-clock-history fs-1"></i>

                                        <h5 class="mt-3">
                                            No login history found
                                        </h5>

                                        <p class="mb-0">
                                            No login records match the selected filters.
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>


        <!-- PAGINATION -->
        @if (totalPages > 1)
        {
            <div class="card-footer bg-white">

                <nav>

                    <ul class="pagination justify-content-center mb-0">

                        <!-- PREVIOUS -->
                        <li class="page-item @(currentPage <= 1 ? "disabled" : "")">

                            @if (currentPage > 1)
                            {
                                <a class="page-link"
                                       asp-action="LoginHistory"
                                       asp-route-userId="@selectedUserId"
                                       asp-route-status="@selectedStatus"
                                       asp-route-fromDate="@selectedFromDate"
                                       asp-route-toDate="@selectedToDate"
                                       asp-route-page="@(currentPage - 1)"
                                       asp-route-pageSize="@pageSize">

                                    Previous

                                </a>
                            }
                            else
                            {
                                <span class="page-link">
                                    Previous
                                </span>
                            }

                        </li>


                        <!-- PAGE NUMBERS -->
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">

                                <a class="page-link"
                                       asp-action="LoginHistory"
                                       asp-route-userId="@selectedUserId"
                                       asp-route-status="@selectedStatus"
                                       asp-route-fromDate="@selectedFromDate"
                                       asp-route-toDate="@selectedToDate"
                                       asp-route-page="@i"
                                       asp-route-pageSize="@pageSize">

                                    @i

                                </a>

                            </li>
                        }


                        <!-- NEXT -->
                        <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">

                            @if (currentPage < totalPages)
                            {
                                <a class="page-link"
                                       asp-action="LoginHistory"
                                       asp-route-userId="@selectedUserId"
                                       asp-route-status="@selectedStatus"
                                       asp-route-fromDate="@selectedFromDate"
                                       asp-route-toDate="@selectedToDate"
                                       asp-route-page="@(currentPage + 1)"
                                       asp-route-pageSize="@pageSize">

                                    Next

                                </a>
                            }
                            else
                            {
                                <span class="page-link">
                                    Next
                                </span>
                            }

                        </li>

                    </ul>

                </nav>

            </div>
        }

    </div>
    

</div>
