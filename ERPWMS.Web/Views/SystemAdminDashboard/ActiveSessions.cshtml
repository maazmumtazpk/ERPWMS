@model IEnumerable<ERPWMS.Application.DTOs.Identity.UserSessionDto>

@{
    ViewData["Title"] = "Active Sessions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>?? Active Sessions</h2>
        <span class="badge bg-primary fs-6">@Model.Count() active</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>User</th>
                            <th>Login Time</th>
                            <th>Last Activity</th>
                            <th>Duration</th>
                            <th>IP Address</th>
                            <th>Device</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.Username</strong></td>
                                    <td>@item.LoginTime?.ToString("dd-MMM-yyyy HH:mm")</td>
                                    <td>@item.LastActivity?.ToString("dd-MMM-yyyy HH:mm")</td>
                                    <td>@item.Duration</td>
                                    <td>@(item.IPAddress ?? "-")</td>
                                    <td>@(item.DeviceInfo ?? "-")</td>
                                    <td>
                                        <form method="post" asp-action="TerminateSession" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.SessionId" />
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Terminate this session?')">
                                                <i class="bi bi-x-circle"></i> Terminate
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox display-6 d-block"></i>
                                    No active sessions found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>