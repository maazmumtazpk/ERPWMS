@{
    Layout = null;
}
<form id="addCycleCountForm" method="post" action="/CycleCount/Register">
    @Html.AntiForgeryToken()
    <div id="addCycleCountAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    
    <div id="stockWarn" style="display:none;padding:10px 14px;border-radius:8px;font-size:12px;margin-bottom:14px;background:#FFF7ED;color:#C2410C;border-left:4px solid #F5A623;font-weight:600;">
        <i class="bi bi-exclamation-triangle-fill" style="margin-right:6px;"></i>
        <span id="stockWarnMsg"></span>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label fw-bold">Product *</label>
            <select name="productId" id="addProd" class="form-select" required>
                <option value="">Loading...</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Warehouse * (auto)</label>
            <select name="warehouseId" id="addWh" class="form-select" required>
                <option value="">-- Select Product first --</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Bin * (auto)</label>
            <select name="binId" id="addBin" class="form-select" required>
                <option value="">-- Select Product first --</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">System Qty (auto)</label>
            <input type="number" name="systemQty" id="addSysQty" class="form-control" value="0" readonly style="background:#f1f5f9;" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Actual Qty *</label>
            <input type="number" name="actualQty" id="addActQty" class="form-control" value="0" required />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Variance (auto)</label>
            <input type="number" id="addVar" class="form-control" value="0" readonly style="background:#f1f5f9;font-weight:700;" />
        </div>
        <div class="col-12">
            <label class="form-label fw-bold">Remarks</label>
            <textarea name="remarks" class="form-control" rows="2"></textarea>
        </div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" id="ccSubmitBtn" class="btn btn-gold btn-sm">Create</button>
    </div>
</form>
<script>
(function(){
    var prodSel = document.getElementById("addProd");
    var whSel = document.getElementById("addWh");
    var binSel = document.getElementById("addBin");
    var sysQty = document.getElementById("addSysQty");
    var actQty = document.getElementById("addActQty");
    var variance = document.getElementById("addVar");
    var warnBox = document.getElementById("stockWarn");
    var warnMsg = document.getElementById("stockWarnMsg");
    var submitBtn = document.getElementById("ccSubmitBtn");

    function showWarning(msg){
        warnMsg.textContent = msg;
        warnBox.style.display = "block";
        if(submitBtn){ submitBtn.disabled = true; submitBtn.style.opacity = "0.5"; submitBtn.style.cursor = "not-allowed"; }
    }
    function hideWarning(){
        warnBox.style.display = "none";
        if(submitBtn){ submitBtn.disabled = false; submitBtn.style.opacity = "1"; submitBtn.style.cursor = "pointer"; }
    }
    function recalc(){
        var s = parseInt(sysQty.value) || 0;
        var a = parseInt(actQty.value) || 0;
        variance.value = a - s;
    }
    actQty.addEventListener("input", recalc);

    // Load Products
    fetch("/CycleCount/GetProducts").then(r=>r.json()).then(d=>{
        prodSel.innerHTML = "<option value=''>-- Select --</option>";
        (d||[]).forEach(x=>{
            var o = document.createElement("option");
            o.value = x.productId;
            o.textContent = x.productName;
            prodSel.appendChild(o);
        });
    });

    // Product change par auto-load
    prodSel.addEventListener("change", function(){
        var pid = this.value;
        whSel.innerHTML = "<option value=''>Loading...</option>";
        binSel.innerHTML = "<option value=''>Loading...</option>";
        sysQty.value = 0;
        variance.value = 0;
        hideWarning();

        if(!pid){
            whSel.innerHTML = "<option value=''>-- Select Product first --</option>";
            binSel.innerHTML = "<option value=''>-- Select Product first --</option>";
            return;
        }

        fetch("/CycleCount/GetProductBins?productId=" + pid)
            .then(r => r.json())
            .then(function(res){
                if(!res.warehouseId || res.warehouseId <= 0){
                    whSel.innerHTML = "<option value=''>-- Not Available --</option>";
                    binSel.innerHTML = "<option value=''>-- Not Available --</option>";
                    showWarning("Please do Stock IN first for this product.");
                    return;
                }

                whSel.innerHTML = "<option value='"+res.warehouseId+"' selected>"+res.warehouseName+"</option>";

                if(!res.bins || res.bins.length === 0){
                    binSel.innerHTML = "<option value=''>-- No Bin found --</option>";
                    showWarning("Please do Stock IN first for this product.");
                    return;
                }

                binSel.innerHTML = "<option value=''>-- Select Bin --</option>";
                res.bins.forEach(function(b){
                    var o = document.createElement("option");
                    o.value = b.binId;
                    o.textContent = b.binName + " (Balance: " + b.balance + ")";
                    o.setAttribute("data-balance", b.balance);
                    binSel.appendChild(o);
                });

                if(res.bins.length === 1){
                    binSel.value = res.bins[0].binId;
                    sysQty.value = res.bins[0].balance || 0;
                    actQty.value = res.bins[0].balance || 0;
                    recalc();
                }
            })
            .catch(function(err){
                console.error("Error:", err);
                whSel.innerHTML = "<option value=''>-- Error --</option>";
                binSel.innerHTML = "<option value=''>-- Error --</option>";
                showWarning("Please do Stock IN first for this product.");
            });
    });

    // Bin select par System Qty auto-fill
    binSel.addEventListener("change", function(){
        var opt = this.options[this.selectedIndex];
        var bal = opt ? parseInt(opt.getAttribute("data-balance")) || 0 : 0;
        sysQty.value = bal;
        actQty.value = bal;
        recalc();
    });
})();
</script>
