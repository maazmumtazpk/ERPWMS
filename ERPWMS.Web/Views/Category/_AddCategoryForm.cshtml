@{
    Layout = null;
}
<form id="addCategoryForm" method="post" action="/Category/Register">
    @Html.AntiForgeryToken()
    <div id="addCategoryAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-12"><label class="form-label fw-bold">Category Name *</label><input type="text" name="categoryName" class="form-control" required maxlength="200" placeholder="Enter category name" /></div>
        <div class="col-12"><label class="form-label fw-bold">Category Code</label><input type="text" name="categoryCode" class="form-control" maxlength="20" placeholder="CT-001" /></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Register</button>
    </div>
</form>
