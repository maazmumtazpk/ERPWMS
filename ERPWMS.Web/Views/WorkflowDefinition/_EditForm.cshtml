@model ERPWMS.Database.Models.WorkflowDefinition
@{ Layout = null; }
<form id="editDefForm" method="post" action="/WorkflowDefinition/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="workflowDefId" value="@Model.WorkflowDefId" />
    <div id="editDefAlert" style="display:none;padding:8px 10px;border-radius:6px;font-size:11px;margin-bottom:12px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-2">
        <div class="col-md-6"><label class="form-label fw-bold">Workflow Name *</label><input type="text" name="workflowName" class="form-control form-control-sm" value="@Model.WorkflowName" required maxlength="200" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Module Type</label><input type="text" name="moduleType" class="form-control form-control-sm" value="@Model.ModuleType" maxlength="50" /></div>
        <div class="col-12"><label class="form-label fw-bold">Description</label><textarea name="description" class="form-control form-control-sm" rows="2" maxlength="500">@Model.Description</textarea></div>
        <div class="col-md-6"><label class="form-label fw-bold">Status</label><select name="isActive" class="form-select form-select-sm">@if((Model.IsActive == true)){<option value="true" selected>Active</option><option value="false">Inactive</option>}else{<option value="true">Active</option><option value="false" selected>Inactive</option>}</select></div>
    </div>
    <div style="padding:10px 0 0;border-top:1px solid #eef2f6;margin-top:10px;display:flex;justify-content:flex-end;gap:6px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>
