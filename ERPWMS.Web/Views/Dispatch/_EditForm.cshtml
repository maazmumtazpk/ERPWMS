@model ERPWMS.Database.Models.DispatchMaster
@{
    Layout = null;
}
<style>
    .dsp-f .form-label { font-size: 11px; font-weight: 600; color: #1e293b; margin-bottom: 3px; display: block; }
    .dsp-f .form-control, .dsp-f .form-select { font-size: 12px; padding: 6px 10px; min-height: 34px; border-radius: 6px; border: 1px solid #cbd5e1; }
    .dsp-f .form-control[readonly] { background: #f1f5f9; }
    .dsp-f .row.g-2 { --bs-gutter-y: 8px; --bs-gutter-x: 10px; }
    .dsp-f .btn-gold { background:#F5A623;color:#0A1628;border:none;font-weight:700;padding:6px 16px;border-radius:6px;font-size:12px; }
    .dsp-f .btn-ghost { background:#fff;color:#475569;border:1px solid #cbd5e1;padding:6px 16px;border-radius:6px;font-size:12px;font-weight:600; }
</style>

<form id="editForm" method="post" action="/Dispatch/Edit" autocomplete="off" class="dsp-f">
    @Html.AntiForgeryToken()
    <input type="hidden" name="DispatchId" value="@Model.DispatchId" />
    <div id="editAlert" style="display:none;padding:8px 12px;border-radius:6px;font-size:11.5px;margin-bottom:12px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>

    <div class="row g-2">
        <div class="col-md-6">
            <label class="form-label">Dispatch No</label>
            <input type="text" name="DispatchNo" class="form-control" readonly value="@Model.DispatchNo" style="font-family:monospace;font-weight:700;" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Dispatch Date</label>
            <input type="date" name="DispatchDate" class="form-control" value="@(Model.DispatchDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Sales Order</label>
            <select name="SalesId" class="form-select">
                <option value="">-- Select --</option>
                @if(ViewBag.Sales != null) { foreach(var s in ViewBag.Sales) {
                    <option value="@s.salesId" selected="@(Model.SalesId == s.salesId)">@s.salesOrderNo</option>
                } }
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Warehouse</label>
            <select name="WarehouseId" class="form-select">
                <option value="">-- Select --</option>
                @if(ViewBag.Warehouses != null) { foreach(var w in ViewBag.Warehouses) {
                    <option value="@w.warehouseId" selected="@(Model.WarehouseId == w.warehouseId)">@w.warehouseName</option>
                } }
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Carrier Name</label>
            <input type="text" name="CarrierName" class="form-control" value="@Model.CarrierName" maxlength="200" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Tracking No</label>
            <input type="text" name="TrackingNo" class="form-control" value="@Model.TrackingNo" maxlength="100" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Delivery Date</label>
            <input type="date" name="DeliveryDate" class="form-control" value="@(Model.DeliveryDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Status</label>
            <select name="Status" class="form-select">
                @foreach (var s in new[] { "Pending", "Shipped", "Delivered", "Completed", "Cancelled" })
                {
                    if (Model.Status == s) { <option value="@s" selected>@s</option> }
                    else { <option value="@s">@s</option> }
                }
            </select>
        </div>
    </div>

    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold"><i class="bi bi-check-lg"></i> Update Dispatch</button>
    </div>
</form>



<script>
    // --- AUTO-FILL DISPATCH ITEMS ---
    document.addEventListener("DOMContentLoaded", function() {
        const soDropdown = document.getElementById("SalesId") || document.querySelector("select[name='SalesId']");
        if (!soDropdown) return;

        soDropdown.addEventListener("change", function() {
            const salesId = this.value;
            if (!salesId) return;

            fetch(/Dispatch/GetSalesDetails?salesId=)
                .then(res => res.json())
                .then(data => {
                    const tableBody = document.querySelector("#ItemsTable tbody, .items-table tbody, table tbody");
                    if (!tableBody) {
                        console.warn("Table body nahi mila. Apne table ki ID ya class check karein.");
                        return;
                    }
                    tableBody.innerHTML = "";
                    
                    data.forEach(item => {
                        const row = document.createElement("tr");
                        row.innerHTML = 
                            <td><input type="text" name="DispatchDetails[].ProductName" value="" readonly class="form-control" /></td>
                            <td><input type="number" name="DispatchDetails[].Quantity" value="" class="form-control" /></td>
                            <td><input type="text" name="DispatchDetails[].BatchNo" value="" class="form-control" /></td>
                            <td><input type="text" name="DispatchDetails[].SerialNumbers" placeholder="SN-001, SN-002" class="form-control" /></td>
                        ;
                        tableBody.appendChild(row);
                    });
                })
                .catch(err => console.error("Auto-fill error:", err));
        });
    });
</script>
