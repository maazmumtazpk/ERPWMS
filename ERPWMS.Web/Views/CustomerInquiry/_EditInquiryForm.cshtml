@model ERPWMS.Database.Models.CustomerInquiry
@{ Layout = null; }
<form id="editInquiryForm" method="post" action="/CustomerInquiry/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="inquiryId" value="@Model.InquiryId" />
    <div id="editInquiryAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-12"><label class="form-label fw-bold">Subject *</label><input type="text" name="subject" class="form-control" value="@Model.Subject" required maxlength="200" /></div>
        <div class="col-12"><label class="form-label fw-bold">Message</label><textarea name="message" class="form-control" rows="3">@Model.Message</textarea></div>
        <div class="col-12"><label class="form-label fw-bold">Status</label><select name="status" class="form-select">@foreach(var s in new[]{"Open","Pending","Resolved","Closed"}){if(Model.Status == s){<option value="@s" selected>@s</option>}else{<option value="@s">@s</option>}}</select></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>
