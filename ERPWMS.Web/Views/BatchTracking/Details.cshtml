@model ERPWMS.Application.DTOs.Inventory.BatchTrackingDto

@{
    ViewData["Title"] = "Batch Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>?? Batch Details</h2>
        <a asp-action="BatchTracking" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <table class="table table-bordered">
                        <tr>
                            <th class="bg-light w-50">Batch No</th>
                            <td><code><strong>@Model.BatchNo</strong></code></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Product</th>
                            <td>@Model.ProductCode - @Model.ProductName</td>
                        </tr>
                        <tr>
                            <th class="bg-light">GRN Detail</th>
                            <td>#@Model.GrndetailId</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Total Quantity</th>
                            <td>@Model.Quantity</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Remaining Quantity</th>
                            <td><strong>@Model.RemainingQty</strong></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Expiry Date</th>
                            <td>
                                @Model.ExpiryDate.ToString("dd-MMM-yyyy")
                                @if (Model.IsExpired)
                                {
                                    <span class="badge bg-danger ms-2">EXPIRED</span>
                                }
                                else if (Model.IsNearExpiry)
                                {
                                    <span class="badge bg-warning text-dark ms-2">NEAR EXPIRY</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="bg-light">Status</th>
                            <td>@Html.Raw(Model.StatusDisplay)</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Created By</th>
                            <td>@Model.CreatedByName</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Created Date</th>
                            <td>@Model.CreatedDate?.ToString("dd-MMM-yyyy HH:mm")</td>
                        </tr>
                    </table>
                </div>
            </div>

            <div class="mt-3 text-muted small">
                <i class="bi bi-info-circle"></i> Batch quantities are automatically updated through GRN, Transfers, and Sales.
            </div>
        </div>
    </div>
</div>