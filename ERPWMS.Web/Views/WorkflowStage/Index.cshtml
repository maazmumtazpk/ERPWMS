@{
    ViewData["Title"] = "Workflow Stages";
    Layout = "_Layout";
}
<form id="__af" style="display:none;">@Html.AntiForgeryToken()</form>
<div class="toast-holder" id="toastHolder"></div>
@await Html.PartialAsync("_AdminCss")
<div style="padding-bottom:30px;">
<div class="row g-3">
<div class="col-xl-3 col-lg-3 col-md-6"><div class="kpi-card total"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Total Stages</p><h2 class="kpi-number" id="kpiTotal">0</h2></div><div class="kpi-icon blue"><i class="bi bi-list-ol"></i></div></div></div></div>
<div class="col-xl-3 col-lg-3 col-md-6"><div class="kpi-card active"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Active</p><h2 class="kpi-number" id="kpiActive">0</h2></div><div class="kpi-icon green"><i class="bi bi-check-circle"></i></div></div></div></div>
<div class="col-xl-3 col-lg-3 col-md-6"><div class="kpi-card inactive"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Inactive</p><h2 class="kpi-number" id="kpiInactive">0</h2></div><div class="kpi-icon orange"><i class="bi bi-x-circle"></i></div></div></div></div>
<div class="col-xl-3 col-lg-3 col-md-6"><div class="kpi-card month"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">This Month</p><h2 class="kpi-number" id="kpiMonth">0</h2></div><div class="kpi-icon purple"><i class="bi bi-calendar-plus"></i></div></div></div></div>
</div>
<div class="table-card">
<div class="card-header-custom">
<h5><i class="bi bi-list-ol" style="color:#F5A623;"></i> All Stages <span class="badge-count" id="xCount">0</span></h5>
<div style="display:flex;gap:4px;align-items:center;">
<input type="text" id="tSearch" class="search-input" placeholder="Search..." onkeyup="filterRows()" />
<button type="button" class="btn-icon gold" onclick="openAdd()"><i class="bi bi-plus-circle"></i></button>
<button type="button" class="btn-icon" onclick="reload_()"><i class="bi bi-arrow-clockwise"></i></button>
</div>
</div>
<div class="card-body">
<table class="table-premium" id="xTable">
<thead><tr><th>Stage</th><th>Workflow</th><th>Code</th><th>Order</th><th>Status</th><th style="text-align:right;">Actions</th></tr></thead>
<tbody id="xBody"><tr><td colspan="6" class="text-center py-3"><div class="spinner-border text-primary" style="width:20px;height:20px;"></div></td></tr></tbody>
</table>
<div id="emptyState" class="empty-state d-none"><i class="bi bi-list-ol empty-icon"></i><h4>No Stages Yet</h4><button class="btn-gold" onclick="openAdd()"><i class="bi bi-plus-circle"></i> Register Stage</button></div>
</div>
<div class="table-footer"><span><i class="bi bi-info-circle"></i> Showing <span id="tableCount">0</span> stages</span></div>
</div>
</div>
<div class="modal fade pm-modal" id="addModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5><i class="bi bi-list-ol"></i> Register New Stage</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body" id="addModalBody"></div></div></div></div>
<div class="modal fade pm-modal" id="editModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5><i class="bi bi-pencil-square"></i> Edit Stage</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body" id="editModalBody"></div></div></div></div>
@await Html.PartialAsync("_AdminJs")
<script>
function openAdd(){
  var el=document.getElementById("addModal");
  var b=document.getElementById("addModalBody");
  b.innerHTML="<div class='text-center py-4'><div class='spinner-border text-primary'></div></div>";
  new bootstrap.Modal(el).show();
  fetch("/WorkflowStage/AddPartial").then(function(r){
    if(!r.ok) throw new Error("HTTP "+r.status);
    return r.text();
  }).then(function(h){
    b.innerHTML=h;
    execScripts(b);
  }).catch(function(e){
    b.innerHTML="<div class='text-center py-4 text-danger'>Load failed: "+e.message+"</div>";
  });
}
function openEdit(id){
  var el=document.getElementById("editModal");
  var b=document.getElementById("editModalBody");
  b.innerHTML="<div class='text-center py-4'><div class='spinner-border text-primary'></div></div>";
  new bootstrap.Modal(el).show();
  fetch("/WorkflowStage/EditPartial?id="+id).then(function(r){
    if(!r.ok) throw new Error("HTTP "+r.status);
    return r.text();
  }).then(function(h){
    b.innerHTML=h;
    execScripts(b);
  }).catch(function(e){
    b.innerHTML="<div class='text-center py-4 text-danger'>Load failed: "+e.message+"</div>";
  });
}
function reload_(){
  fetch("/WorkflowStage/GetStatistics").then(function(r){return r.json();}).then(function(d){
    document.getElementById("kpiTotal").textContent=d.total||0;
    document.getElementById("kpiActive").textContent=d.active||0;
    document.getElementById("kpiInactive").textContent=d.inactive||0;
    document.getElementById("kpiMonth").textContent=d.addedThisMonth||0;
  }).catch(function(){});
  fetch("/WorkflowStage/GetAll").then(function(r){return r.json();}).then(function(d){
    var body=document.getElementById("xBody");
    if(!d||d.length===0){
      body.innerHTML="";
      document.getElementById("xTable").style.display="none";
      document.getElementById("emptyState").classList.remove("d-none");
      document.getElementById("xCount").textContent="0";
      document.getElementById("tableCount").textContent="0";
      return;
    }
    document.getElementById("xTable").style.display="";
    document.getElementById("emptyState").classList.add("d-none");
    var h="";
    d.forEach(function(x){
      var st=x.isActive?"active":"inactive";
      var badges="";
      if(x.isStart) badges+="<span class='badge-status role'>START</span> ";
      if(x.isEnd) badges+="<span class='badge-status role'>END</span>";
      h+="<tr>";
      h+="<td><div class='row-name'><span class='avatar'><i class='bi bi-list-ol'></i></span><div>"+(x.stageName||"-")+badges+"</div></div></td>";
      h+="<td style='font-size:11px;'>"+(x.workflowName||"-")+"</td>";
      h+="<td><span class='badge-status role' style='font-family:monospace;'>"+(x.stageCode||"-")+"</span></td>";
      h+="<td><span class='badge-count'>"+(x.stageOrder||0)+"</span></td>";
      h+="<td><span class='badge-status "+st+"'>"+(x.isActive?"Active":"Inactive")+"</span></td>";
      h+="<td style='text-align:right;'><div class='act-wrap'><button class='btn-icon' onclick='toggleMenu("+x.stageId+",event)'><i class='bi bi-three-dots-vertical'></i></button><div class='act-menu' id='menu-"+x.stageId+"'><button onclick='openEdit("+x.stageId+")'><i class='bi bi-pencil'></i> Edit</button><button onclick='toggleActive("+x.stageId+")'><i class='bi bi-power'></i> Toggle</button><div class='sep'></div><button class='danger' onclick='delRow("+x.stageId+")'><i class='bi bi-trash3'></i> Delete</button></div></div></td>";
      h+="</tr>";
    });
    body.innerHTML=h;
    document.getElementById("xCount").textContent=d.length;
    document.getElementById("tableCount").textContent=d.length;
  }).catch(function(){
    document.getElementById("xBody").innerHTML="<tr><td colspan='6' class='text-center py-3 text-danger'>Failed to load</td></tr>";
  });
}
function delRow(id){if(!confirm("Delete this stage?"))return;var fd=new FormData();fd.append("__RequestVerificationToken",tk());fetch("/WorkflowStage/QuickDelete/"+id,{method:"POST",body:fd}).then(function(r){return r.json();}).then(function(res){if(res.success){showToast(res.message||"Deleted","success");reload_();}else{showToast(res.message||"Failed","error");}});}
function toggleActive(id){var fd=new FormData();fd.append("__RequestVerificationToken",tk());fetch("/WorkflowStage/QuickToggle/"+id,{method:"POST",body:fd}).then(function(r){return r.json();}).then(function(res){if(res.success){showToast(res.message||"Updated","success");reload_();}});}
document.addEventListener("DOMContentLoaded",reload_);
</script>
