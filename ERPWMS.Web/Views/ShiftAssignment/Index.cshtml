@{
    ViewData["Title"] = "Shift Assignment";
    Layout = "_Layout";
}
<form id="__af" style="display:none;">@Html.AntiForgeryToken()</form>
<div class="toast-holder" id="toastHolder"></div>
@await Html.PartialAsync("_AdminCss")
<div style="padding-bottom:30px;">
<div class="table-card">
    <div class="card-header-custom">
        <h5><i class="bi bi-person-badge" style="color:#F5A623;"></i> Shift Assignments</h5>
        <div style="display:flex;gap:4px;">
            <button type="button" class="btn-icon gold" onclick="openAdd()"><i class="bi bi-plus-circle"></i></button>
            <button type="button" class="btn-icon" onclick="reload_()"><i class="bi bi-arrow-clockwise"></i></button>
        </div>
    </div>
    <div class="card-body">
        <table class="table-premium" id="xTable">
            <thead><tr><th>Employee</th><th>Shift</th><th>From</th><th>To</th><th>Status</th><th style="text-align:right;">Actions</th></tr></thead>
            <tbody id="xBody"><tr><td colspan="6" class="text-center py-3"><div class="spinner-border text-primary"></div></td></tr></tbody>
        </table>
        <div id="emptyState" class="empty-state d-none"><h4>No Shift Assignments</h4><button class="btn-gold" onclick="openAdd()">Assign Shift</button></div>
    </div>
</div>
</div>
<div class="modal fade pm-modal" id="formModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5><i class="bi bi-person-badge"></i> Assign Shift</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">
<div class="row g-3">
<div class="col-12"><label class="form-label">Employee <span class="text-danger">*</span></label><select id="employeeId" class="form-control"></select></div>
<div class="col-12"><label class="form-label">Shift <span class="text-danger">*</span></label><select id="shiftId" class="form-control"></select></div>
<div class="col-12"><label class="form-label">Remarks</label><textarea id="remarks" class="form-control" rows="2"></textarea></div>
</div>
</div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn-gold" onclick="save_()"><i class="bi bi-check-circle"></i> Assign</button></div></div></div></div>
@await Html.PartialAsync("_AdminJs")
<script>
function tk(){var i=document.querySelector('#__af input[name="__RequestVerificationToken"]');return i?i.value:'';}
function openAdd(){
    fetch('/ShiftAssignment/GetDropdowns').then(function(r){return r.json();}).then(function(d){
        var es = document.getElementById('employeeId'); es.innerHTML = '<option value="">-- Select --</option>';
        d.employees.forEach(function(e){ var o=document.createElement('option'); o.value=e.id; o.textContent=e.name; es.appendChild(o); });
        var ss = document.getElementById('shiftId'); ss.innerHTML = '<option value="">-- Select --</option>';
        d.shifts.forEach(function(s){ var o=document.createElement('option'); o.value=s.id; o.textContent=s.name; ss.appendChild(o); });
        document.getElementById('remarks').value = '';
        new bootstrap.Modal(document.getElementById('formModal')).show();
    });
}
function save_(){
    var fd = new FormData();
    fd.append('__RequestVerificationToken', tk());
    fd.append('employeeId', document.getElementById('employeeId').value);
    fd.append('shiftId', document.getElementById('shiftId').value);
    fd.append('remarks', document.getElementById('remarks').value);
    fetch('/ShiftAssignment/Assign', {method:'POST', body:fd}).then(function(r){return r.json();}).then(function(res){
        if(res.success){ showToast(res.message,'success'); bootstrap.Modal.getInstance(document.getElementById('formModal')).hide(); reload_(); }
        else showToast(res.message,'error');
    });
}
function delRow(id){
    if(!confirm('Delete?')) return;
    var fd = new FormData(); fd.append('__RequestVerificationToken', tk());
    fetch('/ShiftAssignment/Delete/'+id, {method:'POST', body:fd}).then(function(r){return r.json();}).then(function(res){
        if(res.success){ showToast(res.message,'success'); reload_(); }
    });
}
function reload_(){
    fetch('/ShiftAssignment/GetAll').then(function(r){return r.json();}).then(function(d){
        var b = document.getElementById('xBody');
        if(!d || d.length===0){ b.innerHTML=''; document.getElementById('xTable').style.display='none'; document.getElementById('emptyState').classList.remove('d-none'); return; }
        document.getElementById('xTable').style.display=''; document.getElementById('emptyState').classList.add('d-none');
        var h='';
        d.forEach(function(x){
            h+='<tr><td>'+x.employeeName+'<br><small>'+x.employeeCode+'</small></td><td>'+x.shiftName+'</td><td>'+x.effectiveFrom+'</td><td>'+(x.effectiveTo||'-')+'</td><td>'+(x.isActive?'<span class="badge-status active">Active</span>':'<span class="badge-status inactive">Inactive</span>')+'</td><td style="text-align:right;"><button class="btn-icon" onclick="delRow('+x.assignmentId+')"><i class="bi bi-trash3"></i></button></td></tr>';
        });
        b.innerHTML=h;
    });
}
document.addEventListener('DOMContentLoaded', reload_);
</script>
