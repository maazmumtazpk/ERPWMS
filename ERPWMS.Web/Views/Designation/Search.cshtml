@using ERPWMS.Web.ViewModels.Designation
@model DesignationSearchViewModel

@{
    ViewData["Title"] = "Search Designations";
    Layout = "_Layout";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row">
        <div class="col-12">
            <div class="page-header">
                <h1>
                    <i class="bi bi-search"></i> Search Designations
                </h1>
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item"><a href="@Url.Action("Index")">Designations</a></li>
                    <li class="breadcrumb-item active">Search</li>
                </ol>
            </div>
        </div>
    </div>

    <!-- Search Form -->
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5><i class="bi bi-funnel"></i> Search Criteria</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Search" method="post" id="searchForm">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="SearchTerm" class="form-label">Search Term</label>
                                    <input asp-for="SearchTerm" class="form-control" placeholder="Name..." />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label asp-for="DepartmentId" class="form-label">Department</label>
                                    <select asp-for="DepartmentId" class="form-select" id="departmentFilter">
                                        <option value="">All Departments</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label asp-for="IsActive" class="form-label">Status</label>
                                    <select asp-for="IsActive" class="form-select">
                                        <option value="">All</option>
                                        <option value="true">Active</option>
                                        <option value="false">Inactive</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label asp-for="PageSize" class="form-label">Per Page</label>
                                    <select asp-for="PageSize" class="form-select">
                                        <option value="5">5</option>
                                        <option value="10" selected>10</option>
                                        <option value="25">25</option>
                                        <option value="50">50</option>
                                        <option value="100">100</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-1 d-flex align-items-end">
                                <button type="submit" class="btn btn-primary w-100">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Results -->
    @if (Model.Designations != null)
    {
        <div class="row mt-3">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5><i class="bi bi-list"></i> Search Results</h5>
                            <span class="badge bg-info">@Model.ResultsSummary</span>
                        </div>
                    </div>
                    <div class="card-body">
                        @if (Model.HasResults)
                        {
                            <div class="table-responsive">
                                <table class="table table-striped table-hover">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Rank</th>
                                            <th>Department</th>
                                            <th>Company</th>
                                            <th>Status</th>
                                            <th>Created Date</th>
                                            <th>Employees</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var desig in Model.Designations)
                                        {
                                            <tr>
                                                <td><a href="@Url.Action("Profile", new { id = desig.DesignationId })">@desig.DesignationName</a></td>
                                                <td>@(desig.RankLevel.HasValue ? desig.RankLevel.Value.ToString() : "N/A")</td>
                                                <td>@desig.DepartmentName</td>
                                                <td>@desig.CompanyName</td>
                                                <td>
                                                    @* ✅ FIX 1 & 2: desig.IsActive is bool? — use == true *@
                                                    <span class="badge @((desig.IsActive == true) ? "badge-success" : "badge-secondary")">
                                                        @((desig.IsActive == true) ? "Active" : "Inactive")
                                                    </span>
                                                </td>
                                                <td>
                                                    @* ✅ FIX 3: desig.CreatedDate is DateTime? — null-safe *@
                                                    @(desig.CreatedDate.HasValue
                                                        ? desig.CreatedDate.Value.ToString("dd-MMM-yyyy")
                                                        : "N/A")
                                                </td>
                                                
                                                <td>
                                                    <a href="@Url.Action("Profile", new { id = desig.DesignationId })" class="btn btn-sm btn-info" title="View Profile">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    <a href="@Url.Action("Edit", new { id = desig.DesignationId })" class="btn btn-sm btn-warning" title="Edit">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- Pagination -->
                            @if (Model.TotalPages > 1)
                            {
                                <nav aria-label="Page navigation">
                                    <ul class="pagination justify-content-center">
                                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                            <a class="page-link" href="@Url.Action("Search", new { 
                                                page = Model.Page - 1, 
                                                searchTerm = Model.SearchTerm, 
                                                departmentId = Model.DepartmentId,
                                                companyId = Model.CompanyId,
                                                isActive = Model.IsActive, 
                                                pageSize = Model.PageSize 
                                            })">
                                                <i class="bi bi-chevron-left"></i>
                                            </a>
                                        </li>
                                        @for (int i = 1; i <= Model.TotalPages; i++)
                                        {
                                            <li class="page-item @(i == Model.Page ? "active" : "")">
                                                <a class="page-link" href="@Url.Action("Search", new { 
                                                    page = i, 
                                                    searchTerm = Model.SearchTerm, 
                                                    departmentId = Model.DepartmentId,
                                                    companyId = Model.CompanyId,
                                                    isActive = Model.IsActive, 
                                                    pageSize = Model.PageSize 
                                                })">@i</a>
                                            </li>
                                        }
                                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                            <a class="page-link" href="@Url.Action("Search", new { 
                                                page = Model.Page + 1, 
                                                searchTerm = Model.SearchTerm, 
                                                departmentId = Model.DepartmentId,
                                                companyId = Model.CompanyId,
                                                isActive = Model.IsActive, 
                                                pageSize = Model.PageSize 
                                            })">
                                                <i class="bi bi-chevron-right"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </nav>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4">
                                <i class="bi bi-search display-1 text-muted"></i>
                                <h5 class="text-muted mt-3">No designations found matching your search criteria</h5>
                                <p class="text-muted">Try adjusting your search terms or filters</p>
                                <a href="@Url.Action("Search")" class="btn btn-primary">
                                    <i class="bi bi-arrow-counterclockwise"></i> Clear Search
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function() {
            // Load departments for dropdown
            loadDepartments();

            // Auto-submit on filter change
            $('#IsActive, #PageSize, #DepartmentId').change(function() {
                $('#searchForm').submit();
            });

            // Clear search
            $('#clearSearch').click(function() {
                $('#SearchTerm').val('');
                $('#DepartmentId').val('');
                $('#CompanyId').val('');
                $('#IsActive').val('');
                $('#searchForm').submit();
            });
        });

        function loadDepartments() {
            $.ajax({
                url: '@Url.Action("GetActiveDepartments", "Department")',
                type: 'GET',
                success: function(data) {
                    var select = $('#departmentFilter');
                    select.empty();
                    select.append('<option value="">All Departments</option>');
                    $.each(data, function(i, dept) {
                        var selected = '@Model.DepartmentId' == dept.departmentId ? 'selected' : '';
                        select.append('<option value="' + dept.departmentId + '" ' + selected + '>' + dept.departmentName + '</option>');
                    });
                },
                error: function() {
                    $('#departmentFilter').append('<option value="">Error loading departments</option>');
                }
            });
        }
    </script>
}