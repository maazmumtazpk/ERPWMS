@model ERPWMS.Web.ViewModels.Designation.RegisterDesignationViewModel

@{
    ViewData["Title"] = "Register Designation";
}

<div class="designation-page">

    <div class="page-header">
        <div>
            <h2>Register Designation</h2>
            <p>Create a new designation</p>
        </div>

        <a asp-controller="Designation"
               asp-action="Index"
               class="btn btn-secondary">
            ? Back
        </a>
    </div>

    <div class="card register-card">

        <div class="card-header">
            <h4>Designation Information</h4>
        </div>

        <div class="card-body">

            <form asp-controller="Designation"
                  asp-action="Register"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <!-- Designation Name -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="DesignationName"
                               class="form-label">
                            Designation Name
                        </label>

                        <input asp-for="DesignationName"
                               class="form-control"
                               placeholder="Enter designation name" />

                        <span asp-validation-for="DesignationName"
                              class="text-danger">
                        </span>
                    </div>


                    <!-- Rank Level -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="RankLevel"
                               class="form-label">
                            Rank Level
                        </label>

                        <input asp-for="RankLevel"
                               type="number"
                               min="0"
                               class="form-control"
                               placeholder="Enter rank level" />

                        <span asp-validation-for="RankLevel"
                              class="text-danger">
                        </span>
                    </div>


                    <!-- Department -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="DepartmentId"
                               class="form-label">
                            Department
                        </label>

                        <select asp-for="DepartmentId"
                                class="form-select">

                            <option value="">
                                -- Select Department --
                            </option>

                            @if (ViewBag.Departments != null)
                            {
                                foreach (var department in ViewBag.Departments)
                                {
                                    <option value="@department.DepartmentId">
                                        @department.DepartmentName
                                    </option>
                                }
                            }

                        </select>

                        <span asp-validation-for="DepartmentId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Company -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="CompanyId"
                               class="form-label">
                            Company
                        </label>

                        <input asp-for="CompanyId"
                               type="number"
                               class="form-control"
                               placeholder="Company ID" />

                        <span asp-validation-for="CompanyId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Active -->
                    <div class="col-md-6 mb-3">

                        <div class="form-check mt-2">

                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="IsActive"
                                   class="form-check-label">
                                Is Active
                            </label>

                        </div>

                    </div>

                </div>

                <hr />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-controller="Designation"
                           asp-action="Index"
                           class="btn btn-light border">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Register Designation
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}


<style>

    .designation-page {
        padding: 25px;
        max-width: 1100px;
        margin: auto;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .page-header h2 {
            margin: 0;
            font-weight: 700;
        }

        .page-header p {
            margin: 5px 0 0;
            color: #6c757d;
        }

    .register-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .card-header {
        background: #f8f9fa;
        padding: 18px 22px;
        border-bottom: 1px solid #e9ecef;
    }

        .card-header h4 {
            margin: 0;
            font-size: 18px;
            font-weight: 600;
        }

    .card-body {
        padding: 25px;
    }

    .form-label {
        font-weight: 600;
        margin-bottom: 7px;
    }

    .form-control,
    .form-select {
        min-height: 44px;
        border-radius: 7px;
    }

        .form-control:focus,
        .form-select:focus {
            box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, .15);
        }

    .btn {
        border-radius: 7px;
        padding: 9px 18px;
    }

    .text-danger {
        font-size: 13px;
    }

</style>