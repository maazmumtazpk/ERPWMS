@model ERPWMS.Database.Models.Designation
@{
    Layout = null;
    var deptName = ViewBag.DepartmentName as string ?? "N/A";
}
<form id="editDesForm" method="post" action="/Designation/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="designationId" value="@Model.DesignationId" />
    <div id="editDesAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-12">
            <label class="form-label fw-bold">Designation Name *</label>
            <input type="text" name="designationName" class="form-control" value="@Model.DesignationName" required maxlength="200" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Rank Level</label>
            <input type="number" name="rankLevel" class="form-control" min="0" value="@(Model.RankLevel ?? 0)" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Department</label>
            <input type="text" class="form-control" value="@deptName" disabled />
        </div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>
