@{
    Layout = null;
}
<form id="addDesForm" method="post" action="/Designation/Register">
    @Html.AntiForgeryToken()
    <div id="addDesAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-12">
            <label class="form-label fw-bold">Designation Name *</label>
            <input type="text" name="designationName" class="form-control" required maxlength="200" placeholder="Enter designation name" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Rank Level</label>
            <input type="number" name="rankLevel" class="form-control" min="0" value="0" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Department *</label>
            <select name="departmentId" id="addDeptId" class="form-select" required>
                <option value="">Loading...</option>
            </select>
        </div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Register</button>
    </div>
</form>
<script>
fetch("/Designation/GetDepartments").then(function(r){return r.json();}).then(function(d){
    var s=document.getElementById("addDeptId");if(!s)return;
    s.innerHTML="<option value=\"\">-- Select Department --</option>";
    (d||[]).forEach(function(x){var o=document.createElement("option");o.value=x.departmentId;o.textContent=x.departmentName;s.appendChild(o);});
});
</script>
