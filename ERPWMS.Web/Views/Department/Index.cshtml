@{
    ViewData["Title"] = "Department Management";
    Layout = "_Layout";
}
<form id="__mainAntiforgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>
<div class="toast-holder" id="toastHolder"></div>
<style>
.mod-page{padding-bottom:30px}
.kpi-card{background:#fff;border:1px solid #edf0f4;border-radius:10px;padding:12px 14px;box-shadow:0 2px 8px rgba(0,0,0,.04);height:100%;min-height:80px;position:relative;overflow:hidden;transition:all .25s ease;display:flex;flex-direction:column;justify-content:center}
.kpi-card::before{content:"";position:absolute;top:0;left:0;right:0;height:2.5px}
.kpi-card.total::before{background:#0A1628}
.kpi-card.active::before{background:#159A89}
.kpi-card.inactive::before{background:#F5A623}
.kpi-card.month::before{background:#7167D8}
.kpi-card:hover{transform:translateY(-2px);box-shadow:0 4px 16px rgba(0,0,0,.07)}
.kpi-content{display:flex;justify-content:space-between;align-items:center;width:100%;gap:8px}
.kpi-text-group{display:flex;flex-direction:column;flex:1}
.kpi-label{margin:0 0 3px 0;color:#64748B;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.4px}
.kpi-number{margin:0;color:#0A1628;font-size:20px;font-weight:750;line-height:1.2}
.kpi-trend{display:inline-flex;align-items:center;gap:3px;margin-top:4px;padding:2px 7px;border-radius:12px;font-size:8px;font-weight:600;width:fit-content}
.kpi-trend.up{background:#DDF7F1;color:#128B7B}
.kpi-trend.neutral{background:#F1F5F9;color:#64748B}
.kpi-icon{width:30px;height:30px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:13px;flex-shrink:0}
.kpi-icon.blue{background:#0A1628;color:#fff}
.kpi-icon.green{background:#D7F4EE;color:#159A89}
.kpi-icon.orange{background:#FFF1D7;color:#E39A19}
.kpi-icon.purple{background:#EAE8FF;color:#7167D8}
.table-card{background:#fff;border:1px solid #edf0f4;border-radius:10px;box-shadow:0 2px 8px rgba(0,0,0,.04);overflow:visible;margin-top:16px}
.table-card .card-header-custom{padding:10px 14px;border-bottom:2px solid #F1F5F9;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
.table-card .card-header-custom h5{margin:0;font-size:12px;font-weight:700;color:#0A1628;display:flex;align-items:center;gap:6px}
.badge-count{background:#F1F5F9;color:#64748B;font-size:9px;font-weight:700;padding:1px 8px;border-radius:12px}
.table-card .card-body{padding:0;overflow-x:auto}
.table-premium{margin:0;font-size:11px;width:100%}
.table-premium thead{background:#F8FAFC;border-bottom:2px solid #E2E8F0}
.table-premium thead th{padding:8px 14px;font-weight:700;font-size:9px;text-transform:uppercase;color:#64748B;border:none;text-align:left;white-space:nowrap}
.table-premium tbody td{padding:8px 14px;vertical-align:middle;border-bottom:1px solid #F1F5F9;color:#0A1628;font-size:11px}
.table-premium tbody tr:hover{background:#FEFBF5}
.row-name{font-weight:600;display:flex;align-items:center;gap:8px}
.row-name .avatar{width:28px;height:28px;border-radius:6px;background:#FEF3C7;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:10px;color:#D97706;flex-shrink:0}
.badge-status{padding:2px 8px;border-radius:12px;font-size:8px;font-weight:700;display:inline-flex;align-items:center;gap:4px;text-transform:uppercase}
.badge-status.active{background:#DDF7F1;color:#118B7B}
.badge-status.inactive{background:#F1F5F9;color:#64748B}
.btn-icon{width:26px;height:26px;border-radius:6px;border:1px solid #E8ECF1;display:inline-flex;align-items:center;justify-content:center;font-size:12px;color:#64748B;background:#fff;cursor:pointer;text-decoration:none}
.btn-icon:hover{background:#F1F5F9;color:#0A1628;border-color:#CBD5E1}
.btn-icon.gold{background:#F5A623;color:#fff;border-color:#F5A623}
.btn-icon.gold:hover{background:#E39A19;color:#fff}
.table-footer{padding:8px 14px;border-top:2px solid #F1F5F9;display:flex;justify-content:space-between;align-items:center;font-size:10px;color:#64748B;background:#F8FAFC}
.search-wrapper{position:relative;display:inline-block}
.search-wrapper input{border:1px solid #E2E8F0;border-radius:6px;padding:4px 10px 4px 28px;font-size:10px;outline:none;width:160px;background:#FAFBFC}
.search-wrapper input:focus{border-color:#F5A623;background:#fff}
.search-wrapper i{position:absolute;left:8px;top:50%;transform:translateY(-50%);color:#94A3B8;font-size:10px}
.empty-state{padding:30px 16px;text-align:center}
.empty-state .empty-icon{font-size:35px;color:#E2E8F0;display:block;margin-bottom:8px}
.empty-state h4{font-size:13px;font-weight:700;color:#0A1628;margin-bottom:4px}
.empty-state p{color:#64748B;font-size:10px;max-width:300px;margin:0 auto 12px auto}
.btn-gold{background:#F5A623;color:#0A1628;border:none;padding:6px 14px;border-radius:6px;font-weight:700;font-size:10px;cursor:pointer;display:inline-flex;align-items:center;gap:5px}
.act-wrap{position:relative;display:inline-block}
.act-menu{position:fixed;background:#fff;border:1px solid #E8ECF1;border-radius:8px;box-shadow:0 8px 24px rgba(15,23,42,.14);min-width:180px;padding:5px;z-index:99999;display:none;text-align:left}
.act-menu.show{display:block}
.act-menu a,.act-menu button{display:flex;align-items:center;gap:10px;width:100%;padding:8px 11px;border:none;background:transparent;font-size:11.5px;color:#334155;border-radius:6px;text-decoration:none;cursor:pointer;text-align:left;font-weight:500}
.act-menu a:hover,.act-menu button:hover{background:#F8FAFC;color:#0A1628}
.act-menu a i,.act-menu button i{width:14px;font-size:12px;color:#64748B;flex-shrink:0}
.act-menu .sep{height:1px;background:#F1F5F9;margin:3px 5px}
.act-menu .danger{color:#DC2626}
.act-menu .danger i{color:#DC2626}
.act-menu .danger:hover{background:#FEF2F2}
.pm-modal .modal-content{border:0;border-radius:12px;box-shadow:0 20px 60px rgba(15,23,42,.25);overflow:hidden}
.pm-modal .modal-header{background:#0A1628;color:#fff;padding:14px 20px;border:0}
.pm-modal .modal-header h5{font-size:14px;font-weight:700;margin:0;display:flex;align-items:center}
.pm-modal .modal-header h5 i{color:#F5A623;margin-right:8px}
.pm-modal .modal-header .btn-close{filter:invert(1);opacity:.7}
.pm-modal .modal-body{padding:18px 22px;max-height:75vh;overflow-y:auto}
.pm-modal .form-label{font-size:11px;font-weight:600;color:#475569;margin-bottom:3px}
.pm-modal .form-control,.pm-modal .form-select{font-size:12px;padding:7px 11px;min-height:34px;border-radius:6px;border:1px solid #dde4ec}
.pm-modal .btn-gold{background:#F5A623;border-color:#F5A623;color:#0A1628;font-weight:700;font-size:12px}
.toast-holder{position:fixed;top:20px;right:20px;z-index:99999;display:flex;flex-direction:column;gap:8px}
.toast-item{background:#fff;border-left:4px solid #10b981;border-radius:8px;box-shadow:0 8px 24px rgba(15,23,42,.15);padding:12px 16px;min-width:280px;display:flex;align-items:center;gap:10px;font-size:12px}
.toast-item.error{border-left-color:#ef4444}
.toast-item i{font-size:16px;color:#10b981}
.toast-item.error i{color:#ef4444}
.toast-item .msg{font-weight:600;color:#0A1628}
</style>
<div class="mod-page">
<div class="row g-3">
<div class="col-xl-3 col-lg-3 col-md-6 col-12"><div class="kpi-card total"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Total Departments</p><h2 class="kpi-number" id="kpiTotal">-</h2><span class="kpi-trend neutral"><i class="bi bi-dash-circle"></i> Total registered</span></div><div class="kpi-icon blue"><i class="bi bi-diagram-2"></i></div></div></div></div>
<div class="col-xl-3 col-lg-3 col-md-6 col-12"><div class="kpi-card active"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Active Departments</p><h2 class="kpi-number" id="kpiActive">-</h2><span class="kpi-trend up"><i class="bi bi-check-circle"></i> Currently active</span></div><div class="kpi-icon green"><i class="bi bi-check-circle"></i></div></div></div></div>
<div class="col-xl-3 col-lg-3 col-md-6 col-12"><div class="kpi-card inactive"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Inactive Departments</p><h2 class="kpi-number" id="kpiInactive">-</h2><span class="kpi-trend neutral"><i class="bi bi-dash-circle"></i> Currently inactive</span></div><div class="kpi-icon orange"><i class="bi bi-x-circle"></i></div></div></div></div>
<div class="col-xl-3 col-lg-3 col-md-6 col-12"><div class="kpi-card month"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Added This Month</p><h2 class="kpi-number" id="kpiMonth">-</h2><span class="kpi-trend neutral"><i class="bi bi-calendar3"></i> This month</span></div><div class="kpi-icon purple"><i class="bi bi-calendar-plus"></i></div></div></div></div>
</div>
<div class="table-card">
<div class="card-header-custom">
<h5><i class="bi bi-clock-history" style="color:#F5A623;"></i> All Departments <span class="badge-count" id="deptCount">0</span></h5>
<div style="display:flex;gap:4px;align-items:center;">
<div class="search-wrapper"><i class="bi bi-search"></i><input type="text" id="tableSearch" placeholder="Search..." onkeyup="filterTable()" /></div>
<button type="button" class="btn-icon gold" title="Add Department" onclick="openAdd()"><i class="bi bi-plus-circle"></i></button>
<button type="button" class="btn-icon" onclick="location.reload()" title="Refresh"><i class="bi bi-arrow-clockwise"></i></button>
</div>
</div>
<div class="card-body">
<table class="table-premium" id="deptTable">
<thead><tr><th>Department</th><th>Code</th><th>Branch</th><th>Company</th><th>Status</th><th>Created</th><th style="text-align:right;">Actions</th></tr></thead>
<tbody id="deptTableBody"><tr><td colspan="7" class="text-center py-3"><div class="spinner-border text-primary" style="width:20px;height:20px;"></div></td></tr></tbody>
</table>
<div id="emptyState" class="empty-state d-none">
<i class="bi bi-diagram-2 empty-icon"></i>
<h4>No Departments Yet</h4>
<p>Start by registering your first department.</p>
<button class="btn-gold" onclick="openAdd()"><i class="bi bi-plus-circle"></i> Register First Department</button>
</div>
</div>
<div class="table-footer"><span><i class="bi bi-info-circle"></i> Showing <span id="footerCount">0</span> departments</span></div>
</div>
</div>
<div class="modal fade pm-modal" id="addDeptModal" tabindex="-1" aria-hidden="true">
<div class="modal-dialog modal-dialog-centered">
<div class="modal-content">
<div class="modal-header"><h5><i class="bi bi-diagram-2"></i> Register New Department</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
<div class="modal-body" id="addDeptModalBody"><div class="text-center py-4"><div class="spinner-border text-primary"></div></div></div>
</div>
</div>
</div>
<div class="modal fade pm-modal" id="editDeptModal" tabindex="-1" aria-hidden="true">
<div class="modal-dialog modal-dialog-centered">
<div class="modal-content">
<div class="modal-header"><h5><i class="bi bi-pencil-square"></i> Edit Department</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
<div class="modal-body" id="editDeptModalBody"><div class="text-center py-4"><div class="spinner-border text-primary"></div></div></div>
</div>
</div>
</div>
@section Scripts {
<script>
window.execScripts=function(c){c.querySelectorAll('script').forEach(function(s){var n=document.createElement('script');n.textContent=s.textContent;document.body.appendChild(n);});};function tk(){var e=document.querySelector('input[name="__RequestVerificationToken"]');return e?e.value:'';}
function showToast(msg,type){var h=document.getElementById('toastHolder');if(!h)return;var d=document.createElement('div');d.className='toast-item '+(type||'success');var ic=type==='error'?'bi-x-circle-fill':'bi-check-circle-fill';d.innerHTML='<i class="bi '+ic+'"></i><span class="msg">'+msg+'</span>';h.appendChild(d);setTimeout(function(){d.style.transition='opacity .4s';d.style.opacity='0';setTimeout(function(){d.remove();},400);},3500);}
window.openAdd=function(){var el=document.getElementById('addDeptModal');var body=document.getElementById('addDeptModalBody');body.innerHTML='<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';new bootstrap.Modal(el).show();fetch('/Department/AddDepartmentPartial').then(function(r){return r.text();}).then(function(h){body.innerHTML=h;execScripts(body);});};
window.openEdit=function(id){var el=document.getElementById('editDeptModal');var body=document.getElementById('editDeptModalBody');body.innerHTML='<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';new bootstrap.Modal(el).show();fetch('/Department/EditDepartmentPartial?id='+id).then(function(r){return r.text();}).then(function(h){body.innerHTML=h;execScripts(body);});};
function loadStats(){fetch('/Department/GetStatistics').then(function(r){return r.json();}).then(function(d){document.getElementById('kpiTotal').textContent=d.total||0;document.getElementById('kpiActive').textContent=d.active||0;document.getElementById('kpiInactive').textContent=d.inactive||0;document.getElementById('kpiMonth').textContent=d.addedThisMonth||0;});}
function loadList(){fetch('/Department/GetAll').then(function(r){return r.json();}).then(function(d){
if(!d||d.length===0){document.getElementById('deptTableBody').innerHTML='';document.getElementById('deptTable').classList.add('d-none');document.getElementById('emptyState').classList.remove('d-none');document.getElementById('deptCount').textContent='0';document.getElementById('footerCount').textContent='0';return;}
document.getElementById('deptTable').classList.remove('d-none');document.getElementById('emptyState').classList.add('d-none');
var h='';
d.forEach(function(x){
var st=x.isActive?'active':'inactive';
var ini=(x.departmentName||'DP').substring(0,2).toUpperCase();
var dt=x.createdDate?new Date(x.createdDate).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}):'-';
h+='<tr>';
h+='<td><div class="row-name"><span class="avatar">'+ini+'</span><div><div>'+x.departmentName+'</div><div style="font-size:9px;color:#94A3B8;">ID: #'+x.departmentId+'</div></div></div></td>';
h+='<td><span style="font-family:monospace;font-size:10px;color:#64748B;">'+(x.departmentCode||'N/A')+'</span></td>';
h+='<td>'+x.branchName+'</td>';
h+='<td>'+x.companyName+'</td>';
h+='<td><span class="badge-status '+st+'">'+(x.isActive?'Active':'Inactive')+'</span></td>';
h+='<td><span style="font-size:10px;color:#64748B;"><i class="bi bi-calendar3 me-1"></i>'+dt+'</span></td>';
h+='<td style="text-align:right;"><div class="act-wrap"><button class="btn-icon" onclick="toggleMenu('+x.departmentId+',event)"><i class="bi bi-three-dots-vertical"></i></button><div class="act-menu" id="menu-'+x.departmentId+'"><a href="/Department/Profile/'+x.departmentId+'"><i class="bi bi-eye"></i> View Profile</a><button onclick="openEdit('+x.departmentId+')"><i class="bi bi-pencil"></i> Edit</button><button onclick="toggleActive('+x.departmentId+')"><i class="bi bi-power"></i> '+(x.isActive?'Deactivate':'Activate')+'</button><div class="sep"></div><button class="danger" onclick="delDept('+x.departmentId+',\''+(x.departmentName||'').replace(/'/g,"")+'\')"><i class="bi bi-trash3"></i> Delete</button></div></div></td>';
h+='</tr>';
});
document.getElementById('deptTableBody').innerHTML=h;
document.getElementById('deptCount').textContent=d.length;
document.getElementById('footerCount').textContent=d.length;
});}
window.toggleMenu=function(id,e){e.stopPropagation();document.querySelectorAll('.act-menu').forEach(function(m){if(m.id!=='menu-'+id)m.classList.remove('show');});var el=document.getElementById('menu-'+id);if(!el)return;if(el.classList.contains('show')){el.classList.remove('show');return;}var btn=e.currentTarget||e.target;var r=btn.getBoundingClientRect();el.style.top=(r.bottom+4)+'px';el.style.right=(window.innerWidth-r.right)+'px';el.style.left='auto';el.classList.add('show');var mh=el.offsetHeight;if(r.bottom+mh+10>window.innerHeight){el.style.top=(r.top-mh-4)+'px';}};
document.addEventListener('click',function(){document.querySelectorAll('.act-menu').forEach(function(m){m.classList.remove('show');});});
window.delDept=function(id,name){if(!confirm('Delete department "'+name+'"?'))return;var fd=new FormData();fd.append('__RequestVerificationToken',tk());fetch('/Department/Delete/'+id,{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){if(res.success){showToast(res.message||'Deleted','success');loadList();loadStats();}});};
window.toggleActive=function(id){var fd=new FormData();fd.append('__RequestVerificationToken',tk());fetch('/Department/ToggleActive/'+id,{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){if(res.success){showToast(res.message||'Updated','success');loadList();loadStats();}});};
window.filterTable=function(){var f=document.getElementById('tableSearch').value.toLowerCase();var rows=document.querySelectorAll('#deptTableBody tr');var n=0;rows.forEach(function(r){var t=(r.textContent||'').toLowerCase();if(t.indexOf(f)>-1){r.style.display='';n++;}else{r.style.display='none';}});document.getElementById('footerCount').textContent=n;};
document.addEventListener('submit',function(e){var f=e.target;if(!f||(f.id!=='addDeptForm'&&f.id!=='editDeptForm'))return;e.preventDefault();var isAdd=f.id==='addDeptForm';var ab=document.getElementById(isAdd?'addDeptAlert':'editDeptAlert');if(ab)ab.style.display='none';var btn=f.querySelector('button[type="submit"]');var orig=btn?btn.textContent:'';if(btn){btn.disabled=true;btn.textContent=isAdd?'Saving...':'Updating...';}fetch(f.action,{method:'POST',body:new FormData(f)}).then(function(r){return r.json();}).then(function(res){if(res.success){var m=bootstrap.Modal.getInstance(document.getElementById(isAdd?'addDeptModal':'editDeptModal'));if(m)m.hide();showToast(res.message||'Saved','success');loadList();loadStats();}else{if(ab){ab.textContent=res.message||'Failed';ab.style.display='block';}}}).catch(function(){if(ab){ab.textContent='Network error';ab.style.display='block';}}).finally(function(){if(btn){btn.disabled=false;btn.textContent=orig;}});});
document.addEventListener('DOMContentLoaded',function(){loadStats();loadList();});
document.addEventListener("click",function(e){
var b=e.target.closest("[data-del-action]");if(!b)return;e.preventDefault();e.stopPropagation();
var act=b.getAttribute("data-del-action"),id=b.getAttribute("data-id"),nm=b.getAttribute("data-name")||"";
if(!confirm("Delete "+act+" \""+nm+"\"?"))return;
var u="/"+(act==="Zone"?"Warehouse/DeleteZone":act==="Rack"?"Warehouse/DeleteRack":act==="Bin"?"Warehouse/DeleteBin":act==="Warehouse"?"Warehouse/Delete":act==="Department"?"Department/Delete":"Designation/Delete")+"/"+id;
var fd=new FormData();fd.append("__RequestVerificationToken",tk());
fetch(u,{method:"POST",body:fd}).then(r=>r.json()).then(res=>{if(res.success){showToast(res.message||"Deleted","success");if(window.reload_)reload_();else if(window.loadList)loadList();else location.reload();}});
});
</script>
}
