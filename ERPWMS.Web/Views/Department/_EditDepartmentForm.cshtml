@model ERPWMS.Database.Models.Department
@{
    Layout = null;
    var branchName = ViewBag.BranchName as string ?? "N/A";
}
<form id="editDeptForm" method="post" action="/Department/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="departmentId" value="@Model.DepartmentId" />
    <div id="editDeptAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-12">
            <label class="form-label fw-bold">Department Name *</label>
            <input type="text" name="departmentName" class="form-control" value="@Model.DepartmentName" required maxlength="200" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Department Code</label>
            <input type="text" name="departmentCode" class="form-control" value="@Model.DepartmentCode" maxlength="20" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Branch</label>
            <input type="text" class="form-control" value="@branchName" disabled />
        </div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>