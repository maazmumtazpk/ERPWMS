@using ERPWMS.Web.ViewModels.Department
@model RegisterDepartmentViewModel

@{
    ViewData["Title"] = Model.Title;
    Layout = "_Layout";
}

<div class="container-fluid">

    <!-- ============================================================
         PAGE HEADER
         ============================================================ -->
    <div class="row">
        <div class="col-12">
            <div class="page-header">
                <h1>
                    <i class="bi @(Model.IsEdit ? "bi-pencil-square" : "bi-plus-circle")"></i>
                    @Model.Title
                </h1>

                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="/">Home</a>
                    </li>

                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Department")">
                            Departments
                        </a>
                    </li>

                    <li class="breadcrumb-item active">
                        @Model.Title
                    </li>
                </ol>
            </div>
        </div>
    </div>


    <!-- ============================================================
         FORM AREA
         ============================================================ -->
    <div class="row">

        <!-- ========================================================
             MAIN FORM
             ======================================================== -->
        <div class="col-md-8">

            <div class="card">

                <div class="card-header">
                    <h5>
                        <i class="bi bi-building"></i>
                        Department Information
                    </h5>
                </div>

                <div class="card-body">

                    <form asp-action="@(Model.IsEdit ? "Edit" : "Register")"
                          asp-controller="Department"
                          method="post"
                          id="departmentForm">

                        <!-- ====================================================
                             EDIT ONLY HIDDEN VALUES
                             ==================================================== -->
                        @if (Model.IsEdit)
                        {
                            <input type="hidden" asp-for="DepartmentId" />

                            <input type="hidden" asp-for="IsActive" />

                            <!--
                                Branch cannot be changed during Edit.
                                CompanyId is derived from Branch in backend.
                            -->
                            <input type="hidden" asp-for="BranchId" />
                        }


                        <!-- ====================================================
                             VALIDATION SUMMARY
                             ==================================================== -->
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>


                        <!-- ====================================================
                             DEPARTMENT NAME
                             ==================================================== -->
                        <div class="row">

                            <div class="col-md-12">

                                <div class="form-group mb-3">

                                    <label asp-for="DepartmentName"
                                           class="form-label">

                                        Department Name
                                        <span class="text-danger">*</span>

                                    </label>

                                    <input asp-for="DepartmentName"
                                           class="form-control"
                                           id="DepartmentName"
                                           placeholder="Enter department name"
                                           autocomplete="off" />

                                    <span asp-validation-for="DepartmentName"
                                          class="text-danger">
                                    </span>

                                    <small class="form-text text-muted">
                                        Must be unique within the selected branch
                                        and between 2-200 characters.
                                    </small>

                                </div>

                            </div>

                        </div>


                        <!-- ====================================================
                             CODE + BRANCH
                             ==================================================== -->
                        <div class="row">

                            <!-- DEPARTMENT CODE -->
                            <div class="col-md-6">

                                <div class="form-group mb-3">

                                    <label asp-for="DepartmentCode"
                                           class="form-label">

                                        Department Code

                                    </label>

                                    <input asp-for="DepartmentCode"
                                           class="form-control"
                                           id="DepartmentCode"
                                           placeholder="Enter department code"
                                           autocomplete="off" />

                                    <span asp-validation-for="DepartmentCode"
                                          class="text-danger">
                                    </span>

                                    <small class="form-text text-muted">
                                        Optional. Must be unique within the branch.
                                    </small>

                                </div>

                            </div>


                            <!-- BRANCH -->
                            <div class="col-md-6">

                                <div class="form-group mb-3">

                                    <label asp-for="BranchId"
                                           class="form-label">

                                        Branch
                                        <span class="text-danger">*</span>

                                    </label>


                                    @if (Model.IsEdit)
                                    {
                                        <!-- EDIT MODE -->

                                        <input type="text"
                                               class="form-control"
                                               value="@Model.BranchName"
                                               disabled />

                                        <small class="form-text text-muted">
                                            Branch cannot be changed after department
                                            creation.
                                        </small>
                                    }
                                    else
                                    {
                                        <!-- REGISTER MODE -->

                                        <select asp-for="BranchId"
                                                class="form-select"
                                                id="BranchId">

                                            <option value="">
                                                Loading branches...
                                            </option>

                                        </select>

                                        <span asp-validation-for="BranchId"
                                              class="text-danger">
                                        </span>

                                        <small class="form-text text-muted">
                                            Only active branches are available for
                                            department registration.
                                        </small>
                                    }

                                </div>

                            </div>

                        </div>


                        <!-- ====================================================
                             COMPANY INFORMATION
                             ==================================================== -->
                        @if (Model.IsEdit && !string.IsNullOrWhiteSpace(Model.CompanyName))
                        {
                            <div class="row">

                                <div class="col-md-12">

                                    <div class="alert alert-light border">

                                        <div class="d-flex align-items-center">

                                            <i class="bi bi-building me-2"></i>

                                            <div>

                                                <strong>Company:</strong>

                                                @Model.CompanyName

                                                <small class="text-muted d-block">
                                                    Company is automatically associated
                                                    with the selected branch.
                                                </small>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>
                        }


                        <!-- ====================================================
                             EDIT STATUS
                             ==================================================== -->
                        @if (Model.IsEdit)
                        {
                            <div class="row">

                                <div class="col-md-12">

                                    <div class="alert alert-info">

                                        <i class="bi bi-info-circle"></i>

                                        <strong>Current status:</strong>

                                        @* ✅ FIX: IsActive is bool? — use == true *@
                                        <span class="badge @((Model.IsActive == true) ? "bg-success" : "bg-secondary")">

                                            @((Model.IsActive == true) ? "Active" : "Inactive")

                                        </span>

                                    </div>

                                </div>

                            </div>
                        }


                        <!-- ====================================================
                             BUTTONS
                             ==================================================== -->
                        <div class="form-group mt-4">

                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi @(Model.IsEdit ? "bi-save" : "bi-plus-circle")"></i>

                                @Model.SubmitButtonText

                            </button>

                            <a href="@Model.CancelUrl"
                                   class="btn btn-secondary">

                                <i class="bi bi-x-circle"></i>
                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>


        <!-- ============================================================
             HELP PANEL
             ============================================================ -->
        <div class="col-md-4">

            <div class="card">

                <div class="card-header">

                    <h5>
                        <i class="bi bi-question-circle"></i>
                        Help & Tips
                    </h5>

                </div>

                <div class="card-body">

                    <ul class="list-unstyled">

                        <li class="mb-3">
                            <i class="bi bi-info-circle text-primary"></i>
                            Department name is required and must be unique
                            within the selected branch.
                        </li>

                        <li class="mb-3">
                            <i class="bi bi-info-circle text-primary"></i>
                            Department code is optional but must be unique
                            within the selected branch.
                        </li>

                        <li class="mb-3">
                            <i class="bi bi-info-circle text-primary"></i>
                            Only active branches can be selected.
                        </li>

                        <li class="mb-3">
                            <i class="bi bi-info-circle text-primary"></i>
                            Company is automatically determined from the
                            selected branch.
                        </li>

                        <li class="mb-3">
                            <i class="bi bi-info-circle text-primary"></i>

                            @(Model.IsEdit
                                ? "Changes will be logged for audit purposes."
                                : "Department will be created with Active status.")
                        </li>

                    </ul>

                </div>

            </div>


            <!-- ========================================================
                 EDIT ACTIONS
                 ======================================================== -->
            @if (Model.IsEdit)
            {
                <div class="card mt-3">

                    <div class="card-header">

                        <h5>
                            <i class="bi bi-shield"></i>
                            Actions
                        </h5>

                    </div>

                    <div class="card-body">

                        <div class="d-grid gap-2">

                            <!-- View Profile -->
                            <a href="@Url.Action(
                                                                   "Profile",
                                                                   "Department",
                                                                   new { id = Model.DepartmentId })"
                                   class="btn btn-info">

                                <i class="bi bi-eye"></i>
                                View Profile

                            </a>


                            @* ✅ FIX: IsActive is bool? — use == true *@
                            @if (Model.IsActive == true)
                            {
                                <!-- DEACTIVATE -->
                                <form asp-action="Deactivate"
                                      asp-controller="Department"
                                      asp-route-id="@Model.DepartmentId"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to deactivate this department?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger w-100">

                                        <i class="bi bi-x-circle"></i>
                                        Deactivate

                                    </button>

                                </form>
                            }
                            else
                            {
                                <!-- ACTIVATE -->
                                <form asp-action="Activate"
                                      asp-controller="Department"
                                      asp-route-id="@Model.DepartmentId"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-success w-100">

                                        <i class="bi bi-check-circle"></i>
                                        Activate

                                    </button>

                                </form>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</div>


@section Scripts 
{
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    
     }
    <script>

        $(document).ready(function () {

        // ============================================================
        // REGISTER MODE ONLY: Load active branches
        // ============================================================

        @if (!Model.IsEdit)
        {
            <text>
                loadActiveBranches();
            </text>
        }


        // ============================================================
        // FORM VALIDATION
        // ============================================================

        $('#departmentForm').validate({

        rules: {

        DepartmentName: {

        required: true,

        minlength: 2,

        maxlength: 200,

        remote: {

        url: '@Url.Action("ValidateName", "Department")',

        type: 'GET',

        data: {

        name: function () {
        return $('#DepartmentName').val();
        },

        branchId: function () {
        return $('#BranchId').val();
        },

        excludeId: function () {

        return $('#DepartmentId').length
        ? $('#DepartmentId').val()
        : null;
        }

        },

        dataType: 'json'

        }

        },


        DepartmentCode: {

        maxlength: 20,

        remote: {

        url: '@Url.Action("ValidateCode", "Department")',

        type: 'GET',

        data: {

        code: function () {
        return $('#DepartmentCode').val();
        },

        branchId: function () {
        return $('#BranchId').val();
        },

        excludeId: function () {

        return $('#DepartmentId').length
        ? $('#DepartmentId').val()
        : null;
        }

        },

        dataType: 'json'

        }

        },


        BranchId: {

        required: true,

        min: 1

        }

        },


        messages: {

        DepartmentName: {

        required: "Department name is required.",

        minlength:
        "Department name must be at least 2 characters.",

        maxlength:
        "Department name cannot exceed 200 characters.",

        remote:
        "Department name already exists in this branch."

        },


        DepartmentCode: {

        maxlength:
        "Department code cannot exceed 20 characters.",

        remote:
        "Department code already exists in this branch."

        },


        BranchId: {

        required:
        "Please select a branch.",

        min:
        "Please select a valid branch."

        }

        }

        });


        // ============================================================
        // LOAD ACTIVE BRANCHES (REGISTER MODE ONLY)
        // ============================================================

        @if (!Model.IsEdit)
        {
            <text>

                function loadActiveBranches() {

                var select = $('#BranchId');


                select.empty();

                select.append(
                $('<option></option>')
                .val('')
                .text('Loading branches...')
                );


                $.ajax({

                url: '@Url.Action("GetActiveBranches", "Branch")',

                type: 'GET',

                dataType: 'json',

                timeout: 10000,


                success: function (data) {

                console.log(
                'Active Branch API Response:',
                data
                );


                select.empty();


                select.append(
                $('<option></option>')
                .val('')
                .text('-- Select Branch --')
                );


                if (
                Array.isArray(data) &&
                data.length > 0
                ) {

                $.each(
                data,
                function (index, branch) {

                console.log(
                'Branch object:',
                branch
                );


                var id =
                branch.branchId;

                var name =
                branch.branchName;

                var code =
                branch.branchCode;


                if (
                id !== undefined &&
                id !== null &&
                Number(id) > 0
                ) {

                var displayText =
                name ||
                'Unnamed Branch';


                if (code) {

                displayText =
                displayText +
                ' (' +
                code +
                ')';

                }


                var option =
                $('<option></option>');


                option
                .val(String(id))
                .text(displayText);


                select.append(option);


                console.log(
                'Added branch:',
                id,
                displayText
                );

                }
                else {

                console.warn(
                'Invalid branch received:',
                branch
                );

                }

                }
                );

                }
                else {

                select.empty();

                select.append(
                $('<option></option>')
                .val('')
                .text(
                'No active branches available'
                )
                );

                }


                console.log(
                'Final Branch Dropdown:',
                select.html()
                );

                },


                error: function (
                xhr,
                status,
                error
                ) {

                console.error(
                'Error loading active branches:',
                error
                );

                console.error(
                'Response:',
                xhr.responseText
                );


                select.empty();

                select.append(
                $('<option></option>')
                .val('')
                .text(
                'Error loading branches'
                )
                );

                }

                });

                }

            </text>
        }


        // ============================================================
        // FOCUS
        // ============================================================