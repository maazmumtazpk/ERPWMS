@model ERPWMS.Web.ViewModels.Department.RegisterDepartmentViewModel

@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-3">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">@Model.Title</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" id="editForm">
                        @Html.AntiForgeryToken()

                        <!-- ? CRITICAL: All hidden fields must include BranchId -->
                        <input type="hidden" asp-for="DepartmentId" />
                        <input type="hidden" asp-for="BranchId" />    <!-- ? ADDED - This was missing! -->
                        <input type="hidden" asp-for="CompanyId" />
                        <input type="hidden" asp-for="BranchName" />
                        <input type="hidden" asp-for="CompanyName" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                        }

                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                        }

                        <div class="row">
                            <!-- Department Name -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="DepartmentName" class="control-label font-weight-bold">
                                        <span class="text-danger">*</span> @Html.DisplayNameFor(m => m.DepartmentName)
                                    </label>
                                    <input asp-for="DepartmentName" class="form-control" placeholder="Enter department name" />
                                    <span asp-validation-for="DepartmentName" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Department Code -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="DepartmentCode" class="control-label font-weight-bold">
                                        @Html.DisplayNameFor(m => m.DepartmentCode)
                                    </label>
                                    <input asp-for="DepartmentCode" class="form-control" placeholder="Enter department code" />
                                    <span asp-validation-for="DepartmentCode" class="text-danger"></span>
                                    <small class="form-text text-muted">Optional. Use letters, numbers, hyphens, or underscores.</small>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Branch Name (Readonly) -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="BranchName" class="control-label font-weight-bold">
                                        @Html.DisplayNameFor(m => m.BranchName)
                                    </label>
                                    <input asp-for="BranchName" class="form-control" readonly disabled />
                                </div>
                            </div>

                            <!-- Company Name (Readonly) -->
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="CompanyName" class="control-label font-weight-bold">
                                        @Html.DisplayNameFor(m => m.CompanyName)
                                    </label>
                                    <input asp-for="CompanyName" class="form-control" readonly disabled />
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Is Active -->
                            <div class="col-md-12">
                                <div class="form-group form-check mt-2">
                                    <input asp-for="IsActive" class="form-check-input" />
                                    <label asp-for="IsActive" class="form-check-label font-weight-bold">
                                        @Html.DisplayNameFor(m => m.IsActive)
                                    </label>
                                </div>
                            </div>
                        </div>

                        <hr />

                        <!-- Buttons -->
                        <div class="form-group mt-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> @Model.SubmitButtonText
                            </button>
                            <a href="@Model.CancelUrl" class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Additional Information Card -->
            <div class="card mt-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="fas fa-info-circle"></i> Help</h5>
                </div>
                <div class="card-body">
                    <ul class="mb-0">
                        <li><strong>Department Name:</strong> Required field. Must be between 2 and 200 characters.</li>
                        <li><strong>Department Code:</strong> Optional. Use alphanumeric characters, hyphens, or underscores.</li>
                        <li><strong>Branch & Company:</strong> These fields are read-only. To change branch, contact your administrator.</li>
                        <li><strong>Is Active:</strong> Uncheck to deactivate this department.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // ? Debug - Check hidden fields values
            console.log('DepartmentId:', $('#DepartmentId').val());
            console.log('BranchId:', $('#BranchId').val());
            console.log('CompanyId:', $('#CompanyId').val());
            console.log('DepartmentName:', $('#DepartmentName').val());

            // Form validation
            $('#editForm').on('submit', function(e) {
                var isValid = true;
                var departmentName = $('#DepartmentName').val().trim();
                
                // ? Check if DepartmentId exists
                var deptId = $('#DepartmentId').val();
                if (!deptId || deptId === '0') {
                    alert('Invalid department ID. Please try again.');
                    e.preventDefault();
                    return false;
                }

                // ? Check if BranchId exists
                var branchId = $('#BranchId').val();
                if (!branchId || branchId === '0' || branchId === '') {
                    alert('Branch ID is missing. Please contact administrator.');
                    e.preventDefault();
                    return false;
                }
                
                if (!departmentName || departmentName.length < 2) {
                    isValid = false;
                    $('#DepartmentName').addClass('is-invalid');
                    $('#DepartmentName').next('.text-danger').text('Department Name must be between 2 and 200 characters.');
                } else {
                    $('#DepartmentName').removeClass('is-invalid');
                }

                if (!isValid) {
                    e.preventDefault();
                    return false;
                }

                // ? Log form data
                console.log('Submitting form with data:', $(this).serialize());
                return true;
            });

            // Clear validation on input
            $('#DepartmentName').on('input', function() {
                if ($(this).val().trim().length >= 2) {
                    $(this).removeClass('is-invalid');
                }
            });
        });
    </script>
    
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}