@{
    Layout = null;
}
<form id="addDeptForm" method="post" action="/Department/Register">
    @Html.AntiForgeryToken()
    <div id="addDeptAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-12">
            <label class="form-label fw-bold">Department Name *</label>
            <input type="text" name="departmentName" class="form-control" required maxlength="200" placeholder="Enter department name" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Department Code</label>
            <input type="text" name="departmentCode" class="form-control" maxlength="20" placeholder="DP-001" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Branch *</label>
            <select name="branchId" id="addBranchId" class="form-select" required>
                <option value="">Loading...</option>
            </select>
        </div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Register</button>
    </div>
</form>
<script>
    fetch('/Department/GetBranches').then(function(r){return r.json();}).then(function(d){
        var s=document.getElementById('addBranchId');
        if(!s)return;
        s.innerHTML='<option value="">-- Select Branch --</option>';
        (d||[]).forEach(function(b){var o=document.createElement('option');o.value=b.branchId;o.textContent=b.branchName;s.appendChild(o);});
    });
</script>