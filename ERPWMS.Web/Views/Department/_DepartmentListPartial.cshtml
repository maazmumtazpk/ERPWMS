@using ERPWMS.Application.DTOs.Department
@model IEnumerable<DepartmentSummaryResponse>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Code</th>
                    <th>Branch</th>
                    <th>Company</th>
                    <th>Status</th>
                    <th>Created Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var dept in Model)
                {
                    <tr>
                        <td><a href="@Url.Action("Profile", "Department", new { id = dept.DepartmentId })">@dept.DepartmentName</a></td>
                        <td>@(string.IsNullOrEmpty(dept.DepartmentCode) ? "N/A" : dept.DepartmentCode)</td>
                        <td>@dept.BranchName</td>
                        <td>@dept.CompanyName</td>
                        <td>
                            <span class="badge @(dept.IsActive ? "badge-success" : "badge-secondary")">
                                @(dept.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>@dept.CreatedDate.ToString("dd-MMM-yyyy")</td>
                        <td>
                            <a href="@Url.Action("Profile", "Department", new { id = dept.DepartmentId })" class="btn btn-sm btn-info" title="View Profile">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a href="@Url.Action("Edit", "Department", new { id = dept.DepartmentId })" class="btn btn-sm btn-warning" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No departments found.
    </div>
}


