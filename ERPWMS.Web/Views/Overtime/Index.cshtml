@{
    ViewData["Title"] = "Overtime";
    Layout = "_Layout";
}
<form id="__af" style="display:none;">@Html.AntiForgeryToken()</form>
<div class="toast-holder" id="toastHolder"></div>
@await Html.PartialAsync("_AdminCss")
<div style="padding-bottom:30px;">
<div class="table-card">
    <div class="card-header-custom">
        <h5><i class="bi bi-clock-history" style="color:#F5A623;"></i> Overtime Records</h5>
        <button type="button" class="btn-icon gold" onclick="openAdd()"><i class="bi bi-plus-circle"></i></button>
    </div>
    <div class="card-body">
        <table class="table-premium" id="xTable">
            <thead><tr><th>Employee</th><th>Date</th><th>OT Hrs</th><th>Rate</th><th>Mult</th><th>Amount</th><th>Type</th><th>Status</th><th style="text-align:right;">Actions</th></tr></thead>
            <tbody id="xBody"></tbody>
        </table>
    </div>
</div>
</div>
<div class="modal fade pm-modal" id="formModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5>Record Overtime</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">
<div class="row g-3">
<div class="col-12"><label class="form-label">Employee *</label><select id="employeeId" class="form-control"></select></div>
<div class="col-6"><label class="form-label">Date *</label><input type="date" id="overtimeDate" class="form-control" /></div>
<div class="col-6"><label class="form-label">OT Hours *</label><input type="number" id="otHours" class="form-control" value="2" step="0.5" min="0.5" /></div>
<div class="col-6"><div class="form-check form-switch" style="padding-top:22px;"><input class="form-check-input" type="checkbox" id="isHolidayWork" /><label class="form-check-label" for="isHolidayWork">Holiday Work (2x)</label></div></div>
<div class="col-6"><div class="form-check form-switch" style="padding-top:22px;"><input class="form-check-input" type="checkbox" id="isWeeklyOffWork" /><label class="form-check-label" for="isWeeklyOffWork">Weekly Off Work (2x)</label></div></div>
<div class="col-12"><label class="form-label">Remarks</label><textarea id="remarks" class="form-control" rows="2"></textarea></div>
</div>
</div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn-gold" onclick="save_()">Record</button></div></div></div></div>
@await Html.PartialAsync("_AdminJs")
<script>
function tk(){var i=document.querySelector('#__af input[name="__RequestVerificationToken"]');return i?i.value:'';}
function openAdd(){
    fetch('/Overtime/GetEmployees').then(function(r){return r.json();}).then(function(d){
        var e=document.getElementById('employeeId'); e.innerHTML='<option value="">-- Select --</option>';
        d.forEach(function(x){var o=document.createElement('option'); o.value=x.employeeId; o.textContent=x.employeeCode+' - '+x.fullName; e.appendChild(o);});
        document.getElementById('overtimeDate').value=new Date().toISOString().split('T')[0];
        new bootstrap.Modal(document.getElementById('formModal')).show();
    });
}
function save_(){
    var fd=new FormData();
    fd.append('__RequestVerificationToken',tk());
    fd.append('employeeId',document.getElementById('employeeId').value);
    fd.append('overtimeDate',document.getElementById('overtimeDate').value);
    fd.append('otHours',document.getElementById('otHours').value);
    fd.append('isHolidayWork',document.getElementById('isHolidayWork').checked);
    fd.append('isWeeklyOffWork',document.getElementById('isWeeklyOffWork').checked);
    fd.append('remarks',document.getElementById('remarks').value);
    fetch('/Overtime/Record',{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){
        if(res.success){showToast(res.message,'success'); bootstrap.Modal.getInstance(document.getElementById('formModal')).hide(); reload_();}
        else showToast(res.message,'error');
    });
}
function approve(id){var fd=new FormData(); fd.append('__RequestVerificationToken',tk()); fetch('/Overtime/Approve/'+id,{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){if(res.success){showToast(res.message,'success'); reload_();}});}
function reject(id){var fd=new FormData(); fd.append('__RequestVerificationToken',tk()); fetch('/Overtime/Reject/'+id,{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){if(res.success){showToast(res.message,'success'); reload_();}});}
function reload_(){
    fetch('/Overtime/GetAll').then(function(r){return r.json();}).then(function(d){
        var b=document.getElementById('xBody');
        if(!d||d.length===0){b.innerHTML='<tr><td colspan="9" class="text-center">No OT records</td></tr>'; return;}
        var h='';
        d.forEach(function(x){
            var cls=x.status==='Approved'?'active':(x.status==='Rejected'?'inactive':'role');
            var type = x.isHolidayWork?'Holiday':(x.isWeeklyOffWork?'Weekly Off':'-');
            h+='<tr><td>'+x.employeeName+'</td><td>'+x.overtimeDate+'</td><td>'+x.otHours+'</td><td>'+x.otRate.toFixed(2)+'</td><td>'+x.otMultiplier+'x</td><td>'+x.otAmount.toFixed(2)+'</td><td>'+type+'</td><td><span class="badge-status '+cls+'">'+x.status+'</span></td>';
            h+='<td style="text-align:right;">';
            if(x.status==='Pending'){h+='<button class="btn-icon" onclick="approve('+x.overtimeId+')"><i class="bi bi-check-circle"></i></button> <button class="btn-icon" onclick="reject('+x.overtimeId+')"><i class="bi bi-x-circle"></i></button>';}
            h+='</td></tr>';
        });
        b.innerHTML=h;
    });
}
document.addEventListener('DOMContentLoaded', reload_);
</script>
