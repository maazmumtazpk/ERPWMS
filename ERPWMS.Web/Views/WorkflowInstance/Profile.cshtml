@model ERPWMS.Database.Models.WorkflowInstance
@{
    ViewData["Title"] = "Instance Profile";
    Layout = "_Layout";
    var logs = ViewBag.Logs as System.Collections.Generic.List<ERPWMS.Database.Models.WorkflowInstanceLog> ?? new System.Collections.Generic.List<ERPWMS.Database.Models.WorkflowInstanceLog>();
}
<style>
.table-card{background:#fff;border:1px solid #edf0f4;border-radius:10px;box-shadow:0 2px 8px rgba(0,0,0,.04);margin-top:16px}
.card-header-custom{padding:10px 14px;border-bottom:2px solid #F1F5F9;display:flex;justify-content:space-between;align-items:center}
.card-header-custom h5{margin:0;font-size:12px;font-weight:700;color:#0A1628;display:flex;align-items:center;gap:6px}
.card-body{padding:16px 20px}
.badge-status{padding:2px 8px;border-radius:12px;font-size:9px;font-weight:700;text-transform:uppercase}
.badge-status.active{background:#DDF7F1;color:#118B7B}
.badge-status.inactive{background:#FEF2F2;color:#DC2626}
.badge-status.progress{background:#DBEAFE;color:#1D4ED8}
table.table-premium{margin:0;font-size:11px;width:100%;border-collapse:collapse}
table.table-premium thead{background:#F8FAFC;border-bottom:2px solid #E2E8F0}
table.table-premium thead th{padding:8px 14px;font-weight:700;font-size:9px;text-transform:uppercase;color:#64748B;text-align:left}
table.table-premium tbody td{padding:8px 14px;border-bottom:1px solid #F1F5F9;color:#0A1628;font-size:11px}
table.table-premium tbody tr:hover{background:#FEFBF5}
.btn-icon{width:32px;height:32px;border-radius:6px;border:1px solid #E8ECF1;display:inline-flex;align-items:center;justify-content:center;font-size:13px;color:#64748B;background:#fff;text-decoration:none;}
.btn-icon:hover{background:#F1F5F9;color:#0A1628;}
</style>

<div style="padding-bottom:30px;">
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0" style="color:#0A1628;">Instance Profile #@Model.WorkflowInstId</h4>
        <small class="text-muted">Home / Instances / #@Model.WorkflowInstId</small>
    </div>
    <a href="/WorkflowInstance/Index" class="btn-icon"><i class="bi bi-arrow-left"></i></a>
</div>

<div class="table-card" style="margin-top:0;">
    <div class="card-header-custom">
        <h5><i class="bi bi-play-circle" style="color:#F5A623;"></i> Instance Details</h5>
        @{ var st = Model.Status ?? "InProgress"; var cls = st == "Completed" ? "active" : (st == "Rejected" || st == "Cancelled" ? "inactive" : "progress"); }
        <span class="badge-status @cls">@st</span>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4"><div style="font-size:10px;color:#64748B;font-weight:600;text-transform:uppercase;">Workflow</div><div style="font-size:13px;font-weight:700;color:#0A1628;margin-top:4px;">@(Model.WorkflowDef?.WorkflowName ?? "-")</div></div>
            <div class="col-md-4"><div style="font-size:10px;color:#64748B;font-weight:600;text-transform:uppercase;">Current Stage</div><div style="font-size:13px;font-weight:700;color:#0A1628;margin-top:4px;">@(Model.CurrentStage?.StageName ?? "-")</div></div>
            <div class="col-md-4"><div style="font-size:10px;color:#64748B;font-weight:600;text-transform:uppercase;">Record</div><div style="font-size:13px;font-weight:700;color:#0A1628;margin-top:4px;">@(Model.RecordType ?? "-") #@Model.RecordId</div></div>
            <div class="col-md-4"><div style="font-size:10px;color:#64748B;font-weight:600;text-transform:uppercase;">Started</div><div style="font-size:13px;font-weight:700;color:#0A1628;margin-top:4px;">@(Model.StartedDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</div></div>
            <div class="col-md-4"><div style="font-size:10px;color:#64748B;font-weight:600;text-transform:uppercase;">Completed</div><div style="font-size:13px;font-weight:700;color:#0A1628;margin-top:4px;">@(Model.CompletedDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</div></div>
            <div class="col-md-4"><div style="font-size:10px;color:#64748B;font-weight:600;text-transform:uppercase;">Created</div><div style="font-size:13px;font-weight:700;color:#0A1628;margin-top:4px;">@(Model.CreatedDate?.ToString("dd MMM yyyy") ?? "-")</div></div>
        </div>
    </div>
</div>

<div class="table-card">
    <div class="card-header-custom">
        <h5><i class="bi bi-journal-text" style="color:#F5A623;"></i> Activity Timeline <span style="background:#F1F5F9;color:#64748B;font-size:9px;font-weight:700;padding:1px 8px;border-radius:12px;">@logs.Count</span></h5>
    </div>
    <div style="overflow-x:auto;">
        <table class="table-premium">
            <thead><tr><th>#</th><th>From</th><th>To</th><th>Action</th><th>User</th><th>Comments</th><th>Date</th></tr></thead>
            <tbody>
            @if (logs.Count == 0)
            {
                <tr><td colspan="7" style="text-align:center;padding:30px;color:#94A3B8;">No activity logs yet</td></tr>
            }
            else
            {
                var i = 1;
                foreach (var log in logs)
                {
                    <tr>
                        <td style="font-weight:600;color:#64748B;">@i</td>
                        <td>@(log.StageFrom?.StageName ?? "-")</td>
                        <td>@(log.StageTo?.StageName ?? "-")</td>
                        <td><span class="badge-status progress">@(log.Action?.ActionName ?? "-")</span></td>
                        <td>@(log.User?.UserName ?? "-")</td>
                        <td style="color:#64748B;font-size:10px;">@(log.Comments ?? "-")</td>
                        <td style="color:#64748B;font-size:10px;">@(log.ActionDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</td>
                    </tr>
                    i++;
                }
            }
            </tbody>
        </table>
    </div>
</div>
</div>
