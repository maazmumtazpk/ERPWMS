@model ERPWMS.Database.Models.CustomerFeedback
@{ Layout = null; }
<form id="editFeedbackForm" method="post" action="/CustomerFeedback/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="feedbackId" value="@Model.FeedbackId" />
    <div id="editFeedbackAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label fw-bold">Rating (1-5)</label><input type="number" name="rating" class="form-control" min="1" max="5" value="@(Model.Rating ?? 5)" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Category</label><input type="text" name="category" class="form-control" value="@Model.Category" maxlength="50" /></div>
        <div class="col-12"><label class="form-label fw-bold">Comments</label><textarea name="comments" class="form-control" rows="3">@Model.Comments</textarea></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>
