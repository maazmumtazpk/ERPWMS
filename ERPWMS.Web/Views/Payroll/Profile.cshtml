@model ERPWMS.Database.Models.EmployeePayroll
@{
    ViewData["Title"] = "Payroll Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string statusColor = Model.Status == "Paid" ? "#159A89" : Model.Status == "Approved" ? "#0EA5E9" : "#F5A623";
    string statusText = Model.Status ?? "Pending";
    var fullName = Model.Employee != null ? (Model.Employee.FirstName + " " + (Model.Employee.LastName ?? "")).Trim() : "N/A";
}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h3 class="mb-0 fw-bold" style="color:#0A1628;">Payroll Details</h3><small class="text-muted">Home / Payroll / @fullName</small></div>
        <div>
            <a href="/Payroll/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
            <button class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
        </div>
    </div>
    <div class="card shadow-sm mb-3" style="background:#0A1628;color:#fff;border:none;">
        <div class="card-body"><div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <div style="background:#F5A623;color:#0A1628;padding:14px;border-radius:10px;font-size:1.6rem;margin-right:16px;"><i class="bi bi-wallet2"></i></div>
                <div><h3 class="mb-1 fw-bold" style="color:#fff;">@fullName</h3>
                <div style="font-size:12px;color:#94A3B8;">@(Model.Employee?.EmployeeCode ?? "-") | Month: @Model.MonthYear.ToString("MMM yyyy")</div></div>
            </div>
            <div><span style="background:@statusColor;color:#fff;padding:6px 16px;border-radius:20px;font-size:11px;font-weight:700;text-transform:uppercase;">@statusText</span></div>
        </div></div>
    </div>
    <div class="row mb-3">
        <div class="col-md-6 mb-3 mb-md-0"><div class="card shadow-sm h-100"><div class="card-body">
            <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-person" style="color:#F5A623;"></i> Employee Information</h6>
            <table class="table table-sm mb-0" style="font-size:12px;">
                <tr><td style="color:#64748B;border:none;">Name</td><td class="text-end fw-bold" style="border:none;">@fullName</td></tr>
                <tr><td style="color:#64748B;border:none;">Code</td><td class="text-end fw-bold" style="border:none;">@(Model.Employee?.EmployeeCode ?? "-")</td></tr>
                <tr><td style="color:#64748B;border:none;">Month</td><td class="text-end fw-bold" style="border:none;">@Model.MonthYear.ToString("MMM yyyy")</td></tr>
                <tr><td style="color:#64748B;border:none;">Status</td><td class="text-end fw-bold" style="border:none;color:@statusColor;">@statusText</td></tr>
                <tr><td style="color:#64748B;border:none;">Payment Date</td><td class="text-end fw-bold" style="border:none;">@(Model.PaymentDate?.ToString("dd MMM yyyy") ?? "-")</td></tr>
            </table>
        </div></div></div>
        <div class="col-md-6"><div class="card shadow-sm h-100"><div class="card-body">
            <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-currency-dollar" style="color:#F5A623;"></i> Salary Breakdown</h6>
            <table class="table table-sm mb-0" style="font-size:12px;">
                <tr><td style="color:#64748B;border:none;">Gross Pay</td><td class="text-end fw-bold" style="border:none;">Rs @Model.GrossPay.ToString("N2")</td></tr>
                <tr><td style="color:#64748B;border:none;">Total Deductions</td><td class="text-end fw-bold" style="border:none;color:#DC2626;">Rs @((Model.TotalDeductions ?? 0).ToString("N2"))</td></tr>
                <tr style="background:#F0FDF4;"><td style="color:#0A1628;border:none;font-weight:700;">Net Pay</td><td class="text-end fw-bold" style="border:none;color:#059669;font-size:16px;">Rs @Model.NetPay.ToString("N2")</td></tr>
            </table>
        </div></div></div>
    </div>
    <div class="card shadow-sm"><div class="card-body">
        <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-people" style="color:#F5A623;"></i> Audit Information (Created / Approved / Updated)</h6>
        <div class="row" style="font-size:12px;">
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Created Date:</span> <strong>@(Model.CreatedDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</strong></div>
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Approved Date:</span> <strong>@(Model.ApprovedDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</strong></div>
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Updated Date:</span> <strong>@(Model.UpdatedDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</strong></div>
        </div>
    </div></div>
</div>

