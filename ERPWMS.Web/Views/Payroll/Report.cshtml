@model List<ERPWMS.Application.DTOs.Payroll.PayrollReportDto>

@{
    ViewData["Title"] = "Payroll Report";
    Layout = "_Layout";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2>Payroll Report</h2>
        <p class="text-muted">
            Filter and review payroll records
        </p>
    </div>


    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Report"
                  method="post">

                <div class="row g-3">

                    <div class="col-md-3">

                        <label class="form-label">
                            Department ID
                        </label>

                        <input type="number"
                               name="DepartmentId"
                               class="form-control" />

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            Employee ID
                        </label>

                        <input type="number"
                               name="EmployeeId"
                               class="form-control" />

                    </div>

                    <div class="col-md-2">

                        <label class="form-label">
                            From
                        </label>

                        <input type="date"
                               name="PeriodStart"
                               class="form-control" />

                    </div>

                    <div class="col-md-2">

                        <label class="form-label">
                            To
                        </label>

                        <input type="date"
                               name="PeriodEnd"
                               class="form-control" />

                    </div>

                    <div class="col-md-2">

                        <label class="form-label">
                            Status
                        </label>

                        <select name="Status"
                                class="form-select">

                            <option value="">
                                All
                            </option>

                            <option value="Draft">
                                Draft
                            </option>

                            <option value="Submitted">
                                Submitted
                            </option>

                            <option value="Approved">
                                Approved
                            </option>

                            <option value="Paid">
                                Paid
                            </option>

                            <option value="Cancelled">
                                Cancelled
                            </option>

                        </select>

                    </div>

                </div>

                <div class="mt-3">

                    <button type="submit"
                            class="btn btn-primary">
                        Search
                    </button>

                </div>

            </form>

        </div>

    </div>


    @if (Model != null)
    {
        <div class="card shadow-sm">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead>
                            <tr>
                                <th>Payroll</th>
                                <th>Employee</th>
                                <th>Month</th>
                                <th>Gross</th>
                                <th>Deductions</th>
                                <th>Net</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.PayrollId
                                    </td>

                                    <td>
                                        @item.EmployeeName
                                    </td>

                                    <td>
                                        @item.MonthYear
                                    </td>

                                    <td>
                                        @item.GrossPay.ToString("N2")
                                    </td>

                                    <td>
                                        @item.TotalDeductions.ToString("N2")
                                    </td>

                                    <td>
                                        @item.NetPay.ToString("N2")
                                    </td>

                                    <td>
                                        @item.Status
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>
