@{ Layout = null; }
<form id="addCondForm" method="post" action="/WorkflowCondition/QuickAdd">
    @Html.AntiForgeryToken()
    <div id="addCondAlert" style="display:none;padding:8px 10px;border-radius:6px;font-size:11px;margin-bottom:12px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-2">
        <div class="col-12"><label class="form-label fw-bold">Workflow *</label><select name="workflowDefId" id="addWF" class="form-select form-select-sm" required><option value="">-- Select Workflow --</option></select></div>
        <div class="col-md-6"><label class="form-label fw-bold">From Stage *</label><select name="stageFromId" id="addFrom" class="form-select form-select-sm" required><option value="">-- Select Workflow First --</option></select></div>
        <div class="col-md-6"><label class="form-label fw-bold">To Stage *</label><select name="stageToId" id="addTo" class="form-select form-select-sm" required><option value="">-- Select Workflow First --</option></select></div>
        <div class="col-md-6"><label class="form-label fw-bold">Field Name</label><input type="text" name="conditionType" class="form-control form-control-sm" maxlength="100" placeholder="Amount, Status..." /></div>
        <div class="col-md-3"><label class="form-label fw-bold">Operator</label><select name="operatorName" class="form-select form-select-sm"><option value="=">=</option><option value=">">&gt;</option><option value="<">&lt;</option><option value=">=">&gt;=</option><option value="<=">&lt;=</option></select></div>
        <div class="col-md-3"><label class="form-label fw-bold">Value</label><input type="text" name="value" class="form-control form-control-sm" maxlength="100" /></div>
        <div class="col-md-12"><label class="form-label fw-bold">Action on Fail</label><input type="text" name="actionOnFail" class="form-control form-control-sm" maxlength="50" placeholder="Reject / Hold / Allow" value="Allow" /></div>
    </div>
    <div style="padding:10px 0 0;border-top:1px solid #eef2f6;margin-top:10px;display:flex;justify-content:flex-end;gap:6px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Create</button>
    </div>
</form>
<script>
fetch("/WorkflowCondition/GetWorkflows").then(function(r){return r.json();}).then(function(d){
    var s=document.getElementById("addWF");if(!s)return;
    s.innerHTML="<option value=''>-- Select Workflow --</option>";
    (d||[]).forEach(function(x){var o=document.createElement("option");o.value=x.workflowDefId;o.textContent=x.workflowName;s.appendChild(o);});
}).catch(function(){});
document.getElementById("addWF").addEventListener("change",function(){
    var wid=this.value;
    var f=document.getElementById("addFrom");
    var t=document.getElementById("addTo");
    f.innerHTML="<option value=''>Loading...</option>";
    t.innerHTML="<option value=''>Loading...</option>";
    if(!wid)return;
    fetch("/WorkflowCondition/GetStages?workflowDefId="+wid).then(function(r){return r.json();}).then(function(d){
        f.innerHTML="<option value=''>-- Select --</option>";
        t.innerHTML="<option value=''>-- Select --</option>";
        (d||[]).forEach(function(x){
            var o1=document.createElement("option");o1.value=x.stageId;o1.textContent=x.stageName;f.appendChild(o1);
            var o2=document.createElement("option");o2.value=x.stageId;o2.textContent=x.stageName;t.appendChild(o2);
        });
    });
});
</script>
