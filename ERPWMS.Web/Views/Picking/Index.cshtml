
@model IEnumerable<ERPWMS.Application.DTOs.Sales.PickingListDto>

@{
    ViewData["Title"] = "Picking Lists";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currentStatus = ViewBag.CurrentStatus as string;
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>?? Picking Lists</h2>

        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Create Picking List
        </a>
    </div>

    <!-- Search & Filter -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form method="get" class="row g-3">

                <div class="col-md-3">
                    <label class="form-label">Search</label>

                    <input type="text"
                           name="searchTerm"
                           class="form-control"
                           placeholder="Search by Picking No, Sales Order..."
                           value="@searchTerm" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">Status</label>

                    <select name="status" class="form-select">
                        <option value="">All</option>

                        @foreach (var s in ViewBag.Statuses as string[] ?? Array.Empty<string>())
                        {
                            <option value="@s" selected="@(s == currentStatus)">
                                @s
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">From Date</label>

                    <input type="date"
                           name="fromDate"
                           class="form-control" />
                </div>

                <div class="col-md-2">
                    <label class="form-label">To Date</label>

                    <input type="date"
                           name="toDate"
                           class="form-control" />
                </div>

                <div class="col-md-3 d-flex align-items-end gap-2">

                    <button type="submit"
                            class="btn btn-primary w-50">

                        <i class="bi bi-search"></i>
                        Filter

                    </button>

                    <a asp-action="Index"
                           class="btn btn-secondary w-50">

                        Clear

                    </a>

                </div>

            </form>

        </div>
    </div>

    @* Success Message *@
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    @* Error Message *@
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover table-striped mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>Picking No</th>
                            <th>Sales Order</th>
                            <th>Picking Date</th>
                            <th>Status</th>
                            <th>Assigned To</th>
                            <th>Created By</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>@item.PickingNo</strong>
                                    </td>

                                    <td>
                                        @item.SalesOrderNo
                                    </td>

                                    <td>
                                        @item.PickingDate?.ToString("dd-MMM-yyyy")
                                    </td>

                                    <td>
                                        @{
                                            var statusClass = item.Status switch
                                            {
                                                "Draft" => "bg-secondary",
                                                "Assigned" => "bg-primary",
                                                "Picked" => "bg-warning text-dark",
                                                "Verified" => "bg-success",
                                                "Completed" => "bg-info",
                                                "Cancelled" => "bg-dark",
                                                _ => "bg-secondary"
                                            };
                                        }

                                        <span class="badge @statusClass">
                                            @item.Status
                                        </span>
                                    </td>

                                    <td>
                                        @item.AssignedToName
                                    </td>

                                    <td>
                                        @item.CreatedBy
                                    </td>

                                    <td>

                                        <div class="btn-group btn-group-sm">

                                            <a asp-action="Details"
                                                   asp-route-id="@item.PickingId"
                                                   class="btn btn-outline-info">

                                                <i class="bi bi-eye"></i>

                                            </a>

                                            @if (item.Status == "Draft" ||
                                                                                             item.Status == "Assigned")
                                            {
                                                <a asp-action="Edit"
                                                       asp-route-id="@item.PickingId"
                                                       class="btn btn-outline-primary">

                                                    <i class="bi bi-pencil"></i>

                                                </a>
                                            }

                                            @if (item.Status == "Draft")
                                            {
                                                <button type="button"
                                                        class="btn btn-outline-danger"
                                                        onclick="deletePicking(@item.PickingId, '@item.PickingNo')">

                                                    <i class="bi bi-trash"></i>

                                                </button>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center py-4 text-muted">

                                    <i class="bi bi-inbox display-6 d-block"></i>

                                    No picking lists found.

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<!-- Delete Modal -->
<div class="modal fade"
     id="deleteModal"
     tabindex="-1">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Confirm Delete
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <div class="modal-body">

                <p>
                    Are you sure you want to delete
                    <strong id="deletePickingName"></strong>?
                </p>

                <p class="text-danger small">
                    This action cannot be undone.
                    Only Draft picking lists can be deleted.
                </p>

            </div>

            <div class="modal-footer">

                <form id="deleteForm"
                      method="post"
                      asp-action="Delete">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="id"
                           id="deletePickingId" />

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-danger">

                        Delete

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script>
        function deletePicking(id, name) {
            document.getElementById('deletePickingId').value = id;
            document.getElementById('deletePickingName').textContent = name;

            var modal = new bootstrap.Modal(
                document.getElementById('deleteModal')
            );

            modal.show();
        }
    </script>
}






