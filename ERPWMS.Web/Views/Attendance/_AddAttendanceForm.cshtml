@{ Layout = null; }
<form id="addAttendanceForm" method="post" action="/Attendance/Register">
    @Html.AntiForgeryToken()
    <div id="addAttendanceAlert" style="display:none;padding:8px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Employee *</label>
            <select name="employeeId" id="addEmp" class="form-select form-select-sm" required style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;">
                <option value="">-- Select Employee --</option>
            </select>
        </div>
        <div class="col-md-6">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Date *</label>
            <input type="date" name="attendanceDate" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")" required style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;" />
        </div>
        <div class="col-md-4">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Status *</label>
            <select name="status" class="form-select form-select-sm" required style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;">
                <option value="Present">Present</option>
                <option value="Late">Late</option>
                <option value="Absent">Absent</option>
                <option value="Leave">Leave</option>
                <option value="HalfDay">Half Day</option>
            </select>
        </div>
        <div class="col-md-4">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Check In</label>
            <input type="time" name="checkInTime" class="form-control form-control-sm" style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;" />
        </div>
        <div class="col-md-4">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Check Out</label>
            <input type="time" name="checkOutTime" class="form-control form-control-sm" style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;" />
        </div>
        <div class="col-md-4">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Overtime (Hrs)</label>
            <input type="number" name="overtimeHours" class="form-control form-control-sm" step="0.5" min="0" value="0" style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;" />
        </div>
        <div class="col-md-4">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Shift</label>
            <select name="shiftId" id="addShift" class="form-select form-select-sm" style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;">
                <option value="">-- Select Shift --</option>
            </select>
        </div>
    </div>

    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:14px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-sm" style="background:#F5A623;color:#0A1628;font-weight:700;border:none;">Save</button>
    </div>
</form>
<script>
    fetch("/Attendance/GetEmployees").then(r=>r.json()).then(d=>{
        var s=document.getElementById("addEmp");
        s.innerHTML="<option value=''>-- Select Employee --</option>";
        (d||[]).forEach(function(x){ var o=document.createElement("option"); o.value=x.employeeId; o.textContent=x.employeeName; s.appendChild(o); });
    });
    fetch("/Attendance/GetShifts").then(r=>r.json()).then(d=>{
        var s=document.getElementById("addShift");
        s.innerHTML="<option value=''>-- Select Shift --</option>";
        (d||[]).forEach(function(x){ var o=document.createElement("option"); o.value=x.shiftId; o.textContent=x.shiftName; s.appendChild(o); });
    }).catch(function(){});
</script>
