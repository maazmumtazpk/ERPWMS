@model ERPWMS.Database.Models.EmployeeAttendance
@{ Layout = null; }
<form id="editAttendanceForm" method="post" action="/Attendance/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="attendanceId" value="@Model.AttendanceId" />
    <div id="editAttendanceAlert" style="display:none;padding:8px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Employee</label>
            <input type="text" class="form-control form-control-sm" value="@(Model.Employee != null ? (Model.Employee.FirstName + " " + (Model.Employee.LastName ?? "")).Trim() : "-")" readonly style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;background:#f1f5f9;" />
        </div>
        <div class="col-md-6">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Date</label>
            <input type="text" class="form-control form-control-sm" value="@Model.AttendanceDate.ToString("dd MMM yyyy")" readonly style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;background:#f1f5f9;" />
        </div>
        <div class="col-md-4">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Status *</label>
            <select name="status" class="form-select form-select-sm" required style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;">
                <option value="Present" selected="@(Model.Status=="Present")">Present</option>
                <option value="Late" selected="@(Model.Status=="Late")">Late</option>
                <option value="Absent" selected="@(Model.Status=="Absent")">Absent</option>
                <option value="Leave" selected="@(Model.Status=="Leave")">Leave</option>
                <option value="HalfDay" selected="@(Model.Status=="HalfDay")">Half Day</option>
            </select>
        </div>
        <div class="col-md-4">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Check In</label>
            <input type="time" name="checkInTime" value="@(Model.CheckInTime?.ToString("HH\\:mm"))" class="form-control form-control-sm" style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;" />
        </div>
        <div class="col-md-4">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Check Out</label>
            <input type="time" name="checkOutTime" value="@(Model.CheckOutTime?.ToString("HH\\:mm"))" class="form-control form-control-sm" style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;" />
        </div>
        <div class="col-md-4">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Overtime (Hrs)</label>
            <input type="number" name="overtimeHours" value="@(Model.OvertimeHours ?? 0)" class="form-control form-control-sm" step="0.5" min="0" style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;" />
        </div>
        <div class="col-md-4">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Shift</label>
            <select name="shiftId" id="editShift" class="form-select form-select-sm" style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;" data-sel="@(Model.ShiftId ?? 0)">
                <option value="">-- Select Shift --</option>
            </select>
        </div>
    </div>

    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:14px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-sm" style="background:#F5A623;color:#0A1628;font-weight:700;border:none;">Update</button>
    </div>
</form>
<script>
    fetch("/Attendance/GetShifts").then(r=>r.json()).then(d=>{
        var s=document.getElementById("editShift");
        var sel = parseInt(s.getAttribute("data-sel") || "0");
        s.innerHTML="<option value=''>-- Select Shift --</option>";
        (d||[]).forEach(function(x){ var o=document.createElement("option"); o.value=x.shiftId; o.textContent=x.shiftName; if(sel === parseInt(x.shiftId)) o.selected=true; s.appendChild(o); });
    }).catch(function(){});
</script>
