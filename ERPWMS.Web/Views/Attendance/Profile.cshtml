@model ERPWMS.Database.Models.EmployeeAttendance
@{
    ViewData["Title"] = "Attendance Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string statusColor = Model.Status == "Present" ? "#159A89" : Model.Status == "Late" ? "#F5A623" : Model.Status == "Absent" ? "#DC2626" : "#94A3B8";
    string statusText = Model.Status ?? "Pending";
    var fullName = Model.Employee != null ? (Model.Employee.FirstName + " " + (Model.Employee.LastName ?? "")).Trim() : "N/A";
}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h3 class="mb-0 fw-bold" style="color:#0A1628;">Attendance Details</h3><small class="text-muted">Home / Attendance / @fullName</small></div>
        <div>
            <a href="/Attendance/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
            <button class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
        </div>
    </div>
    <div class="card shadow-sm mb-3" style="background:#0A1628;color:#fff;border:none;">
        <div class="card-body"><div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <div style="background:#F5A623;color:#0A1628;padding:14px;border-radius:10px;font-size:1.6rem;margin-right:16px;"><i class="bi bi-calendar-check"></i></div>
                <div><h3 class="mb-1 fw-bold" style="color:#fff;">@fullName</h3>
                <div style="font-size:12px;color:#94A3B8;">@(Model.Employee?.EmployeeCode ?? "-") | @Model.AttendanceDate.ToString("dd MMM yyyy")</div></div>
            </div>
            <div><span style="background:@statusColor;color:#fff;padding:6px 16px;border-radius:20px;font-size:11px;font-weight:700;text-transform:uppercase;">@statusText</span></div>
        </div></div>
    </div>
    <div class="row mb-3">
        <div class="col-md-6 mb-3 mb-md-0"><div class="card shadow-sm h-100"><div class="card-body">
            <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-person" style="color:#F5A623;"></i> Employee Information</h6>
            <table class="table table-sm mb-0" style="font-size:12px;">
                <tr><td style="color:#64748B;border:none;">Name</td><td class="text-end fw-bold" style="border:none;">@fullName</td></tr>
                <tr><td style="color:#64748B;border:none;">Code</td><td class="text-end fw-bold" style="border:none;font-family:monospace;">@(Model.Employee?.EmployeeCode ?? "-")</td></tr>
                <tr><td style="color:#64748B;border:none;">Date</td><td class="text-end fw-bold" style="border:none;">@Model.AttendanceDate.ToString("dd MMM yyyy")</td></tr>
                <tr><td style="color:#64748B;border:none;">Status</td><td class="text-end fw-bold" style="border:none;color:@statusColor;">@statusText</td></tr>
            </table>
        </div></div></div>
        <div class="col-md-6"><div class="card shadow-sm h-100"><div class="card-body">
            <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-clock-history" style="color:#F5A623;"></i> Time Details</h6>
            <table class="table table-sm mb-0" style="font-size:12px;">
                <tr><td style="color:#64748B;border:none;">Check In</td><td class="text-end fw-bold" style="border:none;">@(Model.CheckInTime?.ToString("hh\\:mm") ?? "-")</td></tr>
                <tr><td style="color:#64748B;border:none;">Check Out</td><td class="text-end fw-bold" style="border:none;">@(Model.CheckOutTime?.ToString("hh\\:mm") ?? "-")</td></tr>
                <tr><td style="color:#64748B;border:none;">Overtime</td><td class="text-end fw-bold" style="border:none;color:#F5A623;">@(Model.OvertimeHours?.ToString("N2") ?? "0") hrs</td></tr>
                <tr><td style="color:#64748B;border:none;">Shift</td><td class="text-end fw-bold" style="border:none;">@(Model.ShiftId.HasValue ? "Assigned" : "Not Assigned")</td></tr>
            </table>
        </div></div></div>
    </div>
    <div class="card shadow-sm"><div class="card-body">
        <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-people" style="color:#F5A623;"></i> Audit Information</h6>
        <div class="row" style="font-size:12px;">
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Created By:</span> <strong>@(ViewBag.CreatedBy ?? "N/A")</strong></div>
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Created Date:</span> <strong>@(Model.CreatedDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</strong></div>
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Updated By:</span> <strong>@(ViewBag.UpdatedBy ?? "-")</strong></div>
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Updated Date:</span> <strong>@(Model.UpdatedDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</strong></div>
        </div>
    </div></div>
</div>

