@model ERPWMS.Application.DTOs.Product.RegisterProductDto

@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Create Product";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var categoryList = ViewBag.CategoryList as SelectList;
    var subCategoryList = ViewBag.SubCategoryList as SelectList;
    var brandList = ViewBag.BrandList as SelectList;
    var unitList = ViewBag.UnitList as SelectList;
}

<div class="container-fluid">

    <div class="row">

        <div class="col-md-10 offset-md-1">

            <div class="card">

                <!-- ================================================= -->
                <!-- HEADER -->
                <!-- ================================================= -->

                <div class="card-header">

                    <h3 class="card-title">
                        <i class="fas fa-plus-circle"></i>
                        Create Product
                    </h3>

                    <div class="card-tools">

                        <a asp-controller="Product"
                               asp-action="Index"
                               class="btn btn-secondary btn-sm">

                            <i class="fas fa-arrow-left"></i>
                            Back

                        </a>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- BODY -->
                <!-- ================================================= -->

                <div class="card-body">

                    <form asp-controller="Product"
                          asp-action="Register"
                          method="post"
                          id="productForm"
                          autocomplete="off">

                        @Html.AntiForgeryToken()


                        <!-- ================================================= -->
                        <!-- VALIDATION -->
                        <!-- ================================================= -->

                        <div asp-validation-summary="All"
                             class="alert alert-danger"
                             role="alert">
                        </div>


                        <!-- ================================================= -->
                        <!-- BASIC INFORMATION -->
                        <!-- ================================================= -->

                        <div class="row">

                            <div class="col-md-12">

                                <h5 class="text-primary">

                                    <i class="fas fa-info-circle"></i>

                                    Basic Information

                                </h5>

                                <hr />

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- CATEGORY / SUB CATEGORY -->
                        <!-- ================================================= -->

                        <div class="row">

                            <!-- CATEGORY -->

                            <div class="col-md-6">

                                <div class="form-group">

                                    <label asp-for="CategoryId"
                                           class="control-label required">

                                        Category

                                    </label>

                                    <select asp-for="CategoryId"
                                            class="form-control"
                                            id="categoryId">

                                        <option value="0">
                                            -- Select Category --
                                        </option>

                                        @if (categoryList != null)
                                        {
                                            foreach (var category in categoryList)
                                            {
                                                <option value="@category.Value">
                                                    @category.Text
                                                </option>
                                            }
                                        }

                                    </select>

                                    <span asp-validation-for="CategoryId"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- SUB CATEGORY -->

                            <div class="col-md-6">

                                <div class="form-group">

                                    <label asp-for="SubCategoryId"
                                           class="control-label required">

                                        Sub Category

                                    </label>

                                    <select asp-for="SubCategoryId"
                                            class="form-control"
                                            id="subCategoryId">

                                        @if (subCategoryList != null)
                                        {
                                            <option value="0">
                                                -- Select Sub Category --
                                            </option>

                                            foreach (var subCategory in subCategoryList)
                                            {
                                                <option value="@subCategory.Value">
                                                    @subCategory.Text
                                                </option>
                                            }
                                        }
                                        else
                                        {
                                            <option value="0">
                                                -- Select Category First --
                                            </option>
                                        }

                                    </select>

                                    <span asp-validation-for="SubCategoryId"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- BRAND / UNIT -->
                        <!-- ================================================= -->

                        <div class="row">

                            <!-- BRAND -->

                            <div class="col-md-6">

                                <div class="form-group">

                                    <label asp-for="BrandId"
                                           class="control-label required">

                                        Brand

                                    </label>

                                    <select asp-for="BrandId"
                                            class="form-control"
                                            asp-items="brandList">

                                        <option value="0">
                                            -- Select Brand --
                                        </option>

                                    </select>

                                    <span asp-validation-for="BrandId"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- UNIT -->

                            <div class="col-md-6">

                                <div class="form-group">

                                    <label asp-for="UnitId"
                                           class="control-label required">

                                        Unit

                                    </label>

                                    <select asp-for="UnitId"
                                            class="form-control"
                                            asp-items="unitList">

                                        <option value="0">
                                            -- Select Unit --
                                        </option>

                                    </select>

                                    <span asp-validation-for="UnitId"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- PRODUCT NAME -->
                        <!-- ================================================= -->

                        <div class="row">

                            <div class="col-md-12">

                                <div class="form-group">

                                    <label asp-for="ProductName"
                                           class="control-label required">

                                        Product Name

                                    </label>

                                    <input asp-for="ProductName"
                                           class="form-control"
                                           placeholder="Enter product name"
                                           maxlength="200" />

                                    <span asp-validation-for="ProductName"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- SKU / BARCODE / QR -->
                        <!-- ================================================= -->

                        <div class="row">

                            <!-- SKU -->

                            <div class="col-md-4">

                                <div class="form-group">

                                    <label asp-for="SKU"
                                           class="control-label required">

                                        SKU

                                    </label>

                                    <input asp-for="SKU"
                                           class="form-control"
                                           id="SKU"
                                           placeholder="Enter SKU"
                                           maxlength="100" />

                                    <span asp-validation-for="SKU"
                                          class="text-danger">
                                    </span>

                                    <small class="form-text text-muted">
                                        Unique Identifier
                                    </small>

                                    <small id="skuMessage"
                                           class="d-block mt-1">
                                    </small>

                                </div>

                            </div>


                            <!-- BARCODE -->

                            <div class="col-md-4">

                                <div class="form-group">

                                    <label asp-for="Barcode"
                                           class="control-label">

                                        Barcode

                                    </label>

                                    <input asp-for="Barcode"
                                           class="form-control"
                                           placeholder="Enter barcode (optional)"
                                           maxlength="100" />

                                    <span asp-validation-for="Barcode"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- QR CODE -->

                            <div class="col-md-4">

                                <div class="form-group">

                                    <label asp-for="QRCode"
                                           class="control-label">

                                        QR Code

                                    </label>

                                    <input asp-for="QRCode"
                                           class="form-control"
                                           placeholder="Enter QR code (optional)"
                                           maxlength="200" />

                                    <span asp-validation-for="QRCode"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- DESCRIPTION -->
                        <!-- ================================================= -->

                        <div class="row">

                            <div class="col-md-12">

                                <div class="form-group">

                                    <label asp-for="Description"
                                           class="control-label">

                                        Description

                                    </label>

                                    <textarea asp-for="Description"
                                              class="form-control"
                                              rows="3"
                                                  placeholder="Enter product description (optional)">
                                    </textarea>

                                        <span asp-validation-for="Description"
                                              class="text-danger">
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <!-- ================================================= -->
                            <!-- PHYSICAL DIMENSIONS -->
                            <!-- ================================================= -->

                            <div class="row mt-3">

                                <div class="col-md-12">

                                    <h5 class="text-primary">

                                        <i class="fas fa-ruler"></i>

                                        Physical Dimensions

                                    </h5>

                                    <hr />

                                </div>

                            </div>


                            <div class="row">

                                <!-- WEIGHT -->

                                <div class="col-md-3">

                                    <div class="form-group">

                                        <label asp-for="Weight"
                                               class="control-label">Weight (kg)</label>

                                        <input asp-for="Weight"
                                               type="number"
                                               step="0.01"
                                               min="0"
                                               class="form-control"
                                               placeholder="e.g. 8.5 kg" />

                                        <span asp-validation-for="Weight"
                                              class="text-danger">
                                        </span>

                                        <small class="form-text text-muted">
                                            In kilograms
                                        </small>

                                    </div>

                                </div>


                                <!-- LENGTH -->

                                <div class="col-md-3">

                                    <div class="form-group">

                                        <label asp-for="Length"
                                               class="control-label">Length (cm)</label>

                                        <input asp-for="Length"
                                               type="number"
                                               step="0.01"
                                               min="0"
                                               class="form-control"
                                               placeholder="e.g. 97 cm" />

                                        <span asp-validation-for="Length"
                                              class="text-danger">
                                        </span>

                                        <small class="form-text text-muted">
                                            In centimeters
                                        </small>

                                    </div>

                                </div>


                                <!-- WIDTH -->

                                <div class="col-md-3">

                                    <div class="form-group">

                                        <label asp-for="Width"
                                               class="control-label">Width (cm)</label>

                                        <input asp-for="Width"
                                               type="number"
                                               step="0.01"
                                               min="0"
                                               class="form-control"
                                               placeholder="e.g. 45 cm" />

                                        <span asp-validation-for="Width"
                                              class="text-danger">
                                        </span>

                                        <small class="form-text text-muted">
                                            In centimeters
                                        </small>

                                    </div>

                                </div>


                                <!-- HEIGHT -->

                                <div class="col-md-3">

                                    <div class="form-group">

                                        <label asp-for="Height"
                                               class="control-label">Height (cm)</label>

                                        <input asp-for="Height"
                                               type="number"
                                               step="0.01"
                                               min="0"
                                               class="form-control"
                                               placeholder="e.g. 6 cm" />

                                        <span asp-validation-for="Height"
                                              class="text-danger">
                                        </span>

                                        <small class="form-text text-muted">
                                            In centimeters
                                        </small>

                                    </div>

                                </div>

                            </div>


                            <!-- ================================================= -->
                            <!-- STOCK LEVELS -->
                            <!-- ================================================= -->

                            <div class="row mt-3">

                                <div class="col-md-12">

                                    <h5 class="text-primary">

                                        <i class="fas fa-warehouse"></i>

                                        Stock Levels

                                    </h5>

                                    <hr />

                                </div>

                            </div>


                            <div class="row">

                                <!-- MIN -->

                                <div class="col-md-4">

                                    <div class="form-group">

                                        <label asp-for="MinStockLevel"
                                               class="control-label">

                                            Minimum Stock

                                        </label>

                                        <input asp-for="MinStockLevel"
                                               type="number"
                                               min="0"
                                               class="form-control"
                                               placeholder="Minimum quantity" />

                                        <span asp-validation-for="MinStockLevel"
                                              class="text-danger">
                                        </span>

                                    </div>

                                </div>


                                <!-- MAX -->

                                <div class="col-md-4">

                                    <div class="form-group">

                                        <label asp-for="MaxStockLevel"
                                               class="control-label">

                                            Maximum Stock

                                        </label>

                                        <input asp-for="MaxStockLevel"
                                               type="number"
                                               min="0"
                                               class="form-control"
                                               placeholder="Maximum quantity" />

                                        <span asp-validation-for="MaxStockLevel"
                                              class="text-danger">
                                        </span>

                                    </div>

                                </div>


                                <!-- REORDER -->

                                <div class="col-md-4">

                                    <div class="form-group">

                                        <label asp-for="ReorderLevel"
                                               class="control-label">

                                            Reorder Level

                                        </label>

                                        <input asp-for="ReorderLevel"
                                               type="number"
                                               min="0"
                                               class="form-control"
                                               placeholder="Reorder quantity" />

                                        <span asp-validation-for="ReorderLevel"
                                              class="text-danger">
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <!-- ================================================= -->
                            <!-- ADDITIONAL SETTINGS -->
                            <!-- ================================================= -->

                            <div class="row mt-3">

                                <div class="col-md-12">

                                    <h5 class="text-primary">

                                        <i class="fas fa-cog"></i>

                                        Additional Settings

                                    </h5>

                                    <hr />

                                </div>

                            </div>


                            <div class="row">

                                <!-- SERIALIZED -->

                                <div class="col-md-4">

                                    <div class="form-group">

                                        <div class="custom-control custom-switch">

                                            <input asp-for="IsSerialized"
                                                   type="checkbox"
                                                   class="custom-control-input"
                                                   id="IsSerialized" />

                                            <label asp-for="IsSerialized"
                                                   class="custom-control-label">

                                                Is Serialized

                                            </label>

                                        </div>

                                    </div>

                                </div>


                                <!-- BATCH -->

                                <div class="col-md-4">

                                    <div class="form-group">

                                        <div class="custom-control custom-switch">

                                            <input asp-for="IsBatchManaged"
                                                   type="checkbox"
                                                   class="custom-control-input"
                                                   id="IsBatchManaged" />

                                            <label asp-for="IsBatchManaged"
                                                   class="custom-control-label">

                                                Is Batch Managed

                                            </label>

                                        </div>

                                    </div>

                                </div>


                                <!-- ACTIVE -->

                                <div class="col-md-4">

                                    <div class="form-group">

                                        <div class="custom-control custom-switch">

                                            <input asp-for="IsActive"
                                                   type="checkbox"
                                                   class="custom-control-input"
                                                   id="IsActive" />

                                            <label asp-for="IsActive"
                                                   class="custom-control-label">

                                                Is Active

                                            </label>

                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- ================================================= -->
                            <!-- BUTTONS -->
                            <!-- ================================================= -->

                            <div class="form-group mt-4">

                                <button type="submit"
                                        id="saveProductBtn"
                                        class="btn btn-primary">

                                    <i class="fas fa-save"></i>

                                    <span id="saveButtonText">
                                        Save Product
                                    </span>

                                </button>


                                <a asp-controller="Product"
                                       asp-action="Index"
                                       class="btn btn-secondary">

                                    <i class="fas fa-times"></i>

                                    Cancel

                                </a>

                            </div>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>


    @section Scripts {

        @await Html.PartialAsync("_ValidationScriptsPartial")

        <script>

            $(document).ready(function () {

                // =========================================================
                // URLS
                // =========================================================

                var subCategoryUrl =
                    '@Url.Action(
                                                "GetSubCategories",
                                                "Product",
                                        new { categoryId = "__CATEGORY_ID__" }
                                )';

                var checkSkuUrl =
                    '@Url.Action(
                                                "CheckSKU",
                                                "Product"
                                )';


                // =========================================================
                // CATEGORY -> SUB CATEGORY
                // =========================================================

                $('#categoryId').on('change', function () {

                    var categoryId = $(this).val();

                    var subCategorySelect =
                        $('#subCategoryId');


                    subCategorySelect.empty();


                    if (!categoryId || categoryId === "0") {

                        subCategorySelect.append(
                            $('<option>', {
                                value: '0',
                                text: '-- Select Category First --'
                            })
                        );

                        return;
                    }


                    subCategorySelect.append(
                        $('<option>', {
                            value: '0',
                            text: '-- Loading... --'
                        })
                    );


                    var url =
                        subCategoryUrl.replace(
                            '__CATEGORY_ID__',
                            categoryId
                        );


                    console.log(
                        "Category ID:",
                        categoryId
                    );

                    console.log(
                        "SubCategory URL:",
                        url
                    );


                    $.ajax({

                        url: url,

                        type: 'GET',

                        dataType: 'json',

                        cache: false,

                        success: function (data) {

                            console.log(
                                "SubCategory Response:",
                                data
                            );


                            subCategorySelect.empty();


                            subCategorySelect.append(
                                $('<option>', {
                                    value: '0',
                                    text: '-- Select Sub Category --'
                                })
                            );


                            if (
                                Array.isArray(data) &&
                                data.length > 0
                            ) {

                                $.each(
                                    data,
                                    function (index, item) {

                                        subCategorySelect.append(

                                            $('<option>', {

                                                value:
                                                    item.subCategoryId,

                                                text:
                                                    item.subCategoryName

                                            })

                                        );

                                    }
                                );

                            }
                            else {

                                subCategorySelect.empty();

                                subCategorySelect.append(
                                    $('<option>', {
                                        value: '0',
                                        text: '-- No Sub Categories Found --'
                                    })
                                );

                            }

                        },

                        error: function (xhr) {

                            console.error(
                                "SubCategory Error:",
                                xhr.status
                            );

                            console.error(
                                xhr.responseText
                            );


                            subCategorySelect.empty();

                            subCategorySelect.append(
                                $('<option>', {
                                    value: '0',
                                    text: '-- Unable to Load Sub Categories --'
                                })
                            );

                        }

                    });

                });


                // =========================================================
                // SKU CHECK
                // =========================================================

                $('#SKU').on('blur', function () {

                    var sku =
                        $.trim($(this).val());


                    if (!sku) {

                        $('#skuMessage').text('');

                        return;
                    }


                    $.ajax({

                        url: checkSkuUrl,

                        type: 'GET',

                        data: {
                            sku: sku
                        },

                        success: function (data) {

                            var message =
                                $('#skuMessage');


                            if (
                                data &&
                                data.available === false
                            ) {

                                message
                                    .removeClass('text-success')
                                    .addClass('text-danger')
                                    .text(
                                        data.message ||
                                        'This SKU already exists.'
                                    );

                            }
                            else {

                                message
                                    .removeClass('text-danger')
                                    .addClass('text-success')
                                    .text(
                                        'SKU is available.'
                                    );

                            }

                        },

                        error: function () {

                            $('#skuMessage')
                                .removeClass('text-success')
                                .addClass('text-warning')
                                .text(
                                    'Unable to check SKU.'
                                );

                        }

                    });

                });


                // =========================================================
                // FORM SUBMIT
                // =========================================================

                $('#productForm').on('submit', function (e) {

                    var categoryId =
                        $('#categoryId').val();

                    var subCategoryId =
                        $('#subCategoryId').val();

                    var brandId =
                        $('select[name="BrandId"]').val();

                    var unitId =
                        $('select[name="UnitId"]').val();

                    var productName =
                        $.trim(
                            $('input[name="ProductName"]').val()
                        );

                    var sku =
                        $.trim(
                            $('#SKU').val()
                        );


                    // CATEGORY

                    if (!categoryId || categoryId === "0") {

                        e.preventDefault();

                        alert(
                            'Please select Category.'
                        );

                        $('#categoryId').focus();

                        return false;
                    }


                    // SUB CATEGORY

                    if (!subCategoryId || subCategoryId === "0") {

                        e.preventDefault();

                        alert(
                            'Please select Sub Category.'
                        );

                        $('#subCategoryId').focus();

                        return false;
                    }


                    // BRAND

                    if (!brandId || brandId === "0") {

                        e.preventDefault();

                        alert(
                            'Please select Brand.'
                        );

                        return false;
                    }


                    // UNIT

                    if (!unitId || unitId === "0") {

                        e.preventDefault();

                        alert(
                            'Please select Unit.'
                        );

                        return false;
                    }


                    // PRODUCT NAME

                    if (!productName) {

                        e.preventDefault();

                        alert(
                            'Product Name is required.'
                        );

                        $('input[name="ProductName"]').focus();

                        return false;
                    }


                    // SKU

                    if (!sku) {

                        e.preventDefault();

                        alert(
                            'SKU is required.'
                        );

                        $('#SKU').focus();

                        return false;
                    }


                    // =====================================================
                    // CONSOLE LOG
                    // =====================================================

                    console.log(
                        "========== PRODUCT SUBMIT =========="
                    );

                    console.log(
                        "CategoryId:",
                        categoryId
                    );

                    console.log(
                        "SubCategoryId:",
                        subCategoryId
                    );

                    console.log(
                        "BrandId:",
                        brandId
                    );

                    console.log(
                        "UnitId:",
                        unitId
                    );

                    console.log(
                        "ProductName:",
                        productName
                    );

                    console.log(
                        "SKU:",
                        sku
                    );

                    console.log(
                        "IsSerialized:",
                        $('#IsSerialized').is(':checked')
                    );

                    console.log(
                        "IsBatchManaged:",
                        $('#IsBatchManaged').is(':checked')
                    );

                    console.log(
                        "IsActive:",
                        $('#IsActive').is(':checked')
                    );


                    // =====================================================
                    // PREVENT DOUBLE CLICK
                    // =====================================================

                    var button =
                        $('#saveProductBtn');


                    button.prop(
                        'disabled',
                        true
                    );


                    $('#saveButtonText').text(
                        'Saving...'
                    );


                    // IMPORTANT:
                    // Form POST continue hoga.

                    return true;

                });

            });

        </script>
    }
