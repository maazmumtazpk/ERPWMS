@model ERPWMS.Database.Models.Product
@{ Layout = null; }
<form id="editProductForm" method="post" action="/Product/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="productId" value="@Model.ProductId" />
    <div id="editProductAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-md-8"><label class="form-label fw-bold">Product Name *</label><input type="text" name="productName" class="form-control" value="@Model.ProductName" required maxlength="200" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">SKU</label><input type="text" name="sku" class="form-control" value="@Model.Sku" maxlength="50" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Barcode</label><input type="text" name="barcode" class="form-control" value="@Model.Barcode" maxlength="50" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Category *</label><select name="categoryId" id="editCategory" class="form-select" required><option value="">Loading...</option></select></div>
        <div class="col-md-4"><label class="form-label fw-bold">Sub Category</label><select name="subCategoryId" id="editSubCategory" class="form-select"><option value="">-- Select --</option></select></div>
        <div class="col-md-4"><label class="form-label fw-bold">Brand</label><select name="brandId" id="editBrand" class="form-select"><option value="">Loading...</option></select></div>
        <div class="col-md-4"><label class="form-label fw-bold">Unit</label><select name="unitId" id="editUnit" class="form-select"><option value="">Loading...</option></select></div>
        <div class="col-md-4"><label class="form-label fw-bold">Weight (kg)</label><input type="number" step="0.01" name="weight" class="form-control" value="@Model.Weight" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Length (cm)</label><input type="number" step="0.01" name="length" class="form-control" value="@Model.Length" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Width (cm)</label><input type="number" step="0.01" name="width" class="form-control" value="@Model.Width" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Height (cm)</label><input type="number" step="0.01" name="height" class="form-control" value="@Model.Height" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Min Stock Level</label><input type="number" name="minStockLevel" class="form-control" value="@Model.MinStockLevel" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Max Stock Level</label><input type="number" name="maxStockLevel" class="form-control" value="@Model.MaxStockLevel" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Reorder Level</label><input type="number" name="reorderLevel" class="form-control" value="@Model.ReorderLevel" /></div>
        <div class="col-12"><label class="form-label fw-bold">Description</label><textarea name="description" class="form-control" rows="2" maxlength="1000">@Model.Description</textarea></div>
        <div class="col-md-4"><div class="form-check form-switch"><input type="checkbox" name="isSerialized" value="true" class="form-check-input" @((Model.IsSerialized == true) ? "checked" : "") /><label class="form-check-label" style="font-size:11.5px;">Is Serialized</label></div></div>
        <div class="col-md-4"><div class="form-check form-switch"><input type="checkbox" name="isBatchManaged" value="true" class="form-check-input" @((Model.IsBatchManaged == true) ? "checked" : "") /><label class="form-check-label" style="font-size:11.5px;">Is Batch Managed</label></div></div>
        <div class="col-md-4"><label class="form-label fw-bold">Status</label><select name="isActive" class="form-select">@if((Model.IsActive == true)){<option value="true" selected>Active</option><option value="false">Inactive</option>}else{<option value="true">Active</option><option value="false" selected>Inactive</option>}</select></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>
<script>
(function(){
var cid=@(Model.CategoryId);var scid=@(Model.SubCategoryId);var bid=@(Model.BrandId);var uid=@(Model.UnitId);
fetch("/Product/GetCategories").then(r=>r.json()).then(d=>{var s=document.getElementById("editCategory");s.innerHTML="<option value=''>-- Select Category --</option>";(d||[]).forEach(c=>{var o=document.createElement("option");o.value=c.categoryId;o.textContent=c.categoryName;if(c.categoryId===cid)o.selected=true;s.appendChild(o);});if(cid)loadSubs(cid);});
fetch("/Product/GetBrands").then(r=>r.json()).then(d=>{var s=document.getElementById("editBrand");s.innerHTML="<option value=''>-- Select Brand --</option>";(d||[]).forEach(b=>{var o=document.createElement("option");o.value=b.brandId;o.textContent=b.brandName;if(b.brandId===bid)o.selected=true;s.appendChild(o);});});
fetch("/Product/GetUnits").then(r=>r.json()).then(d=>{var s=document.getElementById("editUnit");s.innerHTML="<option value=''>-- Select Unit --</option>";(d||[]).forEach(u=>{var o=document.createElement("option");o.value=u.unitId;o.textContent=u.unitName;if(u.unitId===uid)o.selected=true;s.appendChild(o);});});
function loadSubs(cid){fetch("/Product/GetSubCategories?categoryId="+cid).then(r=>r.json()).then(d=>{var s=document.getElementById("editSubCategory");s.innerHTML="<option value=''>-- Select --</option>";(d||[]).forEach(x=>{var o=document.createElement("option");o.value=x.subCategoryId;o.textContent=x.subCategoryName;if(x.subCategoryId===scid)o.selected=true;s.appendChild(o);});});}
document.getElementById("editCategory").addEventListener("change",function(){loadSubs(this.value);});
})();
</script>

