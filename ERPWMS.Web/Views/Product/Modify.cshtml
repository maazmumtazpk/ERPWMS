@model ERPWMS.Application.DTOs.Product.ModifyProductDto

@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Edit Product";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var categoryList = ViewBag.CategoryList as SelectList
                       ?? new SelectList(Enumerable.Empty<SelectListItem>());

    var subCategoryList = ViewBag.SubCategoryList as SelectList
                          ?? new SelectList(Enumerable.Empty<SelectListItem>());

    var brandList = ViewBag.BrandList as SelectList
                    ?? new SelectList(Enumerable.Empty<SelectListItem>());

    var unitList = ViewBag.UnitList as SelectList
                   ?? new SelectList(Enumerable.Empty<SelectListItem>());
}

<div class="container-fluid">

    <div class="row">

        <div class="col-md-10 offset-md-1">

            <div class="card">

                <!-- ========================================================= -->
                <!-- HEADER -->
                <!-- ========================================================= -->

                <div class="card-header">

                    <h3 class="card-title">
                        <i class="fas fa-edit"></i>
                        Edit Product
                    </h3>

                    <div class="card-tools">

                        <a asp-action="Index"
                               class="btn btn-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i>
                            Back
                        </a>

                        <a asp-action="Detail"
                               asp-route-id="@Model.ProductId"
                               class="btn btn-info btn-sm">
                            <i class="fas fa-eye"></i>
                            Details
                        </a>

                    </div>

                </div>


                <!-- ========================================================= -->
                <!-- BODY -->
                <!-- ========================================================= -->

                <div class="card-body">

                    <form asp-action="Modify"
                          method="post"
                          id="productForm">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="ProductId" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger">
                        </div>


                        <!-- ================================================= -->
                        <!-- BASIC INFORMATION -->
                        <!-- ================================================= -->

                        <div class="row">

                            <div class="col-md-12">

                                <h5 class="text-primary">
                                    <i class="fas fa-info-circle"></i>
                                    Basic Information
                                </h5>

                                <hr />

                            </div>

                        </div>


                        <!-- Category / SubCategory -->

                        <div class="row">

                            <!-- Category -->

                            <div class="col-md-6">

                                <div class="form-group">

                                    <label asp-for="CategoryId"
                                           class="control-label required">
                                        Category
                                    </label>

                                    <select asp-for="CategoryId"
                                            class="form-control"
                                            id="categoryId">

                                        <option value="">
                                            -- Select Category --
                                        </option>

                                        @foreach (var category in categoryList)
                                        {
                                            <option value="@category.Value"
                                                    selected="@category.Selected">
                                                @category.Text
                                            </option>
                                        }

                                    </select>

                                    <span asp-validation-for="CategoryId"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- Sub Category -->

                            <div class="col-md-6">

                                <div class="form-group">

                                    <label asp-for="SubCategoryId"
                                           class="control-label required">
                                        Sub Category
                                    </label>

                                    <select asp-for="SubCategoryId"
                                            class="form-control"
                                            id="subCategoryId">

                                        @if (subCategoryList.Any())
                                        {
                                            <option value="">
                                                -- Select Sub Category --
                                            </option>

                                            @foreach (var subCategory in subCategoryList)
                                            {
                                                <option value="@subCategory.Value"
                                                        selected="@subCategory.Selected">
                                                    @subCategory.Text
                                                </option>
                                            }
                                        }
                                        else
                                        {
                                            <option value="">
                                                -- Select Category First --
                                            </option>
                                        }

                                    </select>

                                    <span asp-validation-for="SubCategoryId"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- Brand / Unit -->

                        <div class="row">

                            <!-- Brand -->

                            <div class="col-md-6">

                                <div class="form-group">

                                    <label asp-for="BrandId"
                                           class="control-label required">
                                        Brand
                                    </label>

                                    <select asp-for="BrandId"
                                            class="form-control"
                                            asp-items="brandList">

                                        <option value="">
                                            -- Select Brand --
                                        </option>

                                    </select>

                                    <span asp-validation-for="BrandId"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- Unit -->

                            <div class="col-md-6">

                                <div class="form-group">

                                    <label asp-for="UnitId"
                                           class="control-label required">
                                        Unit
                                    </label>

                                    <select asp-for="UnitId"
                                            class="form-control"
                                            asp-items="unitList">

                                        <option value="">
                                            -- Select Unit --
                                        </option>

                                    </select>

                                    <span asp-validation-for="UnitId"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- Product Name -->

                        <div class="row">

                            <div class="col-md-12">

                                <div class="form-group">

                                    <label asp-for="ProductName"
                                           class="control-label required">
                                        Product Name
                                    </label>

                                    <input asp-for="ProductName"
                                           class="form-control"
                                           placeholder="Enter product name" />

                                    <span asp-validation-for="ProductName"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- SKU / Barcode / QR -->

                        <div class="row">

                            <!-- SKU -->

                            <div class="col-md-4">

                                <div class="form-group">

                                    <label asp-for="SKU"
                                           class="control-label required">
                                        SKU
                                    </label>

                                    <input asp-for="SKU"
                                           class="form-control"
                                           placeholder="Enter SKU" />

                                    <span asp-validation-for="SKU"
                                          class="text-danger">
                                    </span>

                                    <small class="form-text text-muted">
                                        Unique identifier
                                    </small>

                                </div>

                            </div>


                            <!-- Barcode -->

                            <div class="col-md-4">

                                <div class="form-group">

                                    <label asp-for="Barcode"
                                           class="control-label">
                                        Barcode
                                    </label>

                                    <input asp-for="Barcode"
                                           class="form-control"
                                           placeholder="Enter barcode (optional)" />

                                    <span asp-validation-for="Barcode"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- QR Code -->

                            <div class="col-md-4">

                                <div class="form-group">

                                    <label asp-for="QRCode"
                                           class="control-label">
                                        QR Code
                                    </label>

                                    <input asp-for="QRCode"
                                           class="form-control"
                                           placeholder="Enter QR code (optional)" />

                                    <span asp-validation-for="QRCode"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- Description -->

                        <div class="row">

                            <div class="col-md-12">

                                <div class="form-group">

                                    <label asp-for="Description"
                                           class="control-label">
                                        Description
                                    </label>

                                    <textarea asp-for="Description"
                                              class="form-control"
                                              rows="3"
                                              placeholder="Enter product description (optional)"></textarea>

                                    <span asp-validation-for="Description"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- PHYSICAL DIMENSIONS -->
                        <!-- ================================================= -->

                        <div class="row mt-3">

                            <div class="col-md-12">

                                <h5 class="text-primary">
                                    <i class="fas fa-ruler"></i>
                                    Physical Dimensions
                                </h5>

                                <hr />

                            </div>

                        </div>


                        <div class="row">

                            <!-- Weight -->

                            <div class="col-md-3">

                                <div class="form-group">

                                    <label asp-for="Weight"
                                           class="control-label">Weight (kg)</label>

                                    <input asp-for="Weight"
                                           class="form-control"
                                           placeholder="Weight (optional)" />

                                    <span asp-validation-for="Weight"
                                          class="text-danger">
                                    </span>

                                    <small class="form-text text-muted">
                                        In kilograms
                                    </small>

                                </div>

                            </div>


                            <!-- Length -->

                            <div class="col-md-3">

                                <div class="form-group">

                                    <label asp-for="Length"
                                           class="control-label">Length (cm)</label>

                                    <input asp-for="Length"
                                           class="form-control"
                                           placeholder="Length (optional)" />

                                    <span asp-validation-for="Length"
                                          class="text-danger">
                                    </span>

                                    <small class="form-text text-muted">
                                        In centimeters
                                    </small>

                                </div>

                            </div>


                            <!-- Width -->

                            <div class="col-md-3">

                                <div class="form-group">

                                    <label asp-for="Width"
                                           class="control-label">Width (cm)</label>

                                    <input asp-for="Width"
                                           class="form-control"
                                           placeholder="Width (optional)" />

                                    <span asp-validation-for="Width"
                                          class="text-danger">
                                    </span>

                                    <small class="form-text text-muted">
                                        In centimeters
                                    </small>

                                </div>

                            </div>


                            <!-- Height -->

                            <div class="col-md-3">

                                <div class="form-group">

                                    <label asp-for="Height"
                                           class="control-label">Height (cm)</label>

                                    <input asp-for="Height"
                                           class="form-control"
                                           placeholder="Height (optional)" />

                                    <span asp-validation-for="Height"
                                          class="text-danger">
                                    </span>

                                    <small class="form-text text-muted">
                                        In centimeters
                                    </small>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- STOCK LEVELS -->
                        <!-- ================================================= -->

                        <div class="row mt-3">

                            <div class="col-md-12">

                                <h5 class="text-primary">
                                    <i class="fas fa-warehouse"></i>
                                    Stock Levels
                                </h5>

                                <hr />

                            </div>

                        </div>


                        <div class="row">

                            <!-- Minimum -->

                            <div class="col-md-4">

                                <div class="form-group">

                                    <label asp-for="MinStockLevel"
                                           class="control-label">
                                        Minimum Stock Level
                                    </label>

                                    <input asp-for="MinStockLevel"
                                           class="form-control"
                                           placeholder="Minimum quantity" />

                                    <span asp-validation-for="MinStockLevel"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- Maximum -->

                            <div class="col-md-4">

                                <div class="form-group">

                                    <label asp-for="MaxStockLevel"
                                           class="control-label">
                                        Maximum Stock Level
                                    </label>

                                    <input asp-for="MaxStockLevel"
                                           class="form-control"
                                           placeholder="Maximum quantity" />

                                    <span asp-validation-for="MaxStockLevel"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>


                            <!-- Reorder -->

                            <div class="col-md-4">

                                <div class="form-group">

                                    <label asp-for="ReorderLevel"
                                           class="control-label">
                                        Reorder Level
                                    </label>

                                    <input asp-for="ReorderLevel"
                                           class="form-control"
                                           placeholder="Reorder quantity" />

                                    <span asp-validation-for="ReorderLevel"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- ADDITIONAL SETTINGS -->
                        <!-- ================================================= -->

                        <div class="row mt-3">

                            <div class="col-md-12">

                                <h5 class="text-primary">
                                    <i class="fas fa-cog"></i>
                                    Additional Settings
                                </h5>

                                <hr />

                            </div>

                        </div>


                        <div class="row">

                            <!-- Serialized -->

                            <div class="col-md-4">

                                <div class="form-group">

                                    <div class="custom-control custom-switch">

                                        <input asp-for="IsSerialized"
                                               class="custom-control-input" />

                                        <label asp-for="IsSerialized"
                                               class="custom-control-label">
                                            Serialized
                                        </label>

                                    </div>

                                </div>

                            </div>


                            <!-- Batch -->

                            <div class="col-md-4">

                                <div class="form-group">

                                    <div class="custom-control custom-switch">

                                        <input asp-for="IsBatchManaged"
                                               class="custom-control-input" />

                                        <label asp-for="IsBatchManaged"
                                               class="custom-control-label">
                                            Batch Managed
                                        </label>

                                    </div>

                                </div>

                            </div>


                            <!-- Active -->

                            <div class="col-md-4">

                                <div class="form-group">

                                    <div class="custom-control custom-switch">

                                        <input asp-for="IsActive"
                                               class="custom-control-input" />

                                        <label asp-for="IsActive"
                                               class="custom-control-label">
                                            Active
                                        </label>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- ================================================= -->
                        <!-- BUTTONS -->
                        <!-- ================================================= -->

                        <div class="form-group mt-3">

                            <button type="submit"
                                    class="btn btn-warning">

                                <i class="fas fa-save"></i>
                                Update

                            </button>

                            <a asp-action="Index"
                                   class="btn btn-secondary">

                                <i class="fas fa-times"></i>
                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        $(document).ready(function () {

            // ============================================================
            // LOAD SUB CATEGORIES
            // ============================================================

            $('#categoryId').change(function () {

                var categoryId = $(this).val();

                var subCategorySelect = $('#subCategoryId');

                subCategorySelect.empty();

                if (categoryId) {

                    subCategorySelect.append(
                        '<option value="">-- Loading... --</option>'
                    );

                    $.ajax({

                        url: '@Url.Action("GetSubCategories")/' + categoryId,

                        type: 'GET',

                        success: function (data) {

                            subCategorySelect.empty();

                            subCategorySelect.append(
                                '<option value="">-- Select Sub Category --</option>'
                            );

                            if (data && data.length > 0) {

                                $.each(data, function (index, item) {

                                    subCategorySelect.append(
                                        '<option value="' +
                                        item.subCategoryId +
                                        '">' +
                                        item.subCategoryName +
                                        '</option>'
                                    );

                                });

                            }
                            else {

                                subCategorySelect.empty();

                                subCategorySelect.append(
                                    '<option value="">-- No Sub Categories Found --</option>'
                                );

                            }

                        },

                        error: function () {

                            subCategorySelect.empty();

                            subCategorySelect.append(
                                '<option value="">-- Error Loading Sub Categories --</option>'
                            );

                            alert(
                                'An error occurred while loading subcategories.'
                            );

                        }

                    });

                }
                else {

                    subCategorySelect.empty();

                    subCategorySelect.append(
                        '<option value="">-- Select Category First --</option>'
                    );

                }

            });


            // ============================================================
            // CHECK SKU UNIQUENESS
            // ============================================================

            $('#SKU').blur(function () {

                var sku = $(this).val();

                var productId = $('#ProductId').val();

                if (sku) {

                    $.ajax({

                        url: '@Url.Action("CheckSKU")',

                        type: 'GET',

                        data: {
                            sku: sku,
                            productId: productId
                        },

                        success: function (data) {

                            if (data && !data.available) {

                                alert(
                                    'This SKU already exists. Please use another SKU.'
                                );

                                $('#SKU').val('');

                                $('#SKU').focus();

                            }

                        },

                        error: function () {

                            console.log(
                                'Unable to check SKU availability.'
                            );

                        }

                    });

                }

            });

        });

    </script>
}
