@{ Layout = null; }
<form id="addForm" method="post" action="/StockTransfer/Register">
    @Html.AntiForgeryToken()
    <div id="addAlert" style="display:none;padding:8px 10px;border-radius:6px;font-size:11px;margin-bottom:12px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    
    <div id="stockWarn" style="display:none;padding:10px 14px;border-radius:8px;font-size:12px;margin-bottom:14px;background:#FFF7ED;color:#C2410C;border-left:4px solid #F5A623;font-weight:600;">
        <i class="bi bi-exclamation-triangle-fill" style="margin-right:6px;"></i>
        <span id="stockWarnMsg"></span>
    </div>

    <div class="row g-2">
        <div class="col-md-12">
            <label class="form-label">Product *</label>
            <select name="productId" id="stProduct" class="form-select" required>
                <option value="">Loading...</option>
            </select>
            <small id="stockInfo" style="display:none;color:#059669;font-size:11px;font-weight:600;margin-top:4px;">
                <i class="bi bi-check-circle"></i> <span id="stockInfoText"></span>
            </small>
        </div>
        <div class="col-md-6">
            <label class="form-label">From Warehouse * (auto)</label>
            <select name="fromWarehouseId" id="stFrom" class="form-select" required>
                <option value="">-- Select Product first --</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">To Warehouse *</label>
            <select name="toWarehouseId" id="stTo" class="form-select" required>
                <option value="">-- Select --</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Available Qty (auto)</label>
            <input type="number" id="stAvailable" class="form-control" value="0" readonly style="background:#f1f5f9;font-weight:700;color:#0A1628;" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Transfer Qty *</label>
            <input type="number" name="quantity" id="stQty" class="form-control" min="1" value="1" required />
        </div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:6px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" id="stSubmitBtn" class="btn btn-gold btn-sm" style="background:#F5A623;color:#0A1628;font-weight:700;border:none;">Create Transfer</button>
    </div>
</form>
<script>
(function(){
    var prodSel = document.getElementById("stProduct");
    var fromSel = document.getElementById("stFrom");
    var toSel = document.getElementById("stTo");
    var availQty = document.getElementById("stAvailable");
    var qtyInput = document.getElementById("stQty");
    var warnBox = document.getElementById("stockWarn");
    var warnMsg = document.getElementById("stockWarnMsg");
    var submitBtn = document.getElementById("stSubmitBtn");
    var stockInfo = document.getElementById("stockInfo");
    var stockInfoText = document.getElementById("stockInfoText");

    function showWarning(msg){
        warnMsg.textContent = msg;
        warnBox.style.display = "block";
        if(submitBtn){ submitBtn.disabled = true; submitBtn.style.opacity = "0.5"; submitBtn.style.cursor = "not-allowed"; }
    }
    function hideWarning(){
        warnBox.style.display = "none";
        if(submitBtn){ submitBtn.disabled = false; submitBtn.style.opacity = "1"; submitBtn.style.cursor = "pointer"; }
    }

    // Load Products
    fetch("/StockTransfer/GetProducts").then(r=>r.json()).then(d=>{
        prodSel.innerHTML = "<option value=''>-- Select --</option>";
        (d||[]).forEach(x=>{
            var o = document.createElement("option");
            o.value = x.productId;
            o.textContent = x.productName;
            prodSel.appendChild(o);
        });
    });

    // Load Warehouses (To dropdown ke liye)
    fetch("/StockTransfer/GetWarehouses").then(r=>r.json()).then(d=>{
        toSel.innerHTML = "<option value=''>-- Select --</option>";
        (d||[]).forEach(x=>{
            var o = document.createElement("option");
            o.value = x.warehouseId;
            o.textContent = x.warehouseName;
            toSel.appendChild(o);
        });
    });

    // Product change par From Warehouse auto-select + Available Qty show
    prodSel.addEventListener("change", function(){
        var pid = this.value;
        fromSel.innerHTML = "<option value=''>Loading...</option>";
        availQty.value = 0;
        stockInfo.style.display = "none";
        hideWarning();

        if(!pid){
            fromSel.innerHTML = "<option value=''>-- Select Product first --</option>";
            return;
        }

        fetch("/StockTransfer/GetProductBins?productId=" + pid)
            .then(r => r.json())
            .then(function(res){
                if(!res.warehouseId || res.warehouseId <= 0){
                    fromSel.innerHTML = "<option value=''>-- Not Available --</option>";
                    showWarning("Please do Stock IN first for this product.");
                    return;
                }

                // From Warehouse auto-select
                fromSel.innerHTML = "<option value='"+res.warehouseId+"' selected>"+res.warehouseName+"</option>";

                // Available Quantity show
                availQty.value = res.balance || 0;
                stockInfoText.textContent = "Available: " + (res.balance || 0) + " units in " + res.warehouseName;
                stockInfo.style.display = "block";

                // To dropdown se same warehouse hataao
                Array.from(toSel.options).forEach(function(opt){
                    opt.disabled = (opt.value == res.warehouseId);
                });

                // Transfer Qty max = available
                qtyInput.max = res.balance || 1;
            })
            .catch(function(err){
                console.error("Error:", err);
                fromSel.innerHTML = "<option value=''>-- Error --</option>";
                showWarning("Please do Stock IN first for this product.");
            });
    });
})();
</script>
