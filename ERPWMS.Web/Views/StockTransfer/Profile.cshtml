@model ERPWMS.Database.Models.StockTransfer
@{
    ViewData["Title"] = "Transfer Details";
    Layout = "_Layout";
}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0 fw-bold" style="color:#0A1628;">Transfer Details</h3>
            <small class="text-muted">Home / Stock Transfer / @Model.TransferNo</small>
        </div>
        <div>
            <button class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
        </div>
    </div>
    <div class="card shadow-sm mb-3" style="background:#0A1628;color:#fff;border:none;">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <div style="background:#F5A623;color:#0A1628;padding:14px;border-radius:10px;font-size:1.6rem;margin-right:16px;"><i class="bi bi-arrow-left-right"></i></div>
                    <div>
                        <h3 class="mb-1 fw-bold" style="color:#fff;">@Model.TransferNo</h3>
                        <div style="font-size:12px;color:#94A3B8;"><i class="bi bi-calendar3"></i> @(Model.TransferDate?.ToString("dd MMM yyyy") ?? "-")</div>
                    </div>
                </div>
                <div>
                    @{ var statusColor = Model.Status == "Completed" ? "#159A89" : Model.Status == "Received" ? "#0EA5E9" : "#F5A623"; }
                    <span style="background:@statusColor;color:#fff;padding:6px 16px;border-radius:20px;font-size:11px;font-weight:700;text-transform:uppercase;">@Model.Status</span>
                </div>
            </div>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="card shadow-sm h-100" style="border:1px solid #edf0f4;">
                <div class="card-body">
                    <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-box" style="color:#F5A623;"></i> Product</h6>
                    <p class="mb-0 fw-bold" style="color:#0A1628;font-size:14px;">@(Model.Product?.ProductName ?? "N/A")</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm h-100" style="border:1px solid #edf0f4;">
                <div class="card-body">
                    <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-arrow-left-right" style="color:#F5A623;"></i> Transfer Info</h6>
                    <table class="table table-sm mb-0" style="font-size:12px;">
                        <tr><td style="color:#64748B;border:none;">From</td><td class="text-end fw-bold" style="border:none;">@(Model.FromWarehouse?.WarehouseName ?? "-")</td></tr>
                        <tr><td style="color:#64748B;border:none;">To</td><td class="text-end fw-bold" style="border:none;">@(Model.ToWarehouse?.WarehouseName ?? "-")</td></tr>
                        <tr><td style="color:#64748B;border:none;">Quantity</td><td class="text-end fw-bold" style="border:none;">@Model.Quantity</td></tr>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
