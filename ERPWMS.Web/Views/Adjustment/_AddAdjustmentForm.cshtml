@{
    Layout = null;
}
<form id="addAdjustmentForm" method="post" action="/Adjustment/Register">
    @Html.AntiForgeryToken()
    <div id="addAdjustmentAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label fw-bold">Product *</label><select name="productId" id="addProduct" class="form-select" required><option value="">Loading...</option></select></div>
        <div class="col-md-6"><label class="form-label fw-bold">Warehouse *</label><select name="warehouseId" id="addWarehouse" class="form-select" required><option value="">Loading...</option></select></div>
        <div class="col-md-6"><label class="form-label fw-bold">Type</label><select name="adjustmentType" class="form-select"><option value="Increase">Increase</option><option value="Decrease">Decrease</option></select></div>
        <div class="col-md-6"><label class="form-label fw-bold">Quantity</label><input type="number" name="quantity" class="form-control" value="0" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Previous Qty</label><input type="number" name="previousQty" class="form-control" value="0" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">New Qty</label><input type="number" name="newQty" class="form-control" value="0" /></div>
        <input type="hidden" name="binId" value="0" />
        <div class="col-12"><label class="form-label fw-bold">Reason</label><textarea name="reason" class="form-control" rows="2"></textarea></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Create</button>
    </div>
</form>
<script>
fetch("/Adjustment/GetProducts").then(r=>r.json()).then(d=>{var s=document.getElementById("addProduct");s.innerHTML="<option value=''>-- Select --</option>";(d||[]).forEach(x=>{var o=document.createElement("option");o.value=x.productId;o.textContent=x.productName;s.appendChild(o);});});
fetch("/Adjustment/GetWarehouses").then(r=>r.json()).then(d=>{var s=document.getElementById("addWarehouse");s.innerHTML="<option value=''>-- Select --</option>";(d||[]).forEach(x=>{var o=document.createElement("option");o.value=x.warehouseId;o.textContent=x.warehouseName;s.appendChild(o);});});
</script>
