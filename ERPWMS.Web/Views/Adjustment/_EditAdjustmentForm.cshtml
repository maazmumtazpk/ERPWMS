@model ERPWMS.Database.Models.StockAdjustment
@{ Layout = null; }
<form id="editAdjustmentForm" method="post" action="/Adjustment/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="adjustmentId" value="@Model.AdjustmentId" />
    <div id="editAdjustmentAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label fw-bold">Type</label><select name="adjustmentType" class="form-select">@if(Model.AdjustmentType == "Increase"){<option value="Increase" selected>Increase</option><option value="Decrease">Decrease</option>}else{<option value="Increase">Increase</option><option value="Decrease" selected>Decrease</option>}</select></div>
        <div class="col-md-6"><label class="form-label fw-bold">Quantity</label><input type="number" name="quantity" class="form-control" value="@Model.Quantity" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Previous Qty</label><input type="number" name="previousQty" class="form-control" value="@Model.PreviousQty" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">New Qty</label><input type="number" name="newQty" class="form-control" value="@Model.NewQty" /></div>
        <div class="col-12"><label class="form-label fw-bold">Reason</label><textarea name="reason" class="form-control" rows="2">@Model.Reason</textarea></div>
        <div class="col-12"><label class="form-label fw-bold">Status</label><select name="status" class="form-select">@foreach(var s in new[]{"Pending","Approved","Rejected"}){if(Model.Status == s){<option value="@s" selected>@s</option>}else{<option value="@s">@s</option>}}</select></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>
