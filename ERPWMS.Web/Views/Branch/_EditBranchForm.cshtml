@model ERPWMS.Web.ViewModels.Branch.RegisterBranchViewModel
@{
    Layout = null;
}
<form id="editBranchForm" method="post" action="/Branch/UpdateBranchAjax" autocomplete="off">
    @Html.AntiForgeryToken()
    <input type="hidden" name="BranchId" value="@Model.BranchId" />
    <div id="editBranchAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-12">
            <label class="form-label fw-bold">Branch Name *</label>
            <input type="text" name="BranchName" class="form-control" value="@Model.BranchName" required maxlength="200" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Branch Code</label>
            <input type="text" name="BranchCode" class="form-control" value="@Model.BranchCode" maxlength="20" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Company</label>
            <input type="text" class="form-control" value="@Model.CompanyName" disabled />
            <input type="hidden" name="CompanyId" value="@Model.CompanyId" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Phone</label>
            <input type="text" name="Phone" class="form-control" value="@Model.Phone" maxlength="20" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Email</label>
            <input type="email" name="Email" class="form-control" value="@Model.Email" maxlength="100" />
        </div>
        <div class="col-12">
            <label class="form-label fw-bold">Address</label>
            <textarea name="Address" class="form-control" rows="2" maxlength="500">@Model.Address</textarea>
        </div>
    </div>
    <div class="modal-footer" style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>
