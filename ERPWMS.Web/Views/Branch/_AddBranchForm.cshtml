@{
    Layout = null;
}
<form id="addBranchForm" method="post" action="/Branch/CreateBranchAjax">
    @Html.AntiForgeryToken()
    <div id="addBranchAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-12">
            <label class="form-label fw-bold">Branch Name *</label>
            <input type="text" name="BranchName" class="form-control" required maxlength="200" placeholder="Enter branch name" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Branch Code</label>
            <input type="text" name="BranchCode" class="form-control" maxlength="20" placeholder="BR-001" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Company *</label>
            <select name="CompanyId" id="addBranchCompany" class="form-select" required
                    onfocus="loadCompaniesOnce(this)" onclick="loadCompaniesOnce(this)">
                <option value="">-- Select Company --</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Phone</label>
            <input type="text" name="Phone" class="form-control" maxlength="20" placeholder="0300-1234567" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Email</label>
            <input type="email" name="Email" class="form-control" maxlength="100" placeholder="branch@company.com" />
        </div>
        <div class="col-12">
            <label class="form-label fw-bold">Address</label>
            <textarea name="Address" class="form-control" rows="2" maxlength="500" placeholder="Full address"></textarea>
        </div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Register</button>
    </div>
</form>
