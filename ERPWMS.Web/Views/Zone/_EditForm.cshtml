@model ERPWMS.Database.Models.Zone
@{
    Layout = null;
}
<form id="editZoneForm" method="post" action="/Zone/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="zoneId" value="@Model.ZoneId" />
    <div id="editZoneAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label fw-bold">Zone Name *</label>
            <input type="text" name="zoneName" class="form-control" value="@Model.ZoneName" required maxlength="200" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Zone Code</label>
            <input type="text" name="zoneCode" class="form-control" value="@Model.ZoneCode" maxlength="20" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Status</label>
            <select name="isActive" class="form-select">
                @if((Model.IsActive == true)){<option value="true" selected>Active</option><option value="false">Inactive</option>}
                else{<option value="true">Active</option><option value="false" selected>Inactive</option>}
            </select>
        </div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>
