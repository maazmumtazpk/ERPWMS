@{
    ViewData["Title"] = "Preview Template";
    Layout = "_Layout";
}
@await Html.PartialAsync("_AdminCss")
<div style="padding-bottom:30px;">
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0" style="color:#0A1628;font-size:18px;">Preview: @ViewBag.TemplateName</h4>
        <small class="text-muted" style="font-size:11px;">Home / Templates / Preview</small>
    </div>
    <a href="/NotificationTemplate/Index" class="btn-icon" style="width:auto;padding:0 12px;text-decoration:none;"><i class="bi bi-arrow-left me-1"></i> Back</a>
</div>

<div class="table-card" style="margin-top:0;">
    <div class="card-header-custom">
        <h5><i class="bi bi-eye" style="color:#F5A623;"></i> Preview with Sample Data</h5>
        <span class="badge-status role">Demo values</span>
    </div>
    <div style="padding:24px;">
        <div style="font-size:10px;color:#94A3B8;text-transform:uppercase;font-weight:700;letter-spacing:.5px;margin-bottom:8px;">Subject Line</div>
        <div style="font-size:15px;font-weight:800;color:#0A1628;padding:14px 18px;background:#FEF3C7;border-radius:10px;border-left:4px solid #F5A623;margin-bottom:20px;">@ViewBag.Subject</div>

        <div style="font-size:10px;color:#94A3B8;text-transform:uppercase;font-weight:700;letter-spacing:.5px;margin-bottom:8px;">Message Body</div>
        <div style="font-size:13px;line-height:1.8;color:#334155;padding:20px;background:#F8FAFC;border-radius:10px;border:1px solid #E2E8F0;white-space:pre-wrap;min-height:200px;">@ViewBag.Body</div>
    </div>
    <div style="padding:14px 24px;background:#FAFBFC;border-top:1px solid #F1F5F9;display:flex;justify-content:flex-end;gap:8px;">
        <a href="/NotificationTemplate/Index" class="btn-icon" style="width:auto;padding:0 14px;height:34px;text-decoration:none;font-size:11px;font-weight:600;">Close</a>
    </div>
</div>
</div>
