@model ERPWMS.Database.Models.Company
@{
    Layout = null;
}
<form id="editCompanyForm" method="post" action="/Company/Edit" autocomplete="off">
    @Html.AntiForgeryToken()
    <input type="hidden" name="CompanyId" value="@Model.CompanyId" />
    <div id="editFormAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-12">
            <label class="form-label fw-bold">Company Name *</label>
            <input type="text" name="CompanyName" class="form-control" value="@Model.CompanyName" required maxlength="200" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Registration No.</label>
            <input type="text" name="RegistrationNo" class="form-control" value="@Model.RegistrationNo" maxlength="50" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Phone</label>
            <input type="text" name="Phone" class="form-control" value="@Model.Phone" maxlength="20" />
        </div>
        <div class="col-12">
            <label class="form-label fw-bold">Email</label>
            <input type="email" name="Email" class="form-control" value="@Model.Email" maxlength="100" />
        </div>
        <div class="col-12">
            <label class="form-label fw-bold">Address</label>
            <textarea name="Address" class="form-control" rows="2" maxlength="500">@Model.Address</textarea>
        </div>
        <div class="col-12">
            <label class="form-label fw-bold">Logo URL</label>
            <input type="text" name="LogoUrl" class="form-control" value="@Model.LogoUrl" maxlength="300" />
        </div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>
