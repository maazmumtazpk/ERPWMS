@{
    ViewData["Title"] = "Company Management";
    Layout = "_Layout";
}
<form id="__mainAntiforgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>
<style>
.mod-page{padding-bottom:30px}
.kpi-card{background:#fff;border:1px solid #edf0f4;border-radius:10px;padding:12px 14px;box-shadow:0 2px 8px rgba(0,0,0,.04);height:100%;min-height:80px;position:relative;overflow:hidden;transition:all .25s ease;display:flex;flex-direction:column;justify-content:center}
.kpi-card::before{content:"";position:absolute;top:0;left:0;right:0;height:2.5px}
.kpi-card.total::before{background:#0A1628}
.kpi-card.active::before{background:#159A89}
.kpi-card.inactive::before{background:#F5A623}
.kpi-card.month::before{background:#7167D8}
.kpi-card:hover{transform:translateY(-2px);box-shadow:0 4px 16px rgba(0,0,0,.07)}
.kpi-content{display:flex;justify-content:space-between;align-items:center;width:100%;gap:8px}
.kpi-text-group{display:flex;flex-direction:column;flex:1}
.kpi-label{margin:0 0 3px 0;color:#64748B;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.4px}
.kpi-number{margin:0;color:#0A1628;font-size:20px;font-weight:750;line-height:1.2}
.kpi-trend{display:inline-flex;align-items:center;gap:3px;margin-top:4px;padding:2px 7px;border-radius:12px;font-size:8px;font-weight:600;width:fit-content}
.kpi-trend.up{background:#DDF7F1;color:#128B7B}
.kpi-trend.neutral{background:#F1F5F9;color:#64748B}
.kpi-icon{width:30px;height:30px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:13px;flex-shrink:0}
.kpi-icon.blue{background:#0A1628;color:#fff}
.kpi-icon.green{background:#D7F4EE;color:#159A89}
.kpi-icon.orange{background:#FFF1D7;color:#E39A19}
.kpi-icon.purple{background:#EAE8FF;color:#7167D8}
.panel{background:#fff;border:1px solid #edf0f4;border-radius:10px;box-shadow:0 2px 8px rgba(0,0,0,.04);margin-top:16px;overflow:visible}
.panel-head{padding:12px 16px;border-bottom:1px solid #F1F5F9;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
.panel-head .ttl{font-size:12px;font-weight:700;color:#0A1628;display:flex;align-items:center;gap:6px;margin:0}
.panel-head .ttl i{color:#F5A623}
.panel-head .sub{font-size:10px;color:#94A3B8;margin:2px 0 0}
.badge-count{background:#F1F5F9;color:#64748B;font-size:9px;font-weight:700;padding:1px 8px;border-radius:12px;margin-left:6px}
.qa-row{padding:14px 16px;display:flex;flex-wrap:wrap;gap:8px}
.qa-btn{background:#fff;border:1px solid #E2E8F0;border-radius:8px;padding:8px 14px;font-size:11px;font-weight:600;color:#334155;display:inline-flex;align-items:center;gap:6px;text-decoration:none;transition:all .15s;cursor:pointer}
.qa-btn:hover{background:#F8FAFC;border-color:#CBD5E1;color:#0A1628}
.qa-btn.dark{background:#0A1628;border-color:#0A1628;color:#fff}
.qa-btn.dark:hover{background:#1a2a4a;color:#fff}
.qa-btn i{font-size:12px}
.search-wrap{position:relative;display:inline-block}
.search-wrap input{border:1px solid #E2E8F0;border-radius:6px;padding:5px 10px 5px 28px;font-size:10px;outline:none;width:200px;background:#FAFBFC}
.search-wrap input:focus{border-color:#F5A623;background:#fff}
.search-wrap i{position:absolute;left:8px;top:50%;transform:translateY(-50%);color:#94A3B8;font-size:10px}
.list-row{display:flex;align-items:center;padding:14px 16px;gap:14px;border-bottom:1px solid #F1F5F9;transition:background .15s}
.list-row:last-child{border-bottom:none}
.list-row:hover{background:#FEFBF5}
.avatar-sq{width:40px;height:40px;border-radius:10px;background:#DBEAFE;color:#1D4ED8;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12px;flex-shrink:0}
.avatar-sq.alt{background:#FEF3C7;color:#D97706}
.row-main{flex:1;min-width:0}
.row-name{font-size:13px;font-weight:600;color:#0A1628;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.row-meta{font-size:10.5px;color:#94A3B8;margin-top:3px;display:flex;align-items:center;gap:6px}
.row-meta .dot{color:#CBD5E1}
.badge-status{padding:2px 8px;border-radius:12px;font-size:8px;font-weight:700;display:inline-flex;align-items:center;gap:4px;text-transform:uppercase;letter-spacing:.3px}
.badge-status.active{background:#DDF7F1;color:#118B7B}
.badge-status.inactive{background:#F1F5F9;color:#64748B}
.row-actions{margin-left:auto;flex-shrink:0}
.btn-icon{width:28px;height:28px;border-radius:6px;border:1px solid #E8ECF1;display:inline-flex;align-items:center;justify-content:center;font-size:13px;color:#64748B;background:#fff;cursor:pointer;transition:all .15s}
.btn-icon:hover{background:#F1F5F9;color:#0A1628;border-color:#CBD5E1}
.btn-icon.gold{background:#F5A623;color:#fff;border-color:#F5A623}
.btn-icon.gold:hover{background:#E39A19;color:#fff}
.act-wrap{position:relative;display:inline-block}
.act-menu{position:fixed;background:#fff;border:1px solid #E8ECF1;border-radius:8px;box-shadow:0 8px 24px rgba(15,23,42,.14);min-width:180px;padding:5px;z-index:9999;display:none}
.act-menu.show{display:block}
.act-menu a,.act-menu button{display:flex;align-items:center;gap:10px;width:100%;padding:8px 11px;border:none;background:transparent;font-size:11.5px;color:#334155;border-radius:6px;text-decoration:none;cursor:pointer;text-align:left;font-weight:500}
.act-menu a:hover,.act-menu button:hover{background:#F8FAFC;color:#0A1628}
.act-menu a i,.act-menu button i{width:14px;font-size:12px;color:#64748B;flex-shrink:0}
.act-menu .sep{height:1px;background:#F1F5F9;margin:3px 5px}
.act-menu .danger{color:#DC2626}
.act-menu .danger i{color:#DC2626}
.act-menu .danger:hover{background:#FEF2F2;color:#DC2626}
.footer-add{padding:12px 16px;text-align:center}
.btn-dash-add{display:inline-flex;align-items:center;gap:6px;padding:9px 20px;border:1.5px dashed #CBD5E1;border-radius:8px;background:#FAFBFC;color:#64748B;font-size:11.5px;font-weight:600;text-decoration:none;transition:all .15s;cursor:pointer;width:100%;justify-content:center}
.btn-dash-add:hover{border-color:#F5A623;color:#D97706;background:#FFF8EC}
.btn-dash-add i{font-size:12px}
.empty-state{padding:40px 16px;text-align:center}
.empty-state .empty-icon{font-size:38px;color:#E2E8F0;display:block;margin-bottom:10px}
.empty-state h4{font-size:13px;font-weight:700;color:#0A1628;margin-bottom:4px}
.empty-state p{color:#64748B;font-size:10.5px;max-width:320px;margin:0 auto 12px auto}
.pm-modal .modal-content{border:0;border-radius:12px;box-shadow:0 20px 60px rgba(15,23,42,.25);overflow:hidden}
.pm-modal .modal-header{background:#0A1628;color:#fff;padding:14px 20px;border:0}
.pm-modal .modal-header h5{font-size:14px;font-weight:700;margin:0;display:flex;align-items:center}
.pm-modal .modal-header h5 i{color:#F5A623;margin-right:8px}
.pm-modal .modal-header .btn-close{filter:invert(1);opacity:.7}
.pm-modal .modal-body{padding:18px 22px;max-height:75vh;overflow-y:auto}
.pm-modal .form-label{font-size:11px;font-weight:600;color:#475569;margin-bottom:3px}
.pm-modal .form-control,.pm-modal .form-select{font-size:12px;padding:7px 11px;min-height:34px;border-radius:6px;border:1px solid #dde4ec}
.pm-modal .btn-gold{background:#F5A623;border-color:#F5A623;color:#0A1628;font-weight:700;font-size:12px}
.toast-holder{position:fixed;top:20px;right:20px;z-index:99999;display:flex;flex-direction:column;gap:8px}
.toast-item{background:#fff;border-left:4px solid #10b981;border-radius:8px;box-shadow:0 8px 24px rgba(15,23,42,.15);padding:12px 16px;min-width:280px;display:flex;align-items:center;gap:10px;font-size:12px}
.toast-item.error{border-left-color:#ef4444}
.toast-item i{font-size:16px;color:#10b981}
.toast-item.error i{color:#ef4444}
.toast-item .msg{font-weight:600;color:#0A1628}
</style>

<div class="toast-holder" id="toastHolder"></div>

<div class="mod-page">
    <div class="row g-3">
        <div class="col-xl-3 col-lg-3 col-md-6 col-12"><div class="kpi-card total"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Total Companies</p><h2 class="kpi-number" id="kpiTotal">-</h2><span class="kpi-trend neutral"><i class="bi bi-dash-circle"></i> Total registered</span></div><div class="kpi-icon blue"><i class="bi bi-building"></i></div></div></div></div>
        <div class="col-xl-3 col-lg-3 col-md-6 col-12"><div class="kpi-card active"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Active Companies</p><h2 class="kpi-number" id="kpiActive">-</h2><span class="kpi-trend up"><i class="bi bi-check-circle"></i> Currently active</span></div><div class="kpi-icon green"><i class="bi bi-check-circle"></i></div></div></div></div>
        <div class="col-xl-3 col-lg-3 col-md-6 col-12"><div class="kpi-card inactive"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Inactive Companies</p><h2 class="kpi-number" id="kpiInactive">-</h2><span class="kpi-trend neutral"><i class="bi bi-dash-circle"></i> Currently inactive</span></div><div class="kpi-icon orange"><i class="bi bi-x-circle"></i></div></div></div></div>
        <div class="col-xl-3 col-lg-3 col-md-6 col-12"><div class="kpi-card month"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Added This Month</p><h2 class="kpi-number" id="kpiMonth">-</h2><span class="kpi-trend neutral"><i class="bi bi-calendar3"></i> This month</span></div><div class="kpi-icon purple"><i class="bi bi-calendar-plus"></i></div></div></div></div>
    </div>

    <!-- QUICK ACTIONS -->
    <div class="panel">
        <div class="panel-head">
            <div>
                <h5 class="ttl"><i class="bi bi-lightning-charge-fill"></i> Quick Actions</h5>
                <div class="sub">Frequently used company management actions</div>
            </div>
        </div>
        <div class="qa-row">
            <button class="qa-btn dark" onclick="openAddCompanyModal()"><i class="bi bi-plus-lg"></i> Add Company</button>
            <a href="/Company" class="qa-btn"><i class="bi bi-buildings"></i> All Companies</a>
            <a href="/Branch" class="qa-btn"><i class="bi bi-diagram-3"></i> Branches</a>
            <a href="/Department" class="qa-btn"><i class="bi bi-people"></i> Departments</a>
        </div>
    </div>

    <!-- RECENTLY ADDED COMPANIES -->
    <div class="panel">
        <div class="panel-head">
            <h5 class="ttl"><i class="bi bi-clock-history"></i> Recently Added Companies <span class="badge-count" id="companyCount">0</span></h5>
            <div class="search-wrap"><i class="bi bi-search"></i><input type="text" id="tableSearch" placeholder="Search company or registration" onkeyup="filterList()" /></div>
        </div>
        <div id="listBody">
            <div class="text-center py-4"><div class="spinner-border text-warning" style="width:22px;height:22px;"></div></div>
        </div>
        <div id="emptyState" class="empty-state d-none">
            <i class="bi bi-building empty-icon"></i>
            <h4>No Companies Yet</h4>
            <p>Start by registering your first company to see it here.</p>
        </div>
        <div class="footer-add">
            <button class="btn-dash-add" onclick="openAddCompanyModal()"><i class="bi bi-plus-circle"></i> Add Another Company</button>
        </div>
    </div>
</div>

<div class="modal fade pm-modal" id="addCompanyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5><i class="bi bi-building-add"></i> Register New Company</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body" id="addCompanyModalBody"><div class="text-center py-4"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted" style="font-size:11px;">Loading...</p></div></div>
        </div>
    </div>
</div>
<div class="modal fade pm-modal" id="editCompanyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header"><h5><i class="bi bi-pencil-square"></i> Edit Company</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body" id="editCompanyModalBody"><div class="text-center py-4"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted" style="font-size:11px;">Loading...</p></div></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function tk(){var e=document.querySelector('input[name="__RequestVerificationToken"]');return e?e.value:'';}
function showToast(msg,type){var h=document.getElementById('toastHolder');var d=document.createElement('div');d.className='toast-item '+(type||'success');var ic=type==='error'?'bi-x-circle-fill':'bi-check-circle-fill';d.innerHTML='<i class="bi '+ic+'"></i><span class="msg">'+msg+'</span>';h.appendChild(d);setTimeout(function(){d.style.transition='opacity .4s';d.style.opacity='0';setTimeout(function(){d.remove();},400);},3500);}
window.openAddCompanyModal=function(){var el=document.getElementById('addCompanyModal');var body=document.getElementById('addCompanyModalBody');body.innerHTML='<div class="text-center py-4"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted" style="font-size:11px;">Loading...</p></div>';new bootstrap.Modal(el).show();fetch('/Company/AddCompanyPartial').then(function(r){return r.text();}).then(function(h){body.innerHTML=h;});};
window.openEditCompanyModal=function(id){var el=document.getElementById('editCompanyModal');var body=document.getElementById('editCompanyModalBody');body.innerHTML='<div class="text-center py-4"><div class="spinner-border text-primary"></div><p class="mt-2 text-muted" style="font-size:11px;">Loading...</p></div>';new bootstrap.Modal(el).show();fetch('/Company/EditCompanyPartial?id='+id).then(function(r){return r.text();}).then(function(h){body.innerHTML=h;});};
function loadStats(){fetch('/Company/GetStatistics').then(function(r){return r.json();}).then(function(d){document.getElementById('kpiTotal').textContent=d.total||0;document.getElementById('kpiActive').textContent=d.active||0;document.getElementById('kpiInactive').textContent=d.inactive||0;document.getElementById('kpiMonth').textContent=d.addedThisMonth||0;});}
function loadList(){fetch('/Company/GetAllCompanies').then(function(r){return r.json();}).then(function(d){
    var body=document.getElementById('listBody'),empty=document.getElementById('emptyState');
    if(!d||d.length===0){body.innerHTML='';body.classList.add('d-none');empty.classList.remove('d-none');document.getElementById('companyCount').textContent='0';return;}
    body.classList.remove('d-none');empty.classList.add('d-none');
    var h='';var idx=0;
    d.forEach(function(c){
        var st=c.isActive?'active':'inactive';
        var ini=(c.companyName||'CO').substring(0,2).toUpperCase();
        var dt=c.createdDate?new Date(c.createdDate).toLocaleDateString('en-GB',{day:'2-digit',month:'short',year:'numeric'}):'-';
        var alt=(idx%2===1)?'alt':'';
        h+='<div class="list-row" data-name="'+((c.companyName||'')+' '+(c.registrationNo||'')).toLowerCase()+'">';
        h+='<div class="avatar-sq '+alt+'">'+ini+'</div>';
        h+='<div class="row-main">';
        h+='<div class="row-name">'+c.companyName+' <span class="badge-status '+st+'">'+(c.isActive?'Active':'Inactive')+'</span></div>';
        h+='<div class="row-meta">'+(c.registrationNo||'N/A')+' <span class="dot">·</span> '+dt+'</div>';
        h+='</div>';
        h+='<div class="row-actions"><div class="act-wrap"><button class="btn-icon" onclick="toggleMenu('+c.companyId+',event)"><i class="bi bi-three-dots-vertical"></i></button><div class="act-menu" id="menu-'+c.companyId+'">';
        h+='<a href="/Company/Profile/'+c.companyId+'"><i class="bi bi-eye"></i> View Profile</a>';
        h+='<button onclick="openEditCompanyModal('+c.companyId+')"><i class="bi bi-pencil"></i> Edit</button>';
        h+='<button onclick="toggleCompany('+c.companyId+')"><i class="bi bi-power"></i> '+(c.isActive?'Deactivate':'Activate')+'</button>';
        h+='<div class="sep"></div>';
        h+='<button class="danger" onclick="deleteCompany('+c.companyId+',\''+(c.companyName||'').replace(/'/g,"")+'\')"><i class="bi bi-trash3"></i> Delete</button>';
        h+='</div></div></div></div>';
        idx++;
    });
    body.innerHTML=h;
    document.getElementById('companyCount').textContent=d.length;
});}
window.toggleMenu=function(id,e){
    e.stopPropagation();
    document.querySelectorAll('.act-menu').forEach(function(m){if(m.id!=='menu-'+id)m.classList.remove('show');});
    var el=document.getElementById('menu-'+id);
    if(!el) return;
    if(el.classList.contains('show')){el.classList.remove('show');return;}
    var btn=e.currentTarget||e.target;
    var rect=btn.getBoundingClientRect();
    el.style.top=(rect.bottom+4)+'px';
    el.style.right=(window.innerWidth-rect.right)+'px';
    el.style.left='auto';
    el.classList.add('show');
    // auto-flip if too low
    var menuH=el.offsetHeight;
    if(rect.bottom+menuH+10>window.innerHeight){
        el.style.top=(rect.top-menuH-4)+'px';
    }
};
document.addEventListener('click',function(){document.querySelectorAll('.act-menu').forEach(function(m){m.classList.remove('show');});});
window.deleteCompany=function(id,name){if(!confirm('Delete company "'+name+'"?'))return;var fd=new FormData();fd.append('__RequestVerificationToken',tk());fetch('/Company/Delete/'+id,{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){if(res.success){showToast(res.message||'Deleted','success');loadList();loadStats();}});};
window.toggleCompany=function(id){var fd=new FormData();fd.append('__RequestVerificationToken',tk());fetch('/Company/ToggleActive/'+id,{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){if(res.success){showToast(res.message||'Updated','success');loadList();loadStats();}});};
window.filterList=function(){var f=document.getElementById('tableSearch').value.toLowerCase();var rows=document.querySelectorAll('.list-row');rows.forEach(function(r){var n=r.getAttribute('data-name')||'';r.style.display=(f===''||n.indexOf(f)>-1)?'':'none';});};
/* ===== MODAL FORM SUBMIT HANDLER ===== */
document.addEventListener('submit', function(e){
    var f = e.target;
    if(!f || !f.id) return;

    if(f.id === 'addCompanyForm' || f.id === 'editCompanyForm'){
        e.preventDefault();
        var isAdd = (f.id === 'addCompanyForm');
        var ab = document.getElementById(isAdd ? 'addFormAlert' : 'editFormAlert');
        var modalId = isAdd ? 'addCompanyModal' : 'editCompanyModal';
        var btn = f.querySelector('button[type="submit"]');
        var orig = btn ? btn.textContent : '';
        if(ab) ab.style.display='none';
        if(btn){ btn.disabled=true; btn.textContent = isAdd ? 'Saving...' : 'Updating...'; }

        fetch(f.action,{method:'POST',body:new FormData(f)})
            .then(function(r){ return r.json(); })
            .then(function(res){
                if(res.success){
                    var m = bootstrap.Modal.getInstance(document.getElementById(modalId));
                    if(m) m.hide();
                    showToast(res.message || (isAdd ? 'Company registered successfully' : 'Company updated successfully'), 'success');
                    if(typeof loadList==='function') loadList();
                    if(typeof loadStats==='function') loadStats();
                } else {
                    if(ab){ ab.textContent = res.message || 'Save failed'; ab.style.display='block'; }
                }
            })
            .catch(function(){ if(ab){ ab.textContent='Network error. Please try again.'; ab.style.display='block'; }})
            .finally(function(){ if(btn){ btn.disabled=false; btn.textContent=orig; }});
    }
});
/* ===== END MODAL FORM SUBMIT HANDLER ===== */
document.addEventListener('DOMContentLoaded',function(){loadStats();loadList();});
</script>
}


