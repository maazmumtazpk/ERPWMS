@model ERPWMS.Database.Models.Company
@{
    ViewData["Title"] = "Company - " + Model.CompanyName;
    Layout = "_Layout";
    int branchCount = (int)(ViewBag.BranchCount ?? 0);
    int deptCount = (int)(ViewBag.DepartmentCount ?? 0);
}
<style>
.bp-wrap{max-width:1200px;margin:0 auto;padding:10px 16px 40px}
.bp-hero{background:linear-gradient(135deg,#0A1628 0%,#1a2a4a 100%);border-radius:14px;padding:22px 26px;color:#fff;position:relative;overflow:hidden;margin-bottom:20px}
.bp-hero::after{content:"";position:absolute;right:-60px;top:-60px;width:220px;height:220px;border-radius:50%;background:rgba(245,166,35,.12)}
.bp-hero-inner{display:flex;align-items:center;gap:18px;position:relative;z-index:2;flex-wrap:wrap}
.bp-avatar{width:68px;height:68px;border-radius:14px;background:#F5A623;color:#0A1628;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:800;flex-shrink:0}
.bp-hero-info{flex:1;min-width:240px}
.bp-hero-info h2{font-size:20px;font-weight:800;margin:0 0 6px}
.bp-hero-meta{display:flex;flex-wrap:wrap;gap:14px;font-size:11.5px;opacity:.9}
.bp-hero-meta i{color:#F5A623;margin-right:4px}
.bp-status{display:inline-flex;align-items:center;gap:5px;padding:3px 10px;border-radius:20px;font-size:10.5px;font-weight:700;text-transform:uppercase}
.bp-status.active{background:rgba(16,185,129,.20);color:#6ee7b7}
.bp-status.inactive{background:rgba(239,68,68,.20);color:#fca5a5}
.bp-btn{display:inline-flex;align-items:center;gap:5px;padding:8px 14px;border-radius:8px;font-size:11.5px;font-weight:600;text-decoration:none;border:0;cursor:pointer}
.bp-btn.ghost{background:rgba(255,255,255,.10);color:#fff;border:1px solid rgba(255,255,255,.22)}
.bp-btn.gold{background:#F5A623;color:#0A1628}
.bp-stats{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-bottom:20px;max-width:720px}
.bp-stat{background:#fff;border:1px solid #e8edf3;border-radius:12px;padding:20px;display:flex;align-items:center;gap:16px;text-decoration:none;color:inherit}
.bp-stat:hover{transform:translateY(-2px);box-shadow:0 8px 22px rgba(15,23,42,.09);color:inherit}
.bp-stat-icon{width:52px;height:52px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0}
.bp-stat-icon.blue{background:#dbeafe;color:#2563eb}
.bp-stat-icon.purple{background:#ede9fe;color:#7c3aed}
.bp-stat-info h3{font-size:28px;font-weight:800;margin:0;color:#0A1628;line-height:1.1}
.bp-stat-info small{font-size:11px;color:#64748b;text-transform:uppercase;font-weight:700;letter-spacing:.4px}
.bp-card{background:#fff;border:1px solid #e8edf3;border-radius:12px;overflow:hidden;max-width:900px;margin:0 auto 16px}
.bp-card-header{padding:13px 20px;border-bottom:1px solid #eef2f6;background:#fafbfc}
.bp-card-header h6{font-size:13px;font-weight:700;color:#0A1628;margin:0}
.bp-card-header h6 i{color:#F5A623;margin-right:6px}
.bp-card-body{padding:18px 24px}
.bp-info-table{width:100%;border-collapse:collapse}
.bp-info-table tr{border-bottom:1px solid #f3f4f6}
.bp-info-table td{padding:12px 0;font-size:12.5px}
.bp-info-table td:first-child{color:#64748b;font-weight:600;width:38%}
</style>
<div class="bp-wrap">
<div class="bp-hero">
<div class="bp-hero-inner">
<div class="bp-avatar">@(Model.CompanyName.Length >= 2 ? Model.CompanyName.Substring(0,2).ToUpper() : Model.CompanyName.ToUpper())</div>
<div class="bp-hero-info">
<h2>@Model.CompanyName</h2>
<div class="bp-hero-meta">
<span><i class="bi bi-hash"></i> ID: @Model.CompanyId</span>
@if(!string.IsNullOrEmpty(Model.RegistrationNo)){ <span><i class="bi bi-tag"></i> @Model.RegistrationNo</span> }
<span><i class="bi bi-envelope"></i> @(Model.Email ?? "N/A")</span>
<span class="bp-status @((Model.IsActive == true) ? "active" : "inactive")">@((Model.IsActive == true) ? "Active" : "Inactive")</span>
</div>
</div>
<a href="/Company/Index" class="bp-btn ghost"><i class="bi bi-arrow-left"></i> Back to List</a>
<button class="bp-btn gold" onclick="toggleStatus(@Model.CompanyId)"><i class="bi bi-power"></i> @((Model.IsActive == true) ? "Deactivate" : "Activate")</button>
</div>
</div>
<div class="bp-stats">
<a href="/Branch/Index?companyId=@Model.CompanyId" class="bp-stat">
<div class="bp-stat-icon blue"><i class="bi bi-diagram-3"></i></div>
<div class="bp-stat-info"><h3>@branchCount</h3><small>Branches</small></div>
</a>
<a href="/Department/Index?companyId=@Model.CompanyId" class="bp-stat">
<div class="bp-stat-icon purple"><i class="bi bi-people"></i></div>
<div class="bp-stat-info"><h3>@deptCount</h3><small>Departments</small></div>
</a>
</div>
<div class="bp-card">
<div class="bp-card-header"><h6><i class="bi bi-info-circle"></i> Company Details</h6></div>
<div class="bp-card-body">
<table class="bp-info-table">
<tr><td>Company Name</td><td>@Model.CompanyName</td></tr>
<tr><td>Registration No.</td><td>@(string.IsNullOrEmpty(Model.RegistrationNo) ? "-" : Model.RegistrationNo)</td></tr>
<tr><td>Email</td><td>@(string.IsNullOrEmpty(Model.Email) ? "-" : Model.Email)</td></tr>
<tr><td>Phone</td><td>@(string.IsNullOrEmpty(Model.Phone) ? "-" : Model.Phone)</td></tr>
<tr><td>Address</td><td>@(string.IsNullOrEmpty(Model.Address) ? "-" : Model.Address)</td></tr>
<tr><td>Created By</td><td>@(Model.CreatedByName ?? "-")</td></tr>
<tr><td>Created Date</td><td>@(Model.CreatedDate?.ToString("dd MMM yyyy, hh:mm tt") ?? "-")</td></tr>
</table>
</div>
</div>
</div>
<form id="__mainAntiforgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>
@section Scripts {
<script>
function tk(){var e=document.querySelector('input[name="__RequestVerificationToken"]');return e?e.value:'';}
function toggleStatus(id){var fd=new FormData();fd.append('__RequestVerificationToken',tk());fetch('/Company/ToggleActive/'+id,{method:'POST',body:fd}).then(function(){location.reload();});}
</script>
}
