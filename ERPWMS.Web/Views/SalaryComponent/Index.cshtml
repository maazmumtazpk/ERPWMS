@{
    ViewData["Title"] = "Salary Components";
    Layout = "_Layout";
}
<form id="__af" style="display:none;">@Html.AntiForgeryToken()</form>
<div class="toast-holder" id="toastHolder"></div>
@await Html.PartialAsync("_AdminCss")
<div style="padding-bottom:30px;">
<div class="table-card">
    <div class="card-header-custom">
        <h5><i class="bi bi-list-check" style="color:#F5A623;"></i> Salary Components</h5>
        <button type="button" class="btn-icon gold" onclick="openAdd()"><i class="bi bi-plus-circle"></i></button>
    </div>
    <div class="card-body">
        <table class="table-premium" id="xTable">
            <thead><tr><th>Code</th><th>Name</th><th>Type</th><th>Calc</th><th>Amount</th><th>Taxable</th><th>Status</th><th style="text-align:right;">Actions</th></tr></thead>
            <tbody id="xBody"></tbody>
        </table>
    </div>
</div>
</div>
<div class="modal fade pm-modal" id="formModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 id="mTitle">Salary Component</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">
<input type="hidden" id="componentId" value="0" />
<div class="row g-3">
<div class="col-md-6"><label class="form-label">Code *</label><input type="text" id="componentCode" class="form-control" maxlength="50" /></div>
<div class="col-md-6"><label class="form-label">Name *</label><input type="text" id="componentName" class="form-control" maxlength="100" /></div>
<div class="col-md-4"><label class="form-label">Component Type</label><select id="componentType" class="form-control"><option>Earning</option><option>Deduction</option></select></div>
<div class="col-md-4"><label class="form-label">Calculation</label><select id="calculationType" class="form-control"><option>Fixed</option><option>Percentage</option><option>Formula</option></select></div>
<div class="col-md-4"><label class="form-label">Amount</label><input type="number" id="amount" class="form-control" step="0.01" /></div>
<div class="col-md-4"><label class="form-label">Display Order</label><input type="number" id="displayOrder" class="form-control" value="0" /></div>
<div class="col-md-4"><div class="form-check form-switch" style="padding-top:22px;"><input class="form-check-input" type="checkbox" id="isTaxable" checked /><label class="form-check-label">Taxable</label></div></div>
<div class="col-md-4"><div class="form-check form-switch" style="padding-top:22px;"><input class="form-check-input" type="checkbox" id="isEarning" checked /><label class="form-check-label">Earning</label></div></div>
<div class="col-md-6"><div class="form-check form-switch" style="padding-top:22px;"><input class="form-check-input" type="checkbox" id="showInPayslip" checked /><label class="form-check-label">Show in Payslip</label></div></div>
<div class="col-md-6"><div class="form-check form-switch" style="padding-top:22px;"><input class="form-check-input" type="checkbox" id="isActive" checked /><label class="form-check-label">Active</label></div></div>
<div class="col-12"><label class="form-label">Description</label><textarea id="description" class="form-control" rows="2"></textarea></div>
</div>
</div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn-gold" onclick="save_()">Save</button></div></div></div></div>
@await Html.PartialAsync("_AdminJs")
<script>
function tk(){var i=document.querySelector('#__af input[name="__RequestVerificationToken"]');return i?i.value:'';}
function openAdd(){
    document.getElementById('mTitle').textContent='Add Component';
    document.getElementById('componentId').value=0;
    ['componentCode','componentName','amount','description'].forEach(function(id){document.getElementById(id).value='';});
    document.getElementById('componentType').value='Earning';
    document.getElementById('calculationType').value='Fixed';
    document.getElementById('displayOrder').value=0;
    document.getElementById('isTaxable').checked=true;
    document.getElementById('isEarning').checked=true;
    document.getElementById('showInPayslip').checked=true;
    document.getElementById('isActive').checked=true;
    new bootstrap.Modal(document.getElementById('formModal')).show();
}
function edit_(id){
    fetch('/SalaryComponent/GetById?id='+id).then(function(r){return r.json();}).then(function(d){
        document.getElementById('mTitle').textContent='Edit Component';
        document.getElementById('componentId').value=d.componentId;
        document.getElementById('componentCode').value=d.componentCode;
        document.getElementById('componentName').value=d.componentName;
        document.getElementById('componentType').value=d.componentType;
        document.getElementById('calculationType').value=d.calculationType;
        document.getElementById('amount').value=d.amount||'';
        document.getElementById('displayOrder').value=d.displayOrder;
        document.getElementById('isTaxable').checked=d.isTaxable;
        document.getElementById('isEarning').checked=d.isEarning;
        document.getElementById('showInPayslip').checked=d.showInPayslip;
        document.getElementById('isActive').checked=d.isActive;
        document.getElementById('description').value=d.description||'';
        new bootstrap.Modal(document.getElementById('formModal')).show();
    });
}
function save_(){
    var fd=new FormData();
    fd.append('__RequestVerificationToken',tk());
    fd.append('componentId',document.getElementById('componentId').value);
    fd.append('componentCode',document.getElementById('componentCode').value);
    fd.append('componentName',document.getElementById('componentName').value);
    fd.append('componentType',document.getElementById('componentType').value);
    fd.append('calculationType',document.getElementById('calculationType').value);
    fd.append('amount',document.getElementById('amount').value);
    fd.append('percentage','');
    fd.append('isTaxable',document.getElementById('isTaxable').checked);
    fd.append('isEarning',document.getElementById('isEarning').checked);
    fd.append('displayOrder',document.getElementById('displayOrder').value);
    fd.append('showInPayslip',document.getElementById('showInPayslip').checked);
    fd.append('description',document.getElementById('description').value);
    fd.append('isActive',document.getElementById('isActive').checked);
    fetch('/SalaryComponent/Save',{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){
        if(res.success){showToast(res.message,'success'); bootstrap.Modal.getInstance(document.getElementById('formModal')).hide(); reload_();}
        else showToast(res.message,'error');
    });
}
function del_(id){ if(!confirm('Delete?')) return; var fd=new FormData(); fd.append('__RequestVerificationToken',tk()); fetch('/SalaryComponent/Delete/'+id,{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){if(res.success){showToast(res.message,'success'); reload_();}}); }
function reload_(){
    fetch('/SalaryComponent/GetAll').then(function(r){return r.json();}).then(function(d){
        var b=document.getElementById('xBody');
        if(!d||d.length===0){b.innerHTML='<tr><td colspan="8" class="text-center">No components</td></tr>'; return;}
        var h='';
        d.forEach(function(x){
            h+='<tr><td>'+x.componentCode+'</td><td>'+x.componentName+'</td><td>'+x.componentType+'</td><td>'+x.calculationType+'</td><td>'+(x.amount||'-')+'</td><td>'+(x.isTaxable?'Yes':'No')+'</td><td>'+(x.isActive?'<span class="badge-status active">Active</span>':'<span class="badge-status inactive">Inactive</span>')+'</td>';
            h+='<td style="text-align:right;"><button class="btn-icon" onclick="edit_('+x.componentId+')"><i class="bi bi-pencil"></i></button> <button class="btn-icon" onclick="del_('+x.componentId+')"><i class="bi bi-trash3"></i></button></td></tr>';
        });
        b.innerHTML=h;
    });
}
document.addEventListener('DOMContentLoaded', reload_);
</script>
