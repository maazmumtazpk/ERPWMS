@model ERPWMS.Application.Queries.Customer.SearchCustomers.SearchCustomersResult
@{
    ViewData["Title"] = "Search Customers";
    var searchTerm = ViewBag.SearchTerm as string;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Search Results</h5>
                    <a asp-action="Index" class="btn btn-secondary btn-sm">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                </div>
                <div class="card-body">
                    <!-- Search Box -->
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <form asp-action="Search" method="get" class="d-flex">
                                <input type="text" name="searchTerm" class="form-control form-control-sm me-2" placeholder="Search customers..." value="@searchTerm" />
                                <button type="submit" class="btn btn-outline-primary btn-sm">Search</button>
                            </form>
                        </div>
                        <div class="col-md-6 text-end">
                            <span class="text-muted">Found @Model.TotalCount results</span>
                        </div>
                    </div>

                    <!-- Results -->
                    @if (Model.Customers.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped">
                                <thead>
                                    <tr>
                                        <th>Code</th>
                                        <th>Name</th>
                                        <th>Contact Person</th>
                                        <th>Phone</th>
                                        <th>City</th>
                                        <th>Status</th>
                                        <th>Contacts</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var customer in Model.Customers)
                                    {
                                        <tr>
                                            <td>@customer.CustomerCode</td>
                                            <td>@customer.CustomerName</td>
                                            <td>@customer.ContactPerson</td>
                                            <td>@customer.Phone</td>
                                            <td>@customer.City</td>
                                            <td>
                                                @if (customer.IsDeleted == true)
                                                {
                                                    <span class="badge bg-danger">Deleted</span>
                                                }
                                                else if (customer.IsActive == true)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning">Inactive</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@customer.ContactCount</span>
                                            </td>
                                            <td>
                                                <a asp-action="Details" asp-route-id="@customer.CustomerId" class="btn btn-sm btn-info">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        @if (Model.TotalPages > 1)
                        {
                            <div class="row">
                                <div class="col-12">
                                    <nav>
                                        <ul class="pagination justify-content-center">
                                            <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                                                <a class="page-link" href="@Url.Action("Search", new { searchTerm = searchTerm, page = Model.Page - 1, pageSize = Model.PageSize })">Previous</a>
                                            </li>
                                            @for (int i = 1; i <= Model.TotalPages; i++)
                                            {
                                                <li class="page-item @(i == Model.Page ? "active" : "")">
                                                    <a class="page-link" href="@Url.Action("Search", new { searchTerm = searchTerm, page = i, pageSize = Model.PageSize })">@i</a>
                                                </li>
                                            }
                                            <li class="page-item @(Model.HasNext ? "" : "disabled")">
                                                <a class="page-link" href="@Url.Action("Search", new { searchTerm = searchTerm, page = Model.Page + 1, pageSize = Model.PageSize })">Next</a>
                                            </li>
                                        </ul>
                                    </nav>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info">
                            No customers found matching your search criteria.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
