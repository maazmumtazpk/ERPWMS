@model ERPWMS.Application.DTOs.Supplier.SupplierDto
@{
    ViewData["Title"] = "Supplier Details";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Supplier Details - @Model.SupplierName</h5>
                    <div>
                        @if (Model.IsDeleted != true)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.SupplierId" class="btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i> Edit
                            </a>
                            if ((Model.IsActive == true))
                            {
                                <button onclick="deactivateSupplier(@Model.SupplierId)" class="btn btn-danger btn-sm">
                                    <i class="fas fa-ban"></i> Deactivate
                                </button>
                            }
                            else
                            {
                                <button onclick="activateSupplier(@Model.SupplierId)" class="btn btn-success btn-sm">
                                    <i class="fas fa-check"></i> Activate
                                </button>
                            }
                        }
                        <a asp-action="Index" class="btn btn-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> Back
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <!-- Status -->
                    <div class="alert @((Model.IsDeleted == true) ? "alert-danger" : (Model.IsActive == true) ? "alert-success" : "alert-warning")">
                        <strong>Status:</strong>
                        @if ((Model.IsDeleted == true))
                        {
                            <span>Deleted</span>
                        }
                        else if ((Model.IsActive == true))
                        {
                            <span>Active</span>
                        }
                        else
                        {
                            <span>Inactive</span>
                        }
                    </div>

                    <!-- Details -->
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Supplier Code</dt>
                                <dd class="col-sm-8">@Model.SupplierCode</dd>

                                <dt class="col-sm-4">Contact Person</dt>
                                <dd class="col-sm-8">@Model.ContactPerson</dd>

                                <dt class="col-sm-4">Phone</dt>
                                <dd class="col-sm-8">@Model.Phone</dd>

                                <dt class="col-sm-4">Mobile</dt>
                                <dd class="col-sm-8">@Model.Mobile</dd>

                                <dt class="col-sm-4">Email</dt>
                                <dd class="col-sm-8">@Model.Email</dd>

                                <dt class="col-sm-4">Website</dt>
                                <dd class="col-sm-8">@Model.Website</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">Address</dt>
                                <dd class="col-sm-8">@Model.Address</dd>

                                <dt class="col-sm-4">City</dt>
                                <dd class="col-sm-8">@Model.City</dd>

                                <dt class="col-sm-4">State</dt>
                                <dd class="col-sm-8">@Model.State</dd>

                                <dt class="col-sm-4">Country</dt>
                                <dd class="col-sm-8">@Model.Country</dd>

                                <dt class="col-sm-4">Postal Code</dt>
                                <dd class="col-sm-8">@Model.PostalCode</dd>
                            </dl>
                        </div>
                    </div>

                    <hr />

                    <!-- Financial Information -->
                    <div class="row">
                        <div class="col-md-6">
                            <h6>Financial Information</h6>
                            <dl class="row">
                                <dt class="col-sm-4">Tax ID</dt>
                                <dd class="col-sm-8">@Model.TaxId</dd>

                                <dt class="col-sm-4">NTN</dt>
                                <dd class="col-sm-8">@Model.NTN</dd>

                                <dt class="col-sm-4">Credit Limit</dt>
                                <dd class="col-sm-8">@(Model.CreditLimit.HasValue ? Model.CreditLimit.Value.ToString("N2") : "N/A")</dd>

                                <dt class="col-sm-4">Payment Terms</dt>
                                <dd class="col-sm-8">@Model.PaymentTerms</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <h6>Bank Information</h6>
                            <dl class="row">
                                <dt class="col-sm-4">Bank Name</dt>
                                <dd class="col-sm-8">@Model.BankName</dd>

                                <dt class="col-sm-4">Bank Account</dt>
                                <dd class="col-sm-8">@Model.BankAccountNo</dd>

                                <dt class="col-sm-4">Bank Branch</dt>
                                <dd class="col-sm-8">@Model.BankBranch</dd>
                            </dl>
                        </div>
                    </div>

                    <hr />

                    <!-- Contacts Section -->
                    <div class="row">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6>Contacts</h6>
                                @if (Model.IsDeleted != true && (Model.IsActive == true))
                                {
                                    <button onclick="showAddContact(@Model.SupplierId)" class="btn btn-primary btn-sm">
                                        <i class="fas fa-plus"></i> Add Contact
                                    </button>
                                }
                            </div>
                            <div id="contactsContainer">
                                @await Html.PartialAsync("_SupplierContacts", new ERPWMS.Application.Queries.Supplier.SupplierContact.GetSupplierContacts.GetSupplierContactsResult
                                {
                                    Contacts = Model.Contacts?.Select(c => new ERPWMS.Application.DTOs.Supplier.SupplierContactDto
                                    {
                                        ContactId = c.ContactId,
                                        SupplierId = c.SupplierId,
                                        ContactName = c.ContactName,
                                        Phone = c.Phone,
                                        Mobile = c.Mobile,
                                        Email = c.Email,
                                        Department = c.Department,
                                        IsPrimary = c.IsPrimary,
                                        IsActive = c.IsActive,
                                        CreatedDate = c.CreatedDate
                                    }).ToList() ?? new List<ERPWMS.Application.DTOs.Supplier.SupplierContactDto>(),
                                    TotalCount = Model.Contacts?.Count ?? 0,
                                    Page = 1,
                                    PageSize = 10
                                })
                            </div>
                        </div>
                    </div>

                    <!-- Audit Information -->
                    <hr />
                    <div class="row">
                        <div class="col-12">
                            <small class="text-muted">
                                Created: @Model.CreatedDate?.ToString("g") by User ID: @Model.CreatedBy<br />
                                @if (Model.UpdatedDate.HasValue)
                                {
                                    <span>Last Updated: @Model.UpdatedDate?.ToString("g") by User ID: @Model.UpdatedBy</span>
                                }
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Contact Modal -->
<div class="modal fade" id="contactModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="contactModalLabel">Manage Contact</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="contactModalBody">
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showAddContact(supplierId) {
            $.get('@Url.Action("AddContact", "Supplier")', { supplierId: supplierId }, function (data) {
                $('#contactModalBody').html(data);
                $('#contactModalLabel').text('Add Contact');
                $('#contactModal').modal('show');
            });
        }

        function showEditContact(contactId) {
            $.get('@Url.Action("EditContact", "Supplier")', { contactId: contactId }, function (data) {
                $('#contactModalBody').html(data);
                $('#contactModalLabel').text('Edit Contact');
                $('#contactModal').modal('show');
            });
        }

        function activateSupplier(id) {
            if (confirm('Are you sure you want to activate this supplier?')) {
                $.post('@Url.Action("Activate", "Supplier")', { id: id }, function (response) {
                    location.reload();
                });
            }
        }

        function deactivateSupplier(id) {
            if (confirm('Are you sure you want to deactivate this supplier?')) {
                $.post('@Url.Action("Deactivate", "Supplier")', { id: id }, function (response) {
                    location.reload();
                });
            }
        }

        function activateContact(contactId) {
            if (confirm('Are you sure you want to activate this contact?')) {
                $.post('@Url.Action("ActivateContact", "Supplier")', { contactId: contactId }, function (response) {
                    location.reload();
                });
            }
        }

        function deactivateContact(contactId) {
            if (confirm('Are you sure you want to deactivate this contact?')) {
                $.post('@Url.Action("DeactivateContact", "Supplier")', { contactId: contactId }, function (response) {
                    location.reload();
                });
            }
        }

        function setPrimaryContact(contactId) {
            $.post('@Url.Action("SetPrimaryContact", "Supplier")', { contactId: contactId }, function (response) {
                location.reload();
            });
        }
    </script>
}

