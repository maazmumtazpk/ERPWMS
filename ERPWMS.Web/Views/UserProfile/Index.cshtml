@{
    ViewData["Title"] = "User Profile";
    Layout = "_Layout";
    var userId = ViewBag.UserId ?? 0;
}
@await Html.PartialAsync("_AdminCss")

<div style="padding-bottom:30px;">
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0" style="color:#0A1628;font-size:18px;">User Profile</h4>
        <small class="text-muted" style="font-size:11px;">Home / Users / Profile</small>
    </div>
    <a href="/User/Index" class="btn-icon" style="width:auto;padding:0 12px;text-decoration:none;"><i class="bi bi-arrow-left me-1"></i> Back</a>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="table-card" style="margin-top:0;">
            <div style="padding:24px 20px;text-align:center;">
                <div style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,#DBEAFE,#BFDBFE);color:#1D4ED8;display:inline-flex;align-items:center;justify-content:center;font-size:28px;font-weight:800;" id="pAvatar">U</div>
                <h5 style="margin:14px 0 4px;font-size:16px;font-weight:800;color:#0A1628;" id="pName">Loading...</h5>
                <p style="margin:0;font-size:11px;color:#64748B;" id="pUsername"></p>
                <div style="margin-top:10px;"><span class="badge-status role" id="pRole">-</span></div>
            </div>
            <div style="border-top:1px solid #F1F5F9;padding:12px 20px;">
                <div style="display:flex;justify-content:space-between;font-size:11px;padding:6px 0;"><span style="color:#64748B;">Email</span><strong id="pEmail" style="color:#0A1628;">-</strong></div>
                <div style="display:flex;justify-content:space-between;font-size:11px;padding:6px 0;"><span style="color:#64748B;">Phone</span><strong id="pPhone" style="color:#0A1628;">-</strong></div>
                <div style="display:flex;justify-content:space-between;font-size:11px;padding:6px 0;"><span style="color:#64748B;">Status</span><span class="badge-status active" id="pStatus">-</span></div>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="row g-3">
            <div class="col-md-6"><div class="kpi-card total"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Workflow Assignments</p><h2 class="kpi-number" id="pAssign">0</h2></div><div class="kpi-icon blue"><i class="bi bi-person-check"></i></div></div></div></div>
            <div class="col-md-6"><div class="kpi-card active"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Actions Performed</p><h2 class="kpi-number" id="pActions">0</h2></div><div class="kpi-icon green"><i class="bi bi-journal-check"></i></div></div></div></div>
        </div>
        <div class="table-card">
            <div class="card-header-custom"><h5><i class="bi bi-clock-history" style="color:#F5A623;"></i> Recent Activity</h5></div>
            <div class="card-body">
                <table class="table-premium">
                    <thead><tr><th>Instance</th><th>Action</th><th>Stage</th><th>Date</th></tr></thead>
                    <tbody id="pActivity"><tr><td colspan="4" class="text-center py-3" style="color:#94A3B8;font-size:11px;">Loading...</td></tr></tbody>
                </table>
            </div>
        </div>
    </div>
</div>
</div>

<script>
(function(){
    var uid = @userId;
    var atSymbol = String.fromCharCode(64);

    fetch("/UserProfile/GetProfile?userId=" + uid)
        .then(function(r){ return r.json(); })
        .then(function(d){
            if(!d) return;
            document.getElementById("pAvatar").textContent = (d.userName || "U").substring(0,2).toUpperCase();
            document.getElementById("pName").textContent = d.fullName || d.userName || "-";
            document.getElementById("pUsername").textContent = atSymbol + (d.userName || "-");
            document.getElementById("pRole").textContent = d.roleName || "No Role";
            document.getElementById("pEmail").textContent = d.email || "-";
            document.getElementById("pPhone").textContent = d.phoneNumber || "-";
            document.getElementById("pStatus").textContent = d.isActive ? "Active" : "Inactive";
            document.getElementById("pStatus").className = "badge-status " + (d.isActive ? "active" : "inactive");
            document.getElementById("pAssign").textContent = d.assignments || 0;
            document.getElementById("pActions").textContent = d.actions || 0;
        });

    fetch("/UserProfile/GetActivity?userId=" + uid)
        .then(function(r){ return r.json(); })
        .then(function(d){
            var h = "";
            if(!d || d.length === 0){
                h = "<tr><td colspan='4' class='text-center py-3' style='color:#94A3B8;font-size:11px;'>No recent activity</td></tr>";
            } else {
                d.forEach(function(x){
                    var dt = x.actionDate ? new Date(x.actionDate).toLocaleDateString("en-GB",{day:"2-digit",month:"short",year:"numeric"}) : "-";
                    h += "<tr><td>#" + x.workflowInstId + "</td>";
                    h += "<td><span class='badge-status active'>" + (x.actionName || "-") + "</span></td>";
                    h += "<td>" + (x.toStage || "-") + "</td>";
                    h += "<td style='font-size:10px;color:#64748B;'>" + dt + "</td></tr>";
                });
            }
            document.getElementById("pActivity").innerHTML = h;
        });
})();
</script>
