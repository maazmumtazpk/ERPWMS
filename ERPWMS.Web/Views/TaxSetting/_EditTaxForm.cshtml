@model ERPWMS.Database.Models.TaxSetting
@{ Layout = null; }
<form id="editTaxForm" method="post" action="/TaxSetting/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="taxId" value="@Model.TaxId" />
    <div id="editTaxAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label fw-bold">Tax Name *</label><input type="text" name="taxName" class="form-control" value="@Model.TaxName" required maxlength="100" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Tax Code</label><input type="text" name="taxCode" class="form-control" value="@Model.TaxCode" maxlength="20" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Rate (%)</label><input type="number" step="0.01" name="taxRate" class="form-control" value="@Model.TaxRate" /></div>
        <div class="col-md-4"><div class="form-check form-switch" style="margin-top:24px;"><input type="checkbox" name="isDefault" value="true" class="form-check-input" @((Model.IsDefault == true) ? "checked" : "") /><label class="form-check-label" style="font-size:11.5px;">Default</label></div></div>
        <div class="col-md-4"><label class="form-label fw-bold">Status</label><select name="isActive" class="form-select">@if((Model.IsActive == true)){<option value="true" selected>Active</option><option value="false">Inactive</option>}else{<option value="true">Active</option><option value="false" selected>Inactive</option>}</select></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>
