@{
    Layout = null;
}
<form id="addTaxForm" method="post" action="/TaxSetting/Register">
    @Html.AntiForgeryToken()
    <div id="addTaxAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label fw-bold">Tax Name *</label><input type="text" name="taxName" class="form-control" required maxlength="100" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Tax Code</label><input type="text" name="taxCode" class="form-control" maxlength="20" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Rate (%)</label><input type="number" step="0.01" name="taxRate" class="form-control" value="0" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Effective From</label><input type="date" name="effectiveFrom" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Effective To</label><input type="date" name="effectiveTo" class="form-control" /></div>
        <div class="col-12"><div class="form-check form-switch"><input type="checkbox" name="isDefault" value="true" class="form-check-input" /><label class="form-check-label" style="font-size:11.5px;">Set as Default</label></div></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Create</button>
    </div>
</form>
