@{
    Layout = null;
}
<form id="addBrandForm" method="post" action="/Brand/Register">
    @Html.AntiForgeryToken()
    <div id="addBrandAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-12"><label class="form-label fw-bold">Brand Name *</label><input type="text" name="brandName" class="form-control" required maxlength="200" placeholder="Enter brand name" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Brand Code</label><input type="text" name="brandCode" class="form-control" maxlength="20" placeholder="BR-001" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Logo URL</label><input type="text" name="logoUrl" class="form-control" maxlength="300" placeholder="https://..." /></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Register</button>
    </div>
</form>
