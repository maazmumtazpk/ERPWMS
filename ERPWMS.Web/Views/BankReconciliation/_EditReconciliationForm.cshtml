@model ERPWMS.Database.Models.BankReconciliation
@{ Layout = null; }
<form id="editReconciliationForm" method="post" action="/BankReconciliation/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="reconciliationId" value="@Model.ReconciliationId" />
    <div id="editReconciliationAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label fw-bold">Statement Balance</label><input type="number" step="0.01" name="statementBalance" class="form-control" value="@Model.StatementBalance" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">System Balance</label><input type="number" step="0.01" name="systemBalance" class="form-control" value="@Model.SystemBalance" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Status</label><select name="status" class="form-select">@foreach(var s in new[]{"Pending","Reconciled","Disputed"}){if(Model.Status == s){<option value="@s" selected>@s</option>}else{<option value="@s">@s</option>}}</select></div>
        <div class="col-12"><label class="form-label fw-bold">Remarks</label><textarea name="remarks" class="form-control" rows="2">@Model.Remarks</textarea></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>
