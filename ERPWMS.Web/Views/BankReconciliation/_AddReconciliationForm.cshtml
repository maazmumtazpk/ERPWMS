@{
    Layout = null;
}
<form id="addReconciliationForm" method="post" action="/BankReconciliation/Register">
    @Html.AntiForgeryToken()
    <div id="addReconciliationAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label fw-bold">Bank Account *</label><select name="bankAccountId" id="addBank" class="form-select" required><option value="">Loading...</option></select></div>
        <div class="col-md-6"><label class="form-label fw-bold">Statement Date</label><input type="date" name="statementDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Statement Balance</label><input type="number" step="0.01" name="statementBalance" class="form-control" value="0" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">System Balance</label><input type="number" step="0.01" name="systemBalance" class="form-control" value="0" /></div>
        <div class="col-12"><label class="form-label fw-bold">Remarks</label><textarea name="remarks" class="form-control" rows="2"></textarea></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Create</button>
    </div>
</form>
<script>
fetch("/BankReconciliation/GetBanks").then(r=>r.json()).then(d=>{var s=document.getElementById("addBank");s.innerHTML="<option value=''>-- Select --</option>";(d||[]).forEach(x=>{var o=document.createElement("option");o.value=x.bankAccountId;o.textContent=x.accountTitle;s.appendChild(o);});});
</script>
