@model ERPWMS.Database.Models.Grn
@{
    Layout = null;
}
<style>
    .grn-f .form-label { font-size: 11px; font-weight: 600; color: #1e293b; margin-bottom: 3px; display: block; }
    .grn-f .form-control, .grn-f .form-select { font-size: 12px; padding: 6px 10px; min-height: 34px; border-radius: 6px; border: 1px solid #cbd5e1; }
    .grn-f .form-control[readonly] { background: #f1f5f9; }
    .grn-f .row.g-2 { --bs-gutter-y: 8px; --bs-gutter-x: 10px; }
    .grn-f .btn-gold { background:#F5A623;color:#0A1628;border:none;font-weight:700;padding:6px 16px;border-radius:6px;font-size:12px; }
    .grn-f .btn-ghost { background:#fff;color:#475569;border:1px solid #cbd5e1;padding:6px 16px;border-radius:6px;font-size:12px;font-weight:600; }
</style>

<form id="editForm" method="post" action="/GRN/Edit" autocomplete="off" class="grn-f">
    @Html.AntiForgeryToken()
    <input type="hidden" name="GrnId" value="@Model.GrnId" />
    <div id="editAlert" style="display:none;padding:8px 12px;border-radius:6px;font-size:11.5px;margin-bottom:12px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>

    <div class="row g-2">
        <div class="col-md-6">
            <label class="form-label">GRN No</label>
            <input type="text" name="GrnNo" class="form-control" readonly value="@Model.GrnNo" style="font-family:monospace;font-weight:700;" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Receipt Date</label>
            <input type="date" name="ReceiptDate" class="form-control" value="@(Model.ReceiptDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Purchase Order</label>
            <select name="PurchaseId" class="form-select">
                <option value="">-- Select PO --</option>
                @if(ViewBag.Purchases != null) { foreach(var p in ViewBag.Purchases) {
                    <option value="@p.purchaseId" selected="@(Model.PurchaseId == p.purchaseId)">@p.purchaseOrderNo</option>
                } }
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Warehouse</label>
            <select name="WarehouseId" class="form-select">
                <option value="">-- Select Warehouse --</option>
                @if(ViewBag.Warehouses != null) { foreach(var w in ViewBag.Warehouses) {
                    <option value="@w.warehouseId" selected="@(Model.WarehouseId == w.warehouseId)">@w.warehouseName</option>
                } }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Total Received</label>
            <input type="number" name="TotalReceivedQty" class="form-control" value="@Model.TotalReceivedQty" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Total Accepted</label>
            <input type="number" name="TotalAcceptedQty" class="form-control" value="@Model.TotalAcceptedQty" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Total Rejected</label>
            <input type="number" name="TotalRejectedQty" class="form-control" value="@(Model.TotalRejectedQty ?? 0)" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Status</label>
            <select name="Status" class="form-select">
                @foreach (var s in new[] { "Pending", "Approved", "Completed", "Cancelled" })
                {
                    if (Model.Status == s) { <option value="@s" selected>@s</option> }
                    else { <option value="@s">@s</option> }
                }
            </select>
        </div>
    </div>

    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold"><i class="bi bi-check-lg"></i> Update GRN</button>
    </div>
</form>