@model ERPWMS.Database.Models.SalesMaster
@{
    Layout = null;
    var details = ViewBag.Details as System.Collections.Generic.List<ERPWMS.Database.Models.SalesDetail>
                  ?? new System.Collections.Generic.List<ERPWMS.Database.Models.SalesDetail>();
}
<style>
    .so-f .form-label { font-size: 11px; font-weight: 600; color: #1e293b; margin-bottom: 3px; display: block; }
    .so-f .form-control, .so-f .form-select { font-size: 12px; padding: 6px 10px; min-height: 34px; border-radius: 6px; border: 1px solid #cbd5e1; }
    .so-f .form-control[readonly] { background: #f1f5f9; }
    .so-f .row.g-2 { --bs-gutter-y: 8px; --bs-gutter-x: 10px; }
    .so-f .item-row { padding: 10px 12px; background: #fafbfc; border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 8px; position: relative; }
    .so-f .btn-gold { background:#F5A623;color:#0A1628;border:none;font-weight:700;padding:6px 16px;border-radius:6px;font-size:12px; }
    .so-f .btn-ghost { background:#fff;color:#475569;border:1px solid #cbd5e1;padding:6px 16px;border-radius:6px;font-size:12px;font-weight:600; }
    .stock-box { margin-top: 6px; padding: 5px 9px; border-radius: 5px; font-size: 10.5px; font-weight: 600; display: none; }
    .stock-box.show { display: block; }
    .stock-box.ok { background: #DCFCE7; color: #15803D; border-left: 3px solid #22C55E; }
    .stock-box.low { background: #FEF3C7; color: #92400E; border-left: 3px solid #F59E0B; }
    .stock-box.out { background: #FEE2E2; color: #B91C1C; border-left: 3px solid #DC2626; }
    .item-del { position: absolute; top: 6px; right: 8px; font-size: 10px; color: #94A3B8; cursor: pointer; }
    .item-del:hover { color: #DC2626; }
</style>

<form id="editForm" method="post" action="/Sales/Edit" autocomplete="off" class="so-f">
    @Html.AntiForgeryToken()
    <input type="hidden" name="SalesId" value="@Model.SalesId" />
    <div id="editAlert" style="display:none;padding:8px 12px;border-radius:6px;font-size:11.5px;margin-bottom:12px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>

    <!-- --- HEADER FIELDS --- -->
    <div class="row g-2">
        <div class="col-md-4">
            <label class="form-label">SO Number</label>
            <input type="text" name="SalesOrderNo" class="form-control" readonly value="@Model.SalesOrderNo" style="font-family:monospace;font-weight:700;" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Order Date</label>
            <input type="date" name="OrderDate" class="form-control" value="@(Model.OrderDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Delivery Date</label>
            <input type="date" name="DeliveryDate" class="form-control" value="@(Model.DeliveryDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Customer</label>
            <select name="CustomerId" class="form-select" required>
                <option value="">-- Select --</option>
                @if(ViewBag.Customers != null) { foreach(var c in ViewBag.Customers) {
                    <option value="@c.customerId" selected="@(Model.CustomerId == c.customerId)">@c.customerName</option>
                } }
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Warehouse</label>
            <select name="WarehouseId" class="form-select" required>
                <option value="">-- Select --</option>
                @if(ViewBag.Warehouses != null) { foreach(var w in ViewBag.Warehouses) {
                    <option value="@w.warehouseId" selected="@(Model.WarehouseId == w.warehouseId)">@w.warehouseName</option>
                } }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Discount</label>
            <input type="number" step="0.01" name="Discount" class="form-control discount-input" value="@(Model.Discount ?? 0)" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Tax</label>
            <input type="number" step="0.01" name="TaxAmount" class="form-control tax-input" value="@(Model.TaxAmount ?? 0)" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Net Amount</label>
            <input type="text" class="form-control" id="netDisplay" readonly value="Rs @Model.NetAmount.ToString("N2")" style="background:#f0f9ff;font-weight:700;color:#0369a1;" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Status</label>
            <select name="Status" class="form-select">
                @foreach (var s in new[] { "Draft", "Pending", "Approved", "Completed", "Cancelled" })
                {
                    if (Model.Status == s) { <option value="@s" selected>@s</option> }
                    else { <option value="@s">@s</option> }
                }
            </select>
        </div>
    </div>

    <!-- --- ITEMS SECTION --- -->
    <div style="display:flex;justify-content:space-between;align-items:center;margin:16px 0 8px;">
        <span style="font-size:12px;font-weight:700;color:#0A1628;">
            <i class="bi bi-list-ul" style="color:#F5A623;"></i> Items 
            <span style="background:#F1F5F9;color:#64748B;font-size:9px;padding:1px 8px;border-radius:12px;">@details.Count</span>
        </span>
        <button type="button" class="btn btn-sm btn-gold" id="addItemBtn"><i class="bi bi-plus"></i> Add Item</button>
    </div>

    <div id="itemsContainer">
        @if (details.Count == 0)
        {
            <div class="item-row">
                <div class="row g-2">
                    <div class="col-md-5">
                        <label class="form-label">Product *</label>
                        <select name="SalesDetails[0].ProductId" class="form-select product-select" required>
                            <option value="">-- Select Product --</option>
                            @if(ViewBag.Products != null) { foreach(var p in ViewBag.Products) {
                                <option value="@p.productId">@p.productName</option>
                            } }
                        </select>
                        <div class="stock-box" id="stockBox_0"></div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Qty *</label>
                        <input type="number" name="SalesDetails[0].Quantity" class="form-control qty-input" min="1" value="1" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Price *</label>
                        <input type="number" step="0.01" name="SalesDetails[0].UnitPrice" class="form-control price-input" min="0" value="0" required />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Disc %</label>
                        <input type="number" step="0.01" name="SalesDetails[0].DiscountPercent" class="form-control disc-input" min="0" value="0" />
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <button type="button" class="btn btn-sm btn-danger remove-item w-100" style="font-size:11px;"><i class="bi bi-x"></i></button>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Batch No</label>
                        <input type="text" name="SalesDetails[0].BatchNo" class="form-control" maxlength="50" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Line Total</label>
                        <input type="text" class="form-control line-total" readonly value="Rs 0.00" style="background:#f8fafc;font-weight:700;" />
                    </div>
                </div>
            </div>
        }
        else
        {
            int i = 0;
            foreach (var d in details)
            {
                <div class="item-row">
                    <div class="row g-2">
                        <div class="col-md-5">
                            <label class="form-label">Product *</label>
                            <select name="SalesDetails[@i].ProductId" class="form-select product-select" required>
                                <option value="">-- Select Product --</option>
                                @if(ViewBag.Products != null) { foreach(var p in ViewBag.Products) {
                                    <option value="@p.productId" selected="@(p.productId == d.ProductId)">@p.productName</option>
                                } }
                            </select>
                            <div class="stock-box" id="stockBox_@i"></div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Qty *</label>
                            <input type="number" name="SalesDetails[@i].Quantity" class="form-control qty-input" min="1" value="@d.Quantity" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Price *</label>
                            <input type="number" step="0.01" name="SalesDetails[@i].UnitPrice" class="form-control price-input" min="0" value="@d.UnitPrice" required />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Disc %</label>
                            <input type="number" step="0.01" name="SalesDetails[@i].DiscountPercent" class="form-control disc-input" min="0" value="@(d.DiscountPercent ?? 0)" />
                        </div>
                        <div class="col-md-1 d-flex align-items-end">
                            <button type="button" class="btn btn-sm btn-danger remove-item w-100" style="font-size:11px;"><i class="bi bi-x"></i></button>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">Batch No</label>
                            <input type="text" name="SalesDetails[@i].BatchNo" class="form-control" value="@(d.BatchNo ?? "")" maxlength="50" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Line Total</label>
                            <input type="text" class="form-control line-total" readonly value="Rs @d.TotalPrice.ToString("N2")" style="background:#f8fafc;font-weight:700;" />
                        </div>
                    </div>
                </div>
                i++;
            }
        }
    </div>

    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold"><i class="bi bi-check-lg"></i> Update Sales Order</button>
    </div>
</form>

<script>
(function(){
    var form = document.getElementById('editForm');
    if(!form) return;
    var idx = @details.Count;
    if(idx === 0) idx = 1;

    function fmt(n){ return "Rs " + (Number(n)||0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ","); }

    function calc(){
        var sub = 0;
        form.querySelectorAll('.item-row').forEach(function(row){
            var q = parseFloat(row.querySelector('.qty-input') ? row.querySelector('.qty-input').value : 0) || 0;
            var p = parseFloat(row.querySelector('.price-input') ? row.querySelector('.price-input').value : 0) || 0;
            var dp = parseFloat(row.querySelector('.disc-input') ? row.querySelector('.disc-input').value : 0) || 0;
            var lt = q * p;
            var net = lt - (lt * dp / 100);
            sub += net;
            var lf = row.querySelector('.line-total');
            if(lf) lf.value = fmt(net);
        });
        var disc = parseFloat(form.querySelector('.discount-input') ? form.querySelector('.discount-input').value : 0) || 0;
        var tax = parseFloat(form.querySelector('.tax-input') ? form.querySelector('.tax-input').value : 0) || 0;
        var grand = sub - disc + tax;
        var nd = document.getElementById('netDisplay');
        if(nd) nd.value = fmt(grand);
    }

    form.addEventListener('input', function(e){
        var n = e.target.name || '';
        if(n.match(/quantity|price|discount|tax/i)) calc();
    });

    // --- STOCK CHECK ---
    function checkStock(row){
        var sel = row.querySelector('.product-select');
        if(!sel) return;
        var box = row.querySelector('.stock-box');
        if(!box) return;

        var pid = sel.value;
        if(!pid){ box.className = 'stock-box'; return; }

        box.className = 'stock-box show';
        box.textContent = '? Checking...';

        fetch('/Sales/GetProductStock?productId=' + pid)
            .then(function(r){ return r.json(); })
            .then(function(d){
                if(!d.success){
                    box.className = 'stock-box out show';
                    box.textContent = '? ' + (d.message || 'Error');
                    return;
                }
                // For edit — show available + currently in this order
                var currentQty = parseFloat(row.querySelector('.qty-input') ? row.querySelector('.qty-input').value : 0) || 0;
                var totalAvail = d.available + currentQty; // add back current so user can see total
                
                if(d.status === 'IN_STOCK'){
                    box.className = 'stock-box ok show';
                    box.textContent = '? Available: ' + totalAvail + ' units (Incl. current: ' + currentQty + ')';
                } else if(d.status === 'LOW_STOCK'){
                    box.className = 'stock-box low show';
                    box.textContent = '?? Low: ' + totalAvail + ' units';
                } else {
                    box.className = 'stock-box out show';
                    box.textContent = '? Out of Stock (Available: ' + d.available + ')';
                }
            })
            .catch(function(){
                box.className = 'stock-box out show';
                box.textContent = '? Error';
            });
    }

    form.addEventListener('change', function(e){
        if(e.target.classList && e.target.classList.contains('product-select')){
            var row = e.target.closest('.item-row');
            if(row) checkStock(row);
        }
    });

    // --- ADD ITEM ---
    document.getElementById('addItemBtn').addEventListener('click', function(){
        var cont = document.getElementById('itemsContainer');
        var first = cont.querySelector('.item-row');
        var clone = first.cloneNode(true);

        clone.querySelectorAll('[name]').forEach(function(el){
            var nm = el.getAttribute('name');
            el.setAttribute('name', nm.replace(/SalesDetails\[\d+\]/, 'SalesDetails[' + idx + ']'));
        });

        clone.querySelectorAll('input[type=number]').forEach(function(i){
            i.value = i.classList.contains('qty-input') ? 1 : 0;
        });
        clone.querySelectorAll('input[type=text]').forEach(function(i){ i.value = ''; });
        clone.querySelectorAll('select').forEach(function(s){ s.value = ''; });
        var lt = clone.querySelector('.line-total');
        if(lt) lt.value = 'Rs 0.00';
        var sb = clone.querySelector('.stock-box');
        if(sb){ sb.className = 'stock-box'; sb.textContent = ''; }

        cont.appendChild(clone);
        idx++;
    });

    // --- REMOVE ITEM ---
    form.addEventListener('click', function(e){
        if(e.target.closest('.remove-item')){
            var rows = form.querySelectorAll('.item-row');
            if(rows.length > 1){
                e.target.closest('.item-row').remove();
                // Reindex
                var newIdx = 0;
                form.querySelectorAll('.item-row').forEach(function(row){
                    row.querySelectorAll('[name]').forEach(function(el){
                        var nm = el.getAttribute('name');
                        el.setAttribute('name', nm.replace(/SalesDetails\[\d+\]/, 'SalesDetails[' + newIdx + ']'));
                    });
                    newIdx++;
                });
                idx = newIdx;
                calc();
            } else {
                alert('At least one item required.');
            }
        }
    });

    setTimeout(calc, 300);
})();
</script>

