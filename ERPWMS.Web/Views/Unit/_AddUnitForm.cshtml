@{
    Layout = null;
}
<form id="addUnitForm" method="post" action="/Unit/Register">
    @Html.AntiForgeryToken()
    <div id="addUnitAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-12"><label class="form-label fw-bold">Unit Name *</label><input type="text" name="unitName" class="form-control" required maxlength="100" placeholder="Kilogram, Piece..." /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Unit Code</label><input type="text" name="unitCode" class="form-control" maxlength="20" placeholder="KG, PC" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Conversion Factor</label><input type="number" step="0.01" name="conversionFactor" class="form-control" placeholder="1.0" /></div>
        <div class="col-12"><div class="form-check form-switch"><input type="checkbox" name="isBaseUnit" value="true" class="form-check-input" /><label class="form-check-label" style="font-size:11.5px;">Is Base Unit</label></div></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Register</button>
    </div>
</form>
