@model ERPWMS.Database.Models.Unit
@{ Layout = null; }
<form id="editUnitForm" method="post" action="/Unit/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="unitId" value="@Model.UnitId" />
    <div id="editUnitAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-12"><label class="form-label fw-bold">Unit Name *</label><input type="text" name="unitName" class="form-control" value="@Model.UnitName" required maxlength="100" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Unit Code</label><input type="text" name="unitCode" class="form-control" value="@Model.UnitCode" maxlength="20" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Conversion Factor</label><input type="number" step="0.01" name="conversionFactor" class="form-control" value="@(Model.ConversionFactor ?? 0)" /></div>
        <div class="col-md-6"><div class="form-check form-switch" style="margin-top:24px;"><input type="checkbox" name="isBaseUnit" value="true" class="form-check-input" @((Model.IsBaseUnit == true) ? "checked" : "") /><label class="form-check-label" style="font-size:11.5px;">Is Base Unit</label></div></div>
        <div class="col-md-6"><label class="form-label fw-bold">Status</label><select name="isActive" class="form-select">@if((Model.IsActive == true)){<option value="true" selected>Active</option><option value="false">Inactive</option>}else{<option value="true">Active</option><option value="false" selected>Inactive</option>}</select></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>
