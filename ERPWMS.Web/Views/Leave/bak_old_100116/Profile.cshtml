@model ERPWMS.Database.Models.EmployeeLeave
@{
    ViewData["Title"] = "Leave Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string statusColor = Model.Status == "Approved" ? "#159A89" : Model.Status == "Rejected" ? "#DC2626" : "#F5A623";
    string statusText = Model.Status ?? "Pending";
    var fullName = Model.Employee != null ? (Model.Employee.FirstName + " " + (Model.Employee.LastName ?? "")).Trim() : "N/A";
}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h3 class="mb-0 fw-bold" style="color:#0A1628;">Leave Details</h3><small class="text-muted">Home / Leave / @fullName</small></div>
        <div>
            <a href="/Leave/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
            <button class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
        </div>
    </div>
    <div class="card shadow-sm mb-3" style="background:#0A1628;color:#fff;border:none;">
        <div class="card-body"><div class="d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <div style="background:#F5A623;color:#0A1628;padding:14px;border-radius:10px;font-size:1.6rem;margin-right:16px;"><i class="bi bi-calendar-x"></i></div>
                <div><h3 class="mb-1 fw-bold" style="color:#fff;">@fullName</h3>
                <div style="font-size:12px;color:#94A3B8;">@(Model.Employee?.EmployeeCode ?? "-") | @(Model.LeaveType ?? "-") | @Model.FromDate.ToString("dd MMM") - @Model.ToDate.ToString("dd MMM yyyy")</div></div>
            </div>
            <div><span style="background:@statusColor;color:#fff;padding:6px 16px;border-radius:20px;font-size:11px;font-weight:700;text-transform:uppercase;">@statusText</span></div>
        </div></div>
    </div>
    <div class="row mb-3">
        <div class="col-md-6 mb-3 mb-md-0"><div class="card shadow-sm h-100"><div class="card-body">
            <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-person" style="color:#F5A623;"></i> Employee Information</h6>
            <table class="table table-sm mb-0" style="font-size:12px;">
                <tr><td style="color:#64748B;border:none;">Employee Name</td><td class="text-end fw-bold" style="border:none;">@fullName</td></tr>
                <tr><td style="color:#64748B;border:none;">Employee Code</td><td class="text-end fw-bold" style="border:none;font-family:monospace;">@(Model.Employee?.EmployeeCode ?? "-")</td></tr>
                <tr><td style="color:#64748B;border:none;">Department</td><td class="text-end" style="border:none;">@(Model.Employee?.Department != null ? Model.Employee.Department.DepartmentName : "-")</td></tr>
                <tr><td style="color:#64748B;border:none;">Designation</td><td class="text-end" style="border:none;">@(Model.Employee?.Designation != null ? Model.Employee.Designation.DesignationName : "-")</td></tr>
            </table>
        </div></div></div>
        <div class="col-md-6"><div class="card shadow-sm h-100"><div class="card-body">
            <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-calendar-check" style="color:#F5A623;"></i> Leave Information</h6>
            <table class="table table-sm mb-0" style="font-size:12px;">
                <tr><td style="color:#64748B;border:none;">Leave Type</td><td class="text-end fw-bold" style="border:none;">@(string.IsNullOrEmpty(Model.LeaveType) ? "-" : Model.LeaveType)</td></tr>
                <tr><td style="color:#64748B;border:none;">From Date</td><td class="text-end fw-bold" style="border:none;">@Model.FromDate.ToString("dd MMM yyyy")</td></tr>
                <tr><td style="color:#64748B;border:none;">To Date</td><td class="text-end fw-bold" style="border:none;">@Model.ToDate.ToString("dd MMM yyyy")</td></tr>
                <tr><td style="color:#64748B;border:none;">Total Days</td><td class="text-end fw-bold" style="border:none;color:#F5A623;">@Model.TotalDays</td></tr>
                <tr><td style="color:#64748B;border:none;">Status</td><td class="text-end fw-bold" style="border:none;color:@statusColor;">@statusText</td></tr>
            </table>
        </div></div></div>
    </div>
    <div class="card shadow-sm mb-3"><div class="card-body">
        <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-chat-left-text" style="color:#F5A623;"></i> Reason</h6>
        <p style="font-size:12px;color:#475569;margin:0;">@(string.IsNullOrEmpty(Model.Reason) ? "-" : Model.Reason)</p>
    </div></div>
    @if (!string.IsNullOrEmpty(Model.RejectionReason))
    {
        <div class="card shadow-sm mb-3" style="border-left:4px solid #DC2626;"><div class="card-body">
            <h6 class="fw-bold mb-3" style="color:#DC2626;"><i class="bi bi-x-circle"></i> Rejection Reason</h6>
            <p style="font-size:12px;color:#475569;margin:0;">@Model.RejectionReason</p>
        </div></div>
    }
    <div class="card shadow-sm"><div class="card-body">
        <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-people" style="color:#F5A623;"></i> Audit Information</h6>
        <div class="row" style="font-size:12px;">
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Created By:</span> <strong>@(ViewBag.CreatedByName ?? "N/A")</strong></div>
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Created Date:</span> <strong>@(Model.CreatedDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</strong></div>
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Approved By:</span> <strong>@(ViewBag.ApprovedByName ?? "-")</strong></div>
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Approved Date:</span> <strong>@(Model.ApprovedDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</strong></div>
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Updated By:</span> <strong>@(ViewBag.UpdatedByName ?? "-")</strong></div>
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Updated Date:</span> <strong>@(Model.UpdatedDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</strong></div>
        </div>
    </div></div>
</div>
