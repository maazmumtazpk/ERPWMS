@{
    ViewData["Title"] = "Leave Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<form id="__af" style="display:none;">@Html.AntiForgeryToken()</form>
<style>
    .kpi-card{background:#fff;border:1px solid #edf0f4;border-radius:10px;padding:12px 14px;box-shadow:0 2px 8px rgba(0,0,0,.04);min-height:80px;display:flex;flex-direction:column;justify-content:center;position:relative}
    .kpi-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2.5px}
    .kpi-card.total::before{background:#0A1628}.kpi-card.active::before{background:#159A89}.kpi-card.inactive::before{background:#F5A623}.kpi-card.month::before{background:#7167D8}
    .kpi-content{display:flex;justify-content:space-between;align-items:center;width:100%;gap:8px}
    .kpi-label{margin:0 0 3px 0;color:#64748B;font-size:9px;font-weight:700;text-transform:uppercase}
    .kpi-number{margin:0;color:#0A1628;font-size:20px;font-weight:750}
    .kpi-icon{width:30px;height:30px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:13px}
    .kpi-icon.blue{background:#0A1628;color:#fff}.kpi-icon.green{background:#D7F4EE;color:#159A89}.kpi-icon.orange{background:#FFF1D7;color:#E39A19}.kpi-icon.purple{background:#EAE8FF;color:#7167D8}
    .table-card{background:#fff;border:1px solid #edf0f4;border-radius:10px;box-shadow:0 2px 8px rgba(0,0,0,.04);margin-top:16px}
    .card-header-custom{padding:10px 14px;border-bottom:2px solid #F1F5F9;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
    .card-header-custom h5{margin:0;font-size:12px;font-weight:700;color:#0A1628;display:flex;align-items:center;gap:6px}
    .badge-count{background:#F1F5F9;color:#64748B;font-size:9px;font-weight:700;padding:1px 8px;border-radius:12px}
    .card-body{padding:0;overflow-x:auto}
    table.table-premium{margin:0;font-size:11px;width:100%}
    table.table-premium thead{background:#F8FAFC;border-bottom:2px solid #E2E8F0}
    table.table-premium thead th{padding:8px 14px;font-weight:700;font-size:9px;text-transform:uppercase;color:#64748B;border:none;text-align:left}
    table.table-premium tbody td{padding:8px 14px;vertical-align:middle;border-bottom:1px solid #F1F5F9;color:#0A1628;font-size:11px}
    table.table-premium tbody tr:hover{background:#FEFBF5}
    .row-name{font-weight:600;display:flex;align-items:center;gap:8px}
    .row-name .avatar{width:28px;height:28px;border-radius:6px;background:#DBEAFE;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:10px;color:#1D4ED8}
    .badge-status{padding:2px 8px;border-radius:12px;font-size:8px;font-weight:700;text-transform:uppercase}
    .badge-status.active{background:#DDF7F1;color:#118B7B}
    .badge-status.inactive{background:#F1F5F9;color:#64748B}
    .badge-status.rejected{background:#FEE2E2;color:#DC2626}
    .badge-info{padding:2px 8px;border-radius:4px;font-size:9px;font-weight:600}
    .type-badge{background:#EDE9FE;color:#6D28D9}
    .btn-icon{width:26px;height:26px;border-radius:6px;border:1px solid #E8ECF1;display:inline-flex;align-items:center;justify-content:center;font-size:12px;color:#64748B;background:#fff;cursor:pointer}
    .btn-icon:hover{background:#F1F5F9}.btn-icon.gold{background:#F5A623;color:#fff;border-color:#F5A623}
    .act-wrap{position:relative;display:inline-block}
    .act-menu{position:fixed;background:#fff;border:1px solid #E8ECF1;border-radius:8px;box-shadow:0 8px 24px rgba(15,23,42,.14);min-width:180px;padding:5px;z-index:99999;display:none;text-align:left}
    .act-menu.show{display:block !important}
    .act-menu a{display:flex;align-items:center;gap:10px;width:100%;padding:8px 11px;font-size:11.5px;color:#334155;border-radius:6px;text-decoration:none;cursor:pointer;font-weight:500}
    .act-menu a:hover{background:#F8FAFC}.act-menu a i{width:14px;color:#64748B}
    .act-menu .sep{height:1px;background:#F1F5F9;margin:3px 5px}
    .act-menu .danger{color:#DC2626}.act-menu .danger i{color:#DC2626}
    .search-wrapper{position:relative;display:inline-block}
    .search-wrapper input{border:1px solid #E2E8F0;border-radius:6px;padding:4px 10px 4px 28px;font-size:10px;width:160px;background:#FAFBFC;height:28px}
    .search-wrapper i{position:absolute;left:8px;top:50%;transform:translateY(-50%);color:#94A3B8;font-size:10px}
    .table-footer{padding:8px 14px;border-top:2px solid #F1F5F9;display:flex;justify-content:space-between;font-size:10px;color:#64748B;background:#F8FAFC}
    .empty-state{padding:30px 16px;text-align:center}
    .empty-state i{font-size:35px;color:#E2E8F0;display:block;margin-bottom:8px}
    .empty-state h4{font-size:13px;font-weight:700;color:#0A1628;margin-bottom:4px}
    .empty-state p{color:#64748B;font-size:10px;margin:0 auto 12px auto}
    .btn-gold{background:#F5A623;color:#0A1628;border:none;padding:6px 14px;border-radius:6px;font-weight:700;font-size:10px;text-decoration:none;display:inline-flex;align-items:center;gap:5px;cursor:pointer}
    .modal .modal-header{background:#0A1628;color:#fff;padding:14px 20px;border:0}
    .modal .modal-header h5{font-size:14px;font-weight:700;margin:0}
    .modal .modal-header h5 i{color:#F5A623;margin-right:8px}
    .modal .modal-header .btn-close{filter:invert(1);opacity:.7}
    .modal .modal-body{padding:18px 22px}
</style>
<div class="container-fluid py-4">
    <div class="row g-3">
        <div class="col-xl-3 col-lg-3 col-md-6"><div class="kpi-card total"><div class="kpi-content"><div><p class="kpi-label">Total Leaves</p><h2 class="kpi-number" id="kpiTotal">0</h2></div><div class="kpi-icon blue"><i class="bi bi-calendar-x"></i></div></div></div></div>
        <div class="col-xl-3 col-lg-3 col-md-6"><div class="kpi-card active"><div class="kpi-content"><div><p class="kpi-label">Approved</p><h2 class="kpi-number" id="kpiActive">0</h2></div><div class="kpi-icon green"><i class="bi bi-check-circle"></i></div></div></div></div>
        <div class="col-xl-3 col-lg-3 col-md-6"><div class="kpi-card inactive"><div class="kpi-content"><div><p class="kpi-label">Pending</p><h2 class="kpi-number" id="kpiInactive">0</h2></div><div class="kpi-icon orange"><i class="bi bi-hourglass"></i></div></div></div></div>
        <div class="col-xl-3 col-lg-3 col-md-6"><div class="kpi-card month"><div class="kpi-content"><div><p class="kpi-label">This Month</p><h2 class="kpi-number" id="kpiMonth">0</h2></div><div class="kpi-icon purple"><i class="bi bi-calendar-plus"></i></div></div></div></div>
    </div>
    <div class="table-card">
        <div class="card-header-custom">
            <h5><i class="bi bi-list-ul" style="color:#F5A623;"></i> All Leaves <span class="badge-count" id="xCount">0</span></h5>
            <div style="display:flex;gap:4px;align-items:center;">
                <div class="search-wrapper"><i class="bi bi-search"></i><input type="text" id="tableSearch" placeholder="Search..." onkeyup="filterTable()" /></div>
                <button class="btn-icon gold" onclick="openAdd()"><i class="bi bi-plus-circle"></i></button>
                <button class="btn-icon" onclick="reload_()"><i class="bi bi-arrow-clockwise"></i></button>
            </div>
        </div>
        <div class="card-body">
            <table class="table-premium" id="leaveTable">
                <thead><tr>
                    <th>#</th><th>Employee</th><th>Type</th><th>From</th><th>To</th><th>Days</th><th>Reason</th><th>Status</th><th style="text-align:right;">Actions</th>
                </tr></thead>
                <tbody id="xBody"><tr><td colspan="9" class="text-center py-3"><div class="spinner-border text-primary" style="width:20px;height:20px;"></div></td></tr></tbody>
            </table>
            <div id="emptyState" class="empty-state d-none"><i class="bi bi-calendar-x"></i><h4>No Leave Records</h4><p>Submit your first leave request.</p><button class="btn-gold" onclick="openAdd()"><i class="bi bi-plus-circle"></i> Add Leave</button></div>
        </div>
        <div class="table-footer"><span><i class="bi bi-info-circle"></i> Showing <span id="tableCount">0</span> records</span></div>
    </div>
</div>

<div class="modal fade" id="addModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5><i class="bi bi-calendar-plus"></i> New Leave Request</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body" id="addModalBody"></div></div></div></div>
<div class="modal fade" id="editModal" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5><i class="bi bi-pencil-square"></i> Edit Leave</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body" id="editModalBody"></div></div></div></div>

<script>
function tk(){var e=document.querySelector("input[name=__RequestVerificationToken]");return e?e.value:"";}

function toggleMenu(id, e) {
    e.stopPropagation();
    document.querySelectorAll(".act-menu").forEach(function(m){ m.classList.remove("show"); });
    var el = document.getElementById("menu-" + id);
    if (!el) return;
    var btn = e.currentTarget || e.target;
    var r = btn.getBoundingClientRect();
    el.style.top = (r.bottom + 4) + "px";
    el.style.right = (window.innerWidth - r.right) + "px";
    el.style.left = "auto";
    el.classList.add("show");
}

document.addEventListener("click", function(e){
    if (!e.target.closest(".act-wrap")) {
        document.querySelectorAll(".act-menu").forEach(function(m){ m.classList.remove("show"); });
    }
});

function execScripts(c){c.querySelectorAll("script").forEach(function(s){var n=document.createElement("script");n.textContent=s.textContent;document.body.appendChild(n);});}
function filterTable(){var f=document.getElementById("tableSearch").value.toLowerCase();var rows=document.querySelectorAll("#xBody tr");var n=0;rows.forEach(function(r){var t=(r.textContent||"").toLowerCase();if(t.indexOf(f)>-1){r.style.display="";n++;}else r.style.display="none";});document.getElementById("tableCount").textContent=n;}
function openAdd(){var el=document.getElementById("addModal");var b=document.getElementById("addModalBody");b.innerHTML="<div class='text-center py-4'><div class='spinner-border text-primary'></div></div>";new bootstrap.Modal(el).show();fetch("/Leave/AddLeavePartial").then(r=>r.text()).then(h=>{b.innerHTML=h;execScripts(b);});}
function openEdit(id){var el=document.getElementById("editModal");var b=document.getElementById("editModalBody");b.innerHTML="<div class='text-center py-4'><div class='spinner-border text-primary'></div></div>";new bootstrap.Modal(el).show();fetch("/Leave/EditLeavePartial?id="+id).then(r=>r.text()).then(h=>{b.innerHTML=h;execScripts(b);});}

function toggleStatus(id){
    var fd = new FormData();
    fd.append("__RequestVerificationToken", tk());
    fetch("/Leave/ToggleActive/" + id, {method:"POST", body:fd})
        .then(function(r){ return r.json(); })
        .then(function(res){
            if(res.success){ alert(res.message); reload_(); }
            else alert(res.message || "Failed");
        })
        .catch(function(){ alert("Network error"); });
}

function reload_(){
    fetch("/Leave/GetStatistics").then(function(r){return r.json();}).then(function(d){
        document.getElementById("kpiTotal").textContent = d.total || 0;
        document.getElementById("kpiActive").textContent = d.approved || 0;
        document.getElementById("kpiInactive").textContent = d.pending || 0;
        document.getElementById("kpiMonth").textContent = d.addedThisMonth || 0;
    }).catch(function(){});
    
    fetch("/Leave/GetAll").then(function(r){return r.json();}).then(function(d){
        if(!d || d.length===0 || d.error){
            document.getElementById("xBody").innerHTML="";
            document.getElementById("leaveTable").style.display="none";
            document.getElementById("emptyState").classList.remove("d-none");
            document.getElementById("xCount").textContent="0";
            document.getElementById("tableCount").textContent="0";
            return;
        }
        document.getElementById("leaveTable").style.display="";
        document.getElementById("emptyState").classList.add("d-none");
        var h="";var i=1;
        d.forEach(function(x){
            var st = x.status==="Approved" ? "active" : x.status==="Rejected" ? "rejected" : "inactive";
            var initials = (x.employeeName||"EM").substring(0,2).toUpperCase();
            h += "<tr>";
            h += "<td>"+(i++)+"</td>";
            h += "<td><div class='row-name'><span class='avatar'>"+initials+"</span><div><div>"+x.employeeName+"</div><div style='font-size:9px;color:#94A3B8;'>"+x.employeeCode+"</div></div></div></td>";
            h += "<td><span class='badge-info type-badge'>"+(x.leaveType||"Casual")+"</span></td>";
            h += "<td>"+x.fromDate+"</td>";
            h += "<td>"+x.toDate+"</td>";
            h += "<td style='font-weight:700;'>"+x.totalDays+"</td>";
            h += "<td style='font-size:10px;color:#64748B;'>"+(x.reason||"-")+"</td>";
            h += "<td><span class='badge-status "+st+"'>"+x.status+"</span></td>";
            h += "<td style='text-align:right;'><div class='act-wrap'>";
            h += "<button class='btn-icon' onclick='toggleMenu("+x.leaveId+",event)'><i class='bi bi-three-dots-vertical'></i></button>";
            h += "<div class='act-menu' id='menu-"+x.leaveId+"'>";
            h += "<a href='/Leave/Profile/"+x.leaveId+"'><i class='bi bi-eye'></i> View Profile</a>";
            h += "<a onclick='openEdit("+x.leaveId+")'><i class='bi bi-pencil'></i> Edit</a>";
            h += "<a onclick='toggleStatus("+x.leaveId+")'><i class='bi bi-power'></i> Toggle Status</a>";
            h += "<div class='sep'></div>";
            h += "<a class='danger' onclick='delRow("+x.leaveId+")'><i class='bi bi-trash3'></i> Delete</a>";
            h += "</div></div></td>";
            h += "</tr>";
        });
        document.getElementById("xBody").innerHTML=h;
        document.getElementById("xCount").textContent=d.length;
        document.getElementById("tableCount").textContent=d.length;
    }).catch(function(err){ console.error(err); });
}

function delRow(id){
    if(!confirm("Delete this leave record?")) return;
    var fd = new FormData();
    fd.append("__RequestVerificationToken", tk());
    fetch("/Leave/Delete/"+id, {method:"POST", body:fd})
        .then(function(r){ return r.json(); })
        .then(function(res){ if(res.success){ alert("Deleted"); reload_(); } else alert(res.message); });
}

document.addEventListener("submit", function(e){
    var f = e.target;
    if(!f || (f.id!=="addLeaveForm" && f.id!=="editLeaveForm")) return;
    e.preventDefault();
    var btn = f.querySelector("button[type=submit]");
    if(btn){ if(btn.disabled) return; btn.disabled=true; btn.textContent="Saving..."; }
    var ab = document.getElementById(f.id.replace("Form","Alert"));
    if(ab) ab.style.display="none";
    fetch(f.action, {method:"POST", body:new FormData(f)})
        .then(function(r){ return r.json(); })
        .then(function(res){
            if(res.success){
                var m = bootstrap.Modal.getInstance(f.closest(".modal"));
                if(m) m.hide();
                alert("Saved");
                reload_();
            } else {
                if(ab){ ab.textContent = res.message || "Failed"; ab.style.display="block"; }
                if(btn){ btn.disabled=false; btn.textContent="Save"; }
            }
        })
        .catch(function(){
            if(ab){ ab.textContent="Network error"; ab.style.display="block"; }
            if(btn){ btn.disabled=false; btn.textContent="Save"; }
        });
});

document.addEventListener("DOMContentLoaded", reload_);
</script>
