@{ Layout = null; }
<form id="addLeaveForm" method="post" action="/Leave/Register">
    @Html.AntiForgeryToken()
    <div id="addLeaveAlert" style="display:none;padding:8px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Employee *</label>
            <select name="employeeId" id="addEmp" class="form-select form-select-sm" required style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;">
                <option value="">-- Select Employee --</option>
            </select>
        </div>
        <div class="col-md-6">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Leave Type *</label>
            <select name="leaveType" class="form-select form-select-sm" required style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;">
                <option value="Casual">Casual</option>
                <option value="Sick">Sick</option>
                <option value="Annual">Annual</option>
                <option value="Unpaid">Unpaid</option>
                <option value="Maternity">Maternity</option>
                <option value="Other">Other</option>
            </select>
        </div>
        <div class="col-md-4">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">From Date *</label>
            <input type="date" name="fromDate" id="addFrom" class="form-control form-control-sm" required style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;" />
        </div>
        <div class="col-md-4">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">To Date *</label>
            <input type="date" name="toDate" id="addTo" class="form-control form-control-sm" required style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;" />
        </div>
        <div class="col-md-4">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Total Days *</label>
            <input type="number" name="totalDays" id="addDays" class="form-control form-control-sm" min="1" value="1" required readonly style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;background:#f1f5f9;font-weight:700;" />
        </div>
        <div class="col-md-12">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Reason *</label>
            <textarea name="reason" class="form-control form-control-sm" rows="2" required style="font-size:11px;padding:6px 10px;border-radius:6px;border:1px solid #dde4ec;"></textarea>
        </div>
    </div>

    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:14px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-sm" style="background:#F5A623;color:#0A1628;font-weight:700;border:none;">Save</button>
    </div>
</form>
<script>
    fetch("/Leave/GetEmployees").then(r=>r.json()).then(d=>{
        var s=document.getElementById("addEmp");
        s.innerHTML="<option value=''>-- Select Employee --</option>";
        (d||[]).forEach(function(x){ var o=document.createElement("option"); o.value=x.employeeId; o.textContent=x.employeeName; s.appendChild(o); });
    });
    function calcDays(){
        var f=document.getElementById("addFrom").value;
        var t=document.getElementById("addTo").value;
        if(f && t){
            var d1=new Date(f), d2=new Date(t);
            var diff=Math.floor((d2-d1)/(1000*60*60*24))+1;
            if(diff>0) document.getElementById("addDays").value=diff;
        }
    }
    document.getElementById("addFrom").addEventListener("change",calcDays);
    document.getElementById("addTo").addEventListener("change",calcDays);
</script>
