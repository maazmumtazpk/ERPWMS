@model ERPWMS.Database.Models.EmployeeLeave
@{ Layout = null; }
<form id="editLeaveForm" method="post" action="/Leave/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="leaveId" value="@Model.LeaveId" />
    <div id="editLeaveAlert" style="display:none;padding:8px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>

    <div class="row g-3">
        <div class="col-md-6">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Employee</label>
            <input type="text" class="form-control form-control-sm" value="@(Model.Employee != null ? (Model.Employee.FirstName + " " + (Model.Employee.LastName ?? "")).Trim() : "-")" readonly style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;background:#f1f5f9;" />
        </div>
        <div class="col-md-6">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Leave Type *</label>
            <select name="leaveType" class="form-select form-select-sm" required style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;">
                <option value="Casual" selected="@(Model.LeaveType=="Casual")">Casual</option>
                <option value="Sick" selected="@(Model.LeaveType=="Sick")">Sick</option>
                <option value="Annual" selected="@(Model.LeaveType=="Annual")">Annual</option>
                <option value="Unpaid" selected="@(Model.LeaveType=="Unpaid")">Unpaid</option>
                <option value="Maternity" selected="@(Model.LeaveType=="Maternity")">Maternity</option>
                <option value="Other" selected="@(Model.LeaveType=="Other")">Other</option>
            </select>
        </div>
        <div class="col-md-4">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">From Date *</label>
            <input type="date" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" required style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;" />
        </div>
        <div class="col-md-4">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">To Date *</label>
            <input type="date" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" required style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;" />
        </div>
        <div class="col-md-4">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Total Days *</label>
            <input type="number" name="totalDays" value="@Model.TotalDays" class="form-control form-control-sm" min="1" required style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;" />
        </div>
        <div class="col-md-12">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Reason *</label>
            <textarea name="reason" class="form-control form-control-sm" rows="2" required style="font-size:11px;padding:6px 10px;border-radius:6px;border:1px solid #dde4ec;">@Model.Reason</textarea>
        </div>
        <div class="col-md-6">
            <label style="font-size:10px;font-weight:700;color:#475569;margin-bottom:3px;display:block;">Status</label>
            <select name="status" class="form-select form-select-sm" style="font-size:11px;padding:6px 10px;min-height:32px;border-radius:6px;border:1px solid #dde4ec;">
                <option value="Pending" selected="@(Model.Status=="Pending")">Pending</option>
                <option value="Approved" selected="@(Model.Status=="Approved")">Approved</option>
                <option value="Rejected" selected="@(Model.Status=="Rejected")">Rejected</option>
            </select>
        </div>
    </div>

    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:14px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-sm" style="background:#F5A623;color:#0A1628;font-weight:700;border:none;">Update</button>
    </div>
</form>
