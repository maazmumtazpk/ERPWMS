@{
    ViewData["Title"] = "Loans";
    Layout = "_Layout";
}
<form id="__af" style="display:none;">@Html.AntiForgeryToken()</form>
<div class="toast-holder" id="toastHolder"></div>
@await Html.PartialAsync("_AdminCss")
<div style="padding-bottom:30px;">
<div class="table-card">
    <div class="card-header-custom">
        <h5><i class="bi bi-cash-stack" style="color:#F5A623;"></i> Employee Loans</h5>
        <button type="button" class="btn-icon gold" onclick="openAdd()"><i class="bi bi-plus-circle"></i></button>
    </div>
    <div class="card-body">
        <table class="table-premium" id="xTable">
            <thead><tr><th>Loan No</th><th>Employee</th><th>Amount</th><th>Monthly</th><th>Remaining</th><th>Installments</th><th>Status</th><th style="text-align:right;">Actions</th></tr></thead>
            <tbody id="xBody"></tbody>
        </table>
    </div>
</div>
</div>
<div class="modal fade pm-modal" id="formModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5>Loan</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">
<input type="hidden" id="loanId" value="0" />
<div class="row g-3">
<div class="col-12"><label class="form-label">Employee *</label><select id="employeeId" class="form-control"></select></div>
<div class="col-md-6"><label class="form-label">Loan Amount *</label><input type="number" id="loanAmount" class="form-control" step="0.01" /></div>
<div class="col-md-6"><label class="form-label">Monthly Recovery *</label><input type="number" id="monthlyRecovery" class="form-control" step="0.01" /></div>
<div class="col-md-6"><label class="form-label">Total Installments</label><input type="number" id="totalInstallments" class="form-control" value="1" min="1" /></div>
<div class="col-md-6"><label class="form-label">Issued Date</label><input type="date" id="issuedDate" class="form-control" /></div>
<div class="col-12"><label class="form-label">Reason</label><textarea id="reason" class="form-control" rows="2"></textarea></div>
</div>
</div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn-gold" onclick="save_()">Save</button></div></div></div></div>
@await Html.PartialAsync("_AdminJs")
<script>
function tk(){var i=document.querySelector('#__af input[name="__RequestVerificationToken"]');return i?i.value:'';}
function openAdd(){
    fetch('/Loan/GetEmployees').then(function(r){return r.json();}).then(function(d){
        var e=document.getElementById('employeeId'); e.innerHTML='<option value="">-- Select --</option>';
        d.forEach(function(x){var o=document.createElement('option'); o.value=x.employeeId; o.textContent=x.employeeCode+' - '+x.fullName; e.appendChild(o);});
        document.getElementById('loanId').value=0;
        ['loanAmount','monthlyRecovery','reason'].forEach(function(id){document.getElementById(id).value='';});
        document.getElementById('totalInstallments').value=1;
        document.getElementById('issuedDate').value=new Date().toISOString().split('T')[0];
        new bootstrap.Modal(document.getElementById('formModal')).show();
    });
}
function save_(){
    var fd=new FormData();
    fd.append('__RequestVerificationToken',tk());
    fd.append('loanId',document.getElementById('loanId').value);
    fd.append('employeeId',document.getElementById('employeeId').value);
    fd.append('loanNo','');
    fd.append('loanAmount',document.getElementById('loanAmount').value);
    fd.append('monthlyRecovery',document.getElementById('monthlyRecovery').value);
    fd.append('totalInstallments',document.getElementById('totalInstallments').value);
    fd.append('issuedDate',document.getElementById('issuedDate').value);
    fd.append('reason',document.getElementById('reason').value);
    fd.append('status','Pending');
    fetch('/Loan/Save',{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){
        if(res.success){showToast(res.message,'success'); bootstrap.Modal.getInstance(document.getElementById('formModal')).hide(); reload_();}
        else showToast(res.message,'error');
    });
}
function approve(id){var fd=new FormData(); fd.append('__RequestVerificationToken',tk()); fetch('/Loan/Approve/'+id,{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){if(res.success){showToast(res.message,'success'); reload_();}});}
function del_(id){ if(!confirm('Delete?')) return; var fd=new FormData(); fd.append('__RequestVerificationToken',tk()); fetch('/Loan/Delete/'+id,{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){if(res.success){showToast(res.message,'success'); reload_();}}); }
function reload_(){
    fetch('/Loan/GetAll').then(function(r){return r.json();}).then(function(d){
        var b=document.getElementById('xBody');
        if(!d||d.length===0){b.innerHTML='<tr><td colspan="8" class="text-center">No loans</td></tr>'; return;}
        var h='';
        d.forEach(function(x){
            var cls = x.status==='Active'?'active':(x.status==='Closed'?'role':(x.status==='Pending'?'inactive':'role'));
            h+='<tr><td>'+x.loanNo+'</td><td>'+x.employeeName+'</td><td>'+x.loanAmount.toFixed(2)+'</td><td>'+x.monthlyRecovery.toFixed(2)+'</td><td>'+x.remainingAmount.toFixed(2)+'</td><td>'+x.paidInstallments+'/'+x.totalInstallments+'</td><td><span class="badge-status '+cls+'">'+x.status+'</span></td>';
            h+='<td style="text-align:right;">';
            if(x.status==='Pending'){h+='<button class="btn-icon" onclick="approve('+x.loanId+')" title="Approve"><i class="bi bi-check-circle"></i></button> ';}
            h+='<button class="btn-icon" onclick="del_('+x.loanId+')"><i class="bi bi-trash3"></i></button></td></tr>';
        });
        b.innerHTML=h;
    });
}
document.addEventListener('DOMContentLoaded', reload_);
</script>
