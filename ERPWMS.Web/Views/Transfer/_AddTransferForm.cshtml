@{
    Layout = null;
}
<form id="addTransferForm" method="post" action="/Transfer/Register">
    @Html.AntiForgeryToken()
    <div id="addTransferAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label fw-bold">Transfer No *</label><input type="text" name="transferNo" class="form-control" required maxlength="50" placeholder="TR-2026-001" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Transfer Date</label><input type="date" name="transferDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">From Warehouse *</label><select name="fromWarehouseId" id="addFrom" class="form-select" required><option value="">Loading...</option></select></div>
        <div class="col-md-6"><label class="form-label fw-bold">To Warehouse *</label><select name="toWarehouseId" id="addTo" class="form-select" required><option value="">Loading...</option></select></div>
        <div class="col-md-6"><label class="form-label fw-bold">Product *</label><select name="productId" id="addProd" class="form-select" required><option value="">Loading...</option></select></div>
        <div class="col-md-6"><label class="form-label fw-bold">Quantity</label><input type="number" name="quantity" class="form-control" value="0" /></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Create</button>
    </div>
</form>
<script>
fetch("/Transfer/GetWarehouses").then(r=>r.json()).then(d=>{var a=document.getElementById("addFrom");var b=document.getElementById("addTo");a.innerHTML="<option value=''>-- Select --</option>";b.innerHTML="<option value=''>-- Select --</option>";(d||[]).forEach(x=>{var o1=document.createElement("option");o1.value=x.warehouseId;o1.textContent=x.warehouseName;a.appendChild(o1);var o2=document.createElement("option");o2.value=x.warehouseId;o2.textContent=x.warehouseName;b.appendChild(o2);});});
fetch("/Transfer/GetProducts").then(r=>r.json()).then(d=>{var s=document.getElementById("addProd");s.innerHTML="<option value=''>-- Select --</option>";(d||[]).forEach(x=>{var o=document.createElement("option");o.value=x.productId;o.textContent=x.productName;s.appendChild(o);});});
</script>
