@model ERPWMS.Database.Models.StockTransfer
@{ Layout = null; }
<form id="editTransferForm" method="post" action="/Transfer/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="transferId" value="@Model.TransferId" />
    <div id="editTransferAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label fw-bold">Transfer No *</label><input type="text" name="transferNo" class="form-control" value="@Model.TransferNo" required maxlength="50" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Quantity</label><input type="number" name="quantity" class="form-control" value="@Model.Quantity" /></div>
        <div class="col-12"><label class="form-label fw-bold">Status</label><select name="status" class="form-select">@foreach(var s in new[]{"Pending","Approved","Received","Cancelled"}){if(Model.Status == s){<option value="@s" selected>@s</option>}else{<option value="@s">@s</option>}}</select></div>
        <input type="hidden" name="fromWarehouseId" value="@Model.FromWarehouseId" />
        <input type="hidden" name="toWarehouseId" value="@Model.ToWarehouseId" />
        <input type="hidden" name="productId" value="@Model.ProductId" />
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>
