@model ERPWMS.Web.ViewModels.DashboardViewModel
@{ ViewData["Title"] = "Dashboard"; }

<style>
.dash-wrap{font-size:13px;color:#374151}
.dash-title{font-size:20px;font-weight:700;color:#1f2937;margin:0}
.dash-sub{font-size:12px;color:#9ca3af}
.pill{border:1px solid #e5e7eb;border-radius:20px;padding:5px 14px;font-size:11px;color:#6b7280;background:#fff;display:inline-block}
.kpi{background:#fff;border-radius:10px;padding:14px 16px;box-shadow:0 1px 3px rgba(0,0,0,.06);display:flex;justify-content:space-between;align-items:flex-start;height:100%}
.kpi-lbl{font-size:10px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;color:#9ca3af;margin-bottom:6px}
.kpi-val{font-size:22px;font-weight:700;color:#111827;line-height:1.1}
.kpi-val .c{font-size:13px;color:#6b7280;font-weight:500}
.kpi-sub{font-size:11px;color:#9ca3af;margin-top:4px}
.kpi-ic{width:38px;height:38px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0}
.cnt{background:#fff;border-radius:10px;padding:12px 14px;box-shadow:0 1px 3px rgba(0,0,0,.06);display:flex;justify-content:space-between;align-items:center;height:100%}
.cnt-lbl{font-size:10px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:#9ca3af}
.cnt-val{font-size:20px;font-weight:700;color:#111827;line-height:1;margin-top:4px}
.cnt-sub{font-size:11px;color:#9ca3af;margin-top:3px}
.cnt-ic{width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0}
.pnl{background:#fff;border-radius:10px;box-shadow:0 1px 3px rgba(0,0,0,.06)}
.pnl-h{padding:12px 16px;border-bottom:1px solid #f3f4f6;display:flex;justify-content:space-between;align-items:center}
.pnl-h h6{font-size:13px;font-weight:700;margin:0;color:#374151}
.pnl-b{padding:14px 16px}
.qa{background:#fff;border:1px solid #e5e7eb;border-radius:8px;padding:14px 6px;display:flex;flex-direction:column;align-items:center;gap:6px;text-decoration:none;transition:.15s}
.qa:hover{border-color:#d1d5db;background:#fafafa}
.qa i{font-size:18px}
.qa span{font-size:11px;font-weight:600;color:#374151}
.act{font-size:12px;margin:0}
.act th{font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:#9ca3af;font-weight:700;padding:10px 12px;border-bottom:1px solid #f3f4f6}
.act td{padding:10px 12px;vertical-align:middle;border-bottom:1px solid #f9fafb;font-size:12px}
.act tr:last-child td{border-bottom:none}
.bdg{padding:4px 10px;border-radius:6px;font-size:10px;font-weight:600;display:inline-block}
</style>

<div class="dash-wrap">

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="dash-title">Dashboard</h4>
        <small class="dash-sub">Updated @Model.LastUpdated.ToString("h:mm:ss tt")</small>
    </div>
    <div class="d-flex gap-2">
        <div class="btn-group btn-group-sm">
            <a class="btn @(Model.DateRangeDays == 7 ? "btn-dark" : "btn-light border")" asp-action="Index" asp-route-days="7">7D</a>
            <a class="btn @(Model.DateRangeDays == 30 ? "btn-dark" : "btn-light border")" asp-action="Index" asp-route-days="30">30D</a>
            <a class="btn @(Model.DateRangeDays == 90 ? "btn-dark" : "btn-light border")" asp-action="Index" asp-route-days="90">90D</a>
            <a class="btn @(Model.DateRangeDays == 365 ? "btn-dark" : "btn-light border")" asp-action="Index" asp-route-days="365">1Y</a>
        </div>
        <a class="btn btn-sm btn-light border" asp-action="Index" asp-route-days="@Model.DateRangeDays"><i class="fas fa-sync-alt"></i></a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3"><div class="kpi"><div><div class="kpi-lbl">Total Sales</div><div class="kpi-val"><span class="c">Rs </span>@((Model.TotalSales/1000m).ToString("0.0"))K</div><div class="kpi-sub">Today: Rs @Model.TodaySales.ToString("N0")</div></div><div class="kpi-ic" style="background:#ede9fe;color:#7c3aed;"><i class="fas fa-shopping-cart"></i></div></div></div>
    <div class="col-6 col-lg-3"><div class="kpi"><div><div class="kpi-lbl">Running Stock</div><div class="kpi-val"><span class="c">Rs </span>@((Model.StockValue/1000000m).ToString("0.0"))M</div><div class="kpi-sub">All warehouses</div></div><div class="kpi-ic" style="background:#d1fae5;color:#059669;"><i class="fas fa-cubes"></i></div></div></div>
    <div class="col-6 col-lg-3"><div class="kpi"><div><div class="kpi-lbl">Stock Value</div><div class="kpi-val"><span class="c">Rs </span>@Model.StockValue.ToString("N0")</div><div class="kpi-sub">Current inventory</div></div><div class="kpi-ic" style="background:#fef3c7;color:#d97706;"><i class="fas fa-boxes"></i></div></div></div>
    <div class="col-6 col-lg-3"><div class="kpi"><div><div class="kpi-lbl">Pending Orders</div><div class="kpi-val">@Model.PendingOrders</div><div class="kpi-sub">Out of @Model.TotalOrders orders</div></div><div class="kpi-ic" style="background:#fee2e2;color:#dc2626;"><i class="fas fa-clock"></i></div></div></div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3"><div class="cnt"><div><div class="cnt-lbl">Customers</div><div class="cnt-val">@Model.TotalCustomers</div><div class="cnt-sub">Active accounts</div></div><div class="cnt-ic" style="background:#dbeafe;color:#2563eb;"><i class="fas fa-users"></i></div></div></div>
    <div class="col-6 col-lg-3"><div class="cnt"><div><div class="cnt-lbl">Products</div><div class="cnt-val">@Model.TotalProducts</div><div class="cnt-sub">In catalog</div></div><div class="cnt-ic" style="background:#ede9fe;color:#8b5cf6;"><i class="fas fa-cube"></i></div></div></div>
    <div class="col-6 col-lg-3"><div class="cnt"><div><div class="cnt-lbl">Suppliers</div><div class="cnt-val">@Model.TotalSuppliers</div><div class="cnt-sub">Registered</div></div><div class="cnt-ic" style="background:#cffafe;color:#06b6d4;"><i class="fas fa-truck"></i></div></div></div>
    <div class="col-6 col-lg-3"><div class="cnt"><div><div class="cnt-lbl">Warehouses</div><div class="cnt-val">@Model.TotalWarehouses</div><div class="cnt-sub">Active</div></div><div class="cnt-ic" style="background:#fed7aa;color:#ea580c;"><i class="fas fa-warehouse"></i></div></div></div>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-8"><div class="pnl h-100"><div class="pnl-h"><h6><i class="fas fa-chart-line me-2" style="color:#f59e0b;"></i>Sales &amp; Purchases Trend</h6><small style="font-size:11px;color:#9ca3af;">Last @Model.DateRangeDays days</small></div><div class="pnl-b"><div style="height:230px;"><canvas id="trendChart"></canvas></div></div></div></div>
    <div class="col-lg-4"><div class="pnl h-100"><div class="pnl-h"><h6><i class="fas fa-chart-pie me-2" style="color:#f59e0b;"></i>Top Products</h6><small style="font-size:11px;color:#9ca3af;">By revenue</small></div><div class="pnl-b"><div style="height:230px;"><canvas id="productChart"></canvas></div></div></div></div>
</div>

<div class="d-flex flex-wrap gap-2 mb-3">
    <span class="pill">23 Aug</span><span class="pill">26 Aug</span><span class="pill">29 Aug</span><span class="pill">01 Sep</span>
    <span class="pill">04 Sep</span><span class="pill">07 Sep</span><span class="pill">10 Sep</span><span class="pill">13 Sep</span>
</div>

<div class="row g-3 mb-3">
    <div class="col-lg-4"><div class="pnl h-100"><div class="pnl-h"><h6><i class="fas fa-exclamation-triangle me-2" style="color:#dc2626;"></i>Alerts</h6></div><div class="pnl-b">
        <div style="display:flex;align-items:center;padding:10px 12px;border-radius:8px;background:#fef2f2;">
            <i class="fas fa-exclamation-circle" style="font-size:18px;color:#dc2626;margin-right:10px;"></i>
            <div><div style="font-size:12px;font-weight:700;color:#1f2937;">System Errors</div><div style="font-size:11px;color:#9ca3af;">@Model.SystemErrors24h error(s) in 24 hours</div></div>
        </div>
    </div></div></div>
    <div class="col-lg-8"><div class="pnl h-100"><div class="pnl-h"><h6><i class="fas fa-bolt me-2" style="color:#f59e0b;"></i>Quick Actions</h6></div><div class="pnl-b"><div class="row g-2">
        <div class="col-3"><a href="/PurchaseMasters/Create" class="qa"><i class="fas fa-file-circle-plus" style="color:#2563eb;"></i><span>New PO</span></a></div>
        <div class="col-3"><a href="/GRNs/Create" class="qa"><i class="fas fa-clipboard-check" style="color:#059669;"></i><span>New GRN</span></a></div>
        <div class="col-3"><a href="/SalesMasters/Create" class="qa"><i class="fas fa-cart-plus" style="color:#7c3aed;"></i><span>New Sale</span></a></div>
        <div class="col-3"><a href="/Invoices" class="qa"><i class="fas fa-file-invoice" style="color:#d97706;"></i><span>Invoices</span></a></div>
        <div class="col-3"><a href="/StockTransfers/Create" class="qa"><i class="fas fa-arrow-right-arrow-left" style="color:#0891b2;"></i><span>Transfer</span></a></div>
        <div class="col-3"><a href="/StockAdjustments/Create" class="qa"><i class="fas fa-sliders" style="color:#dc2626;"></i><span>Adjust</span></a></div>
        <div class="col-3"><a href="/CycleCounts/Create" class="qa"><i class="fas fa-rotate" style="color:#7c3aed;"></i><span>Cycle</span></a></div>
        <div class="col-3"><a href="/Reports" class="qa"><i class="fas fa-chart-bar" style="color:#059669;"></i><span>Reports</span></a></div>
    </div></div></div></div>
</div>

<div class="pnl mb-3">
    <div class="pnl-h"><h6><i class="fas fa-clock-rotate-left me-2" style="color:#f59e0b;"></i>Recent Activity</h6><a href="#" style="font-size:11px;color:#f59e0b;text-decoration:none;">View all &rarr;</a></div>
    <div class="pnl-b p-0">
        <table class="table act mb-0">
            <thead><tr><th>Type</th><th>Reference</th><th>Party</th><th style="text-align:right;">Amount</th><th>Status</th><th>Date</th></tr></thead>
            <tbody>
                @if (Model.RecentActivity != null && Model.RecentActivity.Count > 0)
                {
                    foreach (var a in Model.RecentActivity)
                    {
                        var tBg = a.Type == "Sales" ? "#3b82f6" : "#10b981";
                        <tr>
                            <td><span class="bdg" style="background:@tBg;color:#fff;">@(a.Type ?? "-")</span></td>
                            <td style="font-weight:600;color:#111827;">@(a.Reference ?? "-")</td>
                            <td style="color:#6b7280;">@(a.Party ?? "-")</td>
                            <td style="text-align:right;font-weight:700;">Rs @((a.Amount ?? 0m).ToString("N0"))</td>
                            <td><span class="bdg" style="background:#e5e7eb;color:#6b7280;">@(a.Status ?? "-")</span></td>
                            <td style="color:#9ca3af;">@((a.Date ?? DateTime.MinValue).ToString("dd MMM"))</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" style="text-align:center;color:#9ca3af;padding:24px;">No recent activity</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    var labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendLabels ?? new List<string>()));
    var salesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SalesTrend ?? new List<decimal>()));
    var purchaseData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PurchaseTrend ?? new List<decimal>()));

    new Chart(document.getElementById('trendChart'), {
        type: 'line',
        data: { labels: labels, datasets: [
            { label: 'Sales', data: salesData, borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,0.08)', fill: true, tension: 0.3, borderWidth: 2, pointRadius: 0 },
            { label: 'Purchases', data: purchaseData, borderColor: '#10b981', backgroundColor: 'rgba(16,185,129,0.08)', fill: true, tension: 0.3, borderWidth: 2, pointRadius: 0 }
        ]},
        options: { responsive: true, maintainAspectRatio: false,
            plugins: { legend: { position: 'top', align: 'end', labels: { boxWidth: 8, boxHeight: 8, usePointStyle: true, font: { size: 10 } } } },
            scales: {
                y: { beginAtZero: true, grid: { color: '#f3f4f6' }, ticks: { callback: v => (v/1000) + 'K', font: { size: 10 }, color: '#9ca3af' } },
                x: { grid: { display: false }, ticks: { font: { size: 10 }, color: '#9ca3af' } }
            }
        }
    });

    var pL = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        (Model.TopProducts ?? new List<ERPWMS.Web.ViewModels.TopProductItem>())
            .Select(p => p.Name ?? p.ProductName ?? "Unknown").ToList()));
    var pD = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        (Model.TopProducts ?? new List<ERPWMS.Web.ViewModels.TopProductItem>())
            .Select(p => p.Revenue).ToList()));

    if (pL.length === 0) { pL = ['No Data']; pD = [1]; }

    new Chart(document.getElementById('productChart'), {
        type: 'doughnut',
        data: { labels: pL, datasets: [{ data: pD, backgroundColor: ['#3b82f6','#10b981','#f59e0b','#8b5cf6','#ef4444'], borderWidth: 0 }] },
        options: { responsive: true, maintainAspectRatio: false, cutout: '68%',
            plugins: { legend: { position: 'bottom', labels: { boxWidth: 8, boxHeight: 8, usePointStyle: true, font: { size: 10 }, padding: 8 } } }
        }
    });
</script>
}