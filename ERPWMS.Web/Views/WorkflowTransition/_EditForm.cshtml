@model ERPWMS.Database.Models.WorkflowTransition
@{ Layout = null; }
<form id="editTransForm" method="post" action="/WorkflowTransition/QuickEdit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="transitionId" value="@Model.TransitionId" />
    <div id="editTransAlert" style="display:none;padding:8px 10px;border-radius:6px;font-size:11px;margin-bottom:12px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-2">
        <div class="col-md-6"><label class="form-label fw-bold">From Stage *</label><select name="stageFromId" id="editFrom" class="form-select form-select-sm" required><option value="">Loading...</option></select></div>
        <div class="col-md-6"><label class="form-label fw-bold">To Stage *</label><select name="stageToId" id="editTo" class="form-select form-select-sm" required><option value="">Loading...</option></select></div>
        <div class="col-md-6"><label class="form-label fw-bold">Action</label><select name="actionId" id="editAct" class="form-select form-select-sm"><option value="">Loading...</option></select></div>
        <div class="col-md-6"><label class="form-label fw-bold">Allowed</label><div style="padding-top:6px;"><label><input type="checkbox" name="isAllowed" value="true" @((Model.IsAllowed == true) ? "checked" : "") /> Yes</label></div></div>
    </div>
    <div style="padding:10px 0 0;border-top:1px solid #eef2f6;margin-top:10px;display:flex;justify-content:flex-end;gap:6px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>
<script>
(function(){
    var wid=@Model.WorkflowDefId,fid=@Model.StageFromId,tid=@Model.StageToId,aid=@Model.ActionId;
    fetch("/WorkflowTransition/GetStages?workflowDefId="+wid).then(function(r){return r.json();}).then(function(d){
        var f=document.getElementById("editFrom");var t=document.getElementById("editTo");
        f.innerHTML="<option value=''>-- Select --</option>";
        t.innerHTML="<option value=''>-- Select --</option>";
        (d||[]).forEach(function(x){
            var o1=document.createElement("option");o1.value=x.stageId;o1.textContent=x.stageName;if(x.stageId===fid)o1.selected=true;f.appendChild(o1);
            var o2=document.createElement("option");o2.value=x.stageId;o2.textContent=x.stageName;if(x.stageId===tid)o2.selected=true;t.appendChild(o2);
        });
    });
    fetch("/WorkflowTransition/GetActions").then(function(r){return r.json();}).then(function(d){
        var s=document.getElementById("editAct");
        s.innerHTML="<option value=''>-- Select Action --</option>";
        (d||[]).forEach(function(x){var o=document.createElement("option");o.value=x.actionId;o.textContent=x.actionName;if(x.actionId===aid)o.selected=true;s.appendChild(o);});
    });
})();
</script>
