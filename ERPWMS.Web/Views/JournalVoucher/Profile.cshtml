@model ERPWMS.Database.Models.JournalVoucher
@{
    ViewData["Title"] = "Journal Voucher Details";
    Layout = "_Layout";
    var entries = Model.JournalVoucherDetails?.ToList() ?? new List<ERPWMS.Database.Models.JournalVoucherDetail>();
    string statusColor = Model.Status == "Posted" ? "#159A89" : Model.Status == "Approved" ? "#0EA5E9" : "#F5A623";
    string statusText = Model.Status ?? "Draft";
}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0 fw-bold" style="color:#0A1628;">Journal Voucher Details</h3>
            <small class="text-muted">Home / Journal Vouchers / @Model.VoucherNo</small>
        </div>
        <div>
            <a href="/JournalVoucher/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
            <button class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
        </div>
    </div>
    <div class="card shadow-sm mb-3" style="background:#0A1628;color:#fff;border:none;">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <div style="background:#F5A623;color:#0A1628;padding:14px;border-radius:10px;font-size:1.6rem;margin-right:16px;"><i class="bi bi-journal-text"></i></div>
                    <div>
                        <h3 class="mb-1 fw-bold" style="color:#fff;">@Model.VoucherNo</h3>
                        <div style="font-size:12px;color:#94A3B8;"><i class="bi bi-calendar3"></i> @(Model.VoucherDate?.ToString("dd MMM yyyy") ?? "-") | @Model.Description</div>
                    </div>
                </div>
                <div><span style="background:@statusColor;color:#fff;padding:6px 16px;border-radius:20px;font-size:11px;font-weight:700;text-transform:uppercase;">@statusText</span></div>
            </div>
        </div>
    </div>
    <div class="row mb-3">
        <div class="col-md-6 mb-3 mb-md-0">
            <div class="card shadow-sm h-100" style="border:1px solid #edf0f4;"><div class="card-body">
                <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-info-circle" style="color:#F5A623;"></i> Voucher Information</h6>
                <table class="table table-sm mb-0" style="font-size:12px;">
                    <tr><td style="color:#64748B;border:none;">Voucher No</td><td class="text-end fw-bold" style="border:none;font-family:monospace;">@Model.VoucherNo</td></tr>
                    <tr><td style="color:#64748B;border:none;">Date</td><td class="text-end fw-bold" style="border:none;">@(Model.VoucherDate?.ToString("dd MMM yyyy") ?? "-")</td></tr>
                    <tr><td style="color:#64748B;border:none;">Description</td><td class="text-end" style="border:none;font-size:11px;">@Model.Description</td></tr>
                    <tr><td style="color:#64748B;border:none;">Status</td><td class="text-end fw-bold" style="border:none;color:@statusColor;">@statusText</td></tr>
                </table>
            </div></div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm h-100" style="border:1px solid #edf0f4;"><div class="card-body">
                <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-currency-dollar" style="color:#F5A623;"></i> Amount Summary</h6>
                <table class="table table-sm mb-0" style="font-size:12px;">
                    <tr><td style="color:#64748B;border:none;">Total Debit</td><td class="text-end fw-bold" style="border:none;color:#059669;font-size:14px;">Rs @Model.TotalDebit.ToString("N2")</td></tr>
                    <tr><td style="color:#64748B;border:none;">Total Credit</td><td class="text-end fw-bold" style="border:none;color:#DC2626;font-size:14px;">Rs @Model.TotalCredit.ToString("N2")</td></tr>
                    <tr><td style="color:#64748B;border:none;font-weight:700;">Difference</td><td class="text-end fw-bold" style="border:none;color:@(Model.TotalDebit == Model.TotalCredit ? "#059669" : "#DC2626");">Rs @((Model.TotalDebit - Model.TotalCredit).ToString("N2"))</td></tr>
                </table>
                @if (Model.TotalDebit == Model.TotalCredit) { <small style="color:#059669;font-size:10px;"><i class="bi bi-check-circle"></i> Balanced</small> }
                else { <small style="color:#DC2626;font-size:10px;"><i class="bi bi-x-circle"></i> Not Balanced</small> }
            </div></div>
        </div>
    </div>
    <div class="card shadow-sm mb-3" style="border:1px solid #edf0f4;">
        <div class="card-body p-0">
            <div class="px-3 py-2" style="border-bottom:2px solid #F1F5F9;">
                <h6 class="mb-0 fw-bold" style="color:#0A1628;font-size:13px;"><i class="bi bi-list-columns" style="color:#F5A623;"></i> Entry Lines <span style="background:#F1F5F9;color:#64748B;font-size:10px;padding:2px 8px;border-radius:12px;margin-left:6px;">@entries.Count</span></h6>
            </div>
            <div class="table-responsive">
                <table class="table mb-0" style="font-size:12px;">
                    <thead style="background:#F8FAFC;"><tr>
                        <th style="font-size:10px;text-transform:uppercase;color:#64748B;padding:10px 16px;border:none;">#</th>
                        <th style="font-size:10px;text-transform:uppercase;color:#64748B;padding:10px 16px;border:none;">Code</th>
                        <th style="font-size:10px;text-transform:uppercase;color:#64748B;padding:10px 16px;border:none;">Account Name</th>
                        <th style="font-size:10px;text-transform:uppercase;color:#64748B;padding:10px 16px;border:none;">Type</th>
                        <th style="font-size:10px;text-transform:uppercase;color:#64748B;padding:10px 16px;border:none;">Narration</th>
                        <th style="font-size:10px;text-transform:uppercase;color:#64748B;padding:10px 16px;border:none;text-align:right;">Debit</th>
                        <th style="font-size:10px;text-transform:uppercase;color:#64748B;padding:10px 16px;border:none;text-align:right;">Credit</th>
                    </tr></thead>
                    <tbody>
                        @if (entries.Any()) {
                            int i = 1;
                            foreach (var entry in entries) {
                                <tr style="border-bottom:1px solid #F1F5F9;">
                                    <td style="padding:10px 16px;color:#64748B;font-weight:600;">@(i++)</td>
                                    <td style="padding:10px 16px;font-family:monospace;font-weight:600;">@(entry.Account?.AccountCode ?? "-")</td>
                                    <td style="padding:10px 16px;font-weight:500;">@(entry.Account?.AccountName ?? "-")</td>
                                    <td style="padding:10px 16px;"><span style="background:#F1F5F9;color:#475569;padding:2px 8px;border-radius:10px;font-size:9px;font-weight:700;">@(entry.Account?.AccountType ?? "-")</span></td>
                                    <td style="padding:10px 16px;color:#64748B;font-size:11px;">@(string.IsNullOrEmpty(entry.Narration) ? "-" : entry.Narration)</td>
                                    <td style="padding:10px 16px;text-align:right;color:#059669;font-weight:700;">@(entry.Debit > 0 ? entry.Debit.ToString("N2") : "-")</td>
                                    <td style="padding:10px 16px;text-align:right;color:#DC2626;font-weight:700;">@(entry.Credit > 0 ? entry.Credit.ToString("N2") : "-")</td>
                                </tr>
                            }
                            <tr style="background:#F8FAFC;border-top:2px solid #E2E8F0;">
                                <td colspan="5" style="padding:10px 16px;text-align:right;font-weight:700;">TOTAL</td>
                                <td style="padding:10px 16px;text-align:right;font-weight:700;color:#059669;">@entries.Sum(e => e.Debit).ToString("N2")</td>
                                <td style="padding:10px 16px;text-align:right;font-weight:700;color:#DC2626;">@entries.Sum(e => e.Credit).ToString("N2")</td>
                            </tr>
                        } else {
                            <tr><td colspan="7" class="text-center py-4" style="color:#94A3B8;"><i class="bi bi-inbox" style="font-size:24px;display:block;margin-bottom:6px;"></i> No entry lines found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="card shadow-sm mb-3" style="border:1px solid #edf0f4;"><div class="card-body">
        <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-people" style="color:#F5A623;"></i> Audit Information</h6>
        <div class="row" style="font-size:12px;">
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Created By:</span> <strong>@(ViewBag.CreatedBy ?? "N/A")</strong></div>
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Created Date:</span> <strong>@(Model.CreatedDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</strong></div>
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Approved By:</span> <strong>@(ViewBag.ApprovedByName ?? "-")</strong></div>
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Approved Date:</span> <strong>@(Model.ApprovedDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</strong></div>
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Updated By:</span> <strong>@(ViewBag.UpdatedBy ?? "-")</strong></div>
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Updated Date:</span> <strong>@(Model.UpdatedDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</strong></div>
        </div>
    </div></div>
    
</div>
<div class="modal fade" id="editModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content">
    <div class="modal-header"><h5>Edit Journal Voucher</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body" id="editModalBody"></div>
</div></div></div>
<div class="modal fade" id="deleteModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content">
    <div class="modal-header"><h5>Confirm Delete</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body"><p>Are you sure you want to delete <strong id="deleteName"></strong>?</p></div>
    <div class="modal-footer">
        <form id="deleteForm" method="post" action="/JournalVoucher/Delete">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="deleteId" />
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-danger">Delete</button>
        </form>
    </div>
</div></div></div>
<script>
function openEdit(id){var el=document.getElementById("editModal");var b=document.getElementById("editModalBody");b.innerHTML="<div class='text-center py-4'><div class='spinner-border text-primary'></div></div>";new bootstrap.Modal(el).show();fetch("/JournalVoucher/EditJournalPartial?id="+id).then(r=>r.text()).then(h=>{b.innerHTML=h;b.querySelectorAll("script").forEach(function(s){var n=document.createElement("script");n.textContent=s.textContent;document.body.appendChild(n);});});}
function deleteVoucher(id,name){document.getElementById('deleteId').value=id;document.getElementById('deleteName').textContent=name;new bootstrap.Modal(document.getElementById('deleteModal')).show();}
function toggleActive(id){var e=document.querySelector("input[name=__RequestVerificationToken]");var fd=new FormData();fd.append("__RequestVerificationToken",e?e.value:"");fetch("/JournalVoucher/ToggleActive/"+id,{method:"POST",body:fd}).then(r=>r.json()).then(res=>{if(res.success){location.reload();}});}
</script>


