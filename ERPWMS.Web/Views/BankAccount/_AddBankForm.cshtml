@{
    Layout = null;
}
<form id="addBankForm" method="post" action="/BankAccount/Register">
    @Html.AntiForgeryToken()
    <div id="addBankAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <input type="hidden" name="companyId" value="1" />
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label fw-bold">Account Title *</label><input type="text" name="accountTitle" class="form-control" required maxlength="200" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Account No *</label><input type="text" name="accountNo" class="form-control" required maxlength="50" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Bank Name</label><input type="text" name="bankName" class="form-control" maxlength="200" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">IBAN</label><input type="text" name="iban" class="form-control" maxlength="50" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Opening Balance</label><input type="number" step="0.01" name="openingBalance" class="form-control" value="0" /></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Create</button>
    </div>
</form>
