@model ERPWMS.Database.Models.BankAccount
@{
    ViewData["Title"] = "Bank Account Details";
    Layout = "_Layout";
    var transactions = ViewBag.Transactions as List<ERPWMS.Database.Models.BankTransaction>;
    decimal totalIn = ViewBag.TotalIn ?? 0m;
    decimal totalOut = ViewBag.TotalOut ?? 0m;
    decimal currentBalance = ViewBag.CurrentBalance ?? Model.OpeningBalance;
    string statusColor = (Model.IsActive == true) ? "#159A89" : "#94A3B8";
    string statusText = (Model.IsActive == true) ? "ACTIVE" : "INACTIVE";
}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div><h3 class="mb-0 fw-bold" style="color:#0A1628;">Bank Account Details</h3><small class="text-muted">Home / Bank Accounts / @Model.AccountTitle</small></div>
        <div>
            <a href="/BankAccount/Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Back</a>
            <button class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer"></i> Print</button>
        </div>
    </div>

    <div class="card shadow-sm mb-3" style="background:#0A1628;color:#fff;border:none;">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center">
                    <div style="background:#F5A623;color:#0A1628;padding:14px;border-radius:10px;font-size:1.6rem;margin-right:16px;"><i class="bi bi-bank"></i></div>
                    <div>
                        <h3 class="mb-1 fw-bold" style="color:#fff;">@Model.AccountTitle</h3>
                        <div style="font-size:12px;color:#94A3B8;">
                            <i class="bi bi-hash"></i> @Model.AccountNo &nbsp;|&nbsp; @Model.BankName
                            @if (!string.IsNullOrEmpty(Model.Iban)) { <text>&nbsp;|&nbsp; IBAN: @Model.Iban</text> }
                        </div>
                    </div>
                </div>
                <div><span style="background:@statusColor;color:#fff;padding:6px 16px;border-radius:20px;font-size:11px;font-weight:700;text-transform:uppercase;">@statusText</span></div>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6 mb-3 mb-md-0">
            <div class="card shadow-sm h-100" style="border:1px solid #edf0f4;"><div class="card-body">
                <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-info-circle" style="color:#F5A623;"></i> Account Information</h6>
                <table class="table table-sm mb-0" style="font-size:12px;">
                    <tr><td style="color:#64748B;border:none;">Account Title</td><td class="text-end fw-bold" style="border:none;">@Model.AccountTitle</td></tr>
                    <tr><td style="color:#64748B;border:none;">Account No</td><td class="text-end fw-bold" style="border:none;font-family:monospace;">@Model.AccountNo</td></tr>
                    <tr><td style="color:#64748B;border:none;">Bank Name</td><td class="text-end fw-bold" style="border:none;">@Model.BankName</td></tr>
                    <tr><td style="color:#64748B;border:none;">IBAN</td><td class="text-end fw-bold" style="border:none;font-family:monospace;">@(string.IsNullOrEmpty(Model.Iban) ? "-" : Model.Iban)</td></tr>
                    <tr><td style="color:#64748B;border:none;">Branch Code</td><td class="text-end fw-bold" style="border:none;">@(string.IsNullOrEmpty(Model.BranchCode) ? "-" : Model.BranchCode)</td></tr>
                    <tr><td style="color:#64748B;border:none;">Account Type</td><td class="text-end fw-bold" style="border:none;">@(string.IsNullOrEmpty(Model.AccountType) ? "-" : Model.AccountType)</td></tr>
                    <tr><td style="color:#64748B;border:none;">Company</td><td class="text-end fw-bold" style="border:none;">@(ViewBag.CompanyName ?? "N/A")</td></tr>
                    <tr><td style="color:#64748B;border:none;">Status</td><td class="text-end fw-bold" style="border:none;color:@statusColor;">@statusText</td></tr>
                </table>
            </div></div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm h-100" style="border:1px solid #edf0f4;"><div class="card-body">
                <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-currency-dollar" style="color:#F5A623;"></i> Balance Summary</h6>
                <table class="table table-sm mb-0" style="font-size:12px;">
                    <tr><td style="color:#64748B;border:none;">Opening Balance</td><td class="text-end fw-bold" style="border:none;color:#0A1628;">Rs @Model.OpeningBalance.ToString("N2")</td></tr>
                    <tr><td style="color:#64748B;border:none;">Total In (Deposits)</td><td class="text-end fw-bold" style="border:none;color:#059669;">Rs @totalIn.ToString("N2")</td></tr>
                    <tr><td style="color:#64748B;border:none;">Total Out (Withdrawals)</td><td class="text-end fw-bold" style="border:none;color:#DC2626;">Rs @totalOut.ToString("N2")</td></tr>
                    <tr style="background:#F8FAFC;"><td style="color:#0A1628;border:none;font-weight:700;">Current Balance</td><td class="text-end fw-bold" style="border:none;color:#0A1628;font-size:16px;">Rs @currentBalance.ToString("N2")</td></tr>
                </table>
            </div></div>
        </div>
    </div>

    <div class="card shadow-sm mb-3" style="border:1px solid #edf0f4;">
        <div class="card-body p-0">
            <div class="px-3 py-2" style="border-bottom:2px solid #F1F5F9;">
                <h6 class="mb-0 fw-bold" style="color:#0A1628;font-size:13px;"><i class="bi bi-clock-history" style="color:#F5A623;"></i> Transaction History <span style="background:#F1F5F9;color:#64748B;font-size:10px;padding:2px 8px;border-radius:12px;margin-left:6px;">@(transactions?.Count ?? 0)</span></h6>
            </div>
            <div class="table-responsive">
                <table class="table mb-0" style="font-size:12px;">
                    <thead style="background:#F8FAFC;"><tr>
                        <th style="font-size:10px;text-transform:uppercase;color:#64748B;padding:10px 16px;border:none;">#</th>
                        <th style="font-size:10px;text-transform:uppercase;color:#64748B;padding:10px 16px;border:none;">Date</th>
                        <th style="font-size:10px;text-transform:uppercase;color:#64748B;padding:10px 16px;border:none;">Type</th>
                        <th style="font-size:10px;text-transform:uppercase;color:#64748B;padding:10px 16px;border:none;">Reference</th>
                        <th style="font-size:10px;text-transform:uppercase;color:#64748B;padding:10px 16px;border:none;">Description</th>
                        <th style="font-size:10px;text-transform:uppercase;color:#64748B;padding:10px 16px;border:none;text-align:right;">Amount</th>
                    </tr></thead>
                    <tbody>
                        @if (transactions != null && transactions.Any()) {
                            int i = 1;
                            foreach (var t in transactions) {
                                <tr style="border-bottom:1px solid #F1F5F9;">
                                    <td style="padding:10px 16px;color:#64748B;font-weight:600;">@(i++)</td>
                                    <td style="padding:10px 16px;">@(t.TransactionDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                    <td style="padding:10px 16px;"><span style="background:#F1F5F9;color:#475569;padding:2px 8px;border-radius:10px;font-size:9px;font-weight:700;">@(t.TransactionType ?? "-")</span></td>
                                    <td style="padding:10px 16px;font-family:monospace;font-size:11px;">@(t.ReferenceNo ?? "-")</td>
                                    <td style="padding:10px 16px;color:#64748B;font-size:11px;">@(t.Description ?? "-")</td>
                                    <td style="padding:10px 16px;text-align:right;font-weight:700;color:@((t.TransactionType == "Credit" || t.TransactionType == "Deposit") ? "#059669" : "#DC2626");">Rs @t.Amount.ToString("N2")</td>
                                </tr>
                            }
                        } else {
                            <tr><td colspan="6" class="text-center py-4" style="color:#94A3B8;"><i class="bi bi-inbox" style="font-size:24px;display:block;margin-bottom:6px;"></i> No transactions found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-3" style="border:1px solid #edf0f4;"><div class="card-body">
        <h6 class="fw-bold mb-3" style="color:#0A1628;"><i class="bi bi-people" style="color:#F5A623;"></i> Audit Information</h6>
        <div class="row" style="font-size:12px;">
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Created By:</span> <strong>@(ViewBag.CreatedBy ?? "N/A")</strong></div>
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Created Date:</span> <strong>@(Model.CreatedDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</strong></div>
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Updated By:</span> <strong>@(ViewBag.UpdatedBy ?? "-")</strong></div>
            <div class="col-md-4 mb-2"><span style="color:#64748B;">Updated Date:</span> <strong>@(Model.UpdatedDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</strong></div>
        </div>
    </div></div>
</div>

