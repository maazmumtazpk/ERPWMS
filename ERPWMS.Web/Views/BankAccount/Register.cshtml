@model ERPWMS.Application.DTOs.Finance.BankAccount.RegisterBankAccountRequest

@{
    ViewData["Title"] = "Add Bank Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">? Add Bank Account</h2>
        <div>
            <span class="badge bg-primary fs-6 me-2">
                ?? @ViewBag.CompanyName
            </span>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="CompanyId" />

                <!-- Company Display -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">?? Company</label>
                        <input type="text" class="form-control" value="@ViewBag.CompanyName" disabled readonly />
                        <small class="text-muted">Company is auto-selected from your login.</small>
                    </div>
                </div>

                <hr />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="BankName" class="form-label fw-bold"></label>
                        <input asp-for="BankName" class="form-control" placeholder="e.g., HBL" />
                        <span asp-validation-for="BankName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AccountTitle" class="form-label fw-bold"></label>
                        <input asp-for="AccountTitle" class="form-control" placeholder="e.g., ABC Trading" />
                        <span asp-validation-for="AccountTitle" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="AccountNo" class="form-label fw-bold"></label>
                        <input asp-for="AccountNo" class="form-control" placeholder="e.g., 1234-5678-90" />
                        <span asp-validation-for="AccountNo" class="text-danger"></span>
                        <small class="text-muted">Unique account number for this company.</small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Iban" class="form-label fw-bold">IBAN</label>
                        <input asp-for="Iban" class="form-control" placeholder="e.g., PK36HBL..." />
                        <span asp-validation-for="Iban" class="text-danger"></span>
                        <small class="text-muted">Optional: International Bank Account Number.</small>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="BranchCode" class="form-label fw-bold">Branch Code</label>
                        <input asp-for="BranchCode" class="form-control" placeholder="e.g., 0012" />
                        <span asp-validation-for="BranchCode" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="AccountType" class="form-label fw-bold"></label>
                        <select asp-for="AccountType" class="form-select">
                            <option value="">-- Select --</option>
                            <option value="Current">Current</option>
                            <option value="Saving">Saving</option>
                            <option value="Fixed">Fixed</option>
                            <option value="Others">Others</option>
                        </select>
                        <span asp-validation-for="AccountType" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="OpeningBalance" class="form-label fw-bold">Opening Balance</label>
                        <input asp-for="OpeningBalance" class="form-control" type="number" step="0.01" value="0" />
                        <span asp-validation-for="OpeningBalance" class="text-danger"></span>
                        <small class="text-muted">Initial balance for this account.</small>
                    </div>
                </div>

                <hr />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Create Bank Account
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
