@model ERPWMS.Database.Models.BankAccount
@{ Layout = null; }
<form id="editBankForm" method="post" action="/BankAccount/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="bankAccountId" value="@Model.BankAccountId" />
    <div id="editBankAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label fw-bold">Account Title *</label><input type="text" name="accountTitle" class="form-control" value="@Model.AccountTitle" required maxlength="200" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Account No *</label><input type="text" name="accountNo" class="form-control" value="@Model.AccountNo" required maxlength="50" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Bank Name</label><input type="text" name="bankName" class="form-control" value="@Model.BankName" maxlength="200" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">IBAN</label><input type="text" name="iban" class="form-control" value="@Model.Iban" maxlength="50" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Opening Balance</label><input type="number" step="0.01" name="openingBalance" class="form-control" value="@Model.OpeningBalance" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Status</label><select name="isActive" class="form-select">@if((Model.IsActive == true)){<option value="true" selected>Active</option><option value="false">Inactive</option>}else{<option value="true">Active</option><option value="false" selected>Inactive</option>}</select></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>
