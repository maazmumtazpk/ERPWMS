@model ERPWMS.Application.DTOs.Finance.BankAccount.UpdateBankAccountRequest

@{
    ViewData["Title"] = "Edit Bank Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">?? Edit Bank Account</h2>
        <div>
            <span class="badge bg-primary fs-6 me-2">
                ?? @ViewBag.CompanyName
            </span>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="BankAccountId" />
                <input type="hidden" asp-for="CompanyId" />

                <!-- Company Display -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">?? Company</label>
                        <input type="text" class="form-control" value="@ViewBag.CompanyName" disabled readonly />
                        <small class="text-muted">Company is auto-selected from your login.</small>
                    </div>
                </div>

                <hr />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="BankName" class="form-label fw-bold"></label>
                        <input asp-for="BankName" class="form-control" />
                        <span asp-validation-for="BankName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AccountTitle" class="form-label fw-bold"></label>
                        <input asp-for="AccountTitle" class="form-control" />
                        <span asp-validation-for="AccountTitle" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="AccountNo" class="form-label fw-bold"></label>
                        <input asp-for="AccountNo" class="form-control" />
                        <span asp-validation-for="AccountNo" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Iban" class="form-label fw-bold">IBAN</label>
                        <input asp-for="Iban" class="form-control" />
                        <span asp-validation-for="Iban" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="BranchCode" class="form-label fw-bold">Branch Code</label>
                        <input asp-for="BranchCode" class="form-control" />
                        <span asp-validation-for="BranchCode" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="AccountType" class="form-label fw-bold"></label>
                        <select asp-for="AccountType" class="form-select">
                            <option value="">-- Select --</option>
                            <option value="Current">Current</option>
                            <option value="Saving">Saving</option>
                            <option value="Fixed">Fixed</option>
                            <option value="Others">Others</option>
                        </select>
                        <span asp-validation-for="AccountType" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="OpeningBalance" class="form-label fw-bold">Opening Balance</label>
                        <input asp-for="OpeningBalance" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="OpeningBalance" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                    </div>
                </div>

                <hr />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-save"></i> Update Bank Account
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
