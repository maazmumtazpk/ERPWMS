@model ERPWMS.Database.Models.PurchaseMaster
@{ Layout = null; }
<form id="editPurchaseForm" method="post" action="/PurchaseMaster/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="purchaseId" value="@Model.PurchaseId" />
    <div id="editPurchaseAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label fw-bold">PO Number *</label><input type="text" name="purchaseOrderNo" class="form-control" value="@Model.PurchaseOrderNo" required maxlength="50" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Order Date</label><input type="date" name="orderDate" class="form-control" value="@(Model.OrderDate?.ToString("yyyy-MM-dd"))" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Supplier *</label><select name="supplierId" id="editSupplier" class="form-select" required><option value="">Loading...</option></select></div>
        <div class="col-md-6"><label class="form-label fw-bold">Warehouse</label><select name="warehouseId" id="editWarehouse" class="form-select"><option value="">Loading...</option></select></div>
        <div class="col-md-6"><label class="form-label fw-bold">Total Amount</label><input type="number" step="0.01" name="totalAmount" class="form-control" value="@Model.TotalAmount" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Discount</label><input type="number" step="0.01" name="discount" class="form-control" value="@(Model.Discount ?? 0)" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Tax</label><input type="number" step="0.01" name="taxAmount" class="form-control" value="@(Model.TaxAmount ?? 0)" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Net Amount</label><input type="number" step="0.01" name="netAmount" class="form-control" value="@Model.NetAmount" /></div>
        <div class="col-12"><label class="form-label fw-bold">Status</label><select name="status" class="form-select">
            @foreach(var s in new[]{"Pending","Approved","Completed","Cancelled"}){
                if(Model.Status == s){<option value="@s" selected>@s</option>}else{<option value="@s">@s</option>}
            }
        </select></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>
<script>
(function(){
var sid=@Model.SupplierId;var wid=@Model.WarehouseId;
fetch("/PurchaseMaster/GetSuppliers").then(r=>r.json()).then(d=>{var s=document.getElementById("editSupplier");s.innerHTML="<option value=''>-- Select Supplier --</option>";(d||[]).forEach(x=>{var o=document.createElement("option");o.value=x.supplierId;o.textContent=x.supplierName;if(x.supplierId===sid)o.selected=true;s.appendChild(o);});});
fetch("/PurchaseMaster/GetWarehouses").then(r=>r.json()).then(d=>{var s=document.getElementById("editWarehouse");s.innerHTML="<option value=''>-- Select Warehouse --</option>";(d||[]).forEach(x=>{var o=document.createElement("option");o.value=x.warehouseId;o.textContent=x.warehouseName;if(x.warehouseId===wid)o.selected=true;s.appendChild(o);});});
})();
</script>
