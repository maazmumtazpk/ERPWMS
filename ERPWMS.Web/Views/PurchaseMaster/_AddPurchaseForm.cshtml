@{
    Layout = null;
}
<form id="addPurchaseForm" method="post" action="/PurchaseMaster/Register">
    @Html.AntiForgeryToken()
    <div id="addPurchaseAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label fw-bold">PO Number *</label><input type="text" name="purchaseOrderNo" class="form-control" required maxlength="50" placeholder="PO-2026-001" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Order Date</label><input type="date" name="orderDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Supplier *</label><select name="supplierId" id="addSupplier" class="form-select" required><option value="">Loading...</option></select></div>
        <div class="col-md-6"><label class="form-label fw-bold">Warehouse</label><select name="warehouseId" id="addWarehouse" class="form-select"><option value="">Loading...</option></select></div>
        <div class="col-md-6"><label class="form-label fw-bold">Expected Delivery</label><input type="date" name="expectedDeliveryDate" class="form-control" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Total Amount</label><input type="number" step="0.01" name="totalAmount" class="form-control" value="0" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Discount</label><input type="number" step="0.01" name="discount" class="form-control" value="0" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Tax</label><input type="number" step="0.01" name="taxAmount" class="form-control" value="0" /></div>
        <div class="col-md-4"><label class="form-label fw-bold">Net Amount</label><input type="number" step="0.01" name="netAmount" class="form-control" value="0" /></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Create PO</button>
    </div>

<!-- ═══ LIVE AMOUNT CALCULATOR ═══ -->
<div id="po-summary" style="margin-top:14px;padding:14px 18px;background:#F8FAFC;border:1px solid #E2E8F0;border-radius:10px;">
    <div style="display:flex;justify-content:flex-end;gap:40px;flex-wrap:wrap;">
        <div style="text-align:right;">
            <div style="font-size:10px;color:#64748B;text-transform:uppercase;font-weight:700;">Sub Total</div>
            <div id="po-subtotal" style="font-size:15px;font-weight:800;color:#0A1628;">Rs 0.00</div>
        </div>
        <div style="text-align:right;">
            <div style="font-size:10px;color:#64748B;text-transform:uppercase;font-weight:700;">Discount</div>
            <div id="po-discount" style="font-size:15px;font-weight:800;color:#DC2626;">- Rs 0.00</div>
        </div>
        <div style="text-align:right;">
            <div style="font-size:10px;color:#64748B;text-transform:uppercase;font-weight:700;">Tax</div>
            <div id="po-tax" style="font-size:15px;font-weight:800;color:#334155;">+ Rs 0.00</div>
        </div>
        <div style="text-align:right;border-left:2px solid #E2E8F0;padding-left:24px;">
            <div style="font-size:10px;color:#0A1628;text-transform:uppercase;font-weight:800;">Grand Total</div>
            <div id="po-grandtotal" style="font-size:20px;font-weight:900;color:#F5A623;">Rs 0.00</div>
        </div>
    </div>
</div>

<script>
(function(){
    function fmt(n){ return "Rs " + (Number(n) || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ","); }
    
    function calcPO(){
        var rows = document.querySelectorAll('#itemsBody tr');
        var sub = 0;
        rows.forEach(function(tr){
            var qty = parseFloat(tr.querySelector('input[name*="Quantity"], input[name*="quantity"]')?.value || 0) || 0;
            var price = parseFloat(tr.querySelector('input[name*="UnitPrice"], input[name*="unitPrice"], input[name*="Price"]')?.value || 0) || 0;
            var disc = parseFloat(tr.querySelector('input[name*="DiscountPercent"], input[name*="discountPercent"], input[name*="Discount"]')?.value || 0) || 0;
            var line = qty * price;
            sub += line * (1 - disc/100);
        });
        
        var discount = parseFloat(document.querySelector('input[name="discount"]')?.value || 0) || 0;
        var tax = parseFloat(document.querySelector('input[name="tax"], input[name="taxAmount"]')?.value || 0) || 0;
        var grand = sub - discount + tax;
        
        var elSub = document.getElementById('po-subtotal');
        var elDis = document.getElementById('po-discount');
        var elTax = document.getElementById('po-tax');
        var elTot = document.getElementById('po-grandtotal');
        if(elSub) elSub.textContent = fmt(sub);
        if(elDis) elDis.textContent = "- " + fmt(discount);
        if(elTax) elTax.textContent = "+ " + fmt(tax);
        if(elTot) elTot.textContent = fmt(grand);
    }
    
    // Trigger on any input change
    document.addEventListener('input', function(e){
        var t = e.target;
        if(t && (t.name || '').match(/quantity|price|discount|tax/i)) {
            calcPO();
        }
    });
    
    // Trigger on item add/remove (event delegation on Add Item button)
    document.addEventListener('click', function(e){
        var b = e.target.closest('button, a');
        if(b && (b.textContent || '').match(/add item|add row|remove/i)) {
            setTimeout(calcPO, 100);
        }
    });
    
    // Initial calc
    setTimeout(calcPO, 500);
    console.log("✓ PO calculator active");
})();
</script>
</form>
<script>
fetch("/PurchaseMaster/GetSuppliers").then(r=>r.json()).then(d=>{var s=document.getElementById("addSupplier");s.innerHTML="<option value=''>-- Select Supplier --</option>";(d||[]).forEach(x=>{var o=document.createElement("option");o.value=x.supplierId;o.textContent=x.supplierName;s.appendChild(o);});});
fetch("/PurchaseMaster/GetWarehouses").then(r=>r.json()).then(d=>{var s=document.getElementById("addWarehouse");s.innerHTML="<option value=''>-- Select Warehouse --</option>";(d||[]).forEach(x=>{var o=document.createElement("option");o.value=x.warehouseId;o.textContent=x.warehouseName;s.appendChild(o);});});
</script>

