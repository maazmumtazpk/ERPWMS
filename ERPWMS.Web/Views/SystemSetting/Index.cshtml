@{
    ViewData["Title"] = "System Settings";
    Layout = "_Layout";
}
<form id="__af" style="display:none;">@Html.AntiForgeryToken()</form>
<div class="toast-holder" id="toastHolder"></div>
@await Html.PartialAsync("_AdminCss")
<div style="padding-bottom:30px;">
<div class="row g-3">
<div class="col-xl-3 col-lg-3 col-md-6"><div class="kpi-card total"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Total Settings</p><h2 class="kpi-number" id="kpiTotal">0</h2></div><div class="kpi-icon blue"><i class="bi bi-gear"></i></div></div></div></div>
<div class="col-xl-3 col-lg-3 col-md-6"><div class="kpi-card active"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Public</p><h2 class="kpi-number" id="kpiActive">0</h2></div><div class="kpi-icon green"><i class="bi bi-unlock"></i></div></div></div></div>
<div class="col-xl-3 col-lg-3 col-md-6"><div class="kpi-card inactive"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Encrypted</p><h2 class="kpi-number" id="kpiInactive">0</h2></div><div class="kpi-icon orange"><i class="bi bi-lock"></i></div></div></div></div>
<div class="col-xl-3 col-lg-3 col-md-6"><div class="kpi-card month"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Updated This Month</p><h2 class="kpi-number" id="kpiMonth">0</h2></div><div class="kpi-icon purple"><i class="bi bi-calendar-plus"></i></div></div></div></div>
</div>
<div class="table-card">
<div class="card-header-custom">
<h5><i class="bi bi-gear" style="color:#F5A623;"></i> All Settings <span class="badge-count" id="xCount">0</span></h5>
<div style="display:flex;gap:4px;align-items:center;">
<input type="text" id="tSearch" class="search-input" placeholder="Search..." onkeyup="filterRows()" />
<button type="button" class="btn-icon" onclick="reload_()"><i class="bi bi-arrow-clockwise"></i></button>
</div>
</div>
<div class="card-body">
<table class="table-premium" id="xTable">
<thead><tr><th>Key</th><th>Value</th><th>Type</th><th>Description</th><th style="text-align:right;">Actions</th></tr></thead>
<tbody id="xBody"><tr><td colspan="5" class="text-center py-3"><div class="spinner-border text-primary" style="width:20px;height:20px;"></div></td></tr></tbody>
</table>
<div id="emptyState" class="empty-state d-none"><i class="bi bi-gear empty-icon"></i><h4>No Settings Yet</h4></div>
</div>
<div class="table-footer"><span><i class="bi bi-info-circle"></i> Showing <span id="tableCount">0</span> settings</span></div>
</div>
</div>
<div class="modal fade pm-modal" id="editModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5><i class="bi bi-pencil-square"></i> Edit Setting</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body" id="editModalBody"></div></div></div></div>
@await Html.PartialAsync("_AdminJs")
<script>
function openEdit(id){var el=document.getElementById("editModal");var b=document.getElementById("editModalBody");b.innerHTML="<div class='text-center py-4'><div class='spinner-border text-primary'></div></div>";new bootstrap.Modal(el).show();fetch("/SystemSetting/EditPartial?id="+id).then(function(r){return r.text();}).then(function(h){b.innerHTML=h;execScripts(b);});}
function reload_(){fetch("/SystemSetting/GetStatistics").then(function(r){return r.json();}).then(function(d){document.getElementById("kpiTotal").textContent=d.total||0;document.getElementById("kpiActive").textContent=d.active||0;document.getElementById("kpiInactive").textContent=d.inactive||0;document.getElementById("kpiMonth").textContent=d.addedThisMonth||0;});fetch("/SystemSetting/GetAll").then(function(r){return r.json();}).then(function(d){if(!d||d.length===0){document.getElementById("xBody").innerHTML="";document.getElementById("xTable").style.display="none";document.getElementById("emptyState").classList.remove("d-none");document.getElementById("xCount").textContent="0";document.getElementById("tableCount").textContent="0";return;}document.getElementById("xTable").style.display="";document.getElementById("emptyState").classList.add("d-none");var h="";d.forEach(function(x){var enc=x.isEncrypted?"<span style='color:#DC2626;'><i class='bi bi-lock-fill'></i> Encrypted</span>":(x.settingValue||"-");h+="<tr>";h+="<td><div class='row-name'><span class='avatar'><i class='bi bi-key'></i></span><div style='font-family:monospace;font-size:11px;'>"+(x.settingKey||"-")+"</div></div></td>";h+="<td style='font-family:monospace;font-size:11px;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;'>"+enc+"</td>";h+="<td><span class='badge-status role'>"+(x.dataType||"string")+"</span></td>";h+="<td style='font-size:10px;color:#64748B;'>"+(x.description||"-")+"</td>";h+="<td style='text-align:right;'><div class='act-wrap'><button class='btn-icon' onclick='toggleMenu("+x.settingId+",event)'><i class='bi bi-three-dots-vertical'></i></button><div class='act-menu' id='menu-"+x.settingId+"'><button onclick='openEdit("+x.settingId+")'><i class='bi bi-pencil'></i> Edit</button><div class='sep'></div><button class='danger' onclick='delRow("+x.settingId+")'><i class='bi bi-trash3'></i> Delete</button></div></div></td>";h+="</tr>";});document.getElementById("xBody").innerHTML=h;document.getElementById("xCount").textContent=d.length;document.getElementById("tableCount").textContent=d.length;});}
function delRow(id){if(!confirm("Delete this setting?"))return;var fd=new FormData();fd.append("__RequestVerificationToken",tk());fetch("/SystemSetting/QuickDelete/"+id,{method:"POST",body:fd}).then(function(r){return r.json();}).then(function(res){if(res.success){showToast(res.message||"Deleted","success");reload_();}else{showToast(res.message||"Failed","error");}});}
document.addEventListener("DOMContentLoaded",reload_);
</script>
