@model ERPWMS.Database.Models.SystemSetting
@{ Layout = null; }
<form id="editSetForm" method="post" action="/SystemSetting/QuickEdit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="settingId" value="@Model.SettingId" />
    <div id="editSetAlert" style="display:none;padding:8px 10px;border-radius:6px;font-size:11px;margin-bottom:12px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-2">
        <div class="col-md-6"><label class="form-label fw-bold">Key *</label><input type="text" name="settingKey" class="form-control form-control-sm" value="@Model.SettingKey" required maxlength="100" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Data Type</label><select name="dataType" class="form-select form-select-sm">@foreach(var t in new[]{"string","int","bool","decimal","json"}){if(Model.DataType == t){<option value="@t" selected>@t</option>}else{<option value="@t">@t</option>}}</select></div>
        <div class="col-md-12"><label class="form-label fw-bold">Value *</label><textarea name="settingValue" class="form-control form-control-sm" rows="2" required maxlength="1000">@Model.SettingValue</textarea></div>
        <div class="col-md-12"><label class="form-label fw-bold">Description</label><input type="text" name="description" class="form-control form-control-sm" value="@Model.Description" maxlength="250" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Options</label><div style="padding-top:6px;"><label><input type="checkbox" name="isEncrypted" value="true" @((Model.IsEncrypted == true) ? "checked" : "") /> Encrypt value</label></div></div>
    </div>
    <div style="padding:10px 0 0;border-top:1px solid #eef2f6;margin-top:10px;display:flex;justify-content:flex-end;gap:6px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>
