@{
    Layout = null;
    var whId = ViewBag.WarehouseId ?? 0;
}
<form id="addRackForm" method="post" action="/Rack/Register">
    @Html.AntiForgeryToken()
    <div id="addRackAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-12">
            <label class="form-label fw-bold">Zone *</label>
            <select name="zoneId" id="addRackZone" class="form-select" required>
                <option value="">Loading...</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Rack Name *</label>
            <input type="text" name="rackName" class="form-control" required maxlength="200" placeholder="Enter rack name" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Rack Code</label>
            <input type="text" name="rackCode" class="form-control" maxlength="20" placeholder="RK-001" />
        </div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Register</button>
    </div>
</form>
<script>
(function(){
    var whId = @whId;
    var s = document.getElementById("addRackZone");
    fetch("/Zone/GetForDropdown?warehouseId=" + whId).then(function(r){return r.json();}).then(function(d){
        s.innerHTML = "<option value=''>-- Select Zone --</option>";
        (d || []).forEach(function(z){
            var o = document.createElement("option");
            o.value = z.zoneId;
            o.textContent = z.zoneName;
            s.appendChild(o);
        });
    });
})();
</script>
