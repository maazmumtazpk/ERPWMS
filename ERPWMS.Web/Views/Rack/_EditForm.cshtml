@model ERPWMS.Database.Models.Rack
@{
    Layout = null;
    var zoneName = Model.Zone != null ? Model.Zone.ZoneName : "-";
}
<form id="editRackForm" method="post" action="/Rack/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="rackId" value="@Model.RackId" />
    <div id="editRackAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-12">
            <label class="form-label fw-bold">Zone</label>
            <input type="text" class="form-control" value="@zoneName" disabled />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Rack Name *</label>
            <input type="text" name="rackName" class="form-control" value="@Model.RackName" required maxlength="200" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Rack Code</label>
            <input type="text" name="rackCode" class="form-control" value="@Model.RackCode" maxlength="20" />
        </div>
        <div class="col-md-6">
            <label class="form-label fw-bold">Status</label>
            <select name="isActive" class="form-select">
                @if((Model.IsActive == true)){<option value="true" selected>Active</option><option value="false">Inactive</option>}
                else{<option value="true">Active</option><option value="false" selected>Inactive</option>}
            </select>
        </div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>
