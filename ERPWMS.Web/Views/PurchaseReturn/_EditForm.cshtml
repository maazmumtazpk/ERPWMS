@model ERPWMS.Database.Models.PurchaseReturn
@{
    Layout = null;
}
<style>
    .pr-f .form-label { font-size: 11px; font-weight: 600; color: #1e293b; margin-bottom: 3px; display: block; }
    .pr-f .form-control, .pr-f .form-select { font-size: 12px; padding: 6px 10px; min-height: 34px; border-radius: 6px; border: 1px solid #cbd5e1; }
    .pr-f .form-control[readonly] { background: #f1f5f9; }
    .pr-f .row.g-2 { --bs-gutter-y: 8px; --bs-gutter-x: 10px; }
    .pr-f .btn-gold { background:#F5A623;color:#0A1628;border:none;font-weight:700;padding:6px 16px;border-radius:6px;font-size:12px; }
    .pr-f .btn-ghost { background:#fff;color:#475569;border:1px solid #cbd5e1;padding:6px 16px;border-radius:6px;font-size:12px;font-weight:600; }
</style>

<form id="editForm" method="post" action="/PurchaseReturn/Edit" autocomplete="off" class="pr-f">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ReturnId" value="@Model.ReturnId" />
    <div id="editAlert" style="display:none;padding:8px 12px;border-radius:6px;font-size:11.5px;margin-bottom:12px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>

    <div class="row g-2">
        <div class="col-md-6">
            <label class="form-label">Return No</label>
            <input type="text" name="ReturnNo" class="form-control" readonly value="@Model.ReturnNo" style="font-family:monospace;font-weight:700;" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Return Date</label>
            <input type="date" name="ReturnDate" class="form-control" value="@(Model.ReturnDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Purchase Order</label>
            <select name="PurchaseId" class="form-select">
                <option value="">-- Select PO --</option>
                @if(ViewBag.Purchases != null) { foreach(var p in ViewBag.Purchases) {
                    <option value="@p.purchaseId" selected="@(Model.PurchaseId == p.purchaseId)">@p.purchaseOrderNo</option>
                } }
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">GRN (Optional)</label>
            <select name="GRNId" class="form-select">
                <option value="">-- Select GRN --</option>
                @if(ViewBag.GRNs != null) { foreach(var g in ViewBag.GRNs) {
                    <option value="@g.grnId" selected="@(Model.GrnId == g.grnId)">@g.grnNo</option>
                } }
            </select>
        </div>
        <div class="col-md-12">
            <label class="form-label">Return Reason</label>
            <input type="text" name="ReturnReason" class="form-control" value="@Model.ReturnReason" maxlength="500" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Status</label>
            <select name="Status" class="form-select">
                @foreach (var s in new[] { "Pending", "Approved", "Completed", "Cancelled" })
                {
                    if (Model.Status == s) { <option value="@s" selected>@s</option> }
                    else { <option value="@s">@s</option> }
                }
            </select>
        </div>
    </div>

    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold"><i class="bi bi-check-lg"></i> Update Return</button>
    </div>
</form>
