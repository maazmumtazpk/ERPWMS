@{
    Layout = null;
}
<style>
    .pr-f .form-label { font-size: 11px; font-weight: 600; color: #1e293b; margin-bottom: 3px; display: block; }
    .pr-f .form-control, .pr-f .form-select { font-size: 12px; padding: 6px 10px; min-height: 34px; border-radius: 6px; border: 1px solid #cbd5e1; }
    .pr-f .form-control[readonly] { background: #f1f5f9; }
    .pr-f .row.g-2 { --bs-gutter-y: 8px; --bs-gutter-x: 10px; }
    .pr-f .item-row { padding: 10px 12px; background: #fafbfc; border: 1px solid #e2e8f0; border-radius: 8px; margin-bottom: 8px; }
    .pr-f .btn-gold { background:#F5A623;color:#0A1628;border:none;font-weight:700;padding:6px 16px;border-radius:6px;font-size:12px; }
    .pr-f .btn-ghost { background:#fff;color:#475569;border:1px solid #cbd5e1;padding:6px 16px;border-radius:6px;font-size:12px;font-weight:600; }
</style>

<form id="addForm" method="post" action="/PurchaseReturn/Register" autocomplete="off" class="pr-f">
    @Html.AntiForgeryToken()
    <div id="addAlert" style="display:none;padding:8px 12px;border-radius:6px;font-size:11.5px;margin-bottom:12px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>

    <div class="row g-2">
        <div class="col-md-6">
            <label class="form-label">Purchase Order *</label>
            <select name="PurchaseId" id="poSelect" class="form-select" required>
                <option value="">-- Select Purchase Order --</option>
                @if(ViewBag.Purchases != null) { foreach(var p in ViewBag.Purchases) {
                    <option value="@p.purchaseId">@p.purchaseOrderNo</option>
                } }
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">GRN (Optional)</label>
            <select name="GRNId" id="grnSelect" class="form-select">
                <option value="">-- Select GRN --</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">Return No *</label>
            <input type="text" name="ReturnNo" class="form-control" readonly value="@(ViewBag.NextReturnNo ?? "")" style="font-family:monospace;font-weight:700;" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Return Date</label>
            <input type="date" name="ReturnDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-md-12">
            <label class="form-label">Return Reason</label>
            <input type="text" name="ReturnReason" class="form-control" maxlength="500" placeholder="Why returning? e.g. Damaged, Wrong item" />
        </div>
    </div>

    <div style="display:flex;justify-content:space-between;align-items:center;margin:14px 0 8px;">
        <span style="font-size:12px;font-weight:700;color:#0A1628;">Items to Return</span>
        <button type="button" class="btn btn-sm btn-gold" id="addItemBtn"><i class="bi bi-plus"></i> Add Item</button>
    </div>

    <div id="itemsContainer">
        <div class="item-row">
            <div class="row g-2">
                <div class="col-md-5">
                    <label class="form-label">Product *</label>
                    <select name="ReturnDetails[0].ProductId" class="form-select product-select" required>
                        <option value="">-- Select Product --</option>
                    </select>
                    <input type="hidden" name="ReturnDetails[0].PurchaseDetailId" class="pdetail-id" value="0" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Quantity *</label>
                    <input type="number" name="ReturnDetails[0].Quantity" class="form-control qty-input" min="1" value="1" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Unit Price *</label>
                    <input type="number" step="0.01" name="ReturnDetails[0].UnitPrice" class="form-control price-input" min="0" value="0" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Total</label>
                    <input type="text" class="form-control line-total" readonly value="Rs 0.00" style="background:#f8fafc;font-weight:700;" />
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="button" class="btn btn-sm btn-danger remove-item w-100" style="font-size:11px;"><i class="bi bi-x"></i></button>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Batch No</label>
                    <input type="text" name="ReturnDetails[0].BatchNo" class="form-control" maxlength="50" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Expiry Date</label>
                    <input type="date" name="ReturnDetails[0].ExpiryDate" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div id="pr-summary" style="margin-top:14px;padding:14px 18px;background:#F8FAFC;border:1px solid #E2E8F0;border-radius:10px;">
        <div style="display:flex;justify-content:flex-end;gap:40px;flex-wrap:wrap;">
            <div style="text-align:right;">
                <div style="font-size:10px;color:#64748B;text-transform:uppercase;font-weight:700;">Total Return Amount</div>
                <div id="pr-grandtotal" style="font-size:20px;font-weight:900;color:#F5A623;">Rs 0.00</div>
            </div>
        </div>
    </div>

    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold"><i class="bi bi-check-lg"></i> Register Return</button>
    </div>
</form>

<script>
(function(){
    var form = document.getElementById('addForm'); if(!form) return;
    var idx = 1;

    function fmt(n){ return "Rs " + (Number(n)||0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ","); }

    function calc(){
        var sub = 0;
        form.querySelectorAll('.item-row').forEach(function(row){
            var q = parseFloat(row.querySelector('.qty-input')?.value||0)||0;
            var p = parseFloat(row.querySelector('.price-input')?.value||0)||0;
            var line = q * p;
            sub += line;
            var lt = row.querySelector('.line-total');
            if(lt) lt.value = fmt(line);
        });
        document.getElementById('pr-grandtotal').textContent = fmt(sub);
    }
    form.addEventListener('input', function(e){
        if(e.target.classList.contains('qty-input') || e.target.classList.contains('price-input'))
            calc();
    });

    var poSel = document.getElementById('poSelect');
    if(poSel) poSel.addEventListener('change', function(){
        var pid = this.value; if(!pid) return;

        // Load items
        fetch('/PurchaseReturn/GetPurchaseItems?purchaseId='+pid).then(r=>r.json()).then(function(items){
            form.querySelectorAll('.product-select').forEach(function(sel){
                sel.innerHTML = '<option value="">-- Select Product --</option>';
                (items||[]).forEach(function(it){
                    var o = document.createElement('option');
                    o.value = it.productId;
                    o.dataset.detailId = it.detailId;
                    o.dataset.price = it.unitPrice;
                    o.textContent = (it.productName||'Product') + (it.quantity ? ' (Qty: '+it.quantity+')' : '');
                    sel.appendChild(o);
                });
            });
        });

        // Load GRNs
        fetch('/PurchaseReturn/GetGRNs?purchaseId='+pid).then(r=>r.json()).then(function(grns){
            var s = document.getElementById('grnSelect');
            s.innerHTML = '<option value="">-- Select GRN --</option>';
            (grns||[]).forEach(function(g){
                var o = document.createElement('option');
                o.value = g.grnId;
                o.textContent = g.grnNo;
                s.appendChild(o);
            });
        });
    });

    // Auto-fill price when product selected
    form.addEventListener('change', function(e){
        if(e.target.classList.contains('product-select')){
            var row = e.target.closest('.item-row');
            var opt = e.target.options[e.target.selectedIndex];
            var price = row.querySelector('.price-input');
            var did = row.querySelector('.pdetail-id');
            if(opt && price) price.value = opt.dataset.price || 0;
            if(opt && did) did.value = opt.dataset.detailId || 0;
            calc();
        }
    });

    document.getElementById('addItemBtn').addEventListener('click', function(){
        var cont = document.getElementById('itemsContainer');
        var clone = cont.querySelector('.item-row').cloneNode(true);
        clone.querySelectorAll('[name]').forEach(function(el){
            var nm = el.getAttribute('name');
            el.setAttribute('name', nm.replace(/ReturnDetails\[\d+\]/, 'ReturnDetails['+idx+']'));
        });
        clone.querySelectorAll('input[type=number]').forEach(function(i){ i.value = i.classList.contains('qty-input') ? 1 : 0; });
        clone.querySelectorAll('input[type=text], input[type=date]').forEach(function(i){ i.value=''; });
        clone.querySelectorAll('input[type=hidden]').forEach(function(i){ i.value = 0; });
        clone.querySelectorAll('select').forEach(function(s){ s.value=''; });
        var lt = clone.querySelector('.line-total'); if(lt) lt.value = 'Rs 0.00';
        cont.appendChild(clone); idx++;
    });

    form.addEventListener('click', function(e){
        if(e.target.closest('.remove-item')){
            var rows = form.querySelectorAll('.item-row');
            if(rows.length > 1){ e.target.closest('.item-row').remove(); calc(); }
            else alert('At least one item required.');
        }
    });

    setTimeout(calc, 300);

    // ═══ AUTO-LOAD BATCH FROM GRN ═══
    var grnSel = document.getElementById('grnSelect');
    if(grnSel) grnSel.addEventListener('change', function(){
        var gid = this.value;
        var cont = document.getElementById('itemsContainer');
        
        if(!gid){
            // GRN clear → clear items
            return;
        }
        
        fetch('/PurchaseReturn/GetGRNDetails?grnId=' + gid)
            .then(r => r.json())
            .then(function(items){
                if(!Array.isArray(items) || items.length === 0) return;
                
                // Clear container and rebuild
                cont.innerHTML = '';
                idx = 0;
                
                items.forEach(function(it){
                    var row = document.createElement('div');
                    row.className = 'item-row';
                    row.innerHTML = `
                        <div class="row g-2">
                            <div class="col-md-5">
                                <label class="form-label">Product *</label>
                                <select name="ReturnDetails[${idx}].ProductId" class="form-select product-select" required>
                                    <option value="${it.productId}" selected>${it.productName} (Accepted: ${it.acceptedQty})</option>
                                </select>
                                <input type="hidden" name="ReturnDetails[${idx}].PurchaseDetailId" class="pdetail-id" value="${it.grnDetailId}" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Quantity *</label>
                                <input type="number" name="ReturnDetails[${idx}].Quantity" class="form-control qty-input" min="1" max="${it.acceptedQty}" value="${it.acceptedQty}" required />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Unit Price *</label>
                                <input type="number" step="0.01" name="ReturnDetails[${idx}].UnitPrice" class="form-control price-input" min="0" value="0" required />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">Total</label>
                                <input type="text" class="form-control line-total" readonly value="Rs 0.00" style="background:#f8fafc;font-weight:700;" />
                            </div>
                            <div class="col-md-1 d-flex align-items-end">
                                <button type="button" class="btn btn-sm btn-danger remove-item w-100" style="font-size:11px;"><i class="bi bi-x"></i></button>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Batch No</label>
                                <input type="text" name="ReturnDetails[${idx}].BatchNo" class="form-control" value="${it.batchNo || ''}" readonly style="background:#f0f9ff;font-weight:700;color:#0369a1;" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Expiry Date</label>
                                <input type="date" name="ReturnDetails[${idx}].ExpiryDate" class="form-control" value="${it.expiryDate ? it.expiryDate.substring(0,10) : ''}" />
                            </div>
                        </div>
                    `;
                    cont.appendChild(row);
                    idx++;
                });
                
                calc();
                
                // Update unit price from PO items
                if(poSel && poSel.value){
                    fetch('/PurchaseReturn/GetPurchaseItems?purchaseId=' + poSel.value)
                        .then(r => r.json())
                        .then(function(poItems){
                            var map = {};
                            (poItems||[]).forEach(function(p){ map[p.productId] = p.unitPrice; });
                            cont.querySelectorAll('.item-row').forEach(function(row){
                                var sel = row.querySelector('.product-select');
                                var price = row.querySelector('.price-input');
                                if(sel && price){
                                    var pid = parseInt(sel.value);
                                    if(map[pid]) price.value = map[pid];
                                }
                            });
                            calc();
                        });
                }
            })
            .catch(function(e){ console.error('GRN details:', e); });
    });
})();
</script>

