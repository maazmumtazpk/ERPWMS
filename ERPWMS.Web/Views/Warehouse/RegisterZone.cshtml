@model ERPWMS.Web.ViewModels.Warehouse.RegisterZoneViewModel

@{
    ViewData["Title"] = "Register Zone";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>
                <i class="fas fa-layer-group me-2"></i>
                Register Zone
            </h2>

            <p class="text-muted">
                Add a new zone to the warehouse.
            </p>
        </div>

        <a asp-action="Zones"
               asp-route-WarehouseId="@Model.WarehouseId"
               class="btn btn-secondary">

            <i class="fas fa-arrow-left me-1"></i>
            Back

        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="RegisterZone"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="WarehouseId"
                       type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="ZoneName"
                               class="form-label">
                            Zone Name
                        </label>

                        <input asp-for="ZoneName"
                               class="form-control"
                               placeholder="Enter zone name" />

                        <span asp-validation-for="ZoneName"
                              class="text-danger"></span>

                    </div>

                    <div class="col-md-6">

                        <label asp-for="ZoneCode"
                               class="form-label">
                            Zone Code
                        </label>

                        <input asp-for="ZoneCode"
                               class="form-control"
                               placeholder="Enter zone code" />

                        <span asp-validation-for="ZoneCode"
                              class="text-danger"></span>

                    </div>

                </div>

                <div class="mt-4 d-flex justify-content-end gap-2">

                    <a asp-action="Zones"
                           asp-route-WarehouseId="@Model.WarehouseId"
                           class="btn btn-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fas fa-save me-1"></i>
                        Register Zone

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}