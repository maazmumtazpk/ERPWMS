
@model ERPWMS.Web.ViewModels.Warehouse.RegisterBinViewModel

@{
    ViewData["Title"] = "Register Bin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                <i class="fas fa-box me-2"></i>
                Register Bin
            </h2>

            <p class="text-muted mb-0">
                Add a new bin to the warehouse rack.
            </p>
        </div>

        <div>
            <a asp-action="Bins"
                   asp-route-WarehouseId="@Model.WarehouseId"
                   asp-route-ZoneId="@Model.ZoneId"
                   asp-route-RackId="@Model.RackId"
                   class="btn btn-secondary">

                <i class="fas fa-arrow-left me-1"></i>
                Back to Bins

            </a>
        </div>

    </div>


    <!-- FORM CARD -->
    <div class="card shadow-sm">

        <div class="card-header">

            <h5 class="mb-0">
                <i class="fas fa-plus-circle me-2"></i>
                Bin Information
            </h5>

        </div>


        <div class="card-body">

            <form asp-controller="Warehouse"
                  asp-action="RegisterBin"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- VALIDATION -->
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert">
                </div>


                <div class="row g-3">


                    <!-- WAREHOUSE -->
                    <div class="col-md-4">

                        <label asp-for="WarehouseId"
                               class="form-label">

                            Warehouse
                            <span class="text-danger">*</span>

                        </label>

                        <input asp-for="WarehouseId"
                               type="number"
                               id="WarehouseId"
                               class="form-control"
                               readonly />

                        <span asp-validation-for="WarehouseId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ZONE DROPDOWN -->
                    <div class="col-md-4">

                        <label asp-for="ZoneId"
                               class="form-label">

                            Zone
                            <span class="text-danger">*</span>

                        </label>

                        <select asp-for="ZoneId"
                                id="ZoneId"
                                class="form-select">

                            <option value="">
                                -- Select Zone --
                            </option>

                            @if (Model.Zones != null)
                            {
                                foreach (var zone in Model.Zones)
                                {
                                    <option value="@zone.ZoneId">
                                        @zone.ZoneName
                                    </option>
                                }
                            }

                        </select>

                        <span asp-validation-for="ZoneId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- RACK AUTOMATICALLY FILLED -->
                    <div class="col-md-4">

                        <label class="form-label">

                            Rack
                            <span class="text-danger">*</span>

                        </label>

                        <!-- Rack Name shown to user -->
                        <input type="text"
                               id="RackName"
                               class="form-control"
                               placeholder="Select a zone first"
                               readonly />

                        <!-- Actual RackId submitted to controller -->
                        <input asp-for="RackId"
                               type="hidden"
                               id="RackId" />

                        <span asp-validation-for="RackId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- BIN NAME -->
                    <div class="col-md-6">

                        <label asp-for="BinName"
                               class="form-label">

                            Bin Name
                            <span class="text-danger">*</span>

                        </label>

                        <input asp-for="BinName"
                               class="form-control"
                               placeholder="Enter bin name"
                               autocomplete="off" />

                        <span asp-validation-for="BinName"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- BIN CODE -->
                    <div class="col-md-6">

                        <label asp-for="BinCode"
                               class="form-label">

                            Bin Code
                            <span class="text-danger">*</span>

                        </label>

                        <input asp-for="BinCode"
                               class="form-control"
                               placeholder="Enter bin code"
                               autocomplete="off" />

                        <span asp-validation-for="BinCode"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- BUTTONS -->
                <div class="mt-4 d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="fas fa-save me-1"></i>
                        Save Bin

                    </button>


                    <a asp-action="Bins"
                           asp-route-WarehouseId="@Model.WarehouseId"
                           asp-route-ZoneId="@Model.ZoneId"
                           asp-route-RackId="@Model.RackId"
                           class="btn btn-secondary">

                        <i class="fas fa-times me-1"></i>
                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        $(document).ready(function () {

            $("#ZoneId").on("change", function () {

                var zoneId = $(this).val();
                var warehouseId = $("#WarehouseId").val();

                // Clear previous rack
                $("#RackId").val("");
                $("#RackName").val("");

                if (!zoneId) {

                    $("#RackName").attr(
                        "placeholder",
                        "Select a zone first"
                    );

                    return;
                }

                $("#RackName").attr(
                    "placeholder",
                    "Loading rack..."
                );

                $.ajax({

                    url: '@Url.Action("GetRacksByZone", "Warehouse")',

                    type: "GET",

                    data: {
                        warehouseId: warehouseId,
                        zoneId: zoneId
                    },

                    success: function (response) {

                        if (response.success &&
                            response.racks &&
                            response.racks.length > 0) {

                            // First rack automatically selected
                            var rack = response.racks[0];

                            $("#RackId").val(rack.rackId);

                            $("#RackName").val(rack.rackName);

                        }
                        else {

                            $("#RackId").val("");

                            $("#RackName").val(
                                "No rack available"
                            );

                        }

                    },

                    error: function () {

                        $("#RackId").val("");

                        $("#RackName").val(
                            "Unable to load rack"
                        );

                    }

                });

            });


            // Automatically load rack
            // when page opens with an existing ZoneId
            var existingZoneId = $("#ZoneId").val();

            if (existingZoneId) {

                $("#ZoneId").trigger("change");

            }

        });

    </script>

}

