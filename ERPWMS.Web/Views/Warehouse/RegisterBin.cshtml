@{
    ViewData["Title"] = "Bin Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<form id="__af" style="display:none;">@Html.AntiForgeryToken()</form>
<div class="toast-holder" id="toastHolder"></div>

<style>
    .kpi-card{background:#fff;border:1px solid #edf0f4;border-radius:10px;padding:12px 14px;box-shadow:0 2px 8px rgba(0,0,0,.04);height:100%;min-height:80px;position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:center}
    .kpi-card::before{content:"";position:absolute;top:0;left:0;right:0;height:2.5px}
    .kpi-card.total::before{background:#0A1628}.kpi-card.active::before{background:#159A89}
    .kpi-content{display:flex;justify-content:space-between;align-items:center;width:100%;gap:8px}
    .kpi-text-group{display:flex;flex-direction:column;flex:1}
    .kpi-label{margin:0 0 3px 0;color:#64748B;font-size:9px;font-weight:700;text-transform:uppercase}
    .kpi-number{margin:0;color:#0A1628;font-size:20px;font-weight:750;line-height:1.2}
    .kpi-icon{width:30px;height:30px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:13px}
    .kpi-icon.blue{background:#0A1628;color:#fff}.kpi-icon.green{background:#D7F4EE;color:#159A89}
    .table-card{background:#fff;border:1px solid #edf0f4;border-radius:10px;box-shadow:0 2px 8px rgba(0,0,0,.04);overflow:visible;margin-top:16px}
    .card-header-custom{padding:10px 14px;border-bottom:2px solid #F1F5F9;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
    .card-header-custom h5{margin:0;font-size:12px;font-weight:700;color:#0A1628;display:flex;align-items:center;gap:6px}
    .badge-count{background:#F1F5F9;color:#64748B;font-size:9px;font-weight:700;padding:1px 8px;border-radius:12px}
    .card-body{padding:0;overflow-x:auto}
    table.table-premium{margin:0;font-size:11px;width:100%;border-collapse:collapse}
    table.table-premium thead{background:#F8FAFC;border-bottom:2px solid #E2E8F0}
    table.table-premium thead th{padding:8px 14px;font-weight:700;font-size:9px;text-transform:uppercase;color:#64748B;border:none;text-align:left}
    table.table-premium tbody td{padding:8px 14px;vertical-align:middle;border-bottom:1px solid #F1F5F9;color:#0A1628;font-size:11px}
    .row-name{font-weight:600;display:flex;align-items:center;gap:8px}
    .row-name .avatar{width:28px;height:28px;border-radius:6px;background:#DBEAFE;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:10px;color:#1D4ED8}
    .badge-status{padding:2px 8px;border-radius:12px;font-size:8px;font-weight:700;text-transform:uppercase}
    .badge-status.active{background:#DDF7F1;color:#118B7B}.badge-status.inactive{background:#F1F5F9;color:#64748B}
    .btn-icon{width:26px;height:26px;border-radius:6px;border:1px solid #E8ECF1;display:inline-flex;align-items:center;justify-content:center;font-size:12px;color:#64748B;background:#fff;cursor:pointer}
    .btn-icon:hover{background:#F1F5F9}.btn-icon.gold{background:#F5A623;color:#fff;border-color:#F5A623}
    .act-wrap{position:relative;display:inline-block}
    .act-menu{position:fixed;background:#fff;border:1px solid #E8ECF1;border-radius:8px;box-shadow:0 8px 24px rgba(15,23,42,.14);min-width:180px;padding:5px;z-index:99999;display:none;text-align:left}
    .act-menu.show{display:block}
    .act-menu button{display:flex;align-items:center;gap:10px;width:100%;padding:8px 11px;border:none;background:transparent;font-size:11.5px;color:#334155;border-radius:6px;cursor:pointer;text-align:left;font-weight:500}
    .act-menu button:hover{background:#F8FAFC}.act-menu button i{width:14px;color:#64748B}
    .act-menu .sep{height:1px;background:#F1F5F9;margin:3px 5px}.act-menu .danger{color:#DC2626}.act-menu .danger i{color:#DC2626}
    .toast-holder{position:fixed;top:20px;right:20px;z-index:99999;display:flex;flex-direction:column;gap:8px}
    .toast-item{background:#fff;border-left:4px solid #10b981;border-radius:8px;box-shadow:0 8px 24px rgba(15,23,42,.15);padding:12px 16px;min-width:280px;display:flex;align-items:center;gap:10px;font-size:12px}
    .toast-item.error{border-left-color:#ef4444}.toast-item i{color:#10b981}.toast-item.error i{color:#ef4444}
    .pm-modal .modal-header{background:#0A1628;color:#fff;padding:14px 20px;border:0}
    .pm-modal .modal-header h5{font-size:14px;font-weight:700;margin:0;color:#fff}
    .pm-modal .form-label{font-size:11px;font-weight:600;color:#475569;margin-bottom:3px;display:block}
    .pm-modal .form-control,.pm-modal .form-select{font-size:12px;padding:7px 11px;min-height:34px;border-radius:6px;border:1px solid #dde4ec;width:100%}
</style>

<div style="padding-bottom:30px;">
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <label class="form-label fw-bold" style="font-size:11px;">Select Rack to View Bins</label>
            <select id="rackSelect" class="form-select" onchange="reloadBins()">
                <option value="">-- All Racks (List all Bins) --</option>
            </select>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-xl-3 col-lg-3 col-md-6">
            <div class="kpi-card total"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Total Bins</p><h2 class="kpi-number" id="kpiTotal">0</h2></div><div class="kpi-icon blue"><i class="bi bi-box"></i></div></div></div>
        </div>
        <div class="col-xl-3 col-lg-3 col-md-6">
            <div class="kpi-card active"><div class="kpi-content"><div class="kpi-text-group"><p class="kpi-label">Active Bins</p><h2 class="kpi-number" id="kpiActive">0</h2></div><div class="kpi-icon green"><i class="bi bi-check-circle"></i></div></div></div>
        </div>
    </div>

    <div class="table-card">
        <div class="card-header-custom">
            <h5><i class="bi bi-clock-history" style="color:#F5A623;"></i> All Bins <span class="badge-count" id="xCount">0</span></h5>
            <div style="display:flex;gap:4px;align-items:center;">
                <button type="button" class="btn-icon gold" onclick="openAdd()"><i class="bi bi-plus-circle"></i></button>
                <button type="button" class="btn-icon" onclick="reloadBins()"><i class="bi bi-arrow-clockwise"></i></button>
            </div>
        </div>
        <div class="card-body">
            <table class="table-premium" id="xTable">
                <thead><tr><th>Bin Name</th><th>Code</th><th>Rack</th><th>Zone</th><th>Status</th><th style="text-align:right;">Actions</th></tr></thead>
                <tbody id="xBody"><tr><td colspan="6" class="text-center py-3 text-muted">Loading...</td></tr></tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade pm-modal" id="addModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h5><i class="bi bi-box"></i> Register New Bin</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <form id="addBinForm" action="/Bin/Register" method="post">
                <input type="hidden" name="__RequestVerificationToken" value="" id="addToken" />
                <div class="mb-3"><label class="form-label">Rack *</label><select name="rackId" id="addRackId" class="form-select" required></select></div>
                <div class="mb-3"><label class="form-label">Bin Name *</label><input type="text" name="binName" class="form-control" required placeholder="e.g., Bin A1" /></div>
                <div class="mb-3"><label class="form-label">Bin Code</label><input type="text" name="binCode" class="form-control" placeholder="e.g., BN-001" /></div>
                <div class="text-end"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-warning btn-sm fw-bold">Save Bin</button></div>
            </form>
        </div>
    </div></div>
</div>

<div class="modal fade pm-modal" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h5><i class="bi bi-pencil-square"></i> Edit Bin</h5><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <form id="editBinForm" action="/Bin/Edit" method="post">
                <input type="hidden" name="__RequestVerificationToken" value="" id="editToken" />
                <input type="hidden" name="binId" id="editBinId" />
                <div class="mb-3"><label class="form-label">Rack *</label><select name="rackId" id="editRackId" class="form-select" required></select></div>
                <div class="mb-3"><label class="form-label">Bin Name *</label><input type="text" name="binName" id="editBinName" class="form-control" required /></div>
                <div class="mb-3"><label class="form-label">Bin Code</label><input type="text" name="binCode" id="editBinCode" class="form-control" /></div>
                <div class="text-end"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-warning btn-sm fw-bold">Update Bin</button></div>
            </form>
        </div>
    </div></div>
</div>

@section Scripts {
<script>
    var allBins = []; var racks = [];
    function tk(){var e=document.querySelector("input[name=__RequestVerificationToken]");return e?e.value:"";}
    document.getElementById('addToken').value = tk(); document.getElementById('editToken').value = tk();
    function showToast(m,t){var h=document.getElementById("toastHolder");var d=document.createElement("div");d.className="toast-item "+(t||"success");d.innerHTML='<i class="bi '+(t==="error"?"bi-x-circle-fill":"bi-check-circle-fill")+'"></i><span class="msg">'+m+'</span>';h.appendChild(d);setTimeout(function(){d.style.opacity="0";setTimeout(function(){d.remove();},400);},3500);}
    function toggleMenu(id,e){e.stopPropagation();document.querySelectorAll(".act-menu").forEach(function(m){if(m.id!=="menu-"+id)m.classList.remove("show");});var el=document.getElementById("menu-"+id);if(!el)return;if(el.classList.contains("show")){el.classList.remove("show");return;}var b=e.currentTarget||e.target;var r=b.getBoundingClientRect();el.style.top=(r.bottom+4)+"px";el.style.right=(window.innerWidth-r.right)+"px";el.style.left="auto";el.classList.add("show");}
    document.addEventListener("click",function(){document.querySelectorAll(".act-menu").forEach(function(m){m.classList.remove("show");});});
    function reloadBins() {
        var rackId = document.getElementById("rackSelect").value;
        var tbody = document.getElementById("xBody");
        tbody.innerHTML = "<tr><td colspan='6' class='text-center py-3 text-muted'>Loading...</td></tr>";
        fetch("/Bin/GetAll").then(r => r.json()).then(data => {
            allBins = data; var filtered = rackId ? data.filter(b => b.rackId == rackId) : data;
            if(filtered.length === 0) { tbody.innerHTML = "<tr><td colspan='6' class='text-center py-3 text-muted'>No bins found</td></tr>"; document.getElementById("kpiTotal").textContent="0"; document.getElementById("kpiActive").textContent="0"; document.getElementById("xCount").textContent="0"; return; }
            var html = "";
            filtered.forEach(b => {
                var st = b.isActive ? "active" : "inactive"; var ini = (b.binName || "BN").substring(0, 2).toUpperCase();
                html += "<tr><td><div class='row-name'><span class='avatar'>"+ini+"</span><div><div>"+b.binName+"</div><div style='font-size:9px;color:#94A3B8;'>ID: #"+b.binId+"</div></div></div></td>";
                html += "<td><span style='font-family:monospace;font-size:10px;color:#64748B;'>"+(b.binCode||"-")+"</span></td>";
                html += "<td><span style='font-size:11px;color:#334155;'>"+(b.rackName||"-")+"</span></td>";
                html += "<td><span style='font-size:11px;color:#334155;'>"+(b.zoneName||"-")+"</span></td>";
                html += "<td><span class='badge-status "+st+"'>"+(b.isActive?"Active":"Inactive")+"</span></td>";
                html += "<td style='text-align:right;'><div class='act-wrap'><button class='btn-icon' onclick='toggleMenu("+b.binId+",event)'><i class='bi bi-three-dots-vertical'></i></button><div class='act-menu' id='menu-"+b.binId+"'><button onclick='openEdit("+b.binId+")'><i class='bi bi-pencil'></i> Edit</button><button onclick='toggleActive("+b.binId+")'><i class='bi bi-power'></i> "+(b.isActive?"Deactivate":"Activate")+"</button><div class='sep'></div><button class='danger' onclick='delRow("+b.binId+")'><i class='bi bi-trash3'></i> Delete</button></div></div></td></tr>";
            });
            tbody.innerHTML = html;
            document.getElementById("kpiTotal").textContent = filtered.length;
            document.getElementById("kpiActive").textContent = filtered.filter(b => b.isActive).length;
            document.getElementById("xCount").textContent = filtered.length;
        });
    }
    function openAdd() { var sel=document.getElementById("addRackId");sel.innerHTML='<option value="">-- Select Rack --</option>';racks.forEach(r=>{sel.innerHTML+="<option value='"+r.rackId+"'>"+r.rackName+"</option>";});new bootstrap.Modal(document.getElementById('addModal')).show(); }
    function openEdit(id) { var bin=allBins.find(b=>b.binId==id);if(!bin)return;document.getElementById('editBinId').value=bin.binId;document.getElementById('editBinName').value=bin.binName;document.getElementById('editBinCode').value=bin.binCode||'';var sel=document.getElementById("editRackId");sel.innerHTML='';racks.forEach(r=>{var s=(r.rackId==bin.rackId)?'selected':'';sel.innerHTML+="<option value='"+r.rackId+"' "+s+">"+r.rackName+"</option>";});new bootstrap.Modal(document.getElementById('editModal')).show(); }
    function delRow(id) { if(!confirm("Delete this bin?"))return;var fd=new FormData();fd.append("__RequestVerificationToken",tk());fetch("/Bin/Delete/"+id,{method:"POST",body:fd}).then(r=>r.json()).then(res=>{if(res.success){showToast(res.message,"success");reloadBins();}else{showToast(res.message,"error");}}); }
    function toggleActive(id) { var fd=new FormData();fd.append("__RequestVerificationToken",tk());fetch("/Bin/ToggleActive/"+id,{method:"POST",body:fd}).then(r=>r.json()).then(res=>{if(res.success){showToast(res.message,"success");reloadBins();}else{showToast(res.message,"error");}}); }
    document.addEventListener("submit", function(e) { var f=e.target;if(!f||(f.id!=="addBinForm"&&f.id!=="editBinForm"))return;e.preventDefault();fetch(f.action,{method:"POST",body:new FormData(f)}).then(r=>r.json()).then(res=>{if(res.success){var m=bootstrap.Modal.getInstance(f.closest(".modal"));if(m)m.hide();showToast(res.message,"success");f.reset();reloadBins();}else{showToast(res.message,"error");}}); });
    document.addEventListener("DOMContentLoaded", function() { fetch("/Bin/GetRacksDropdown").then(r=>r.json()).then(data=>{racks=data;var sel=document.getElementById("rackSelect");data.forEach(r=>{sel.innerHTML+="<option value='"+r.rackId+"'>"+r.rackName+"</option>";});});reloadBins(); });
</script>
}
