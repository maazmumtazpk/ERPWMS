@*
    Sidebar Menu - Auto-generated
    Include in _Layout.cshtml: @await Html.PartialAsync("_SidebarMenu")
*@

<style>
.sb-menu{list-style:none;padding:0;margin:0;}
.sb-menu li{padding:0;margin:1px 0;}
.sb-menu a{display:flex;align-items:center;gap:10px;padding:9px 14px;color:#94A3B8;text-decoration:none;font-size:12.5px;font-weight:600;border-radius:8px;transition:all .15s;position:relative;}
.sb-menu a:hover{background:rgba(245,166,35,.08);color:#F5A623;}
.sb-menu a.active{background:rgba(245,166,35,.15);color:#F5A623;box-shadow:inset 3px 0 0 #F5A623;}
.sb-menu a i{width:18px;text-align:center;font-size:14px;flex-shrink:0;}
.sb-menu a .sb-badge{margin-left:auto;background:#F5A623;color:#0A1628;font-size:9px;font-weight:800;padding:1px 6px;border-radius:10px;}
.sb-section{padding:16px 14px 6px;color:#4B5563;font-size:9.5px;font-weight:800;text-transform:uppercase;letter-spacing:.8px;}
.sb-section:first-child{padding-top:8px;}
</style>

@{
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    Func<string, string, string> ActiveClass = (ctrl, act) =>
        (string.Equals(currentCtrl, ctrl, System.StringComparison.OrdinalIgnoreCase) &&
         string.Equals(currentAct, act, System.StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    Func<string, string> ActiveCtrlOnly = (ctrl) =>
        string.Equals(currentCtrl, ctrl, System.StringComparison.OrdinalIgnoreCase) ? "active" : "";
}

