@{
    ViewData["Title"] = "Leave Types";
    Layout = "_Layout";
}
<form id="__af" style="display:none;">@Html.AntiForgeryToken()</form>
<div class="toast-holder" id="toastHolder"></div>
@await Html.PartialAsync("_AdminCss")
<div style="padding-bottom:30px;">
<div class="table-card">
    <div class="card-header-custom">
        <h5><i class="bi bi-calendar-check" style="color:#F5A623;"></i> Leave Types</h5>
        <button type="button" class="btn-icon gold" onclick="openAdd()"><i class="bi bi-plus-circle"></i></button>
    </div>
    <div class="card-body">
        <table class="table-premium" id="xTable">
            <thead><tr><th>Code</th><th>Name</th><th>Category</th><th>Entitlement</th><th>Paid</th><th>Status</th><th style="text-align:right;">Actions</th></tr></thead>
            <tbody id="xBody"></tbody>
        </table>
    </div>
</div>
</div>
<div class="modal fade pm-modal" id="formModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 id="mTitle">Leave Type</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">
<input type="hidden" id="leaveTypeId" value="0" />
<div class="row g-3">
<div class="col-md-6"><label class="form-label">Code *</label><input type="text" id="leaveCode" class="form-control" maxlength="20" /></div>
<div class="col-md-6"><label class="form-label">Name *</label><input type="text" id="leaveName" class="form-control" maxlength="100" /></div>
<div class="col-md-6"><label class="form-label">Category</label><select id="category" class="form-control"><option>Annual</option><option>Sick</option><option>Casual</option><option>Maternity</option><option>Unpaid</option><option>Emergency</option></select></div>
<div class="col-md-6"><label class="form-label">Entitlement (days)</label><input type="number" id="annualEntitlement" class="form-control" value="0" min="0" /></div>
<div class="col-md-6"><label class="form-label">Max Consecutive Days</label><input type="number" id="maxConsecutiveDays" class="form-control" value="30" /></div>
<div class="col-md-6"><label class="form-label">Notice Days</label><input type="number" id="noticeDays" class="form-control" value="0" /></div>
<div class="col-md-3"><div class="form-check form-switch" style="padding-top:22px;"><input class="form-check-input" type="checkbox" id="isPaid" checked /><label class="form-check-label" for="isPaid">Paid</label></div></div>
<div class="col-md-3"><div class="form-check form-switch" style="padding-top:22px;"><input class="form-check-input" type="checkbox" id="allowCarryForward" /><label class="form-check-label" for="allowCarryForward">Carry Fwd</label></div></div>
<div class="col-md-3"><div class="form-check form-switch" style="padding-top:22px;"><input class="form-check-input" type="checkbox" id="approvalRequired" checked /><label class="form-check-label" for="approvalRequired">Approval</label></div></div>
<div class="col-md-3"><div class="form-check form-switch" style="padding-top:22px;"><input class="form-check-input" type="checkbox" id="isActive" checked /><label class="form-check-label" for="isActive">Active</label></div></div>
<div class="col-12"><label class="form-label">Description</label><textarea id="description" class="form-control" rows="2"></textarea></div>
</div>
</div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn-gold" onclick="save_()">Save</button></div></div></div></div>
@await Html.PartialAsync("_AdminJs")
<script>
function tk(){var i=document.querySelector('#__af input[name="__RequestVerificationToken"]');return i?i.value:'';}
function openAdd(){
    document.getElementById('mTitle').textContent='Add Leave Type';
    document.getElementById('leaveTypeId').value=0;
    ['leaveCode','leaveName','description'].forEach(function(id){document.getElementById(id).value='';});
    document.getElementById('category').value='Annual';
    document.getElementById('annualEntitlement').value=0;
    document.getElementById('maxConsecutiveDays').value=30;
    document.getElementById('noticeDays').value=0;
    document.getElementById('isPaid').checked=true;
    document.getElementById('allowCarryForward').checked=false;
    document.getElementById('approvalRequired').checked=true;
    document.getElementById('isActive').checked=true;
    new bootstrap.Modal(document.getElementById('formModal')).show();
}
function edit_(id){
    fetch('/LeaveType/GetById?id='+id).then(function(r){return r.json();}).then(function(d){
        document.getElementById('mTitle').textContent='Edit Leave Type';
        document.getElementById('leaveTypeId').value=d.leaveTypeId;
        document.getElementById('leaveCode').value=d.leaveCode;
        document.getElementById('leaveName').value=d.leaveName;
        document.getElementById('category').value=d.category;
        document.getElementById('annualEntitlement').value=d.annualEntitlement;
        document.getElementById('maxConsecutiveDays').value=d.maxConsecutiveDays;
        document.getElementById('noticeDays').value=d.noticeDays;
        document.getElementById('isPaid').checked=d.isPaid;
        document.getElementById('allowCarryForward').checked=d.allowCarryForward;
        document.getElementById('approvalRequired').checked=d.approvalRequired;
        document.getElementById('isActive').checked=d.isActive;
        document.getElementById('description').value=d.description||'';
        new bootstrap.Modal(document.getElementById('formModal')).show();
    });
}
function save_(){
    var fd=new FormData();
    fd.append('__RequestVerificationToken',tk());
    fd.append('leaveTypeId',document.getElementById('leaveTypeId').value);
    fd.append('leaveCode',document.getElementById('leaveCode').value);
    fd.append('leaveName',document.getElementById('leaveName').value);
    fd.append('category',document.getElementById('category').value);
    fd.append('annualEntitlement',document.getElementById('annualEntitlement').value);
    fd.append('maxConsecutiveDays',document.getElementById('maxConsecutiveDays').value);
    fd.append('noticeDays',document.getElementById('noticeDays').value);
    fd.append('isPaid',document.getElementById('isPaid').checked);
    fd.append('allowCarryForward',document.getElementById('allowCarryForward').checked);
    fd.append('maxCarryForwardDays',0);
    fd.append('approvalRequired',document.getElementById('approvalRequired').checked);
    fd.append('documentRequired',false);
    fd.append('isActive',document.getElementById('isActive').checked);
    fd.append('description',document.getElementById('description').value);
    fetch('/LeaveType/Save',{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){
        if(res.success){showToast(res.message,'success'); bootstrap.Modal.getInstance(document.getElementById('formModal')).hide(); reload_();}
        else showToast(res.message,'error');
    });
}
function del_(id){
    if(!confirm('Delete?')) return;
    var fd=new FormData(); fd.append('__RequestVerificationToken',tk());
    fetch('/LeaveType/Delete/'+id,{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){if(res.success){showToast(res.message,'success'); reload_();}});
}
function reload_(){
    fetch('/LeaveType/GetAll').then(function(r){return r.json();}).then(function(d){
        var b=document.getElementById('xBody');
        if(!d||d.length===0){b.innerHTML='<tr><td colspan="7" class="text-center">No leave types</td></tr>'; return;}
        var h='';
        d.forEach(function(x){
            h+='<tr><td>'+x.leaveCode+'</td><td>'+x.leaveName+'</td><td>'+x.category+'</td><td>'+x.annualEntitlement+'</td><td>'+(x.isPaid?'Yes':'No')+'</td><td>'+(x.isActive?'<span class="badge-status active">Active</span>':'<span class="badge-status inactive">Inactive</span>')+'</td>';
            h+='<td style="text-align:right;"><button class="btn-icon" onclick="edit_('+x.leaveTypeId+')"><i class="bi bi-pencil"></i></button> <button class="btn-icon" onclick="del_('+x.leaveTypeId+')"><i class="bi bi-trash3"></i></button></td></tr>';
        });
        b.innerHTML=h;
    });
}
document.addEventListener('DOMContentLoaded', reload_);
</script>
