@{
    ViewData["Title"] = "Missing Punch";
    Layout = "_Layout";
}
<form id="__af" style="display:none;">@Html.AntiForgeryToken()</form>
<div class="toast-holder" id="toastHolder"></div>
@await Html.PartialAsync("_AdminCss")
<div style="padding-bottom:30px;">
<div class="table-card">
    <div class="card-header-custom">
        <h5><i class="bi bi-exclamation-triangle" style="color:#F5A623;"></i> Missing Punch Requests</h5>
        <button type="button" class="btn-icon gold" onclick="openAdd()"><i class="bi bi-plus-circle"></i></button>
    </div>
    <div class="card-body">
        <table class="table-premium" id="xTable">
            <thead><tr><th>Employee</th><th>Date</th><th>Type</th><th>Requested</th><th>Status</th><th style="text-align:right;">Actions</th></tr></thead>
            <tbody id="xBody"></tbody>
        </table>
    </div>
</div>
</div>
<div class="modal fade pm-modal" id="formModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5>Submit Missing Punch</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">
<div class="row g-3">
<div class="col-12"><label class="form-label">Employee</label><select id="employeeId" class="form-control"></select></div>
<div class="col-6"><label class="form-label">Date</label><input type="date" id="attendanceDate" class="form-control" /></div>
<div class="col-6"><label class="form-label">Type</label><select id="punchType" class="form-control"><option value="In">In</option><option value="Out">Out</option><option value="Both">Both</option></select></div>
<div class="col-6"><label class="form-label">In Time</label><input type="time" id="inTime" class="form-control" /></div>
<div class="col-6"><label class="form-label">Out Time</label><input type="time" id="outTime" class="form-control" /></div>
<div class="col-12"><label class="form-label">Reason *</label><textarea id="reason" class="form-control" rows="2"></textarea></div>
</div>
</div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn-gold" onclick="save_()">Submit</button></div></div></div></div>
@await Html.PartialAsync("_AdminJs")
<script>
function tk(){var i=document.querySelector('#__af input[name="__RequestVerificationToken"]');return i?i.value:'';}
function openAdd(){
    fetch('/MissingPunch/GetEmployees').then(function(r){return r.json();}).then(function(d){
        var s=document.getElementById('employeeId'); s.innerHTML='<option value="">-- Select --</option>';
        d.forEach(function(e){var o=document.createElement('option'); o.value=e.employeeId; o.textContent=e.employeeCode+' - '+e.fullName; s.appendChild(o);});
        document.getElementById('attendanceDate').value = new Date().toISOString().split('T')[0];
        new bootstrap.Modal(document.getElementById('formModal')).show();
    });
}
function save_(){
    var fd=new FormData();
    fd.append('__RequestVerificationToken',tk());
    fd.append('employeeId',document.getElementById('employeeId').value);
    fd.append('attendanceDate',document.getElementById('attendanceDate').value);
    fd.append('punchType',document.getElementById('punchType').value);
    fd.append('inTime',document.getElementById('inTime').value);
    fd.append('outTime',document.getElementById('outTime').value);
    fd.append('reason',document.getElementById('reason').value);
    fetch('/MissingPunch/Submit',{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){
        if(res.success){showToast(res.message,'success'); bootstrap.Modal.getInstance(document.getElementById('formModal')).hide(); reload_();}
        else showToast(res.message,'error');
    });
}
function approve(id){var fd=new FormData(); fd.append('__RequestVerificationToken',tk()); fetch('/MissingPunch/Approve/'+id,{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){if(res.success){showToast(res.message,'success'); reload_();}});}
function reject(id){var fd=new FormData(); fd.append('__RequestVerificationToken',tk()); fetch('/MissingPunch/Reject/'+id,{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){if(res.success){showToast(res.message,'success'); reload_();}});}
function reload_(){
    fetch('/MissingPunch/GetAll').then(function(r){return r.json();}).then(function(d){
        var b=document.getElementById('xBody');
        if(!d||d.length===0){b.innerHTML='<tr><td colspan="6" class="text-center">No requests</td></tr>'; return;}
        var h='';
        d.forEach(function(x){
            var cls = x.status==='Approved'?'active':(x.status==='Rejected'?'inactive':'role');
            h+='<tr><td>'+x.employeeName+'<br><small>'+x.employeeCode+'</small></td><td>'+x.attendanceDate+'</td><td>'+x.punchType+'</td><td>'+(x.requestedIn||'-')+' / '+(x.requestedOut||'-')+'</td><td><span class="badge-status '+cls+'">'+x.status+'</span></td>';
            h+='<td style="text-align:right;">';
            if(x.status==='Pending'){h+='<button class="btn-icon" onclick="approve('+x.requestId+')" title="Approve"><i class="bi bi-check-circle"></i></button><button class="btn-icon" onclick="reject('+x.requestId+')" title="Reject"><i class="bi bi-x-circle"></i></button>';}
            h+='</td></tr>';
        });
        b.innerHTML=h;
    });
}
document.addEventListener('DOMContentLoaded', reload_);
</script>
