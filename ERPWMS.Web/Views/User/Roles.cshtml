
@model IEnumerable<ERPWMS.Database.Models.AspNetRole>

@{
    ViewData["Title"] = "Manage User Roles";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var userId = (int)ViewBag.UserId;
    var userName = ViewBag.UserName as string ?? "User";

    var userRoles =
        ViewBag.UserRoles as IEnumerable<string>
        ?? Enumerable.Empty<string>();
}

<div class="container-fluid py-4">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                <i class="bi bi-person-gear"></i>
                Manage User Roles
            </h2>

            <p class="text-muted mb-0">
                Manage roles assigned to
                <strong>@userName</strong>
            </p>
        </div>

        <a asp-action="Index"
               class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Back to Users

        </a>

    </div>


    <!-- =========================================================
         USER INFORMATION
         ========================================================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <div class="row">

                <div class="col-md-6">

                    <div class="text-muted small">
                        USER
                    </div>

                    <div class="fw-semibold fs-5">
                        @userName
                    </div>

                </div>


                <div class="col-md-6">

                    <div class="text-muted small">
                        USER ID
                    </div>

                    <div class="fw-semibold fs-5">
                        @userId
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         ROLES
         ========================================================= -->

    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                <i class="bi bi-shield-check"></i>
                Available Roles
            </h5>

        </div>


        <div class="card-body">

            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info mb-0">

                    <i class="bi bi-info-circle"></i>

                    No roles are available.

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th>
                                    Role Name
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var role in Model)
                            {
                                var isAssigned =
                                    userRoles.Any(
                                        r =>
                                            string.Equals(
                                                r,
                                                role.Name,
                                                StringComparison.OrdinalIgnoreCase));

                                <tr>

                                    <!-- ROLE NAME -->

                                    <td>

                                        <div class="fw-semibold">
                                            @role.Name
                                        </div>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @if (isAssigned)
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle"></i>
                                                Assigned

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">

                                                <i class="bi bi-dash-circle"></i>
                                                Not Assigned

                                            </span>
                                        }

                                    </td>


                                    <!-- ACTION -->

                                    <td class="text-end">

                                        @if (isAssigned)
                                        {
                                            <form asp-action="RemoveRole"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="userId"
                                                       value="@userId" />

                                                <input type="hidden"
                                                       name="roleId"
                                                       value="@role.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">

                                                    <i class="bi bi-x-circle"></i>
                                                    Remove

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="AssignRole"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="userId"
                                                       value="@userId" />

                                                <input type="hidden"
                                                       name="roleId"
                                                       value="@role.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-success">

                                                    <i class="bi bi-plus-circle"></i>
                                                    Assign

                                                </button>

                                            </form>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>

