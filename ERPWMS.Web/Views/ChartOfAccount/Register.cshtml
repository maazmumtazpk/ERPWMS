@model ERPWMS.Application.DTOs.Finance.ChartOfAccount.RegisterChartOfAccountRequest

@{
    ViewData["Title"] = "Add New Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">? Add New Account</h2>
        <div>
            <span class="badge bg-primary fs-6 me-2">
                ?? @ViewBag.CompanyName
            </span>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()

                <!-- ? Hidden CompanyId - Auto from session -->
                <input type="hidden" asp-for="CompanyId" />

                <!-- Company Display (Readonly) -->
                <div class="row mb-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">?? Company</label>
                        <input type="text" class="form-control" value="@ViewBag.CompanyName" disabled readonly />
                        <small class="text-muted">Company is auto-selected from your login.</small>
                    </div>
                </div>

                <hr />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="AccountCode" class="form-label fw-bold"></label>
                        <input asp-for="AccountCode" class="form-control" placeholder="e.g., 4001" />
                        <span asp-validation-for="AccountCode" class="text-danger"></span>
                        <small class="text-muted">Unique account code for this company.</small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AccountName" class="form-label fw-bold"></label>
                        <input asp-for="AccountName" class="form-control" placeholder="e.g., Sales Revenue" />
                        <span asp-validation-for="AccountName" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="AccountType" class="form-label fw-bold"></label>
                        <select asp-for="AccountType" class="form-select">
                            <option value="">-- Select Account Type --</option>
                            <option value="Asset">Asset</option>
                            <option value="Liability">Liability</option>
                            <option value="Equity">Equity</option>
                            <option value="Income">Income</option>
                            <option value="Expense">Expense</option>
                        </select>
                        <span asp-validation-for="AccountType" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ParentAccountId" class="form-label fw-bold">Parent Account</label>
                        <select asp-for="ParentAccountId" class="form-select">
                            <option value="">-- None (Top Level) --</option>
                            <!-- Parent accounts will be loaded via ViewBag -->
                            @if (ViewBag.ParentAccounts != null)
                            {
                                foreach (var parent in ViewBag.ParentAccounts)
                                {
                                    <option value="@parent.AccountId">@parent.AccountCode - @parent.AccountName</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="ParentAccountId" class="text-danger"></span>
                        <small class="text-muted">Optional: Select parent account for hierarchical structure.</small>
                    </div>
                </div>

                <hr />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Create Account
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
