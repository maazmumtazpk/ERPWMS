@model ERPWMS.Database.Models.ChartOfAccount
@{ Layout = null; }
<form id="editAccountForm" method="post" action="/ChartOfAccount/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="accountId" value="@Model.AccountId" />
    <div id="editAccountAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-md-4"><label class="form-label fw-bold">Account Code *</label><input type="text" name="accountCode" class="form-control" value="@Model.AccountCode" required maxlength="20" /></div>
        <div class="col-md-8"><label class="form-label fw-bold">Account Name *</label><input type="text" name="accountName" class="form-control" value="@Model.AccountName" required maxlength="200" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Account Type</label><select name="accountType" class="form-select">@foreach(var t in new[]{"Asset","Liability","Equity","Revenue","Expense"}){if(Model.AccountType == t){<option value="@t" selected>@t</option>}else{<option value="@t">@t</option>}}</select></div>
        <div class="col-md-6"><label class="form-label fw-bold">Status</label><select name="isActive" class="form-select">@if((Model.IsActive == true)){<option value="true" selected>Active</option><option value="false">Inactive</option>}else{<option value="true">Active</option><option value="false" selected>Inactive</option>}</select></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>
