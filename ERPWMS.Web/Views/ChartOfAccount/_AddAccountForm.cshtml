@{
    Layout = null;
}
<form id="addAccountForm" method="post" action="/ChartOfAccount/Register">
    @Html.AntiForgeryToken()
    <div id="addAccountAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-md-4"><label class="form-label fw-bold">Account Code *</label><input type="text" name="accountCode" class="form-control" required maxlength="20" placeholder="1001" /></div>
        <div class="col-md-8"><label class="form-label fw-bold">Account Name *</label><input type="text" name="accountName" class="form-control" required maxlength="200" /></div>
        <div class="col-12"><label class="form-label fw-bold">Account Type</label><select name="accountType" class="form-select"><option value="Asset">Asset</option><option value="Liability">Liability</option><option value="Equity">Equity</option><option value="Revenue">Revenue</option><option value="Expense">Expense</option></select></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Create</button>
    </div>
</form>
