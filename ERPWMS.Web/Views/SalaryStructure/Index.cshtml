@{
    ViewData["Title"] = "Salary Structures";
    Layout = "_Layout";
}
<form id="__af" style="display:none;">@Html.AntiForgeryToken()</form>
<div class="toast-holder" id="toastHolder"></div>
@await Html.PartialAsync("_AdminCss")
<div style="padding-bottom:30px;">
<div class="table-card">
    <div class="card-header-custom">
        <h5><i class="bi bi-diagram-3" style="color:#F5A623;"></i> Salary Structures</h5>
        <button type="button" class="btn-icon gold" onclick="openAdd()"><i class="bi bi-plus-circle"></i></button>
    </div>
    <div class="card-body">
        <table class="table-premium" id="xTable">
            <thead><tr><th>Code</th><th>Name</th><th>Grade</th><th>Range</th><th>Components</th><th>Status</th><th style="text-align:right;">Actions</th></tr></thead>
            <tbody id="xBody"></tbody>
        </table>
    </div>
</div>
</div>
<div class="modal fade pm-modal" id="formModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 id="mTitle">Salary Structure</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body">
<input type="hidden" id="structureId" value="0" />
<div class="row g-3">
<div class="col-md-6"><label class="form-label">Code *</label><input type="text" id="structureCode" class="form-control" maxlength="20" /></div>
<div class="col-md-6"><label class="form-label">Name *</label><input type="text" id="structureName" class="form-control" maxlength="100" /></div>
<div class="col-md-6"><label class="form-label">Grade</label><select id="grade" class="form-control"><option>Worker</option><option>Officer</option><option>Manager</option><option>Executive</option></select></div>
<div class="col-md-6"><label class="form-label">Min Salary</label><input type="number" id="minSalary" class="form-control" step="0.01" /></div>
<div class="col-md-6"><label class="form-label">Max Salary</label><input type="number" id="maxSalary" class="form-control" step="0.01" /></div>
<div class="col-md-6"><div class="form-check form-switch" style="padding-top:22px;"><input class="form-check-input" type="checkbox" id="isActive" checked /><label class="form-check-label">Active</label></div></div>
<div class="col-12"><label class="form-label">Description</label><textarea id="description" class="form-control" rows="2"></textarea></div>
</div>
</div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn-gold" onclick="save_()">Save</button></div></div></div></div>
@await Html.PartialAsync("_AdminJs")
<script>
function tk(){var i=document.querySelector('#__af input[name="__RequestVerificationToken"]');return i?i.value:'';}
function openAdd(){
    document.getElementById('mTitle').textContent='Add Structure';
    document.getElementById('structureId').value=0;
    ['structureCode','structureName','minSalary','maxSalary','description'].forEach(function(id){document.getElementById(id).value='';});
    document.getElementById('grade').value='Worker';
    document.getElementById('isActive').checked=true;
    new bootstrap.Modal(document.getElementById('formModal')).show();
}
function edit_(id){
    fetch('/SalaryStructure/GetById?id='+id).then(function(r){return r.json();}).then(function(d){
        document.getElementById('mTitle').textContent='Edit Structure';
        document.getElementById('structureId').value=d.structureId;
        document.getElementById('structureCode').value=d.structureCode;
        document.getElementById('structureName').value=d.structureName;
        document.getElementById('grade').value=d.grade;
        document.getElementById('minSalary').value=d.minSalary||'';
        document.getElementById('maxSalary').value=d.maxSalary||'';
        document.getElementById('isActive').checked=d.isActive;
        document.getElementById('description').value=d.description||'';
        new bootstrap.Modal(document.getElementById('formModal')).show();
    });
}
function save_(){
    var fd=new FormData();
    fd.append('__RequestVerificationToken',tk());
    fd.append('structureId',document.getElementById('structureId').value);
    fd.append('structureCode',document.getElementById('structureCode').value);
    fd.append('structureName',document.getElementById('structureName').value);
    fd.append('grade',document.getElementById('grade').value);
    fd.append('minSalary',document.getElementById('minSalary').value);
    fd.append('maxSalary',document.getElementById('maxSalary').value);
    fd.append('description',document.getElementById('description').value);
    fd.append('isActive',document.getElementById('isActive').checked);
    fetch('/SalaryStructure/Save',{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){
        if(res.success){showToast(res.message,'success'); bootstrap.Modal.getInstance(document.getElementById('formModal')).hide(); reload_();}
        else showToast(res.message,'error');
    });
}
function del_(id){ if(!confirm('Delete?')) return; var fd=new FormData(); fd.append('__RequestVerificationToken',tk()); fetch('/SalaryStructure/Delete/'+id,{method:'POST',body:fd}).then(function(r){return r.json();}).then(function(res){if(res.success){showToast(res.message,'success'); reload_();}}); }
function reload_(){
    fetch('/SalaryStructure/GetAll').then(function(r){return r.json();}).then(function(d){
        var b=document.getElementById('xBody');
        if(!d||d.length===0){b.innerHTML='<tr><td colspan="7" class="text-center">No structures</td></tr>'; return;}
        var h='';
        d.forEach(function(x){
            var range = (x.minSalary||'-') + ' - ' + (x.maxSalary||'-');
            h+='<tr><td>'+x.structureCode+'</td><td>'+x.structureName+'</td><td>'+x.grade+'</td><td>'+range+'</td><td>'+x.componentCount+'</td><td>'+(x.isActive?'<span class="badge-status active">Active</span>':'<span class="badge-status inactive">Inactive</span>')+'</td>';
            h+='<td style="text-align:right;"><button class="btn-icon" onclick="edit_('+x.structureId+')"><i class="bi bi-pencil"></i></button> <button class="btn-icon" onclick="del_('+x.structureId+')"><i class="bi bi-trash3"></i></button></td></tr>';
        });
        b.innerHTML=h;
    });
}
document.addEventListener('DOMContentLoaded', reload_);
</script>
