@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - ERPWMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <style>
    body { min-height: 100vh; background: linear-gradient(135deg, #0A1628 0%, #1a2a4a 100%); display: flex; align-items: center; justify-content: center; padding: 20px; font-family: 'Inter', sans-serif; }
    .auth-card { background: #fff; border-radius: 16px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); max-width: 440px; width: 100%; padding: 40px 35px; }
    .auth-logo { text-align: center; margin-bottom: 25px; }
    .auth-logo h2 { color: #0A1628; font-weight: 800; font-size: 22px; margin: 0; }
    .auth-logo p { color: #64748B; font-size: 12px; margin: 5px 0 0; }
    .auth-title { color: #0A1628; font-weight: 700; font-size: 20px; margin-bottom: 8px; }
    .auth-subtitle { color: #64748B; font-size: 13px; margin-bottom: 25px; line-height: 1.5; }
    .form-label { font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
    .form-control { padding: 12px 15px; border-radius: 8px; border: 1px solid #E2E8F0; font-size: 14px; }
    .form-control:focus { border-color: #F5A623; box-shadow: 0 0 0 3px rgba(245,166,35,0.15); outline: none; }
    .btn-gold { background: #F5A623; color: #0A1628; font-weight: 700; border: none; padding: 12px; border-radius: 8px; width: 100%; font-size: 14px; transition: all 0.2s; }
    .btn-gold:hover { background: #E39A19; color: #0A1628; }
    .auth-footer { text-align: center; margin-top: 20px; font-size: 12px; color: #64748B; }
    .auth-footer a { color: #F5A623; text-decoration: none; font-weight: 600; }
    .alert-danger { background: #FEF2F2; color: #DC2626; border: 1px solid #FCA5A5; border-left: 4px solid #DC2626; padding: 10px 15px; border-radius: 8px; font-size: 12px; margin-bottom: 15px; }
    .alert-success { background: #DDF7F1; color: #118B7B; border-left: 4px solid #159A89; padding: 10px 15px; border-radius: 8px; font-size: 12px; margin-bottom: 15px; }
    .otp-display { background: #FEFBF5; border: 2px dashed #F5A623; border-radius: 10px; padding: 15px; text-align: center; margin: 15px 0; }
    .otp-display small { color: #64748B; font-size: 10px; text-transform: uppercase; font-weight: 700; }
    .otp-display .code { font-size: 28px; font-weight: 800; color: #0A1628; letter-spacing: 5px; margin-top: 5px; }
</style>
</head>
<body>
    <div class="auth-card">
        <div class="auth-logo">
            <h2>EnterpriseWMS</h2>
            <p>Set New Password</p>
        </div>

        <h3 class="auth-title">Create New Password</h3>
        <p class="auth-subtitle">Choose a strong password (minimum 6 characters) to secure your account.</p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-danger">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }

        <form method="post" asp-controller="Account" asp-action="ResetPassword">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label class="form-label">New Password</label>
                <input type="password" name="newPassword" class="form-control" placeholder="Enter new password" minlength="6" required autofocus />
            </div>
            <div class="mb-3">
                <label class="form-label">Confirm Password</label>
                <input type="password" name="confirmPassword" class="form-control" placeholder="Confirm new password" minlength="6" required />
            </div>
            <button type="submit" class="btn-gold">Reset Password</button>
        </form>

        <div class="auth-footer">
            <a href="/Account/Login">Back to Login</a>
        </div>
    </div>
</body>
</html>
