@model ERPWMS.Application.DTOs.Identity.LoginRequest
@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - EnterpriseWMS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        *{box-sizing:border-box;margin:0;padding:0}
        body{font-family:'Segoe UI',system-ui,sans-serif;min-height:100vh;background:linear-gradient(135deg,#0A1628 0%,#1a2942 50%,#0A1628 100%);display:flex;align-items:center;justify-content:center;padding:20px;position:relative;overflow:hidden}
        body::before{content:"";position:absolute;top:-50%;right:-20%;width:800px;height:800px;background:radial-gradient(circle,rgba(245,166,35,.15) 0%,transparent 70%);border-radius:50%}
        body::after{content:"";position:absolute;bottom:-40%;left:-15%;width:600px;height:600px;background:radial-gradient(circle,rgba(21,154,137,.12) 0%,transparent 70%);border-radius:50%}
        .login-wrap{width:100%;max-width:440px;position:relative;z-index:2}
        .brand{text-align:center;margin-bottom:28px}
        .brand-icon{width:70px;height:70px;background:linear-gradient(135deg,#F5A623,#E0951A);border-radius:18px;display:inline-flex;align-items:center;justify-content:center;font-size:32px;color:#0A1628;box-shadow:0 12px 32px rgba(245,166,35,.35);margin-bottom:14px}
        .brand h1{color:#fff;font-size:24px;font-weight:800;letter-spacing:-.5px;margin:0}
        .brand p{color:rgba(255,255,255,.55);font-size:12px;margin-top:4px;font-weight:500}
        .login-card{background:rgba(255,255,255,.98);backdrop-filter:blur(20px);border-radius:18px;padding:32px 28px;box-shadow:0 24px 60px rgba(0,0,0,.35);border:1px solid rgba(255,255,255,.1)}
        .login-card h2{font-size:18px;font-weight:800;color:#0A1628;margin:0 0 4px;letter-spacing:-.3px}
        .login-card .sub{font-size:11.5px;color:#94A3B8;margin-bottom:22px}
        .form-field{margin-bottom:16px}
        .form-field label{display:block;font-size:10.5px;font-weight:700;color:#475569;text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px}
        .form-input-wrap{position:relative}
        .form-input-wrap i{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#94A3B8;font-size:14px;pointer-events:none}
        .form-input{width:100%;padding:13px 14px 13px 42px;border:1.5px solid #E2E8F0;border-radius:10px;font-size:13px;background:#FAFBFC;outline:none;transition:all .18s;color:#0A1628;font-weight:500}
        .form-input:focus{border-color:#F5A623;background:#fff;box-shadow:0 0 0 4px rgba(245,166,35,.12)}
        .form-input.is-invalid{border-color:#DC2626;background:#FEF2F2}
        .btn-login{width:100%;padding:13px;background:#0A1628;color:#fff;border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;transition:all .18s;display:flex;align-items:center;justify-content:center;gap:8px;letter-spacing:.2px}
        .btn-login:hover{background:#F5A623;color:#0A1628;transform:translateY(-1px);box-shadow:0 8px 20px rgba(245,166,35,.3)}
        .btn-login:disabled{opacity:.6;cursor:not-allowed}
        .remember{display:flex;align-items:center;gap:8px;font-size:12px;color:#475569;font-weight:600;cursor:pointer;margin-bottom:18px}
        .remember input{accent-color:#F5A623;width:16px;height:16px;cursor:pointer}
        .alert-error{padding:11px 14px;border-radius:9px;background:#FEF2F2;color:#B91C1C;border-left:4px solid #DC2626;font-size:12px;font-weight:600;margin-bottom:16px;display:flex;align-items:center;gap:8px}
        .footer-text{text-align:center;margin-top:22px;font-size:11px;color:rgba(255,255,255,.4)}
        .footer-text strong{color:#F5A623}
    </style>
</head>
<body>
    <div class="login-wrap">
        <div class="brand">
            <div class="brand-icon"><i class="bi bi-box-seam"></i></div>
            <h1>EnterpriseWMS</h1>
            <p>Warehouse Management System</p>
        </div>

        <div class="login-card">
            <h2>Welcome Back</h2>
            <p class="sub">Sign in to your account to continue</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-error">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span>@ViewData.ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage</span>
                </div>
            }

            <form method="post" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]">
                @Html.AntiForgeryToken()
                <div class="form-field">
                    <label>Username or Email</label>
                    <div class="form-input-wrap">
                        <i class="bi bi-person"></i>
                        <input type="text" name="UsernameOrEmail" class="form-input" value="@Model?.UsernameOrEmail" required autofocus autocomplete="username" />
                    </div>
                </div>
                <div class="form-field">
                    <label>Password</label>
                    <div class="form-input-wrap">
                        <i class="bi bi-lock"></i>
                        <input type="password" name="Password" class="form-input" required autocomplete="current-password" />
                    </div>
                </div>
                <label class="remember">
                    <input type="checkbox" name="RememberMe" value="true" @(Model?.RememberMe == true ? "checked" : "") />
                    <span>Keep me signed in</span>
                </label>
                <button type="submit" class="btn-login">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Sign In</span>
                </button>
            </form>
        </div>

        <div class="footer-text">
            &copy; @DateTime.Now.Year <strong>EnterpriseWMS</strong> — All Rights Reserved
        </div>
    </div>
</body>
</html>
