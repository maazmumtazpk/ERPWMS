@model List<ERPWMS.Database.Models.Employee>
@{
    ViewData["Title"] = "Employee Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var totalEmp = ViewBag.TotalEmployees ?? 0;
    var activeCount = Model?.Count(e => e.IsActive == true) ?? 0;
    var inactiveCount = Model?.Count(e => e.IsActive != true) ?? 0;
    var bankCount = ViewBag.TotalBankAccounts ?? 0;
}
<form id="__af" style="display:none;">@Html.AntiForgeryToken()</form>
<style>
    .kpi-card{background:#fff;border:1px solid #edf0f4;border-radius:10px;padding:12px 14px;box-shadow:0 2px 8px rgba(0,0,0,.04);min-height:80px;display:flex;flex-direction:column;justify-content:center;position:relative}
    .kpi-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2.5px}
    .kpi-card.total::before{background:#0A1628}.kpi-card.active::before{background:#159A89}.kpi-card.inactive::before{background:#F5A623}.kpi-card.bank::before{background:#0EA5E9}
    .kpi-content{display:flex;justify-content:space-between;align-items:center;width:100%;gap:8px}
    .kpi-label{margin:0 0 3px 0;color:#64748B;font-size:9px;font-weight:700;text-transform:uppercase}
    .kpi-number{margin:0;color:#0A1628;font-size:20px;font-weight:750}
    .kpi-icon{width:30px;height:30px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:13px}
    .kpi-icon.blue{background:#0A1628;color:#fff}.kpi-icon.green{background:#D7F4EE;color:#159A89}.kpi-icon.orange{background:#FFF1D7;color:#E39A19}.kpi-icon.cyan{background:#E0F2FE;color:#0369A1}
    .table-card{background:#fff;border:1px solid #edf0f4;border-radius:10px;box-shadow:0 2px 8px rgba(0,0,0,.04);margin-top:16px;overflow:visible}
    .card-header-custom{padding:10px 14px;border-bottom:2px solid #F1F5F9;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px}
    .card-header-custom h5{margin:0;font-size:12px;font-weight:700;color:#0A1628;display:flex;align-items:center;gap:6px}
    .badge-count{background:#F1F5F9;color:#64748B;font-size:9px;font-weight:700;padding:1px 8px;border-radius:12px}
    .card-body{padding:0;overflow-x:auto}
    table.table-premium{margin:0;font-size:11px;width:100%}
    table.table-premium thead{background:#F8FAFC;border-bottom:2px solid #E2E8F0}
    table.table-premium thead th{padding:8px 14px;font-weight:700;font-size:9px;text-transform:uppercase;color:#64748B;border:none;text-align:left}
    table.table-premium tbody td{padding:8px 14px;vertical-align:middle;border-bottom:1px solid #F1F5F9;color:#0A1628;font-size:11px}
    table.table-premium tbody tr:hover{background:#FEFBF5}
    .row-name{font-weight:600;display:flex;align-items:center;gap:8px}
    .row-name .avatar{width:28px;height:28px;border-radius:6px;background:#DBEAFE;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:10px;color:#1D4ED8}
    .badge-status{padding:2px 8px;border-radius:12px;font-size:8px;font-weight:700;text-transform:uppercase}
    .badge-status.active{background:#DDF7F1;color:#118B7B}
    .badge-status.inactive{background:#F1F5F9;color:#64748B}
    .badge-info{padding:2px 8px;border-radius:4px;font-size:9px;font-weight:600}
    .dept-badge{background:#EDE9FE;color:#6D28D9}.desig-badge{background:#DBEAFE;color:#1D4ED8}.branch-badge{background:#FEF3C7;color:#92400E}
    .btn-icon{width:26px;height:26px;border-radius:6px;border:1px solid #E8ECF1;display:inline-flex;align-items:center;justify-content:center;font-size:12px;color:#64748B;background:#fff;cursor:pointer}
    .btn-icon:hover{background:#F1F5F9}
    .btn-icon.gold{background:#F5A623;color:#fff;border-color:#F5A623}
    .act-wrap{position:relative;display:inline-block}
    .act-menu{position:fixed;background:#fff;border:1px solid #E8ECF1;border-radius:8px;box-shadow:0 8px 24px rgba(15,23,42,.14);min-width:180px;padding:5px;z-index:99999;display:none;text-align:left}
    .act-menu a{display:flex;align-items:center;gap:10px;width:100%;padding:8px 11px;font-size:11.5px;color:#334155;border-radius:6px;text-decoration:none;cursor:pointer;font-weight:500}
    .act-menu a:hover{background:#F8FAFC}
    .act-menu a i{width:14px;color:#64748B}
    .act-menu .sep{height:1px;background:#F1F5F9;margin:3px 5px}
    .act-menu .danger{color:#DC2626}.act-menu .danger i{color:#DC2626}
    .search-wrapper{position:relative;display:inline-block}
    .search-wrapper input{border:1px solid #E2E8F0;border-radius:6px;padding:4px 10px 4px 28px;font-size:10px;width:160px;background:#FAFBFC;height:28px}
    .search-wrapper i{position:absolute;left:8px;top:50%;transform:translateY(-50%);color:#94A3B8;font-size:10px}
    .table-footer{padding:8px 14px;border-top:2px solid #F1F5F9;display:flex;justify-content:space-between;font-size:10px;color:#64748B;background:#F8FAFC}
    .empty-state{padding:30px 16px;text-align:center}
    .empty-state i{font-size:35px;color:#E2E8F0;display:block;margin-bottom:8px}
    .empty-state h4{font-size:13px;font-weight:700;color:#0A1628;margin-bottom:4px}
    .empty-state p{color:#64748B;font-size:10px;margin:0 auto 12px auto}
    .btn-gold{background:#F5A623;color:#0A1628;border:none;padding:6px 14px;border-radius:6px;font-weight:700;font-size:10px;text-decoration:none;display:inline-flex;align-items:center;gap:5px;cursor:pointer}
</style>
<div class="container-fluid py-4">
    <div class="row g-3">
        <div class="col-xl-3 col-lg-3 col-md-6"><div class="kpi-card total"><div class="kpi-content"><div><p class="kpi-label">Total Employees</p><h2 class="kpi-number">@totalEmp</h2></div><div class="kpi-icon blue"><i class="bi bi-people"></i></div></div></div></div>
        <div class="col-xl-3 col-lg-3 col-md-6"><div class="kpi-card active"><div class="kpi-content"><div><p class="kpi-label">Active</p><h2 class="kpi-number">@activeCount</h2></div><div class="kpi-icon green"><i class="bi bi-check-circle"></i></div></div></div></div>
        <div class="col-xl-3 col-lg-3 col-md-6"><div class="kpi-card inactive"><div class="kpi-content"><div><p class="kpi-label">Inactive</p><h2 class="kpi-number">@inactiveCount</h2></div><div class="kpi-icon orange"><i class="bi bi-x-circle"></i></div></div></div></div>
        <div class="col-xl-3 col-lg-3 col-md-6"><div class="kpi-card bank"><div class="kpi-content"><div><p class="kpi-label">Bank Accounts</p><h2 class="kpi-number">@bankCount</h2></div><div class="kpi-icon cyan"><i class="bi bi-bank"></i></div></div></div></div>
    </div>
    <div class="table-card">
        <div class="card-header-custom">
            <h5><i class="bi bi-list-ul" style="color:#F5A623;"></i> Employee List <span class="badge-count">@(Model?.Count ?? 0) Records</span></h5>
            <div style="display:flex;gap:4px;align-items:center;">
                <div class="search-wrapper"><i class="bi bi-search"></i><input type="text" id="tableSearch" placeholder="Search..." onkeyup="filterTable()" /></div>
                <button class="btn-icon gold" onclick="openAdd()"><i class="bi bi-plus-circle"></i></button>
                <button class="btn-icon" onclick="location.reload()"><i class="bi bi-arrow-clockwise"></i></button>
            </div>
        </div>
        <div class="card-body">
            <table class="table-premium" id="empTable">
                <thead><tr>
                    <th>#</th><th>Employee</th><th>Code</th><th>Department</th><th>Designation</th><th>Branch</th><th>Shift</th><th>Status</th><th style="text-align:right;">Actions</th>
                </tr></thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        int i = 1;
                        foreach (var emp in Model)
                        {
                            var initials = !string.IsNullOrWhiteSpace(emp.FirstName) ? (emp.FirstName[0].ToString() + (string.IsNullOrWhiteSpace(emp.LastName) ? "" : emp.LastName[0].ToString())).ToUpper() : "EM";
                            var fullName = (emp.FirstName + " " + (emp.LastName ?? "")).Trim();
                            <tr>
                                <td>@(i++)</td>
                                <td><div class="row-name"><span class="avatar">@initials</span><span>@fullName</span></div></td>
                                <td><span class="badge-info" style="background:#F1F5F9;color:#64748B;font-family:monospace;">@emp.EmployeeCode</span></td>
                                <td><span class="badge-info dept-badge">@(emp.Department?.DepartmentName ?? "-")</span></td>
                                <td><span class="badge-info desig-badge">@(emp.Designation?.DesignationName ?? "-")</span></td>
                                <td><span class="badge-info branch-badge">@(emp.Branch?.BranchName ?? "-")</span></td>
                                <td style="font-size:10px;color:#64748B;">@(emp.Shift?.ShiftName ?? "Not Assigned")</td>
                                <td>@if (emp.IsActive == true) { <span class="badge-status active">Active</span> } else { <span class="badge-status inactive">Inactive</span> }</td>
                                <td style="text-align:right;">
                                    <div class="act-wrap">
                                        <button class="btn-icon" onclick="toggleEmpMenu(@emp.EmployeeId, event)"><i class="bi bi-three-dots-vertical"></i></button>
                                        <div class="act-menu" id="emp-menu-@emp.EmployeeId">
                                            <a href="/Employee/Profile/@emp.EmployeeId"><i class="bi bi-eye"></i> View Profile</a>
                                            <a href="javascript:void(0)" onclick="openEdit(@emp.EmployeeId)"><i class="bi bi-pencil"></i> Edit</a>
                                            <div class="sep"></div>
                                            <a href="javascript:void(0)" onclick="deleteEmp(@emp.EmployeeId)" class="danger"><i class="bi bi-trash3"></i> Delete</a>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="9" class="text-center py-4"><div class="empty-state"><i class="bi bi-people"></i><h4>No Employees Found</h4><p>Register your first employee.</p><a href="javascript:void(0)" onclick="openAdd()" class="btn-gold"><i class="bi bi-plus-circle"></i> Add Employee</a></div></td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer"><span><i class="bi bi-info-circle"></i> Showing <span id="tableCount">@(Model?.Count ?? 0)</span> employees</span></div>
    </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content">
    <div class="modal-header"><h5>Add Employee</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body" id="addModalBody"></div>
</div></div></div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1"><div class="modal-dialog modal-lg"><div class="modal-content">
    <div class="modal-header"><h5>Edit Employee</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
    <div class="modal-body" id="editModalBody"></div>
</div></div></div>

<script>
    function toggleEmpMenu(id, e) {
        e.stopPropagation();
        document.querySelectorAll(".act-menu").forEach(function(m){ if(m.id !== "emp-menu-"+id) m.style.display="none"; });
        var el = document.getElementById("emp-menu-" + id);
        if (!el) return;
        if (el.style.display === "block") { el.style.display="none"; return; }
        var b = e.currentTarget || e.target;
        var r = b.getBoundingClientRect();
        el.style.top = (r.bottom+4)+"px";
        el.style.right = (window.innerWidth-r.right)+"px";
        el.style.left = "auto";
        el.style.display = "block";
        var mh = el.offsetHeight;
        if (r.bottom + mh + 10 > window.innerHeight) el.style.top = (r.top - mh - 4) + "px";
    }
    document.addEventListener("click", function(){ document.querySelectorAll(".act-menu").forEach(function(m){ m.style.display="none"; }); });
    function filterTable() {
        var f = document.getElementById("tableSearch").value.toLowerCase();
        var rows = document.querySelectorAll("#empTable tbody tr");
        var n = 0;
        rows.forEach(function(r){ var t = (r.textContent||"").toLowerCase(); if(t.indexOf(f)>-1){ r.style.display=""; n++; } else r.style.display="none"; });
        document.getElementById("tableCount").textContent = n;
    }
    function execScripts(c) {
        c.querySelectorAll("script").forEach(function(s){ var n=document.createElement("script"); n.textContent=s.textContent; document.body.appendChild(n); });
    }
    function openAdd() {
        var el = document.getElementById("addModal");
        var b = document.getElementById("addModalBody");
        b.innerHTML = "<div class='text-center py-4'><div class='spinner-border text-primary'></div></div>";
        new bootstrap.Modal(el).show();
        fetch("/Employee/AddPartial").then(r=>r.text()).then(h=>{ b.innerHTML=h; execScripts(b); });
    }
    function openEdit(id) {
        var el = document.getElementById("editModal");
        var b = document.getElementById("editModalBody");
        b.innerHTML = "<div class='text-center py-4'><div class='spinner-border text-primary'></div></div>";
        new bootstrap.Modal(el).show();
        fetch("/Employee/EditPartial?id=" + id).then(r=>r.text()).then(h=>{ b.innerHTML=h; execScripts(b); });
    }
    function deleteEmp(id) {
        if (!confirm("Delete this employee?")) return;
        var e = document.querySelector("input[name=__RequestVerificationToken]");
        var fd = new FormData(); fd.append("__RequestVerificationToken", e ? e.value : "");
        fetch("/Employee/DeleteEmployee/" + id, {method:"POST", body:fd})
            .then(r=>r.json()).then(res => { if(res.success) location.reload(); else alert(res.message); });
    }
    document.addEventListener("submit", function(e) {
        var f = e.target;
        if (!f || (f.id !== "addEmployeeForm" && f.id !== "editEmployeeForm")) return;
        e.preventDefault();
        var ab = document.getElementById(f.id === "addEmployeeForm" ? "addEmpAlert" : "editEmpAlert");
        if (ab) ab.style.display = "none";
        var btn = f.querySelector("button[type=submit]");
        var orig = btn ? btn.innerHTML : "";
        if (btn) { btn.disabled=true; btn.textContent="Saving..."; }
        fetch(f.action, {method:"POST", body:new FormData(f)})
            .then(r=>r.json()).then(res => {
                if (res.success) {
                    var m = bootstrap.Modal.getInstance(f.closest(".modal"));
                    if (m) m.hide();
                    location.reload();
                } else { if (ab) { ab.textContent = res.message || "Failed"; ab.style.display="block"; } }
            })
            .catch(()=> { if (ab) { ab.textContent = "Network error"; ab.style.display="block"; } })
            .finally(()=> { if (btn) { btn.disabled=false; btn.innerHTML=orig; } });
    });
</script>
