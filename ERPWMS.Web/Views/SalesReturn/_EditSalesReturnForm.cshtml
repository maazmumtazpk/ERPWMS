@model ERPWMS.Database.Models.SalesReturn
@{ Layout = null; }
<form id="editSalesReturnForm" method="post" action="/SalesReturn/Edit">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnId" value="@Model.ReturnId" />
    <div id="editSalesReturnAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label fw-bold">Return No *</label><input type="text" name="returnNo" class="form-control" value="@Model.ReturnNo" required maxlength="50" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Return Date</label><input type="date" name="returnDate" class="form-control" value="@(Model.ReturnDate?.ToString("yyyy-MM-dd"))" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Sales Order</label><select name="salesId" id="editSales" class="form-select"><option value="">Loading...</option></select></div>
        <div class="col-md-6"><label class="form-label fw-bold">Total Amount</label><input type="number" step="0.01" name="totalAmount" class="form-control" value="@Model.TotalAmount" /></div>
        <div class="col-12"><label class="form-label fw-bold">Return Reason</label><textarea name="returnReason" class="form-control" rows="2" maxlength="500">@Model.ReturnReason</textarea></div>
        <div class="col-12"><label class="form-label fw-bold">Status</label><select name="status" class="form-select">@foreach(var s in new[]{"Pending","Approved","Rejected"}){if(Model.Status == s){<option value="@s" selected>@s</option>}else{<option value="@s">@s</option>}}</select></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Update</button>
    </div>
</form>
<script>
(function(){var sid=@Model.SalesId;
fetch("/SalesReturn/GetSalesOrders").then(r=>r.json()).then(d=>{var s=document.getElementById("editSales");s.innerHTML="<option value=''>-- Select SO --</option>";(d||[]).forEach(x=>{var o=document.createElement("option");o.value=x.salesId;o.textContent=x.salesOrderNo;if(x.salesId===sid)o.selected=true;s.appendChild(o);});});})();
</script>
