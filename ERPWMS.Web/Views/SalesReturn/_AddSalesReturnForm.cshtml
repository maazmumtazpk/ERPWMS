@{
    Layout = null;
}
<form id="addSalesReturnForm" method="post" action="/SalesReturn/Register">
    @Html.AntiForgeryToken()
    <div id="addSalesReturnAlert" style="display:none;padding:9px 12px;border-radius:6px;font-size:11.5px;margin-bottom:14px;background:#FEF2F2;color:#DC2626;border-left:3px solid #DC2626;"></div>
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label fw-bold">Return No *</label><input type="text" name="returnNo" class="form-control" required maxlength="50" placeholder="SR-2026-001" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Return Date</label><input type="date" name="returnDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" /></div>
        <div class="col-md-6"><label class="form-label fw-bold">Sales Order *</label><select name="salesId" id="addSales" class="form-select" required><option value="">Loading...</option></select></div>
        <div class="col-md-6"><label class="form-label fw-bold">Total Amount</label><input type="number" step="0.01" name="totalAmount" class="form-control" value="0" /></div>
        <div class="col-12"><label class="form-label fw-bold">Return Reason</label><textarea name="returnReason" class="form-control" rows="2" maxlength="500"></textarea></div>
    </div>
    <div style="padding:12px 0 0;border-top:1px solid #eef2f6;margin-top:12px;display:flex;justify-content:flex-end;gap:8px;">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-gold btn-sm">Create Return</button>
    </div>
</form>
<script>
fetch("/SalesReturn/GetSalesOrders").then(r=>r.json()).then(d=>{var s=document.getElementById("addSales");s.innerHTML="<option value=''>-- Select SO --</option>";(d||[]).forEach(x=>{var o=document.createElement("option");o.value=x.salesId;o.textContent=x.salesOrderNo;s.appendChild(o);});});
</script>
