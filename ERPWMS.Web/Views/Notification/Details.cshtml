@model ERPWMS.Application.DTOs.Notification.NotificationDto
@{
    ViewData["Title"] = "Notification Details";
    Layout = "_Layout";
}
@await Html.PartialAsync("_AdminCss")
<div style="padding-bottom:30px;">
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0" style="color:#0A1628;font-size:18px;">Notification Details</h4>
        <small class="text-muted" style="font-size:11px;">Home / Notifications / View</small>
    </div>
    <a href="/Notification/Index" class="btn-icon" style="width:auto;padding:0 12px;text-decoration:none;"><i class="bi bi-arrow-left me-1"></i> Back</a>
</div>

<div class="table-card" style="margin-top:0;">
    <div class="card-header-custom">
        <h5><i class="bi bi-bell" style="color:#F5A623;"></i> @(Model.Subject ?? "(No Subject)")</h5>
        @if ((Model.IsRead == true))
        {
            <span class="badge-status active"><i class="bi bi-envelope-open"></i> Read</span>
        }
        else
        {
            <span class="badge-status inactive"><i class="bi bi-envelope-fill"></i> Unread</span>
        }
    </div>
    <div style="padding:20px 24px;">
        <div class="row g-3" style="margin-bottom:20px;">
            <div class="col-md-3">
                <div style="font-size:10px;color:#94A3B8;text-transform:uppercase;font-weight:700;letter-spacing:.5px;">Type</div>
                <div style="font-size:12.5px;font-weight:700;color:#0A1628;margin-top:4px;">@(Model.Type ?? "Info")</div>
            </div>
            <div class="col-md-3">
                <div style="font-size:10px;color:#94A3B8;text-transform:uppercase;font-weight:700;letter-spacing:.5px;">Sent</div>
                <div style="font-size:12.5px;font-weight:700;color:#0A1628;margin-top:4px;">@(Model.SentDate?.ToString("dd MMM yyyy HH:mm") ?? "-")</div>
            </div>
            <div class="col-md-3">
                <div style="font-size:10px;color:#94A3B8;text-transform:uppercase;font-weight:700;letter-spacing:.5px;">Template</div>
                <div style="font-size:12.5px;font-weight:700;color:#0A1628;margin-top:4px;">@(Model.TemplateName ?? "-")</div>
            </div>
            <div class="col-md-3">
                <div style="font-size:10px;color:#94A3B8;text-transform:uppercase;font-weight:700;letter-spacing:.5px;">Reference</div>
                <div style="font-size:12.5px;font-weight:700;color:#0A1628;margin-top:4px;">@(Model.ReferenceNo ?? "-")</div>
            </div>
        </div>
        <div style="border-top:1px solid #F1F5F9;padding-top:20px;">
            <div style="font-size:10px;color:#94A3B8;text-transform:uppercase;font-weight:700;letter-spacing:.5px;margin-bottom:10px;">Message</div>
            <div style="font-size:13px;line-height:1.7;color:#334155;background:#F8FAFC;padding:18px;border-radius:10px;border-left:3px solid #F5A623;white-space:pre-wrap;">@(Model.Message ?? "No message content")</div>
        </div>
    </div>
    <div style="padding:14px 24px;background:#FAFBFC;border-top:1px solid #F1F5F9;display:flex;justify-content:flex-end;gap:8px;">
        @if (Model.IsRead != true)
        {
            <form method="post" asp-action="MarkAsRead" asp-route-id="@Model.NotificationId" style="display:inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-gold" style="padding:8px 16px;font-size:11px;"><i class="bi bi-check2"></i> Mark as Read</button>
            </form>
        }
        <form method="post" asp-action="Delete" asp-route-id="@Model.NotificationId" style="display:inline;">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn-icon" style="width:auto;padding:0 14px;height:34px;background:#FEE2E2;color:#DC2626;border-color:#FCA5A5;" onclick="return confirm('Delete this notification?')"><i class="bi bi-trash3 me-1"></i> Delete</button>
        </form>
    </div>
</div>
</div>
