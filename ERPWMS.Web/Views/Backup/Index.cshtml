@model List<ERPWMS.Controllers.Admin.BackupFileInfo>
@{
    ViewData["Title"] = "Database Backups";
    Layout = "_Layout";
    var totalSize = Model.Sum(x => x.SizeMB);
    var latestBackup = Model.FirstOrDefault();
}
@await Html.PartialAsync("_AdminCss")

<div class="toast-holder" id="toastHolder"></div>
<div style="padding-bottom:30px;">

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div>
        <h4 class="fw-bold mb-0" style="color:#0A1628;font-size:18px;">Database Backups</h4>
        <small class="text-muted" style="font-size:11px;">Home / Admin / Backups</small>
    </div>
    <form method="post" asp-action="Create" style="display:inline;">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn-gold" style="padding:10px 18px;font-size:12px;" onclick="return confirm('Create new database backup? This may take a few minutes.');">
            <i class="bi bi-database-add"></i> Take Backup Now
        </button>
    </form>
</div>

@if (TempData["Success"] != null)
{
    <div style="padding:12px 16px;background:#DCFCE7;color:#15803D;border-left:4px solid #22C55E;border-radius:8px;font-size:12px;font-weight:600;margin-bottom:14px;">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div style="padding:12px 16px;background:#FEE2E2;color:#B91C1C;border-left:4px solid #DC2626;border-radius:8px;font-size:12px;font-weight:600;margin-bottom:14px;">
        <i class="bi bi-x-circle-fill me-2"></i>@TempData["Error"]
    </div>
}

<!-- KPI Cards -->
<div class="row g-3">
    <div class="col-xl-3 col-lg-3 col-md-6">
        <div class="kpi-card total">
            <div class="kpi-content">
                <div class="kpi-text-group">
                    <p class="kpi-label">Total Backups</p>
                    <h2 class="kpi-number">@Model.Count</h2>
                </div>
                <div class="kpi-icon blue"><i class="bi bi-database-fill"></i></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-lg-3 col-md-6">
        <div class="kpi-card active">
            <div class="kpi-content">
                <div class="kpi-text-group">
                    <p class="kpi-label">Total Size</p>
                    <h2 class="kpi-number">@totalSize.ToString("N2") <span style="font-size:12px;">MB</span></h2>
                </div>
                <div class="kpi-icon green"><i class="bi bi-hdd-fill"></i></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-lg-3 col-md-6">
        <div class="kpi-card month">
            <div class="kpi-content">
                <div class="kpi-text-group">
                    <p class="kpi-label">Database</p>
                    <h2 class="kpi-number" style="font-size:14px;">@ViewBag.DatabaseName</h2>
                </div>
                <div class="kpi-icon purple"><i class="bi bi-server"></i></div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-lg-3 col-md-6">
        <div class="kpi-card inactive">
            <div class="kpi-content">
                <div class="kpi-text-group">
                    <p class="kpi-label">Latest Backup</p>
                    <h2 class="kpi-number" style="font-size:12px;">@(latestBackup?.DateFormatted ?? "No backups")</h2>
                </div>
                <div class="kpi-icon orange"><i class="bi bi-clock-history"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Backup List -->
<div class="table-card">
    <div class="card-header-custom">
        <h5><i class="bi bi-database-fill" style="color:#F5A623;"></i> All Backups <span class="badge-count" id="xCount">@Model.Count</span></h5>
        <div style="display:flex;gap:4px;align-items:center;">
            <input type="text" id="tSearch" class="search-input" placeholder="Search..." onkeyup="filterRows()" />
            <a href="/Backup/Index" class="btn-icon" title="Refresh"><i class="bi bi-arrow-clockwise"></i></a>
        </div>
    </div>
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-database empty-icon"></i>
                <h4>No Backups Yet</h4>
                <p>Create your first database backup. This will save a .bak file you can download and restore later.</p>
                <form method="post" asp-action="Create" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-gold" style="padding:10px 18px;font-size:12px;">
                        <i class="bi bi-database-add"></i> Take Backup Now
                    </button>
                </form>
            </div>
        }
        else
        {
            <table class="table-premium" id="xTable">
                <thead>
                    <tr>
                        <th>File</th>
                        <th>Size</th>
                        <th>Created</th>
                        <th style="text-align:right;">Actions</th>
                    </tr>
                </thead>
                <tbody id="xBody">
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td>
                                <div class="row-name">
                                    <span class="avatar" style="background:#DBEAFE;color:#1D4ED8;"><i class="bi bi-file-earmark-zip"></i></span>
                                    <div>
                                        <div style="font-family:monospace;font-size:11px;">@b.FileName</div>
                                        <small style="color:#94A3B8;font-size:10px;">SQL Server .bak file</small>
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge-status role">@b.SizeMB.ToString("N2") MB</span></td>
                            <td style="font-size:11px;color:#64748B;"><i class="bi bi-calendar3 me-1"></i>@b.DateFormatted</td>
                            <td>
                                <div class="act-wrap">
                                    <button class="btn-icon" onclick="toggleMenu('@b.FileName.GetHashCode()', event)">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <div class="act-menu" id="menu-@b.FileName.GetHashCode()">
                                        <a href="/Backup/Download?fileName=@b.FileName"><i class="bi bi-download"></i> Download</a>
                                        <div class="sep"></div>
                                        <form method="post" asp-action="Delete" style="display:block;width:100%;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="fileName" value="@b.FileName" />
                                            <button type="submit" class="danger" style="width:100%;" onclick="return confirm('Delete backup @b.FileName ?');">
                                                <i class="bi bi-trash3"></i> Delete
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="table-footer">
                <span><i class="bi bi-info-circle"></i> Showing <span id="tableCount">@Model.Count</span> backups</span>
                <span><i class="bi bi-info-circle"></i> Backups folder: App_Data\Backups\</span>
            </div>
        }
    </div>
</div>

</div>
@await Html.PartialAsync("_AdminJs")
